<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- PackAsTool allows installing this server as a .NET global/local tool:
         dotnet tool install -g Fakvio.McpServer
         Then run: fakvio-mcp -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fakvio-mcp</ToolCommandName>
    <PackageId>Fakvio.McpServer</PackageId>
    <Description>MCP (Model Context Protocol) server for Fakvio invoicing — exposes invoice, client, template, and reporting tools for AI assistants.</Description>

    <!-- Metadata required for a public nuget.org listing. Version is bumped by hand:
         the publish step pushes with the skip-duplicate flag, so a master build that did not
         touch this number is a no-op instead of a failure. Bump it in the same PR that
         changes the tool, or the fix ships to CI artifacts and to nobody else. -->
    <Version>2.6.0</Version>
    <Authors>zCloud</Authors>
    <Company>zCloud</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zcloudcz/InvoiceApi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zcloudcz/InvoiceApi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;model-context-protocol;fakvio;invoicing;ai-tools;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shown as the package description page on nuget.org. Same file the repo serves,
         so the published page cannot drift from the one developers read. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- ModelContextProtocol — official C# SDK for MCP (stdio transport, tool discovery) -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />

    <!-- ModelContextProtocol.AspNetCore — MapMcp() + the Streamable HTTP transport used by
         the "http" hosting mode. It carries a FrameworkReference to Microsoft.AspNetCore.App,
         so the packaged tool needs the ASP.NET Core shared framework even when run over stdio. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />

    <!-- Generic Host for DI, configuration, and lifetime management -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />

    <!-- IHttpClientFactory for typed HttpClient registration -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts only — zero DB/Infrastructure dependencies.
         Gives us all DTOs, enums, and pagination types. -->
    <ProjectReference Include="..\Fakvio.Contracts\Fakvio.Contracts.csproj" />
  </ItemGroup>

</Project>
