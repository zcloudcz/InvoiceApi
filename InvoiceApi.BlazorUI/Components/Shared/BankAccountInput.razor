@*
    [DEPRECATED] — Replaced by BankAccountSelect.razor (dropdown from 1:N BankAccount collection).
    Kept temporarily for backward compatibility. New code should use BankAccountSelect instead.

    Specialized bank account input field.
    Wraps MudTextField with localized label and future IBAN/format validation.

    Usage:
      <BankAccountInput @bind-Value="_bankAccount" />
      <BankAccountInput @bind-Value="_bankAccount" Label="Custom label" />
*@
@inject IStringLocalizer<SharedResource> L

<MudTextField T="string" Value="@Value" ValueChanged="OnValueChanged"
              Label="@(Label ?? L["Invoice_BankAccount"].Value)"
              Margin="@Margin" Variant="@Variant"
              MaxLength="100"
              HelperText="@HelperText" Disabled="@Disabled" />

@code {
    /// <summary>
    /// Current bank account value (two-way binding)
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Callback when value changes (two-way binding support)
    /// </summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// Optional label override. Defaults to localized "Bank Account" label.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Optional helper text displayed below the field
    /// </summary>
    [Parameter]
    public string? HelperText { get; set; }

    /// <summary>
    /// MudBlazor margin setting
    /// </summary>
    [Parameter]
    public Margin Margin { get; set; } = Margin.None;

    /// <summary>
    /// MudBlazor variant setting
    /// </summary>
    [Parameter]
    public Variant Variant { get; set; } = Variant.Text;

    /// <summary>
    /// When true, the input is disabled (grayed out, no interaction)
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Handles value change and notifies parent
    /// Future: add IBAN format validation here
    /// </summary>
    private async Task OnValueChanged(string? newValue)
    {
        Value = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }
}
