@*
    Dialog for adding or editing an address.
    Used by AddressListEditor for both "Add" and "Edit" operations.
    Returns the edited CreateAddressDto via MudDialog.Close() on save.
*@
@inject IStringLocalizer<SharedResource> L
@using InvoiceApi.Contracts.Dto.Client
@using InvoiceApi.Domain.Enums

<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        @* Capture Enter key to save, allowing natural tab navigation between fields *@
        <MudGrid @onkeydown="OnKeyDown">
            @* Address type dropdown — uses EnumSelect for localized enum labels *@
            <MudItem xs="12" sm="6">
                <EnumSelect TEnum="EAddressType"
                            Value="Address.AddressType"
                            ValueChanged="@(v => Address.AddressType = v)"
                            Label="@L["Address_Type"].Value" />
            </MudItem>

            @* Street is required — main address line *@
            <MudItem xs="12">
                <MudTextField @bind-Value="Address.Street"
                              Label="@L["Client_Street"].Value"
                              Required="true" />
            </MudItem>

            @* Optional secondary address line (apartment, floor, etc.) *@
            <MudItem xs="12">
                <MudTextField @bind-Value="Address.AddressLine2"
                              Label="@L["Client_AddressLine2"].Value" />
            </MudItem>

            @* City and postal code side by side *@
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="Address.City"
                              Label="@L["Client_City"].Value"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="Address.PostalCode"
                              Label="@L["Client_PostalCode"].Value"
                              Required="true" />
            </MudItem>

            @* Country field *@
            <MudItem xs="12">
                <MudTextField @bind-Value="Address.Country"
                              Label="@L["Client_Country"].Value"
                              Required="true" />
            </MudItem>

            @* Primary (default billing) toggle *@
            <MudItem xs="12">
                <MudSwitch @bind-Value="Address.IsPrimary"
                           Label="@L["Address_DefaultBilling"].Value"
                           Color="Color.Warning" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">@L["Btn_Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// MudDialog instance — required for closing the dialog with a result.
    /// </summary>
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// The address being created or edited.
    /// Pre-populated with defaults (add) or existing values (edit) by the caller.
    /// </summary>
    [Parameter]
    public CreateAddressDto Address { get; set; } = new();

    /// <summary>
    /// Dialog title text — set by the caller to distinguish "Add" vs "Edit" mode.
    /// </summary>
    [Parameter]
    public string DialogTitle { get; set; } = "";

    /// <summary>
    /// Validates required fields and closes the dialog returning the edited address.
    /// </summary>
    private void Save()
    {
        // Basic validation — Street and City are required
        if (string.IsNullOrWhiteSpace(Address.Street) || string.IsNullOrWhiteSpace(Address.City))
        {
            return; // Don't close — MudTextField Required="true" will show validation errors
        }

        MudDialog.Close(DialogResult.Ok(Address));
    }

    /// <summary>
    /// Closes the dialog without saving — returns a canceled result.
    /// </summary>
    private void Cancel() => MudDialog.Cancel();

    /// <summary>
    /// Handles keyboard shortcuts:
    /// - Enter → Save (submit the form)
    /// - ESC is handled by MudDialog's CloseOnEscapeKey option
    /// </summary>
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Save();
        }
    }
}
