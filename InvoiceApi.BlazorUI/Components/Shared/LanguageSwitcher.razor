@using System.Globalization
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Language toggle button — switches between Czech and English.
   In WASM, there is no server-side cookie endpoint. Instead:
   1. Save the selected culture to localStorage (persists across sessions)
   2. Set the thread culture immediately
   3. Force-reload the page so the new culture applies to all components *@
<MudToggleIconButton Icon="@Icons.Material.Filled.Translate"
                     ToggledIcon="@Icons.Material.Filled.Translate"
                     Color="Color.Inherit"
                     ToggledColor="Color.Inherit"
                     Toggled="@_isEnglish"
                     ToggledChanged="@OnLanguageToggled"
                     title="@(_isEnglish ? "Switch to Czech" : "Přepnout do angličtiny")" />
<MudText Typo="Typo.caption" Color="Color.Inherit" Class="ml-n2 mr-2" Style="cursor: pointer;"
         @onclick="@(() => OnLanguageToggled(!_isEnglish))">
    @(_isEnglish ? "EN" : "CZ")
</MudText>

@code {
    // Whether the current UI culture is English
    private bool _isEnglish;

    protected override void OnInitialized()
    {
        // Detect current culture from the thread's UI culture
        _isEnglish = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    }

    /// <summary>
    /// Called when the user clicks the language toggle.
    /// Saves the culture to localStorage and reloads the page.
    /// The reload triggers Program.cs to read the stored culture and apply it.
    /// </summary>
    private async Task OnLanguageToggled(bool isEnglish)
    {
        var newCulture = isEnglish ? "en-US" : "cs-CZ";

        // Store in localStorage so it survives page reloads and new sessions.
        // Uses the blazorCulture JS helper (index.html) instead of direct localStorage call
        // to avoid potential "this" binding issues in WASM JS interop.
        await JS.InvokeVoidAsync("blazorCulture.set", newCulture);

        // Apply immediately to current thread (affects components rendered before reload)
        var culture = new CultureInfo(newCulture);
        CultureInfo.DefaultThreadCurrentUICulture = culture;

        // Force-reload the current page so all components pick up the new culture.
        // In WASM, NavigateTo with forceLoad: true reloads the entire app.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
