@using System.Globalization
@inject NavigationManager Navigation

@* Language toggle button — switches between Czech and English.
   Navigates to /Culture/SetCulture endpoint which sets the culture cookie
   and redirects back to the current page. *@
<MudToggleIconButton Icon="@Icons.Material.Filled.Translate"
                     ToggledIcon="@Icons.Material.Filled.Translate"
                     Color="Color.Inherit"
                     ToggledColor="Color.Inherit"
                     Toggled="@_isEnglish"
                     ToggledChanged="@OnLanguageToggled"
                     title="@(_isEnglish ? "Switch to Czech" : "Přepnout do angličtiny")" />
<MudText Typo="Typo.caption" Color="Color.Inherit" Class="ml-n2 mr-2" Style="cursor: pointer;"
         @onclick="@(() => OnLanguageToggled(!_isEnglish))">
    @(_isEnglish ? "EN" : "CZ")
</MudText>

@code {
    // Whether the current UI culture is English
    private bool _isEnglish;

    protected override void OnInitialized()
    {
        // Detect current culture from the thread's UI culture
        _isEnglish = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    }

    /// <summary>
    /// Called when the user clicks the language toggle.
    /// Sets the culture cookie via a server redirect and reloads the page.
    /// </summary>
    private void OnLanguageToggled(bool isEnglish)
    {
        var newCulture = isEnglish ? "en-US" : "cs-CZ";
        var currentUri = new Uri(Navigation.Uri).PathAndQuery;
        var redirectUri = Uri.EscapeDataString(currentUri);

        // Navigate to the culture-setting endpoint (minimal API in Program.cs)
        Navigation.NavigateTo(
            $"/Culture/SetCulture?culture={newCulture}&redirectUri={redirectUri}",
            forceLoad: true);
    }
}
