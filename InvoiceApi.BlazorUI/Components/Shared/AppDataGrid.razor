@*
    AppDataGrid<TItem> — Reusable data grid component for consistent table behavior across all pages.

    Features:
    - Supports both client-side (Items) and server-side (ServerData) data modes
    - Consistent styling: Dense + Hover + Striped + pointer cursor on rows
    - Built-in Edit/Delete action icons with stopPropagation (don't trigger row click)
    - Row click handler for navigation/detail views
    - Localized "No records" message
    - Optional toolbar content (search bars, filters, add buttons)
    - Optional custom per-row actions via RowActions render fragment

    Usage example (client-side):
    <AppDataGrid TItem="VatRateDto" Items="@_vatRates" OnRowClick="OpenEditDialog" OnEdit="OpenEditDialog" OnDelete="DeleteVatRate">
        <Columns>
            <MudTh>Name</MudTh>
            <MudTh>Rate</MudTh>
        </Columns>
        <RowContent>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Rate%</MudTd>
        </RowContent>
    </AppDataGrid>

    Usage example (server-side):
    <AppDataGrid TItem="InvoiceDto" ServerData="LoadServerData" OnRowClick="NavigateToDetail" ShowEditAction="false" ShowDeleteAction="false">
        ...
        <RowActions>
            <MudIconButton ... />
        </RowActions>
    </AppDataGrid>
*@
@typeparam TItem

@* Main data table with consistent look and feel *@
<MudTable T="TItem"
          Items="@Items"
          ServerData="@ServerData"
          Dense="true"
          Hover="true"
          Striped="true"
          Loading="@Loading"
          LoadingProgressColor="Color.Primary"
          OnRowClick="@HandleRowClick"
          RowStyleFunc="@RowCursorStyle"
          Elevation="@Elevation"
          Filter="@Filter"
          @ref="_tableRef">
    <ToolBarContent>
        @ToolBarContent
    </ToolBarContent>
    <HeaderContent>
        @Columns
        @* Auto-generate Actions column header if any action is enabled *@
        @if (ShowEditAction || ShowDeleteAction || RowActions != null)
        {
            <MudTh Style="width: 120px;">@L["Label_Actions"]</MudTh>
        }
    </HeaderContent>
    <RowTemplate>
        @RowContent(context)
        @* Auto-generate action buttons cell — stopPropagation prevents row click when clicking icons *@
        @if (ShowEditAction || ShowDeleteAction || RowActions != null)
        {
            <MudTd @onclick:stopPropagation="true">
                @if (ShowEditAction && OnEdit.HasDelegate)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small" Color="Color.Primary"
                                   OnClick="@(() => OnEdit.InvokeAsync(context))"
                                   title="@L["Btn_Edit"].Value" />
                }
                @if (ShowDeleteAction && OnDelete.HasDelegate)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => OnDelete.InvokeAsync(context))"
                                   title="@L["Btn_Delete"].Value" />
                }
                @if (RowActions != null)
                {
                    @RowActions(context)
                }
            </MudTd>
        }
    </RowTemplate>
    <NoRecordsContent>
        <MudAlert Severity="Severity.Info">@(NoRecordsText ?? L["Msg_NoRecords"].Value)</MudAlert>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@L["Label_Loading"]</MudText>
    </LoadingContent>
    <PagerContent>
        @* Only show pager for server-side data — client-side grids show all items *@
        @if (ServerData != null)
        {
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
        }
    </PagerContent>
</MudTable>

@code {
    /// <summary>
    /// Localization service injected for action column headers and empty state messages.
    /// </summary>
    [Inject] private IStringLocalizer<SharedResource> L { get; set; } = default!;

    // ========== DATA PARAMETERS ==========

    /// <summary>
    /// Client-side data mode: pass a list of items to display.
    /// Mutually exclusive with ServerData.
    /// </summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>
    /// Server-side data mode: pass a function that loads data from the API.
    /// MudTable calls this whenever page/sort changes.
    /// Mutually exclusive with Items.
    /// </summary>
    [Parameter] public Func<TableState, CancellationToken, Task<TableData<TItem>>>? ServerData { get; set; }

    // ========== CONTENT PARAMETERS ==========

    /// <summary>
    /// Header cells for the table — define your MudTh columns here.
    /// The Actions column is auto-appended if any action is enabled.
    /// </summary>
    [Parameter] public RenderFragment? Columns { get; set; }

    /// <summary>
    /// Row cells template — define MudTd cells for each data column.
    /// The Actions cell is auto-appended if any action is enabled.
    /// </summary>
    [Parameter] public RenderFragment<TItem> RowContent { get; set; } = default!;

    /// <summary>
    /// Optional extra action icons rendered after Edit/Delete in the actions cell.
    /// Useful for page-specific actions like "Set as Default", "Download PDF", etc.
    /// </summary>
    [Parameter] public RenderFragment<TItem>? RowActions { get; set; }

    /// <summary>
    /// Optional toolbar content (search bars, filter dropdowns, add buttons).
    /// Rendered inside MudTable's ToolBarContent slot.
    /// </summary>
    [Parameter] public RenderFragment? ToolBarContent { get; set; }

    // ========== EVENT PARAMETERS ==========

    /// <summary>
    /// Fired when a row is clicked (not on action icon clicks — those have stopPropagation).
    /// Use for navigating to detail pages or opening edit dialogs.
    /// </summary>
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }

    /// <summary>
    /// Fired when the Edit icon button is clicked.
    /// Only shown when ShowEditAction is true.
    /// </summary>
    [Parameter] public EventCallback<TItem> OnEdit { get; set; }

    /// <summary>
    /// Fired when the Delete icon button is clicked.
    /// Only shown when ShowDeleteAction is true.
    /// </summary>
    [Parameter] public EventCallback<TItem> OnDelete { get; set; }

    // ========== BEHAVIOR PARAMETERS ==========

    /// <summary>
    /// Whether to show the Edit pencil icon in the Actions column. Default: true.
    /// Set to false for grids where row click opens the edit dialog directly.
    /// </summary>
    [Parameter] public bool ShowEditAction { get; set; } = true;

    /// <summary>
    /// Whether to show the Delete trash icon in the Actions column. Default: true.
    /// </summary>
    [Parameter] public bool ShowDeleteAction { get; set; } = true;

    /// <summary>
    /// Whether the table is currently loading data. Shows a progress indicator.
    /// </summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>
    /// Custom "no records found" message. Falls back to the localized Msg_NoRecords key.
    /// </summary>
    [Parameter] public string? NoRecordsText { get; set; }

    /// <summary>
    /// MudTable elevation (shadow depth). Default: 0 for a flat look.
    /// </summary>
    [Parameter] public int Elevation { get; set; } = 0;

    /// <summary>
    /// Client-side filter function — only used with Items mode.
    /// Return true to include the item, false to exclude it.
    /// </summary>
    [Parameter] public Func<TItem, bool>? Filter { get; set; }

    // ========== INTERNAL STATE ==========

    /// <summary>
    /// Internal MudTable reference — used by ReloadServerDataAsync() for server-side refresh.
    /// </summary>
    private MudTable<TItem>? _tableRef;

    /// <summary>
    /// Handles row click — extracts the item from TableRowClickEventArgs and invokes OnRowClick.
    /// </summary>
    private async Task HandleRowClick(TableRowClickEventArgs<TItem> args)
    {
        if (OnRowClick.HasDelegate && args.Item != null)
        {
            await OnRowClick.InvokeAsync(args.Item);
        }
    }

    /// <summary>
    /// Applies pointer cursor to all rows to indicate they're clickable.
    /// Only applies when OnRowClick has a delegate.
    /// </summary>
    private string RowCursorStyle(TItem item, int index)
    {
        return OnRowClick.HasDelegate ? "cursor: pointer;" : "";
    }

    /// <summary>
    /// Public method for parent pages to trigger a server data reload (e.g., after CRUD operations).
    /// Only works in server-side data mode.
    /// </summary>
    public async Task ReloadServerDataAsync()
    {
        if (_tableRef != null)
        {
            await _tableRef.ReloadServerData();
        }
    }
}
