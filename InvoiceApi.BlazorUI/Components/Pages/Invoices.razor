    /// <summary>
    /// Bulk sends email for all selected invoices.
    /// Uses the default client email address for each invoice.
    /// </summary>
    private async Task BulkEmail()
    {
        if (_selectedInvoices.Count == 0) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            string.Format(L["Bulk_ConfirmEmail"].Value, _selectedInvoices.Count));
        if (!confirmed) return;

        _bulkProcessing = true;
        StateHasChanged();
        try
        {
            var result = await InvoiceService.BulkSendEmailAsync(_selectedInvoices.Select(i => i.Id).ToList());
            ShowBulkResult(result);
            ClearSelection();
            await SearchInvoices();
