@page "/content-templates/create"
@page "/content-templates/{Id:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using InvoiceApi.Contracts.Dto.ContentTemplate
@using InvoiceApi.Domain.Enums
@using Blazored.TextEditor
@inject ContentTemplateApiService TemplateService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(_isCreateMode ? L["ContentTemplate_New"] : L["ContentTemplate_Detail"])</PageTitle>

@* Warn user before navigating away from dirty forms *@
<UnsavedChangesLock IsDirty="_isDirty" />

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (!_isCreateMode && (_errorMessage != null || _template == null))
{
    <MudAlert Severity="Severity.Error">@(_errorMessage ?? L["Msg_NotFound"])</MudAlert>
}
else
{
    @* Header: Back button + template name + type chip + action buttons *@
    <div class="d-flex flex-wrap align-center gap-2 mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" />
        <MudText Typo="Typo.h4" Class="mr-2">
            @if (_isCreateMode) { @L["ContentTemplate_New"] } else { @_template!.Name }
        </MudText>
        @if (!_isCreateMode && _template != null)
        {
            <MudChip T="string" Size="Size.Small" Color="@GetTemplateTypeColor(_template.TemplateType)">
                @GetTemplateTypeLabel(_template.TemplateType)
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="@(_template.IsActive ? Color.Success : Color.Default)">
                @(_template.IsActive ? L["Label_Active"].Value : L["Label_Inactive"].Value)
            </MudChip>
        }
        <MudSpacer />

        @if (_isCreateMode)
        {
            <MudButton Variant="Variant.Text" OnClick="GoBack">@L["Btn_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveTemplate">@L["Btn_Create"]</MudButton>
        }
        else if (!_isEditing)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="EnableEditing">@L["Btn_Edit"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeleteTemplate">@L["Btn_Delete"]</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="CancelEditing">@L["Btn_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveTemplate">@L["Btn_Save"]</MudButton>
        }
    </div>

    <MudGrid>
        @* Card 1: Basic Info *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h6">@L["ContentTemplate_Name"]</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isFormMode)
                    {
                        <MudTextField @bind-Value="_currentName" Label="@L["ContentTemplate_Name"].Value" Required="true" Class="mb-3" />
                        <MudSelect @bind-Value="_currentTemplateType" Label="@L["ContentTemplate_Type"].Value" T="EContentTemplateType" Class="mb-3">
                            <MudSelectItem Value="EContentTemplateType.InvoicePdf">@L["ContentType_InvoicePdf"]</MudSelectItem>
                            <MudSelectItem Value="EContentTemplateType.CreditNotePdf">@L["ContentType_CreditNotePdf"]</MudSelectItem>
                            <MudSelectItem Value="EContentTemplateType.InvoiceEmail">@L["ContentType_InvoiceEmail"]</MudSelectItem>
                            <MudSelectItem Value="EContentTemplateType.CreditNoteEmail">@L["ContentType_CreditNoteEmail"]</MudSelectItem>
                            <MudSelectItem Value="EContentTemplateType.InvitationEmail">@L["ContentType_InvitationEmail"]</MudSelectItem>
                            <MudSelectItem Value="EContentTemplateType.ReminderEmail">@L["ContentType_ReminderEmail"]</MudSelectItem>
                            <MudSelectItem Value="EContentTemplateType.PasswordResetEmail">@L["ContentType_PasswordResetEmail"]</MudSelectItem>
                        </MudSelect>
                        <MudSwitch @bind-Value="_currentIsDefault" Label="@L["ContentTemplate_IsDefault"].Value" Color="Color.Warning" Class="mb-3" />
                        <MudTextField @bind-Value="_currentDescription" Label="@L["ContentTemplate_Description"].Value" Lines="2" />
                    }
                    else
                    {
                        <MudList T="string" Dense="true">
                            <MudListItem T="string"><strong>@L["ContentTemplate_Type"]:</strong>
                                <MudChip T="string" Size="Size.Small" Color="@GetTemplateTypeColor(_template!.TemplateType)">
                                    @GetTemplateTypeLabel(_template.TemplateType)
                                </MudChip>
                            </MudListItem>
                            @if (_template?.IsDefault == true)
                            {
                                <MudListItem T="string"><MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" /> @L["ContentTemplate_IsDefault"]</MudListItem>
                            }
                            @if (!string.IsNullOrEmpty(_template.Description))
                            {
                                <MudListItem T="string"><strong>@L["ContentTemplate_Description"]:</strong> @_template.Description</MudListItem>
                            }
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Card 2: Subject (email types only) *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h6">@L["ContentTemplate_Subject"]</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isFormMode)
                    {
                        @if (IsEmailType(_currentTemplateType))
                        {
                            <MudTextField @bind-Value="_currentSubject" Label="@L["ContentTemplate_Subject"].Value" Required="true" />
                        }
                        else
                        {
                            <MudText Color="Color.Secondary">@L["ContentTemplate_SubjectPdfHint"]</MudText>
                        }
                    }
                    else
                    {
                        @if (IsEmailType(_template!.TemplateType) && !string.IsNullOrEmpty(_template.Subject))
                        {
                            <MudText>@_template.Subject</MudText>
                        }
                        else
                        {
                            <MudText Color="Color.Secondary">—</MudText>
                        }
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Full-width: HTML Body *@
        <MudItem xs="12">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h6">@L["ContentTemplate_HtmlBody"]</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isFormMode)
                    {
                        @* Quill WYSIWYG editor for creating/editing HTML content *@
                        <BlazoredTextEditor @ref="_quillEditor" Placeholder="@L["Template_EditorPlaceholder"].Value">
                            <EditorContent>
                                @((MarkupString)_currentHtmlBody)
                            </EditorContent>
                        </BlazoredTextEditor>
                    }
                    else
                    {
                        @* Rendered HTML preview *@
                        <div class="pa-4" style="border: 1px solid #e0e0e0; border-radius: 4px; min-height: 200px;">
                            @((MarkupString)(_template!.HtmlBody ?? ""))
                        </div>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Full-width: Placeholder reference *@
        <MudItem xs="12">
            <MudExpansionPanels>
                <MudExpansionPanel Text="@L["ContentTemplate_Placeholders"].Value" Icon="@Icons.Material.Filled.Info">
                    <MudText Typo="Typo.body2">
                        @if (_isFormMode ? IsPdfType(_currentTemplateType) : (_template != null && IsPdfType(_template.TemplateType)))
                        {
                            <text>
                            <strong>PDF:</strong>
                            <code>@("{{IssuerName}}")</code>, <code>@("{{ClientName}}")</code>,
                            <code>@("{{DocumentNumber}}")</code>, <code>@("{{IssueDate}}")</code>,
                            <code>@("{{DueDate}}")</code>, <code>@("{{TotalWithVat}}")</code>,
                            <code>@("{{TotalBeforeVat}}")</code>, <code>@("{{TotalVat}}")</code>,
                            <code>@("{{CurrencyCode}}")</code>, <code>@("{{InvoiceItems}}")</code>,
                            <code>@("{{PaymentMethod}}")</code>, <code>@("{{BankAccountNumber}}")</code>,
                            <code>@("{{IBAN}}")</code>, <code>@("{{SWIFT}}")</code>,
                            <code>@("{{VariableSymbol}}")</code>, <code>@("{{Notes}}")</code>
                            </text>
                        }
                        else
                        {
                            <text>
                            <strong>Email:</strong>
                            <code>@("{{InvoiceNumber}}")</code>, <code>@("{{CompanyName}}")</code>,
                            <code>@("{{TotalWithVat}}")</code>, <code>@("{{CurrencyCode}}")</code>,
                            <code>@("{{DueDate}}")</code>, <code>@("{{IssueDate}}")</code>,
                            <code>@("{{FullName}}")</code>, <code>@("{{InvitationLink}}")</code>,
                            <code>@("{{AppName}}")</code>
                            </text>
                        }
                    </MudText>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public long Id { get; set; }

    private ContentTemplateDto? _template;
    private bool _loading = true;
    private string? _errorMessage; // Stores API error message for display instead of generic "Not Found"
    private bool _isCreateMode => Id == 0;
    private bool _isEditing = false;
    private bool _isDirty = false; // Dirty tracking for unsaved changes warning
    private bool _isFormMode => _isCreateMode || _isEditing;

    // Form fields — separate from DTO to work with Quill editor
    private string _currentName = "";
    private string? _currentSubject = "";
    private string _currentHtmlBody = "";
    private string _currentDescription = "";
    private EContentTemplateType _currentTemplateType = EContentTemplateType.InvoiceEmail;
    private bool _currentIsDefault = false;

    // Quill rich text editor reference
    private BlazoredTextEditor? _quillEditor;
    // Flag to load HTML into Quill after render
    private bool _quillNeedsLoad = false;

    protected override async Task OnInitializedAsync()
    {
        if (_isCreateMode)
        {
            _currentName = "";
            _currentSubject = "";
            _currentHtmlBody = "";
            _currentDescription = "";
            _currentTemplateType = EContentTemplateType.InvoiceEmail;
            _currentIsDefault = false;
            _loading = false;
        }
        else
        {
            await LoadTemplate();
        }
    }

    /// <summary>
    /// After render hook — loads HTML into Quill editor when entering edit mode.
    /// Quill needs the DOM to be ready before we can load content into it.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_quillNeedsLoad && _quillEditor != null)
        {
            _quillNeedsLoad = false;
            await _quillEditor.LoadHTMLContent(_currentHtmlBody);
        }
    }

    private async Task LoadTemplate()
    {
        try
        {
            _loading = true;
            _template = await TemplateService.GetByIdAsync(Id);
        }
        catch (Exception ex)
        {
            // Store error message for display in the template instead of generic "Nenalezeno".
            _errorMessage = ex.Message;
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Switches to edit mode — copies template data into form fields.
    /// Sets _quillNeedsLoad so OnAfterRenderAsync loads HTML into the editor.
    /// </summary>
    private void EnableEditing()
    {
        if (_template == null) return;

        _currentName = _template.Name;
        _currentSubject = _template.Subject ?? "";
        _currentHtmlBody = _template.HtmlBody;
        _currentDescription = _template.Description ?? "";
        _currentTemplateType = _template.TemplateType;
        _currentIsDefault = _template.IsDefault;
        _quillNeedsLoad = true;
        _isEditing = true;
        _isDirty = true; // Mark dirty when entering edit mode
    }

    /// <summary>
    /// Cancels editing — resets dirty flag and reloads original data.
    /// </summary>
    private async Task CancelEditing()
    {
        _isEditing = false;
        _isDirty = false;
        await LoadTemplate();
    }

    /// <summary>
    /// Saves the template — reads HTML from Quill editor, then creates or updates.
    /// </summary>
    private async Task SaveTemplate()
    {
        try
        {
            // Read HTML content from the Quill editor
            var htmlBody = _quillEditor != null
                ? await _quillEditor.GetHTML()
                : _currentHtmlBody;

            if (_isCreateMode)
            {
                var createDto = new CreateContentTemplateDto
                {
                    Name = _currentName,
                    Subject = IsEmailType(_currentTemplateType) ? _currentSubject : null,
                    HtmlBody = htmlBody,
                    TemplateType = _currentTemplateType,
                    IsDefault = _currentIsDefault,
                    Description = _currentDescription
                };

                var result = await TemplateService.CreateAsync(createDto);
                if (result != null)
                {
                    // Reset dirty flag and force re-render BEFORE navigation.
                    // Ensures <UnsavedChangesLock> removes <NavigationLock> from the DOM.
                    _isDirty = false;
                    StateHasChanged();
                    await Task.Yield();

                    Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                    Navigation.NavigateTo($"/content-templates/{result.Id}");
                }
                else
                {
                    Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
                }
            }
            else
            {
                var updateDto = new UpdateContentTemplateDto
                {
                    Name = _currentName,
                    Subject = IsEmailType(_currentTemplateType) ? _currentSubject : null,
                    HtmlBody = htmlBody,
                    TemplateType = _currentTemplateType,
                    IsDefault = _currentIsDefault,
                    Description = _currentDescription
                };

                var result = await TemplateService.UpdateAsync(Id, updateDto);
                if (result != null)
                {
                    _isDirty = false; // Reset dirty flag on successful save
                    Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                    _isEditing = false;
                    await LoadTemplate();
                }
                else
                {
                    Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteTemplate()
    {
        try
        {
            if (await TemplateService.DeleteAsync(Id))
            {
                Snackbar.Add(L["Msg_DeleteSuccess"].Value, Severity.Success);
                Navigation.NavigateTo("/content-templates");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    private void GoBack() => Navigation.NavigateTo("/content-templates");

    // ========== Type helpers ==========

    private static bool IsEmailType(EContentTemplateType type) => (int)type >= 10;
    private static bool IsPdfType(EContentTemplateType type) => (int)type >= 1 && (int)type <= 9;

    private static Color GetTemplateTypeColor(EContentTemplateType type) => type switch
    {
        EContentTemplateType.InvoicePdf => Color.Info,
        EContentTemplateType.CreditNotePdf => Color.Info,
        EContentTemplateType.InvoiceEmail => Color.Primary,
        EContentTemplateType.CreditNoteEmail => Color.Primary,
        EContentTemplateType.InvitationEmail => Color.Warning,
        EContentTemplateType.ReminderEmail => Color.Error,
        EContentTemplateType.PasswordResetEmail => Color.Warning,
        _ => Color.Default
    };

    private string GetTemplateTypeLabel(EContentTemplateType type) => type switch
    {
        EContentTemplateType.InvoicePdf => L["ContentType_InvoicePdf"].Value,
        EContentTemplateType.CreditNotePdf => L["ContentType_CreditNotePdf"].Value,
        EContentTemplateType.InvoiceEmail => L["ContentType_InvoiceEmail"].Value,
        EContentTemplateType.CreditNoteEmail => L["ContentType_CreditNoteEmail"].Value,
        EContentTemplateType.InvitationEmail => L["ContentType_InvitationEmail"].Value,
        EContentTemplateType.ReminderEmail => L["ContentType_ReminderEmail"].Value,
        EContentTemplateType.PasswordResetEmail => L["ContentType_PasswordResetEmail"].Value,
        _ => type.ToString()
    };
}
