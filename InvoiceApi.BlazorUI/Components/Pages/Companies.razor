@page "/companies"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SysAdmin")]
@using InvoiceApi.Contracts.Dto.Client
@using InvoiceApi.Contracts.Dto.CompanySettings
@inject CompanyApiService CompanyService
@inject CompanySettingsApiService SettingsService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@* Localization service for multi-language support *@
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Company_Title"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["Company_Title"]</MudText>
<MudText Class="mb-4">@L["Company_Subtitle"]</MudText>

<MudPaper Class="pa-4">
    @* Navigate to create page instead of opening a dialog *@
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Navigation.NavigateTo("/companies/create"))" Class="mb-4">
        @L["Company_New"]
    </MudButton>

    @* AppDataGrid for consistent data presentation with automatic action column generation *@
    <AppDataGrid TItem="ClientDto"
                 Items="@_companies"
                 Loading="@_loading"
                 Filter="@FilterFunc"
                 NoRecordsText="@L["Company_NoRecords"].Value"
                 OnRowClick="@(company => Navigation.NavigateTo($"/companies/{company.Id}"))"
                 OnEdit="@(company => Navigation.NavigateTo($"/companies/{company.Id}"))"
                 OnDelete="@(company => DeleteCompany(company.Id))">
        <ToolBarContent>
            @* Search field for filtering companies by name, registration number, trading name, or city *@
            <MudTextField @bind-Value="_searchString" Placeholder="@L["Btn_Search"].Value" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <Columns>
            @* Header columns - Actions column is auto-generated by AppDataGrid *@
            <MudTh>@L["Client_CompanyName"]</MudTh>
            <MudTh>@L["Client_RegistrationNumber"]</MudTh>
            <MudTh>@L["Client_TaxNumber"]</MudTh>
            <MudTh>@L["Client_City"]</MudTh>
            <MudTh>@L["Client_IsVatPayer"]</MudTh>
            <MudTh>@L["Label_Status"]</MudTh>
            <MudTh>@L["TenantSettings_Provisioned"]</MudTh>
        </Columns>
        <RowContent>
            @* Row data cells - Actions cell is auto-generated by AppDataGrid with View/Edit/Delete icons *@
            <MudTd DataLabel="@L["Client_CompanyName"].Value">@context.CompanyName</MudTd>
            <MudTd DataLabel="@L["Client_RegistrationNumber"].Value">@context.RegistrationNumber</MudTd>
            <MudTd DataLabel="@L["Client_TaxNumber"].Value">@(context.TaxNumber ?? "—")</MudTd>
            <MudTd DataLabel="@L["Client_City"].Value">@(context.Address.FirstOrDefault()?.City ?? "—")</MudTd>
            <MudTd DataLabel="@L["Client_IsVatPayer"].Value">
                @* Display checkmark icon if company is VAT payer *@
                @if (context.IsVatPayer)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                }
            </MudTd>
            <MudTd DataLabel="@L["Label_Status"].Value">
                @* Display status chip with color indicating active/inactive state *@
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? L["Label_Active"].Value : L["Label_Inactive"].Value)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@L["TenantSettings_Provisioned"].Value">
                @* Tenant provisioning status — shows chips for Provisioned (green), Not Provisioned (warning), No Settings (grey) *@
                @if (_settingsMap.TryGetValue(context.Id, out var tenantSettings))
                {
                    @if (tenantSettings.IsProvisioned && tenantSettings.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["TenantSettings_Provisioned"]</MudChip>
                    }
                    else if (tenantSettings.IsProvisioned && !tenantSettings.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["Label_Inactive"]</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["TenantSettings_NotProvisioned"]</MudChip>
                    }
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@L["TenantSettings_NoSettings"]</MudChip>
                }
            </MudTd>
        </RowContent>
    </AppDataGrid>
</MudPaper>

@code {
    private List<ClientDto> _companies = new();
    private Dictionary<long, CompanySystemSettingsDto> _settingsMap = new();
    private bool _loading = true;
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCompanies();
    }

    /// <summary>
    /// Loads companies and their tenant settings in parallel.
    /// Settings are stored in a dictionary for O(1) lookup by CompanyId in the grid.
    /// </summary>
    private async Task LoadCompanies()
    {
        try
        {
            _loading = true;
            var companiesTask = CompanyService.GetAllAsync();
            var settingsTask = SettingsService.GetAllSettingsAsync();
            await Task.WhenAll(companiesTask, settingsTask);

            _companies = companiesTask.Result;
            _settingsMap = settingsTask.Result.ToDictionary(s => s.CompanyId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Client-side filter function for the search bar — matches company name, registration number, trading name, or city.
    /// </summary>
    private bool FilterFunc(ClientDto company)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        var search = _searchString.ToLower();
        return company.CompanyName?.ToLower().Contains(search) == true
            || company.RegistrationNumber?.Contains(search) == true
            || company.TradingName?.ToLower().Contains(search) == true
            || company.Address.Any(a => a.City?.ToLower().Contains(search) == true);
    }

    /// <summary>
    /// Deletes a company by ID via CompanyApiService and reloads the grid.
    /// </summary>
    private async Task DeleteCompany(long id)
    {
        try
        {
            var success = await CompanyService.DeleteAsync(id);
            if (success)
            {
                Snackbar.Add(L["Msg_DeleteSuccess"].Value, Severity.Success);
                await LoadCompanies();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }
}
