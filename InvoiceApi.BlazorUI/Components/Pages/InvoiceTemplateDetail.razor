@page "/invoice-templates/create"
@page "/invoice-templates/{Id:long}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using InvoiceApi.Application.Dto.InvoiceTemplate
@using InvoiceApi.Application.Dto.Invoice
@using InvoiceApi.Application.Dto.Client
@using InvoiceApi.Application.Dto.Currency
@using InvoiceApi.Domain.Enums
@using InvoiceApi.BlazorUI.Components.Shared
@using InvoiceApi.BlazorUI.Services
@using InvoiceApi.Application.Dto.NumberSequence
@inject InvoiceTemplateApiService TemplateService
@inject ClientApiService ClientService
@inject CurrencyApiService CurrencyService
@inject NumberSequenceApiService NumberSequenceService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(_isCreateMode ? L["Template_New"] : L["Template_Edit"])</PageTitle>

@* Warn user before navigating away from dirty forms *@
<UnsavedChangesLock IsDirty="_isDirty" />

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (!_isCreateMode && _template == null)
{
    <MudAlert Severity="Severity.Error">@L["Msg_NotFound"]</MudAlert>
}
else
{
    @* Header: Back button + template name + Active chip + action buttons *@
    <div class="d-flex flex-wrap align-center gap-2 mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" />
        <MudText Typo="Typo.h4" Class="mr-2">
            @if (_isCreateMode) { @L["Template_New"] } else { @_template!.Name }
        </MudText>
        @if (!_isCreateMode && _template != null)
        {
            <MudChip T="string" Size="Size.Small" Color="@(_template.IsActive ? Color.Success : Color.Default)">
                @(_template.IsActive ? L["Label_Active"].Value : L["Label_Inactive"].Value)
            </MudChip>
        }
        <MudSpacer />

        @if (_isCreateMode)
        {
            <MudButton Variant="Variant.Text" OnClick="GoBack">@L["Btn_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveTemplate">@L["Btn_Create"]</MudButton>
        }
        else if (!_isEditing)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="EnableEditing">@L["Btn_Edit"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeleteTemplate">@L["Btn_Delete"]</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="CancelEditing">@L["Btn_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveTemplate">@L["Btn_Save"]</MudButton>
        }
    </div>

    <MudGrid>
        @* Card 1: Template Info *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h6">@L["Template_InfoSection"]</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isFormMode)
                    {
                        <MudTextField @bind-Value="_editModel.Name" Label="@L["Template_TemplateName"].Value" Required="true" Class="mb-3" />
                        <MudTextField @bind-Value="_editModel.Description" Label="@L["Label_Description"].Value" Lines="2" Class="mb-3" />
                        @if (!_isCreateMode)
                        {
                            <MudSwitch T="bool" @bind-Value="_editModel.IsActive" Label="@L["Label_Active"].Value" Color="Color.Primary" />
                        }
                    }
                    else
                    {
                        <MudList T="string" Dense="true">
                            <MudListItem T="string"><strong>@L["Label_Name"]:</strong> @_template!.Name</MudListItem>
                            @if (!string.IsNullOrEmpty(_template.Description))
                            {
                                <MudListItem T="string"><strong>@L["Label_Description"]:</strong> @_template.Description</MudListItem>
                            }
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Card 2: Document Settings *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h6">@L["Template_DocumentSection"]</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isFormMode)
                    {
                        <MudSelect @bind-Value="_editModel.DocumentType" Label="@L["Template_DocumentType"].Value" Required="true" Class="mb-3">
                            <MudSelectItem Value="@EDocumentType.Invoice">@L["Template_DocumentTypeInvoice"]</MudSelectItem>
                            <MudSelectItem Value="@EDocumentType.CreditNote">@L["Template_DocumentTypeCreditNote"]</MudSelectItem>
                        </MudSelect>
                        <MudSelect @bind-Value="_editModel.ClientId" Label="@L["Invoice_Client"].Value" Clearable="true" T="long?" Class="mb-3">
                            @foreach (var client in _clients)
                            {
                                <MudSelectItem Value="@((long?)client.Id)">@client.CompanyName</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect @bind-Value="_editModel.CurrencyId" Label="@L["Template_Currency"].Value" Required="true">
                            @foreach (var currency in _currencies)
                            {
                                <MudSelectItem Value="@currency.Id">@currency.Code - @currency.Name</MudSelectItem>
                            }
                        </MudSelect>
                        @* Optional number sequence override — allows this template to use a specific numbering scheme *@
                        <MudSelect @bind-Value="_editModel.NumberSequenceId" Label="@L["Template_NumberSequence"].Value"
                                   Clearable="true" T="long?" Class="mt-3">
                            @foreach (var seq in _numberSequences)
                            {
                                <MudSelectItem Value="@((long?)seq.Id)">@seq.Name (@seq.DocumentType)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudList T="string" Dense="true">
                            <MudListItem T="string">
                                <strong>@L["Template_DocumentType"]:</strong>
                                <MudChip T="string" Size="Size.Small" Color="@(_template!.DocumentType == EDocumentType.Invoice ? Color.Primary : Color.Warning)">
                                    @(_template.DocumentType == EDocumentType.Invoice ? L["Template_DocumentTypeInvoice"] : L["Template_DocumentTypeCreditNote"])
                                </MudChip>
                            </MudListItem>
                            <MudListItem T="string"><strong>@L["Invoice_Client"]:</strong> @(_template.ClientName ?? "—")</MudListItem>
                            <MudListItem T="string"><strong>@L["Template_Currency"]:</strong> @_template.CurrencyCode</MudListItem>
                            @if (!string.IsNullOrEmpty(_template.NumberSequenceName))
                            {
                                <MudListItem T="string"><strong>@L["Template_NumberSequence"]:</strong> @_template.NumberSequenceName</MudListItem>
                            }
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Card 3: Payment Settings *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h6">@L["Invoice_PaymentInfo"]</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isFormMode)
                    {
                        <EnumSelect TEnum="EPaymentMethod"
                                    NullableValue="_editModel.PaymentMethod"
                                    NullableValueChanged="@(v => _editModel.PaymentMethod = v)"
                                    Label="@L["Invoice_PaymentMethod"].Value"
                                    Nullable="true" />
                        <MudNumericField @bind-Value="_editModel.DueDateOffsetDays" Label="@L["Template_DueDateDays"].Value"
                                         Required="true" Min="0" Max="365" Class="mb-3" />
                        <MudTextField @bind-Value="_editModel.VariableSymbol" Label="@L["Invoice_VariableSymbol"].Value"
                                      MaxLength="10" Validation="@(new Func<string?, string?>(ValidateVariableSymbol))"
                                      HelperText="@L["Invoice_VSDigitsOnly"].Value" Class="mb-3" />
                        <MudTextField @bind-Value="_editModel.ConstantSymbol" Label="@L["Template_ConstantSymbol"].Value" Class="mb-3" />
                        <MudTextField @bind-Value="_editModel.SpecificSymbol" Label="@L["Template_SpecificSymbol"].Value" />
                    }
                    else
                    {
                        <MudList T="string" Dense="true">
                            @if (_template!.PaymentMethod.HasValue)
                            {
                                <MudListItem T="string"><strong>@L["Invoice_PaymentMethod"]:</strong> @_template.PaymentMethod</MudListItem>
                            }
                            <MudListItem T="string"><strong>@L["Template_DueDateDays"]:</strong> @_template.DueDateOffsetDays</MudListItem>
                            @if (!string.IsNullOrEmpty(_template.VariableSymbol))
                            {
                                <MudListItem T="string"><strong>@L["Invoice_VariableSymbol"]:</strong> @_template.VariableSymbol</MudListItem>
                            }
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Full-width: Bank Account *@
        <MudItem xs="12">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h6">@L["Company_BankDetails"]</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isFormMode)
                    {
                        <MudGrid>
                            <MudItem xs="12" md="4">
                                <BankAccountInput Value="@_editModel.BankAccountNumber"
                                                  ValueChanged="@(v => _editModel.BankAccountNumber = v)"
                                                  Label="@L["Invoice_BankAccount"].Value" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_editModel.IBAN" Label="IBAN" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_editModel.SWIFT" Label="SWIFT/BIC" />
                            </MudItem>
                        </MudGrid>
                    }
                    else
                    {
                        <MudGrid>
                            @if (!string.IsNullOrEmpty(_template!.BankAccountNumber))
                            {
                                <MudItem xs="12" md="4"><MudText><strong>@L["Invoice_BankAccount"]:</strong> @_template.BankAccountNumber</MudText></MudItem>
                            }
                            @if (!string.IsNullOrEmpty(_template.IBAN))
                            {
                                <MudItem xs="12" md="4"><MudText><strong>IBAN:</strong> @_template.IBAN</MudText></MudItem>
                            }
                            @if (!string.IsNullOrEmpty(_template.SWIFT))
                            {
                                <MudItem xs="12" md="4"><MudText><strong>SWIFT:</strong> @_template.SWIFT</MudText></MudItem>
                            }
                        </MudGrid>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Full-width: Notes *@
        <MudItem xs="12">
            @if (_isFormMode)
            {
                <MudTextField @bind-Value="_editModel.Notes" Label="@L["Template_Notes"].Value" Lines="3" Class="mb-4" />
            }
            else if (!string.IsNullOrEmpty(_template!.Notes))
            {
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2">@L["Template_Notes"]</MudText>
                        <MudText>@_template.Notes</MudText>
                    </MudCardContent>
                </MudCard>
            }
        </MudItem>

        @* Full-width: Invoice Items *@
        <MudItem xs="12">
            @if (_isFormMode)
            {
                <MudText Typo="Typo.h6" Class="mb-2">@L["Invoice_Items"]</MudText>
                <InvoiceItemEditor Items="_editModel.Items" ItemsChanged="@(items => _editModel.Items = items)" />
            }
            else
            {
                <MudText Typo="Typo.h6" Class="mb-2">@L["Invoice_Items"]</MudText>
                <MudTable Items="@_template!.InvoiceItem" Dense="true" Hover="true" Striped="true" Elevation="2">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>@L["InvoiceItem_Description"]</MudTh>
                        <MudTh Style="text-align:right">@L["InvoiceItem_Quantity"]</MudTh>
                        <MudTh>@L["InvoiceItem_Unit"]</MudTh>
                        <MudTh Style="text-align:right">@L["InvoiceItem_UnitPrice"]</MudTh>
                        <MudTh Style="text-align:right">@L["InvoiceItem_VatRate"]</MudTh>
                        <MudTh Style="text-align:right">@L["InvoiceItem_Total"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.OrderIndex</MudTd>
                        <MudTd>@context.Description</MudTd>
                        <MudTd Style="text-align:right">@context.Quantity.ToString("N2")</MudTd>
                        <MudTd>@context.Unit</MudTd>
                        <MudTd Style="text-align:right">@context.UnitPrice.ToString("N2")</MudTd>
                        <MudTd Style="text-align:right">@context.VatRatePercentage.ToString("N0")%</MudTd>
                        <MudTd Style="text-align:right"><strong>@context.TotalWithVat.ToString("N2")</strong></MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public long Id { get; set; }

    private InvoiceTemplateDto? _template;
    private bool _loading = true;
    private bool _isCreateMode => Id == 0;
    private bool _isEditing = false;
    private bool _isDirty = false; // Dirty tracking for unsaved changes warning
    private bool _isFormMode => _isCreateMode || _isEditing;

    // Reference data
    private List<ClientDto> _clients = new();
    private List<CurrencyDto> _currencies = new();
    private List<NumberSequenceDto> _numberSequences = new();
    private ClientDto? _issuer;

    // Edit model for create/edit form
    private TemplateEditModel _editModel = new();

    protected override async Task OnInitializedAsync()
    {
        // Load reference data in parallel
        await Task.WhenAll(LoadClients(), LoadIssuer(), LoadCurrencies(), LoadNumberSequences());

        if (_isCreateMode)
        {
            InitCreateModel();
            _loading = false;
        }
        else
        {
            await LoadTemplate();
        }
    }

    private async Task LoadClients()
    {
        try { _clients = await ClientService.GetAllAsync(includeInactive: false); }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    private async Task LoadIssuer()
    {
        try { _issuer = await ClientService.GetIssuerAsync(); }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    private async Task LoadCurrencies()
    {
        try { _currencies = await CurrencyService.GetActiveCurrenciesAsync(); }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    /// <summary>
    /// Loads active number sequences for the optional sequence override dropdown.
    /// </summary>
    private async Task LoadNumberSequences()
    {
        try { _numberSequences = await NumberSequenceService.GetAllSequencesAsync(includeInactive: false); }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    private void InitCreateModel()
    {
        _editModel = new TemplateEditModel
        {
            DocumentType = EDocumentType.Invoice,
            IssuerId = _issuer?.Id ?? 0,
            CurrencyId = _currencies.FirstOrDefault()?.Id ?? 1,
            DueDateOffsetDays = 14
        };
    }

    private async Task LoadTemplate()
    {
        try
        {
            _loading = true;
            _template = await TemplateService.GetByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Switches to edit mode — populates form from existing template data.
    /// </summary>
    private void EnableEditing()
    {
        if (_template == null) return;

        _editModel = new TemplateEditModel
        {
            Id = _template.Id,
            Name = _template.Name,
            Description = _template.Description,
            DocumentType = _template.DocumentType,
            IssuerId = _template.IssuerId,
            ClientId = _template.ClientId,
            CurrencyId = _template.CurrencyId,
            DueDateOffsetDays = _template.DueDateOffsetDays,
            PaymentMethod = _template.PaymentMethod,
            VariableSymbol = _template.VariableSymbol,
            ConstantSymbol = _template.ConstantSymbol,
            SpecificSymbol = _template.SpecificSymbol,
            BankAccountNumber = _template.BankAccountNumber,
            IBAN = _template.IBAN,
            SWIFT = _template.SWIFT,
            Notes = _template.Notes,
            NumberSequenceId = _template.NumberSequenceId,
            IsActive = _template.IsActive,
            Items = _template.InvoiceItem.Select(i => new CreateInvoiceItemDto
            {
                OrderIndex = i.OrderIndex,
                Description = i.Description,
                Quantity = i.Quantity,
                Unit = i.Unit,
                UnitPrice = i.UnitPrice,
                VatRateId = i.VatRateId,
                VatRatePercentage = i.VatRatePercentage,
                ProductCode = i.ProductCode,
                Notes = i.Notes
            }).ToList()
        };

        _isEditing = true;
        _isDirty = true; // Mark dirty when entering edit mode
    }

    /// <summary>
    /// Cancels editing — resets dirty flag and reloads original data.
    /// </summary>
    private async Task CancelEditing()
    {
        _isEditing = false;
        _isDirty = false;
        await LoadTemplate();
    }

    /// <summary>
    /// Saves the template — create or update based on mode.
    /// </summary>
    private async Task SaveTemplate()
    {
        try
        {
            if (_editModel.Items == null || !_editModel.Items.Any())
            {
                Snackbar.Add(L["Invoice_AddAtLeastOneItem"].Value, Severity.Warning);
                return;
            }

            if (_isCreateMode)
            {
                var createDto = new CreateInvoiceTemplateDto
                {
                    Name = _editModel.Name,
                    Description = _editModel.Description,
                    DocumentType = _editModel.DocumentType,
                    IssuerId = _editModel.IssuerId,
                    ClientId = _editModel.ClientId,
                    CurrencyId = _editModel.CurrencyId,
                    DueDateOffsetDays = _editModel.DueDateOffsetDays,
                    PaymentMethod = _editModel.PaymentMethod,
                    VariableSymbol = _editModel.VariableSymbol,
                    ConstantSymbol = _editModel.ConstantSymbol,
                    SpecificSymbol = _editModel.SpecificSymbol,
                    BankAccountNumber = _editModel.BankAccountNumber,
                    IBAN = _editModel.IBAN,
                    SWIFT = _editModel.SWIFT,
                    Notes = _editModel.Notes,
                    NumberSequenceId = _editModel.NumberSequenceId,
                    InvoiceItem = _editModel.Items
                };

                var result = await TemplateService.CreateAsync(createDto);
                if (result != null)
                {
                    // Reset dirty flag and force re-render BEFORE navigation.
                    // Ensures <UnsavedChangesLock> removes <NavigationLock> from the DOM.
                    _isDirty = false;
                    StateHasChanged();
                    await Task.Yield();

                    Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                    Navigation.NavigateTo($"/invoice-templates/{result.Id}");
                }
                else
                {
                    Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
                }
            }
            else
            {
                var updateDto = new UpdateInvoiceTemplateDto
                {
                    Name = _editModel.Name,
                    Description = _editModel.Description,
                    ClientId = _editModel.ClientId,
                    DueDateOffsetDays = _editModel.DueDateOffsetDays,
                    CurrencyId = _editModel.CurrencyId,
                    PaymentMethod = _editModel.PaymentMethod,
                    VariableSymbol = _editModel.VariableSymbol,
                    ConstantSymbol = _editModel.ConstantSymbol,
                    SpecificSymbol = _editModel.SpecificSymbol,
                    BankAccountNumber = _editModel.BankAccountNumber,
                    IBAN = _editModel.IBAN,
                    SWIFT = _editModel.SWIFT,
                    Notes = _editModel.Notes,
                    NumberSequenceId = _editModel.NumberSequenceId,
                    IsActive = _editModel.IsActive,
                    InvoiceItem = _editModel.Items
                };

                var result = await TemplateService.UpdateAsync(Id, updateDto);
                if (result != null)
                {
                    _isDirty = false; // Reset dirty flag on successful save
                    Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                    _isEditing = false;
                    await LoadTemplate();
                }
                else
                {
                    Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteTemplate()
    {
        try
        {
            if (await TemplateService.DeleteAsync(Id))
            {
                Snackbar.Add(L["Msg_DeleteSuccess"].Value, Severity.Success);
                Navigation.NavigateTo("/invoice-templates");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    private void GoBack() => Navigation.NavigateTo("/invoice-templates");

    /// <summary>
    /// Validates that VariableSymbol contains only digits and is max 10 characters.
    /// Returns null if valid, or an error message string if invalid.
    /// </summary>
    private string? ValidateVariableSymbol(string? value)
    {
        if (string.IsNullOrEmpty(value)) return null;
        if (value.Length > 10) return L["Invoice_VSMaxLength"].Value;
        if (!value.All(char.IsDigit)) return L["Invoice_VSDigitsOnly"].Value;
        return null;
    }

    /// <summary>
    /// Local edit model — holds template data while user edits in the form.
    /// </summary>
    private class TemplateEditModel
    {
        public long Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public EDocumentType DocumentType { get; set; } = EDocumentType.Invoice;
        public long IssuerId { get; set; }
        public long? ClientId { get; set; }
        public long CurrencyId { get; set; }
        public int DueDateOffsetDays { get; set; } = 14;
        public EPaymentMethod? PaymentMethod { get; set; }
        public string? VariableSymbol { get; set; }
        public string? ConstantSymbol { get; set; }
        public string? SpecificSymbol { get; set; }
        public string? BankAccountNumber { get; set; }
        public string? IBAN { get; set; }
        public string? SWIFT { get; set; }
        public string? Notes { get; set; }
        public long? NumberSequenceId { get; set; }
        public bool IsActive { get; set; } = true;
        public List<CreateInvoiceItemDto> Items { get; set; } = new();
    }
}
