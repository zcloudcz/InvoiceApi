@page "/auth-callback"
@rendermode InteractiveServer
@using InvoiceApi.BlazorUI.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Login_Title"] - Invoice API</PageTitle>

@*
    OAuth callback page — handles the redirect from the API after external OAuth login.
    The API redirects here with ?token=xxx (JWT) on success, or ?error=xxx on failure.
    This page stores the JWT token and redirects to the home page.
*@

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-8">
        <MudStack Spacing="4" AlignItems="AlignItems.Center">
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                    @_error
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="@(() => Navigation.NavigateTo("/login"))">
                    @L["Btn_Login"]
                </MudButton>
            }
            else
            {
                <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Login_LoggingIn"]</MudText>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    /// <summary>
    /// JWT token from the OAuth callback redirect (?token=xxx)
    /// </summary>
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    /// <summary>
    /// Error message from the OAuth callback redirect (?error=xxx)
    /// </summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Handle error from OAuth callback
        if (!string.IsNullOrEmpty(Error))
        {
            _error = $"{L["Login_Error"].Value}: {Error}";
            return;
        }

        // Handle successful OAuth login — store the JWT token
        if (!string.IsNullOrEmpty(Token))
        {
            try
            {
                // Create a minimal LoginResponse to store the session
                var loginResponse = new Models.LoginResponse
                {
                    Token = Token,
                    ExpiresAt = DateTime.UtcNow.AddHours(24) // Default expiration
                };

                var customAuthStateProvider = (CustomAuthenticationStateProvider)AuthStateProvider;
                await customAuthStateProvider.MarkUserAsAuthenticatedAsync(loginResponse);

                // Redirect to home page with full reload to pick up new auth state
                Navigation.NavigateTo("/", forceLoad: true);
            }
            catch (InvalidOperationException)
            {
                // NavigateTo with forceLoad can throw after initiating navigation — expected
            }
            catch (Exception ex)
            {
                _error = $"{L["Login_Error"].Value}: {ex.Message}";
            }
        }
        else
        {
            _error = L["Login_Error"].Value;
        }
    }
}
