{
  "permissions": {
    "allow": [
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(jq:*)",
      "mcp__plugin_github_github"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "env": {
    "AGENTIC_PROJECT_NUMBER": "3",
    "AGENTIC_PROJECT_OWNER": "@me",
    "AGENTIC_AUTO_MERGE": "true",
    "AGENTIC_INTEGRATION_BRANCH": "develop",
    "MAX_PARALLEL_DEVS": "3",
    "MAX_PARALLEL_REVIEWERS": "3",
    "MAX_PARALLEL_TESTERS": "3",
    "AGENTIC_FOCUS": "db-switch,ai-first"
  }
}
