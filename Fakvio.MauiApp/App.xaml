<?xml version = "1.0" encoding = "UTF-8" ?>
<!-- MAUI Application root — defines the app-level resources and lifecycle.
     Unlike Blazor's App.razor, this is a XAML file for MAUI's native shell. -->
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:InvoiceApi.MauiApp"
             x:Class="InvoiceApi.MauiApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MAUI built-in styles (buttons, labels, etc.) -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
