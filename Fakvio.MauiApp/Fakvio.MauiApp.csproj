<!-- .NET MAUI Blazor Hybrid project — native mobile/desktop app hosting the same Blazor UI
     as the WebAssembly project. Uses BlazorWebView to render Razor components in a native WebView.
     All shared components, services, and models come from Fakvio.UI.Shared (RCL). -->
<Project Sdk="Microsoft.NET.Sdk.Maui">

  <PropertyGroup>
    <!-- Multi-target: builds for Android, iOS, macOS, and Windows from a single project -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Minimum OS versions for deployment -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Fakvio.MauiApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Display name and unique identifier for app stores -->
    <ApplicationTitle>Fakvio</ApplicationTitle>
    <ApplicationIdGuid>E3A1F2B4-5C6D-7E8F-9A0B-1C2D3E4F5A6B</ApplicationIdGuid>
    <ApplicationId>com.fakvio.mauiapp</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon and splash screen — MAUI automatically generates platform-specific sizes -->
    <MauiIcon Include="Resources\Images\appicon.svg" ForegroundFile="Resources\Images\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <!-- Fonts included in the app bundle -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw assets accessible via MauiAsset -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- MAUI Blazor Hybrid requires the BlazorWebView control -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.2" />
  </ItemGroup>

  <!-- Reference the shared UI library — same components/services used by BlazorUI (WASM) -->
  <ItemGroup>
    <ProjectReference Include="..\Fakvio.UI.Shared\Fakvio.UI.Shared.csproj" />
  </ItemGroup>

</Project>
