<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Source generators MUST target netstandard2.0 — required by the Roslyn compiler host. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Marks this project as a Roslyn analyzer/generator component. -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Use latest C# syntax features (records, pattern matching, etc.)
         even though the target framework is netstandard2.0. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Fakvio.Functions.Generator</RootNamespace>
  </PropertyGroup>

  <!-- Roslyn code analysis APIs — the only dependency a source generator needs. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

</Project>
