{
  "ConnectionStrings": {
    // PostgreSQL in Docker (docker compose up -d).
    // Single database with schema-per-tenant: "public" = master, "tenant_{id}" = tenants.
    // Matches docker-compose.yml credentials: user=fakvio, password=fakvio_dev, db=fakvio
    //"DefaultConnection": "Host=localhost;Port=5432;Database=fakvio;Username=fakvio;Password=fakvio_dev",
    "DefaultConnection": "Host=zcloudpostgresql.postgres.database.azure.com;Database=postgres;Port=5432;Username=zahalos_seznam.cz#EXT#@zahalosseznam.onmicrosoft.com;Ssl Mode=Require;"
  },
  "Database": {
    // "AzureEntraId" = Azure PostgreSQL with Entra ID token auth (requires `az login` locally).
    // "Password"     = local Docker PostgreSQL with password auth.
    // IMPORTANT: Must match the connection string above — the Azure conn string has no
    // password, so AuthMode MUST be AzureEntraId while it is the active one.
    // Switching this dev box to local Docker PostgreSQL = swap which line is commented out,
    // here and in ConnectionStrings above.
    //"AuthMode": "Password"
    "AuthMode": "AzureEntraId"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Show EF Core SQL queries in Development for debugging
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "JwtSettings": {
    "Secret": "DevOnlyJwtSecretKeyThatIsAtLeast32CharactersLong!ForLocalDevelopment"
  },
