{
  "ConnectionStrings": {
    // DefaultConnection — single PostgreSQL database for all schemas (master + tenants).
    // Master data lives in the "public" schema; each tenant gets "tenant_{id}" schema.
    // Production: use environment variable ConnectionStrings__DefaultConnection or Key Vault
    // When UseAzureAdAuthentication=true, no password is needed — Entra ID token is used instead.
    // Username must match the Entra ID principal name (managed identity name or AAD user).
    "DefaultConnection": "Host=zcloudpostgresql.postgres.database.azure.com;Database=postgres;Port=5432;Username=zahalos_seznam.cz#EXT#@zahalosseznam.onmicrosoft.com;Ssl Mode=Require;"
  },
  // Azure AD (Entra ID) token-based authentication for PostgreSQL.
  // - true: uses DefaultAzureCredential (Managed Identity in Azure, az login locally)
  // - false: uses password from connection string (local dev with local PostgreSQL)
  "UseAzureAdAuthentication": true,
  "JwtSettings": {
    "Issuer": "Fakvio",
    "Audience": "FakvioClient",
    "ExpirationHours": 24
    // SECURITY: "Secret" is NOT stored here — it is loaded from:
    //   Development: appsettings.Development.json or User Secrets
    //   Production:  environment variable JwtSettings__Secret or Key Vault
  },
  "CorsSettings": {
    // Allowed origins for CORS policy. Empty array = reject all cross-origin requests.
    // Development overrides this in appsettings.Development.json.
    // Production: set to your specific domain(s), e.g. ["https://app.example.com"]
    "AllowedOrigins": []
  },
  "OAuth": {
    "Google": { "ClientId": "", "ClientSecret": "" },
    "Microsoft": { "ClientId": "", "ClientSecret": "" },
    "Facebook": { "AppId": "", "AppSecret": "" },
    "Apple": { "ClientId": "", "KeyId": "", "TeamId": "" },
    "Seznam": { "ClientId": "", "ClientSecret": "" }
  },
  "SmtpSettings": {
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "your-email@example.com",
    "Password": "your-password",
    "SenderEmail": "invoices@example.com",
    "SenderName": "Fakvio",
    "UseSsl": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AppSettings": {
    // Base URL of the Blazor UI app — used for email links (set-password, invitations).
    // Production: set to your deployed UI domain, e.g. "https://app.fakvio.com"
    "BlazorBaseUrl": ""
  },
  "AiSettings": {
    // Default AI provider to use when user doesn't specify one.
    // Only providers with non-empty API keys are available at runtime.
    "DefaultProvider": "Ollama",
    "Claude": { "ApiKey": "", "Model": "claude-sonnet-4-6" },
    "OpenAI": { "ApiKey": "", "Model": "gpt-4o" },
    "Gemini": { "ApiKey": "", "Model": "gemini-2.0-flash" },
    "Ollama": { "BaseUrl": "http://localhost:11434", "Model": "gemma3:12b" }
  },
  "AllowedHosts": "*"
}
