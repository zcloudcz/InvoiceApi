<Project Sdk="Microsoft.NET.Sdk">

  <!-- Allow test project to access internal members (e.g., ParseAiResponse for unit testing) -->
  <ItemGroup>
    <InternalsVisibleTo Include="Fakvio.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fakvio.Application\Fakvio.Application.csproj" />
    <ProjectReference Include="..\Fakvio.Domain\Fakvio.Domain.csproj" />
    <ProjectReference Include="..\AresService\AresService.csproj" />
  </ItemGroup>

  <!-- Framework reference for IHttpContextAccessor used by CurrentUserService -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Azure Identity for DefaultAzureCredential (used by other Azure services if needed) -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="Anthropic" Version="3.3.0" />
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="itext7" Version="9.1.0" />
    <PackageReference Include="itext7.bouncy-castle-adapter" Version="9.1.0" />
    <PackageReference Include="itext7.pdfhtml" Version="6.1.0" />
    <PackageReference Include="MailKit" Version="4.10.0" />
    <PackageReference Include="OpenAI" Version="2.2.0-beta.4" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- PostgreSQL EF Core provider — single-database multi-schema tenant isolation -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    <PackageReference Include="ZMapper" Version="1.2.0" />
    <!-- Auth packages needed by DependencyInjection/AuthenticationExtensions.cs (shared with API + Functions) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.3" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.22" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	   <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	  <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
	  
  </PropertyGroup>

	<ItemGroup>
		<Compile Remove="$(CompilerGeneratedFilesOutputPath)/**" />
	</ItemGroup>
	
  <!-- Embed HTML templates as assembly resources so they can be read at runtime -->
  <ItemGroup>
    <EmbeddedResource Include="Templates\*.html" />
    <EmbeddedResource Include="Resources\Isdoc\isdoc-6.0.2.xsd" />
  </ItemGroup>

  <!--
    EPO XSD schemas — copy-to-output (NOT embedded resource) so a new year's XSD
    can be added without recompile. EpoSchemaProvider (issue #35) loads them at runtime
    via AppContext.BaseDirectory. Wildcard covers all years automatically.
  -->
  <ItemGroup>
    <None Update="Resources\Epo\**\*.xsd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Global using for ZMapper so the source generator's output can resolve MapperConfiguration -->
  <ItemGroup>
    <Using Include="ZMapper" />
    <Using Include="Fakvio.Infrastructure.Mapping" />
  </ItemGroup>

</Project>
