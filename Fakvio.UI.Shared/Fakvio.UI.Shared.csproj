<!-- Razor Class Library (RCL) containing all shared Blazor UI components, services, and models.
     Referenced by both BlazorUI (WASM) and MauiApp (MAUI Blazor Hybrid) hosts.
     This ensures a single codebase for the entire UI layer.

     IMPORTANT: We use explicit NuGet packages instead of FrameworkReference because
     FrameworkReference to Microsoft.AspNetCore.App is NOT compatible with browser-wasm
     runtime used by Blazor WebAssembly. All versions must be 10.0.2 to match. -->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- RCL must declare static web assets (CSS, JS) are available to consuming projects -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <!-- Suppress NU1510 "redundant package" warnings — some packages overlap but all are
         needed because there is NO FrameworkReference (WASM compatibility). -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- MudBlazor Material Design component library -->
    <PackageReference Include="MudBlazor" Version="8.15.0" />
    <!-- Browser localStorage for JWT token persistence (works in both WASM and MAUI WebView) -->
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <!-- Quill WYSIWYG rich-text editor for invoice/email template editing -->
    <PackageReference Include="Blazored.TextEditor" Version="1.1.3" />
    <!-- Authorization components (AuthorizeView, CascadingAuthenticationState, etc.) -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.2" />
    <!-- HttpClient factory for named/typed HTTP clients + IHttpClientFactory -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
    <!-- Blazor component base classes and rendering primitives -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.2" />
    <!-- Logging abstractions — ILogger<T> used by all API services -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <!-- Configuration abstractions — IConfiguration used by Login/Register pages -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.2" />
    <!-- Localization — IStringLocalizer<T> for multi-language UI (cs-CZ / en-US).
         Required for AddLocalization() and resource file (.resx) resolution at runtime. -->
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.2" />
  </ItemGroup>

  <!-- Global usings — these are implicit in BlazorWebAssembly SDK but NOT in Razor SDK.
       Added here so service classes compile without adding per-file using directives. -->
  <ItemGroup>
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <!-- Shared library references: Contracts (DTOs, Pagination) and Domain (Enums).
       No reference to Application or Infrastructure — keeps the UI layer lightweight. -->
  <ItemGroup>
    <ProjectReference Include="..\Fakvio.Contracts\Fakvio.Contracts.csproj" />
    <ProjectReference Include="..\Fakvio.Domain\Fakvio.Domain.csproj" />
  </ItemGroup>

</Project>
