@using Microsoft.AspNetCore.Components.Authorization
@using Fakvio.UI.Shared.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResource> L
@inject PaymentMatchingApiService PaymentApi
@inject AppStateService AppState

<AuthorizeView>
    <Authorized>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">@L["Nav_Dashboard"]</MudNavLink>

            @* AI assistant — second entry point next to the AppBar icon, so the assistant
               is discoverable from the navigation like every other feature. It opens the
               chat drawer (owned by MainLayout) instead of navigating anywhere.
               Same tenant-context guard as the AppBar button: /api/chat/* needs a CompanyId. *@
            @if (_showInvoicing)
            {
                <MudNavLink Icon="@Icons.Material.Filled.SmartToy" OnClick="@ToggleChat">@L["Chat_Title"]</MudNavLink>
            }

            @* Invoicing section — visible for User/Admin, and SysAdmin when impersonating a company *@
            @if (_showInvoicing)
            {
                <MudNavGroup Title="@L["Nav_Invoicing"].Value" Icon="@Icons.Material.Filled.Receipt" Expanded="true">
                    <MudNavLink Href="/invoices" Icon="@Icons.Material.Filled.Description">@L["Nav_Invoices"]</MudNavLink>
                    @* Proformas (advance invoices) — separate list page via type filter *@
                    <MudNavLink Href="/invoices?type=Proforma" Icon="@Icons.Material.Filled.RequestQuote">@L["Nav_Proformas"]</MudNavLink>
                    @* Credit Notes — accessible via filter on Invoices page *@
                    <MudNavLink Href="/invoices?type=CreditNote" Icon="@Icons.Material.Filled.CreditCard">@L["Nav_CreditNotes"]</MudNavLink>
                    <MudNavLink Href="/invoice-templates" Icon="@Icons.Material.Filled.ContentCopy">@L["Nav_InvoiceTemplates"]</MudNavLink>
                    <MudNavLink Href="/content-templates" Icon="@Icons.Material.Filled.Article">@L["Nav_ContentTemplates"]</MudNavLink>
                    <MudNavLink Href="/clients" Icon="@Icons.Material.Filled.People">@L["Nav_Clients"]</MudNavLink>
                    <MudNavLink Href="/received-invoices" Icon="@Icons.Material.Filled.CallReceived">@L["Nav_ReceivedInvoices"]</MudNavLink>
                    <MudNavLink Href="/invoice-emails" Icon="@Icons.Material.Filled.MarkEmailRead">Email import</MudNavLink>
                    <MudNavLink Href="/reminders" Icon="@Icons.Material.Filled.NotificationsActive">@L["Nav_Reminders"]</MudNavLink>
                    @* Payment matching — entry point for the auto-match feature.
                       Badge with unmatched count is wired in MainLayout via PaymentMatchingApiService. *@
                    <MudNavLink Href="/payments" Icon="@Icons.Material.Filled.Payments">
                        @L["Nav_Payments"]
                        @if (_unmatchedCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">@_unmatchedCount</MudChip>
                        }
                    </MudNavLink>
                    @* Import hidden — feature under development *@
                    @* <MudNavLink Href="/invoices/import" Icon="@Icons.Material.Filled.UploadFile">@L["Nav_ImportInvoices"]</MudNavLink> *@
                    <MudNavLink Href="/vat-report" Icon="@Icons.Material.Filled.Assessment">@L["Nav_VatReport"]</MudNavLink>
                    <MudNavLink Href="/tax-estimation" Icon="@Icons.Material.Filled.AccountBalance">@L["Nav_TaxEstimation"]</MudNavLink>
                </MudNavGroup>
            }

            <MudNavGroup Title="@L["Nav_Settings"].Value" Icon="@Icons.Material.Filled.Settings">
                @* User preferences moved to the AppBar profile menu (avatar + name) *@
                @* Two-Factor Auth — visible for all authenticated users with invoicing context *@
                @if (_showInvoicing)
                {
                    <MudNavLink Href="/profile/two-factor" Icon="@Icons.Material.Filled.Security">@L["Nav_TwoFactor"]</MudNavLink>
                    <MudNavLink Href="/my-company" Icon="@Icons.Material.Filled.Business">@L["Nav_MyCompany"]</MudNavLink>
                    <MudNavLink Href="/vat-rates" Icon="@Icons.Material.Filled.Percent">@L["Nav_VatRates"]</MudNavLink>
                    <MudNavLink Href="/number-sequences" Icon="@Icons.Material.Filled.Numbers">@L["Nav_NumberSequences"]</MudNavLink>
                }

                @* User management — Admin and SysAdmin *@
                <AuthorizeView Roles="Admin,SysAdmin" Context="adminContext">
                    <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People">@L["Nav_Users"]</MudNavLink>
                </AuthorizeView>

                @* System-wide settings — SysAdmin only *@
                <AuthorizeView Roles="SysAdmin" Context="sysAdminContext">
                    @* Currencies — visible in both modes (dual-context: master or tenant) *@
                    <MudNavLink Href="/currencies" Icon="@Icons.Material.Filled.AttachMoney">@L["Nav_Currencies"]</MudNavLink>

                    @* SysAdmin management pages — only visible when NOT impersonating a company.
                       These operate on master DB and are not relevant in tenant context. *@
                    @if (!_showInvoicing)
                    {
                        <MudNavLink Href="/companies" Icon="@Icons.Material.Filled.Business">@L["Nav_Companies"]</MudNavLink>
                        <MudNavLink Href="/company-settings" Icon="@Icons.Material.Filled.Dns">@L["Nav_TenantSettings"]</MudNavLink>
                        <MudNavLink Href="/system-settings" Icon="@Icons.Material.Filled.Tune">@L["Nav_SystemSettings"]</MudNavLink>
                        <MudNavLink Href="/send-email" Icon="@Icons.Material.Filled.Email">@L["Nav_SendEmail"]</MudNavLink>
                        <MudNavLink Href="/logs" Icon="@Icons.Material.Filled.ListAlt">@L["Nav_Logs"]</MudNavLink>
                        @* Master-level code tables — when NOT impersonating *@
                        <MudNavLink Href="/vat-rates" Icon="@Icons.Material.Filled.Percent">@L["Nav_VatRates"]</MudNavLink>
                        <MudNavLink Href="/content-templates" Icon="@Icons.Material.Filled.Article">@L["Nav_ContentTemplates"]</MudNavLink>
                        <MudNavLink Href="/number-sequences" Icon="@Icons.Material.Filled.Numbers">@L["Nav_NumberSequences"]</MudNavLink>
                        <MudNavLink Href="/tax-configs" Icon="@Icons.Material.Filled.AccountBalance">@L["Nav_TaxConfig"]</MudNavLink>
                        @* Payment matching — system-wide IMAP/AI configuration. *@
                        <MudNavLink Href="/sysadmin/payment-matching" Icon="@Icons.Material.Filled.MarkEmailRead">@L["Nav_PaymentMatching"]</MudNavLink>
                    }
                </AuthorizeView>
            </MudNavGroup>
        </MudNavMenu>
    </Authorized>
</AuthorizeView>

@code {
    /// <summary>
    /// Opens / closes the AI chat drawer. MainLayout owns the drawer, so the request
    /// travels through AppStateService (same pattern as OnCompanyListChanged).
    /// </summary>
    private void ToggleChat() => AppState.NotifyChatToggleRequested();

    // Whether to show invoicing menu items.
    // True for User/Admin (they always have a company), and for SysAdmin when impersonating.
    private bool _showInvoicing = false;

    // Count shown as a chip next to the Payments nav entry.
    // Refreshed once on first render; subsequent updates can be wired later via SignalR.
    private int _unmatchedCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var customAuth = (CustomAuthenticationStateProvider)AuthStateProvider;
                var session = await customAuth.GetUserSessionAsync();

                if (session != null)
                {
                    if (session.Role == 2) // SysAdmin
                    {
                        // Show invoicing only when impersonating a company
                        var impersonatedId = await customAuth.GetImpersonatedCompanyIdAsync();
                        _showInvoicing = impersonatedId.HasValue;
                    }
                    else
                    {
                        // User/Admin always have a company
                        _showInvoicing = true;
                    }

                    // Best-effort badge load — don't block rendering on a network error.
                    if (_showInvoicing)
                    {
                        try { _unmatchedCount = await PaymentApi.GetUnmatchedCountAsync(); }
                        catch { /* badge stays at 0 */ }
                    }

                    StateHasChanged();
                }
            }
            catch
            {
                // Ignore — session might not be available
            }
        }
    }
}
