@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Fakvio.UI.Shared.Services
@using Fakvio.Contracts.Dto.Client
@using Fakvio.UI.Shared.Components.Shared
@using Fakvio.UI.Shared.Components.Notification
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject CompanyApiService CompanyService
@inject IStringLocalizer<SharedResource> L
@inject NotificationApiService NotificationService
@inject AppStateService AppState
@inject IJSRuntime JS
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@implements IDisposable

@* NOTE: CascadingAuthenticationState is provided by App.razor — no need to wrap here.
   All child components can access Task<AuthenticationState> via [CascadingParameter]. *@
<MudThemeProvider @bind-IsDarkMode="_isDarkMode" />
    <MudLayout>
        @* Pink on test, theme default on production — see UiEnvironment. *@
        <MudAppBar Elevation="1" Style="@UiEnvironment.AppBarStyle(_environmentName)">
            @* Hamburger menu — only shown for authenticated users (no nav menu on login/register) *@
            <AuthorizeView>
                <Authorized>
                    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" Title="Menu" />
                </Authorized>
            </AuthorizeView>
            @* App logo + title — switches between grey (dark mode) and color (light mode) *@
            <MudImage Src="@_logoSrc" Alt="Fakvio" Width="32" Height="32" Class="ml-3 mr-2 appbar-logo" />
            @* appbar-title hides on phones (logo stays) — see app.css responsive section *@
            <MudText Typo="Typo.h5" Class="appbar-title">@L["Layout_AppTitle"]</MudText>
            @if (UiEnvironment.IsNonProduction(_environmentName))
            {
                @* The colour alone is not enough for everyone — the name is spelled out too. *@
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="ml-2">@_environmentName!.Trim().ToUpperInvariant()</MudChip>
            }
            <MudSpacer />

            <AuthorizeView>
                <Authorized>
                    @* Impersonation selector — only visible for SysAdmin *@
                    <AuthorizeView Roles="SysAdmin" Context="sysAdminImpContext">
                        @* Company selector — uses Color.Inherit so text color follows AppBar theme
                           (white on dark AppBar, dark on light AppBar) instead of hardcoded white *@
                        @* Width lives in .appbar-select CSS (220px desktop, shrinks on phones) *@
                        <MudSelect T="long?" Value="_impersonatedCompanyId"
                                   ValueChanged="OnImpersonatedCompanyChanged"
                                   Label="" Placeholder="Zvolit společnost..."
                                   Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                   Class="mr-4 appbar-select"
                                   Clearable="true"
                                   ToStringFunc="@(id => _availableCompanies.FirstOrDefault(c => c.Id == id)?.CompanyName ?? L["Layout_NoCompany"].Value)">
                            @foreach (var company in _availableCompanies)
                            {
                                <MudSelectItem Value="@((long?)company.Id)">@company.CompanyName</MudSelectItem>
                            }
                        </MudSelect>
                    </AuthorizeView>

                    <AuthorizeView Context="companyContext"><Authorized>@if (!companyContext.User.IsInRole("SysAdmin")) { <CompanyMembershipSelector /> }</Authorized></AuthorizeView>
                    <FeedbackButton />
                    @* User profile menu — avatar + name opens personal settings (preferences, 2FA) *@
                    <MudMenu Dense="true" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                        <ActivatorContent>
                            <MudButton Color="Color.Inherit" Class="mr-4 text-none appbar-profile-btn"
                                       StartIcon="@Icons.Material.Filled.AccountCircle"
                                       EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                       title="@L["Layout_MyProfile"]">
                                @* Name hides on phones — avatar icon + arrow stay *@
                                <span class="appbar-username">
                                    @context.User.Identity?.Name
                                </span>
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Icon="@Icons.Material.Filled.Tune"
                                         OnClick="@(() => Navigation.NavigateTo("/preferences"))">
                                @L["Nav_Preferences"]
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Security"
                                         OnClick="@(() => Navigation.NavigateTo("/profile/two-factor"))">
                                @L["Nav_TwoFactor"]
                            </MudMenuItem>
                            <MudDivider />
                            @* Logout also lives here — the AppBar logout icon hides on phones *@
                            <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                                         OnClick="@HandleLogoutAsync">
                                @L["Btn_Logout"]
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                    @if (_hasTenantContext)
                    {
                        <NotificationBell />
                    }
                    @* Hidden on phones — logout lives in the profile menu there *@
                    <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                   Color="Color.Inherit"
                                   OnClick="@HandleLogoutAsync"
                                   title="@L["Btn_Logout"]" Class="hide-xs" />
                </Authorized>
                <NotAuthorized>
                    <MudButton Href="/login"
                               Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.Login"
                               Color="Color.Inherit">
                        @L["Btn_Login"]
                    </MudButton>
                </NotAuthorized>
            </AuthorizeView>

            @* Dark/light mode toggle — only shown for authenticated users *@
            <AuthorizeView>
                <Authorized>
                    @* Least essential AppBar icon — hidden on phones to save width *@
                    <MudIconButton Icon="@Icons.Material.Filled.Brightness4" Color="Color.Inherit" OnClick="@ToggleDarkMode" title="@L["Layout_ToggleDarkMode"]" Class="hide-xs" />
                </Authorized>
            </AuthorizeView>
        </MudAppBar>
    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
                <MudDrawerHeader>
                    <MudText Typo="Typo.h6">@L["Nav_Menu"]</MudText>
                </MudDrawerHeader>
                <NavMenu />
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="my-4">
                @* LoggingErrorBoundary catches unhandled component exceptions and forwards them
                   to the server-side AppLog table via IClientLogger. The default fallback UI
                   from the base ErrorBoundary is rendered when an error is caught. *@
                <LoggingErrorBoundary>
                    @Body
                </LoggingErrorBoundary>
            </MudContainer>
        </MudMainContent>

        @* GDPR cookie consent banner — shown until user accepts *@
        @if (!_cookiesAccepted)
        {
            <MudPaper Elevation="8" Class="cookie-banner pa-4"
                      Style="position:fixed;bottom:0;left:0;right:0;z-index:9999;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="4" Class="flex-wrap">
                    <MudText Typo="Typo.body2">
                        @L["Cookie_Text"]
                    </MudText>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="AcceptCookies">
                            @L["Cookie_Accept"]
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    </MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private bool _cookiesAccepted = true; // default true to avoid flash

    /// <summary>
    /// Returns the logo image path based on the current theme.
    /// Grey logo for dark mode (better contrast on dark AppBar),
    /// color logo for light mode.
    /// </summary>
    private string _logoSrc => _isDarkMode ? "images/logo-grey.png" : "images/logo.png";

    /// <summary>Environment name from wwwroot/appsettings.json; null on hosts that do not set it (MAUI, tests).</summary>
    private string? _environmentName => Configuration[UiEnvironment.ConfigKey];

    // Impersonation state — SysAdmin can select a company to "act as"
    private long? _impersonatedCompanyId;
    private List<ClientDto> _availableCompanies = new();

    // Tenant-context flag — true when API calls that require a CompanyId claim
    // are guaranteed to succeed:
    //   - regular tenant user (always carries CompanyId in their JWT)
    //   - SysAdmin who has selected a company to impersonate
    // False for SysAdmin without an impersonated company. Used to hide tenant-scoped UI
    private bool _hasTenantContext;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
    }

    /// <summary>
    /// Accepts cookies — stores consent in localStorage so the banner doesn't show again.
    /// </summary>
    private async Task AcceptCookies()
    {
        _cookiesAccepted = true;
        await JS.InvokeVoidAsync("localStorage.setItem", "cookieConsent", "true");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check if user already accepted cookies
            var consent = await JS.InvokeAsync<string?>("localStorage.getItem", "cookieConsent");
            _cookiesAccepted = consent == "true";

            StateHasChanged();
            // Subscribe to company list changes (e.g., CompanyDetail creates a new company).
            // This replaces forceLoad: true navigation which restarts the WASM app.
            AppState.OnCompanyListChanged += OnCompanyListChanged;

            await LoadCompaniesAsync();
        }
    }

    /// <summary>
    /// Loads the company list for the SysAdmin impersonation dropdown.
    /// Called on first render and when a company is created/deleted.
    /// </summary>
    private async Task LoadCompaniesAsync()
    {
        try
        {
            var customAuth = (CustomAuthenticationStateProvider)AuthStateProvider;
            var session = await customAuth.GetUserSessionAsync();

            if (session != null)
            {
                if (session.Role == 2) // SysAdmin
                {
                    _availableCompanies = await CompanyService.GetAllAsync();
                    _impersonatedCompanyId = await customAuth.GetImpersonatedCompanyIdAsync();

                    // SysAdmin only has tenant context after picking a company to impersonate.
                    _hasTenantContext = _impersonatedCompanyId != null;
                }
                else
                {
                    // Regular tenant user — JWT always carries a CompanyId claim, tenant context guaranteed.
                    _hasTenantContext = true;
                }

                StateHasChanged();
            }
        }
        catch
        {
            // Ignore — auth may not be ready yet
        }
    }

    /// <summary>
    /// Event handler for AppStateService.OnCompanyListChanged.
    /// Refreshes the impersonation dropdown without full page reload.
    /// </summary>
    private async void OnCompanyListChanged()
    {
        await LoadCompaniesAsync();
    }

    public void Dispose()
    {
        AppState.OnCompanyListChanged -= OnCompanyListChanged;
    }

    /// <summary>
    /// Called when SysAdmin selects a company to impersonate.
    /// Stores the selection in session and refreshes the page to update navigation.
    /// </summary>
    private async Task OnImpersonatedCompanyChanged(long? companyId)
    {
        _impersonatedCompanyId = companyId;
        var companyName = _availableCompanies.FirstOrDefault(c => c.Id == companyId)?.CompanyName;

        _hasTenantContext = companyId.HasValue;

        var customAuth = (CustomAuthenticationStateProvider)AuthStateProvider;
        await customAuth.SetImpersonatedCompanyAsync(companyId, companyName);

        // Navigate to Dashboard on company change — stale data from previous tenant
        // would be confusing on any other page.
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private async Task HandleLogoutAsync()
    {
        var customAuthStateProvider = (CustomAuthenticationStateProvider)AuthStateProvider;
        await customAuthStateProvider.MarkUserAsLoggedOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
