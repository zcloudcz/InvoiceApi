@using Fakvio.Contracts.Dto.Notification
@using Fakvio.Domain.Enums
@using Fakvio.UI.Shared.Services
@inject NotificationApiService NotificationService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@implements IDisposable

<MudBadge Content="@_unreadCount" Overlap="true" Color="Color.Error"
          Visible="@(_unreadCount > 0)" Max="99">
    <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                   aria-label="@L["Notification_Title"].Value" title="@L["Notification_Title"].Value"
                   Color="Color.Inherit"
                   OnClick="@ToggleMenu" />
</MudBadge>

<MudPopover Open="@_menuOpen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
            Class="notification-popover" Style="width: min(380px, calc(100vw - 24px)); max-height: 500px;">
    <MudPaper Elevation="0">
        @* Header *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="px-4 py-2">
            <MudText Typo="Typo.h6">@L["Notification_Title"]</MudText>
            @if (_unreadCount > 0)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                           OnClick="@MarkAllAsReadAsync" Disabled="_saving">
                    @L["Notification_MarkAllRead"]
                </MudButton>
            }
        </MudStack>
        <MudDivider />

        @* Notification list *@
        @if (_error)
        {
            <MudAlert Severity="Severity.Error">@L["Notification_Error"]</MudAlert>
            <MudButton OnClick="LoadDashboardAsync" Disabled="_loading">@L["Feedback_Refresh"]</MudButton>
        }
        @if (_loading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            </MudStack>
        }
        else if (_dashboard is not null && _dashboard.RecentNotifications.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4" Align="Align.Center">
                @L["Notification_Empty"]
            </MudText>
        }
        else if (_dashboard is not null)
        {
            <MudList T="NotificationDto" Dense="true" Class="notification-list" Style="max-height: 380px; overflow-y: auto;">
                @foreach (var n in _dashboard.RecentNotifications)
                {
                    <MudListItem T="NotificationDto" OnClick="@(() => OnNotificationClickAsync(n))"
                                 Class="@(n.IsRead ? "" : "notification-unread")">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                            <MudIcon Icon="@GetIcon(n.Type)" Color="@GetColor(n.Type)" Size="Size.Small" Class="mt-1" />
                            <MudStack Spacing="0" Style="min-width: 0; flex: 1;">
                                <MudText Typo="Typo.body2" Style="@(n.IsRead ? "" : "font-weight: 600;")">
                                    @n.Title
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space: normal; word-break: break-word;">
                                    @n.Message
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                    @FormatRelativeTime(n.CreatedAt)
                                </MudText>
                            </MudStack>
                            @if (!n.IsRead)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Primary" Size="Size.Small" />
                            }
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }

        <MudDivider />
        @* Footer *@
        <MudStack Row="true" Justify="Justify.Center" Class="py-2">
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                       OnClick="@GoToNotificationsPage">
                @L["Notification_ShowAll"]
            </MudButton>
        </MudStack>
    </MudPaper>
</MudPopover>

@* Overlay to close the popover when clicking outside *@
@if (_menuOpen)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1299;"
         @onclick="@CloseMenu"></div>
}

@code {
    private bool _menuOpen;
    private int _unreadCount;
    private NotificationDashboardDto? _dashboard;
    private bool _error, _loading, _saving;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Navigation.LocationChanged += OnLocationChanged;
            await RefreshUnreadCountAsync();
            StateHasChanged();
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await RefreshUnreadCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshUnreadCountAsync()
    {
        try
        {
            _unreadCount = await NotificationService.GetUnreadCountAsync();
        }
        catch
        {
            _error = true; // Preserve the last count; an outage does not mean zero unread items.
        }
    }

    private async Task ToggleMenu()
    {
        _menuOpen = !_menuOpen;
        if (_menuOpen)
        {
            await LoadDashboardAsync();
        }
    }

    private async Task LoadDashboardAsync()
    {
        if (_loading) return;
        _loading = true;
        try
        {
            _dashboard = await NotificationService.GetDashboardAsync();
            _unreadCount = _dashboard!.UnreadCount;
            _error = false;
        }
        catch (Exception) { _error = true; }
        finally { _loading = false; }
    }

    private void CloseMenu()
    {
        _menuOpen = false;
    }

    private async Task OnNotificationClickAsync(NotificationDto notification)
    {
        if (_saving) return;
        if (!notification.IsRead)
        {
            _saving = true;
            try { await NotificationService.MarkAsReadAsync(notification.Id); _error = false; }
            catch (Exception) { _error = true; return; }
            finally { _saving = false; }
            notification.IsRead = true;
            notification.ReadAt = DateTime.UtcNow;
            _unreadCount = Math.Max(0, _unreadCount - 1);
        }

        _menuOpen = false;

        var url = GetEntityUrl(notification.RelatedEntityType, notification.RelatedEntityId);
        if (url != null)
            Navigation.NavigateTo(url);
    }

    private async Task MarkAllAsReadAsync()
    {
        if (_saving) return;
        _saving = true;
        try { await NotificationService.MarkAllAsReadAsync(); _error = false; }
        catch (Exception) { _error = true; return; }
        finally { _saving = false; }
        _unreadCount = 0;
        if (_dashboard != null)
        {
            foreach (var n in _dashboard.RecentNotifications)
            {
                n.IsRead = true;
                n.ReadAt = DateTime.UtcNow;
            }
        }
    }

    private void GoToNotificationsPage()
    {
        _menuOpen = false;
        Navigation.NavigateTo("/notifications");
    }

    private static string? GetEntityUrl(string entityType, long entityId) => entityType switch
    {
        "Invoice" => $"/invoices/{entityId}",
        "ReceivedInvoice" => $"/received-invoices/{entityId}",
        "BankTransaction" => "/payments",
        _ => null
    };

    private static string GetIcon(ENotificationType type) => type switch
    {
        ENotificationType.PaymentMatched => Icons.Material.Filled.Payment,
        ENotificationType.InvoiceEmailImported => Icons.Material.Filled.Email,
        ENotificationType.InvoiceEmailNeedsReview => Icons.Material.Filled.MarkEmailUnread,
        _ => Icons.Material.Filled.Notifications
    };

    private static Color GetColor(ENotificationType type) => type switch
    {
        ENotificationType.PaymentMatched => Color.Success,
        ENotificationType.InvoiceEmailImported => Color.Info,
        ENotificationType.InvoiceEmailNeedsReview => Color.Warning,
        _ => Color.Default
    };

    private string FormatRelativeTime(DateTime createdAt)
    {
        var diff = DateTime.UtcNow - createdAt;
        if (diff.TotalMinutes < 1) return L["Notification_Now"];
        if (diff.TotalMinutes < 60) return L["Notification_MinutesAgo", (int)diff.TotalMinutes];
        if (diff.TotalHours < 24) return L["Notification_HoursAgo", (int)diff.TotalHours];
        if (diff.TotalDays < 7) return L["Notification_DaysAgo", (int)diff.TotalDays];
        return createdAt.ToLocalTime().ToString("g");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
