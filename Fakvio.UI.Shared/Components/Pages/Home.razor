@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Fakvio.Contracts.Dto.AppLog
@using Fakvio.Contracts.Dto.Dashboard
@using Fakvio.Contracts.Dto.Invoice
@using Fakvio.Domain.Enums
@using Fakvio.Contracts.Dto.Tax
@using Fakvio.Contracts.Dto.Reminder
@using Fakvio.UI.Shared.Services
@inject DashboardApiService DashboardService
@inject TaxApiService TaxService
@inject ReminderApiService ReminderService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@* Localization service for multi-language support *@
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Dashboard_Title"] - Fakvio</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">@L["Dashboard_Title"]</MudText>
<MudText Class="mb-8">@L["Dashboard_Welcome"]</MudText>

@* Loading indicator while dashboard data is being fetched *@
@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (_isSysAdmin && !_isImpersonating)
{
    @* ════════════════════════════════════════════════════════════════════
       SysAdmin Dashboard — shown when SysAdmin is NOT impersonating a company.
       Shows system-wide statistics: company counts, provisioning status, recent logs.
       ════════════════════════════════════════════════════════════════════ *@

    @if (_sysAdminDashboard != null)
    {
        @* Company statistics — 4 KPI cards (clickable → navigates to /companies) *@
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="rounded-lg cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/companies"))">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" Size="Size.Large" />
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@L["Dashboard_SysAdminTotal"]</MudChip>
                        </div>
                        <MudText Typo="Typo.h5" GutterBottom="true">@_sysAdminDashboard.TotalCompanies</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard_SysAdminCompanies"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="rounded-lg cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/companies"))">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Success" Size="Size.Large" />
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">@L["TenantSettings_Provisioned"]</MudChip>
                        </div>
                        <MudText Typo="Typo.h5" GutterBottom="true">@_sysAdminDashboard.ProvisionedCompanies</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard_SysAdminProvisioned"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="rounded-lg cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/companies"))">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Info" Size="Size.Large" />
                            <MudChip T="string" Color="Color.Info" Size="Size.Small">@L["Label_Active"]</MudChip>
                        </div>
                        <MudText Typo="Typo.h5" GutterBottom="true">@_sysAdminDashboard.ActiveCompanies</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard_SysAdminActive"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="rounded-lg cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/companies"))">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Color="Color.Warning" Size="Size.Large" />
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">@L["Dashboard_Pending"]</MudChip>
                        </div>
                        <MudText Typo="Typo.h5" GutterBottom="true">@_sysAdminDashboard.PendingCompanies</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard_SysAdminPending"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @* Recent Warning/Error logs table *@
        @if (_sysAdminDashboard.RecentLogs.Count > 0)
        {
            <MudCard Elevation="2" Class="mt-6">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Dashboard_SysAdminRecentLogs"]</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/logs">@L["Btn_ViewAll"]</MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="_sysAdminDashboard.RecentLogs" Dense="true" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>@L["Log_Timestamp"]</MudTh>
                            <MudTh>@L["Log_Level"]</MudTh>
                            <MudTh>@L["Log_Source"]</MudTh>
                            <MudTh>@L["Log_Message"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@L["Log_Timestamp"].Value">
                                <MudText Typo="Typo.body2">@context.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                            </MudTd>
                            <MudTd DataLabel="@L["Log_Level"].Value">
                                <MudChip T="string" Size="Size.Small" Color="@GetLogLevelColor(context.Level)">
                                    @context.Level
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="@L["Log_Source"].Value">
                                <MudText Typo="Typo.body2" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis;">
                                    @GetShortSource(context.Source)
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="@L["Log_Message"].Value">
                                <MudText Typo="Typo.body2" Style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @context.Message
                                </MudText>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        }

        @* Log summary by level *@
        @if (_sysAdminDashboard.LogCountByLevel.Count > 0)
        {
            <MudGrid Class="mt-6">
                <MudItem xs="12">
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@L["Dashboard_SysAdminLogSummary"]</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <div class="d-flex flex-wrap gap-4">
                                @foreach (var entry in _sysAdminDashboard.LogCountByLevel.OrderByDescending(e => e.Key))
                                {
                                    <MudChip T="string" Size="Size.Medium" Color="@GetLogLevelColor(entry.Key)">
                                        @entry.Key: @entry.Value
                                    </MudChip>
                                }
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        }
    }
}
else
{
    @* ════════════════════════════════════════════════════════════════════
       Regular User Dashboard — shown for User/Admin roles,
       or for SysAdmin when impersonating a company.
       Shows tenant-specific invoice/client statistics.
       ════════════════════════════════════════════════════════════════════ *@

    @* Top statistics cards - 3 KPIs (clickable → navigate to corresponding list page).
       The first tile forecasts cashflow for the current calendar month: how many issued
       (Completed) invoices come due before month-end, plus totals without / with VAT. *@
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="rounded-lg cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/invoices"))">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Color="Color.Primary" Size="Size.Large" />
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small">@L["Dashboard_ThisMonth"]</MudChip>
                    </div>
                    @* Count is the main number; the two totals underneath answer "how much cashflow do I expect?" *@
                    <MudText Typo="Typo.h5" GutterBottom="true">@_dashboard.InvoicesDueThisMonthCount</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@L["Dashboard_InvoicesDueThisMonth"]</MudText>
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Invoice_TotalBeforeVat"]</MudText>
                        <MudText Typo="Typo.caption"><strong>@_dashboard.InvoicesDueThisMonthTotalWithoutVat.ToString("N2") CZK</strong></MudText>
                    </div>
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Invoice_TotalWithVat"]</MudText>
                        <MudText Typo="Typo.caption"><strong>@_dashboard.InvoicesDueThisMonthTotalWithVat.ToString("N2") CZK</strong></MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="rounded-lg cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/clients"))">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Success" Size="Size.Large" />
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">@L["Label_Active"]</MudChip>
                    </div>
                    <MudText Typo="Typo.h5" GutterBottom="true">@_dashboard.TotalClients</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard_Clients"]</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="rounded-lg cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/invoices"))">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Warning" Size="Size.Large" />
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">@L["Dashboard_Pending"]</MudChip>
                    </div>
                    <MudText Typo="Typo.h5" GutterBottom="true">@_dashboard.UnpaidAmount.ToString("N2") CZK</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard_UnpaidAmount"]</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* ─── Tax Estimate & Insurance Advance Cards ─────────────────────────────
       Two cards side-by-side: (1) next payment date with days-until countdown,
       (2) monthly insurance advance breakdown (social + health).
       The previous standalone "Celkem měsíčně" tile was removed — its value
       (MonthlyTotal = MonthlySocial + MonthlyHealth) was a duplicate of what
       the breakdown card already shows. The AccountBalance icon is kept on
       the breakdown card as visual cue. *@
    @if (_insuranceAdvance != null)
    {
        <MudGrid Class="mt-6">
            <MudItem xs="12" sm="6" md="6">
                <MudCard Elevation="2" Class="rounded-lg">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Large"
                                     Color="@(_insuranceAdvance.DaysUntilPayment <= 5 ? Color.Error : Color.Info)" />
                            @if (_insuranceAdvance.DaysUntilPayment <= 0)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">@L["Dashboard_InsuranceOverdue"]</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="@(_insuranceAdvance.DaysUntilPayment <= 5 ? Color.Warning : Color.Info)" Size="Size.Small">
                                    @string.Format(L["Dashboard_InsuranceDueIn"].Value, _insuranceAdvance.DaysUntilPayment)
                                </MudChip>
                            }
                        </div>
                        <MudText Typo="Typo.h6" GutterBottom="true">
                            @_insuranceAdvance.NextPaymentDate.ToShortDateString()
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard_InsuranceNextDate"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="6">
                @* Navigates to tax estimation page — previously on the removed "Celkem měsíčně" tile. *@
                <MudCard Elevation="2" Class="rounded-lg cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/tax-estimation"))">
                    <MudCardContent>
                        @* Icon inherited from the removed duplicate tile to preserve visual identity. *@
                        <div class="d-flex justify-space-between align-center mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Tertiary" Size="Size.Large" />
                            <MudChip T="string" Color="Color.Tertiary" Size="Size.Small">@DateTime.Today.Year</MudChip>
                        </div>
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Dashboard_InsuranceAdvance"]</MudText>
                        <div class="d-flex justify-space-between mb-1">
                            <MudText>@L["Dashboard_InsuranceSocial"]</MudText>
                            <MudText><strong>@_insuranceAdvance.MonthlySocial.ToString("N0") @_insuranceAdvance.CurrencyCode</strong></MudText>
                        </div>
                        <div class="d-flex justify-space-between">
                            <MudText>@L["Dashboard_InsuranceHealth"]</MudText>
                            <MudText><strong>@_insuranceAdvance.MonthlyHealth.ToString("N0") @_insuranceAdvance.CurrencyCode</strong></MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    @* ─── Donut Charts Row — side-by-side: Invoices by Status + Top Clients by Revenue ─── *@
    @if (_dashboard.InvoiceCountByStatus.Count > 0 || _dashboard.InvoiceTotalByClient.Count > 0)
    {
        <MudGrid Class="mt-6">
            @* Left chart: Invoices by Status (donut) *@
            @if (_dashboard.InvoiceCountByStatus.Count > 0)
            {
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Class="rounded-lg">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@L["Dashboard_InvoicesByStatus"]</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Style="min-height: 300px;">
                            <MudChart ChartType="ChartType.Donut"
                                      InputData="@GetStatusChartData()"
                                      InputLabels="@GetStatusChartLabels()"
                                      Width="300px" Height="300px"
                                      ChartOptions="@_chartOptions" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }

            @* Right chart: Top Clients by Revenue (donut) *@
            @if (_dashboard.InvoiceTotalByClient.Count > 0)
            {
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Class="rounded-lg">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@L["Dashboard_TopClientsByRevenue"]</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Style="min-height: 300px;">
                            <MudChart ChartType="ChartType.Donut"
                                      InputData="@GetClientRevenueChartData()"
                                      InputLabels="@GetClientRevenueChartLabels()"
                                      Width="300px" Height="300px"
                                      ChartOptions="@_chartOptions" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

    @* Overdue invoices alert - only shown when there are overdue invoices *@
    @if (_dashboard.OverdueInvoicesCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-6 mb-2" Icon="@Icons.Material.Filled.Warning">
            <strong>@_dashboard.OverdueInvoicesCount</strong> @L["Dashboard_OverdueAlert"]
        </MudAlert>

        <MudCard Elevation="2" Class="mb-6">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@L["Dashboard_OverdueInvoices"]</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/invoices">@L["Btn_ViewAll"]</MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                @* Row click navigates to the invoice detail page *@
                <MudTable T="InvoiceDto" Items="@_dashboard.OverdueInvoices" Dense="true" Hover="true" Striped="true"
                          OnRowClick="@(args => { if (args.Item != null) Navigation.NavigateTo($"/invoices/{args.Item.Id}"); })"
                          RowClass="cursor-pointer">
                    <HeaderContent>
                        <MudTh>@L["Table_Number"]</MudTh>
                        <MudTh>@L["Invoice_Client"]</MudTh>
                        <MudTh>@L["Table_DueDate"]</MudTh>
                        <MudTh>@L["Table_DaysOverdue"]</MudTh>
                        <MudTh>@L["Label_Total"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["Table_Number"].Value">
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">@context.DocumentNumber</MudChip>
                        </MudTd>
                        <MudTd DataLabel="@L["Invoice_Client"].Value">@context.ClientName</MudTd>
                        <MudTd DataLabel="@L["Table_DueDate"].Value">@context.DueDate?.ToShortDateString()</MudTd>
                        <MudTd DataLabel="@L["Table_DaysOverdue"].Value">
                            <MudText Color="Color.Error">@(context.DueDate.HasValue ? (DateTime.Now - context.DueDate.Value).Days : 0) @L["Dashboard_Days"]</MudText>
                        </MudTd>
                        <MudTd DataLabel="@L["Label_Total"].Value">
                            <strong>@context.TotalWithVat.ToString("N2") @context.CurrencyCode</strong>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    }

    @* Recent invoices table - last 5 invoices for quick overview *@
    <MudGrid Class="mt-6">
        <MudItem xs="12">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Dashboard_RecentInvoices"]</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/invoices">@L["Btn_ViewAll"]</MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    @if (_dashboard.RecentInvoices.Any())
                    {
                        @* Row click navigates to the invoice detail page *@
                        <MudTable T="InvoiceDto" Items="@_dashboard.RecentInvoices" Dense="true" Hover="true" Striped="true"
                                  OnRowClick="@(args => { if (args.Item != null) Navigation.NavigateTo($"/invoices/{args.Item.Id}"); })"
                                  RowClass="cursor-pointer">
                            <HeaderContent>
                                <MudTh>@L["Table_Number"]</MudTh>
                                <MudTh>@L["Invoice_Client"]</MudTh>
                                <MudTh>@L["Table_IssueDate"]</MudTh>
                                <MudTh>@L["Table_DueDate"]</MudTh>
                                <MudTh>@L["Label_Total"]</MudTh>
                                <MudTh>@L["Label_Status"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@L["Table_Number"].Value">
                                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Description">
                                        @context.DocumentNumber
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="@L["Invoice_Client"].Value">@context.ClientName</MudTd>
                                <MudTd DataLabel="@L["Table_IssueDate"].Value">@context.IssueDate?.ToShortDateString()</MudTd>
                                <MudTd DataLabel="@L["Table_DueDate"].Value">@context.DueDate?.ToShortDateString()</MudTd>
                                <MudTd DataLabel="@L["Label_Total"].Value">
                                    <strong>@context.TotalWithVat.ToString("N2") @context.CurrencyCode</strong>
                                </MudTd>
                                <MudTd DataLabel="@L["Label_Status"].Value">
                                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                                        @GetStatusText(context.Status)
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudText Color="Color.Secondary">@L["Dashboard_NoInvoicesYet"] <MudLink Href="/invoices" Color="Color.Primary">@L["Dashboard_CreateFirst"]</MudLink></MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* ── Reminder (Dunning) Dashboard Widget ─────────────────────────────── *@
    @if (_reminderDashboard != null && (_reminderDashboard.OverdueInvoiceCount > 0 || _reminderDashboard.SentCount > 0 || _reminderDashboard.DraftCount > 0))
    {
        <MudGrid Class="mt-6">
            <MudItem xs="12">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Class="mr-1" Size="Size.Small" />
                                @L["Dashboard_Reminders"]
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ArrowForward"
                                       OnClick="@(() => Navigation.NavigateTo("/reminders"))">
                                @L["Common_ViewAll"]
                            </MudButton>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        @* KPI chips — quick overview of reminder status *@
                        <div class="d-flex flex-wrap gap-3 mb-4">
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Schedule">
                                @_reminderDashboard.DraftCount @L["Dashboard_DraftReminders"]
                            </MudChip>
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Send">
                                @_reminderDashboard.SentCount @L["Dashboard_SentReminders"]
                            </MudChip>
                            @if (_reminderDashboard.FailedCount > 0)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Error">
                                    @_reminderDashboard.FailedCount @L["Dashboard_FailedReminders"]
                                </MudChip>
                            }
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.TrendingUp">
                                @_reminderDashboard.RemindersLast30Days @L["Dashboard_RemindersLast30Days"]
                            </MudChip>
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">
                                @_reminderDashboard.OverdueInvoiceCount @L["Dashboard_OverdueInvoices"]
                                (@_reminderDashboard.TotalOverdueAmount.ToString("N2") CZK)
                            </MudChip>
                        </div>

                        @* Recent reminders table *@
                        @if (_reminderDashboard.RecentReminders.Any())
                        {
                            <MudTable T="ReminderDto" Items="@_reminderDashboard.RecentReminders"
                                      Dense="true" Hover="true" Striped="true"
                                      OnRowClick="@(args => { if (args.Item != null) Navigation.NavigateTo("/reminders"); })"
                                      RowClass="cursor-pointer">
                                <HeaderContent>
                                    <MudTh>@L["Reminder_Date"]</MudTh>
                                    <MudTh>@L["Reminder_Invoice"]</MudTh>
                                    <MudTh>@L["Reminder_Client"]</MudTh>
                                    <MudTh>@L["Reminder_Level"]</MudTh>
                                    <MudTh>@L["Reminder_Total"]</MudTh>
                                    <MudTh>@L["Reminder_Status"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.ReminderDate.ToShortDateString()</MudTd>
                                    <MudTd>@context.InvoiceNumber</MudTd>
                                    <MudTd>@context.ClientName</MudTd>
                                    <MudTd>@context.Level</MudTd>
                                    <MudTd><strong>@context.TotalCzk.ToString("N2") CZK</strong></MudTd>
                                    <MudTd>
                                        <MudChip T="string" Size="Size.Small" Color="@GetReminderStatusColor(context.Status)">
                                            @L[$"EReminderStatus_{context.Status}"]
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    @* Quick start guide for new users *@
    <MudGrid Class="mt-6">
        <MudItem xs="12">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Dashboard_QuickStart"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Start">
                        @* VAT rates onboarding step intentionally removed — VAT rates are a system code table,
                           not a per-user setup step, so they no longer belong in the Quick Start guide. *@
                        <MudTimelineItem Color="Color.Info" Size="Size.Small">
                            <ItemContent>
                                <MudText Typo="Typo.h6" GutterBottom="true">@L["Dashboard_ManageClients"]</MudText>
                                <MudText>@L["Dashboard_ManageClientsDesc"] <MudLink Href="/clients" Color="Color.Primary">@L["Nav_Clients"]</MudLink></MudText>
                            </ItemContent>
                        </MudTimelineItem>
                        <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                            <ItemContent>
                                <MudText Typo="Typo.h6" GutterBottom="true">@L["Dashboard_CreateInvoices"]</MudText>
                                <MudText>@L["Dashboard_CreateInvoicesDesc"] <MudLink Href="/invoices" Color="Color.Primary">@L["Nav_Invoices"]</MudLink></MudText>
                            </ItemContent>
                        </MudTimelineItem>
                    </MudTimeline>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    // Dashboard data loaded from the API
    private DashboardDto _dashboard = new();
    private SysAdminDashboardDto? _sysAdminDashboard;
    private InsuranceAdvanceDto? _insuranceAdvance;
    private ReminderDashboardDto? _reminderDashboard;
    private bool _loading = true;
    private bool _isSysAdmin = false;
    private bool _isImpersonating = false;

    // Chart options — shared config for all donut charts on the dashboard
    private ChartOptions _chartOptions = new()
    {
        ChartPalette = new[] { "#1976D2", "#388E3C", "#F57C00", "#D32F2F", "#7B1FA2", "#0097A7", "#FBC02D", "#5D4037", "#455A64", "#C2185B" }
    };

    /// <summary>
    /// Loads dashboard data when the page initializes.
    /// Detects if the user is SysAdmin (without impersonation) to show the admin dashboard.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _loading = true;

            // Check if the current user is SysAdmin and whether they're impersonating
            var customAuth = AuthStateProvider as CustomAuthenticationStateProvider;
            if (customAuth != null)
            {
                var session = await customAuth.GetUserSessionAsync();
                if (session != null && session.Role == 2) // SysAdmin role = 2
                {
                    _isSysAdmin = true;
                    var impersonatedId = await customAuth.GetImpersonatedCompanyIdAsync();
                    _isImpersonating = impersonatedId.HasValue;
                }
            }

            if (_isSysAdmin && !_isImpersonating)
            {
                // SysAdmin without impersonation → load system-wide dashboard
                _sysAdminDashboard = await DashboardService.GetSysAdminDashboardAsync();
            }
            else
            {
                // Regular user or impersonating SysAdmin → load tenant dashboard
                _dashboard = await DashboardService.GetDashboardAsync();

                // Load insurance advance notification (non-blocking — null if not configured)
                try
                {
                    _insuranceAdvance = await TaxService.GetInsuranceAdvanceAsync();
                }
                catch
                {
                    // Ignore — insurance advance is optional
                }

                // Load reminder dashboard data (non-blocking — null if feature not configured)
                try
                {
                    _reminderDashboard = await ReminderService.GetDashboardDataAsync();
                }
                catch
                {
                    // Ignore — reminders may not be configured yet
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ─── Chart Data Helpers ──────────────────────────────────────────────────

    /// <summary>
    /// Converts the InvoiceCountByStatus dictionary to double[] for MudChart InputData.
    /// MudChart requires double[] for chart values.
    /// </summary>
    private double[] GetStatusChartData() =>
        _dashboard.InvoiceCountByStatus.Values.Select(v => (double)v).ToArray();

    /// <summary>
    /// Converts the InvoiceCountByStatus dictionary to localized string[] for MudChart InputLabels.
    /// Uses the same localized status names as the rest of the UI for consistency.
    /// </summary>
    private string[] GetStatusChartLabels() =>
        _dashboard.InvoiceCountByStatus.Select(kvp =>
        {
            // Try to parse the status string back to enum for localization
            if (Enum.TryParse<EInvoiceStatus>(kvp.Key, out var status))
            {
                return $"{GetStatusText(status)} ({kvp.Value})";
            }
            return $"{kvp.Key} ({kvp.Value})";
        }).ToArray();

    /// <summary>
    /// Converts the InvoiceTotalByClient dictionary to double[] for MudChart InputData.
    /// </summary>
    private double[] GetClientRevenueChartData() =>
        _dashboard.InvoiceTotalByClient.Values.Select(v => (double)v).ToArray();

    /// <summary>
    /// Converts the InvoiceTotalByClient dictionary to string[] for MudChart InputLabels.
    /// Shows client name with amount for clarity in the legend.
    /// </summary>
    private string[] GetClientRevenueChartLabels() =>
        _dashboard.InvoiceTotalByClient.Select(kvp =>
            $"{kvp.Key} ({kvp.Value:N0})").ToArray();

    /// <summary>
    /// Returns the MudBlazor color for each invoice status.
    /// </summary>
    private Color GetStatusColor(EInvoiceStatus status)
    {
        return status switch
        {
            EInvoiceStatus.Draft => Color.Default,
            EInvoiceStatus.Completed => Color.Info,
            EInvoiceStatus.Paid => Color.Success,
            EInvoiceStatus.Creditnoted => Color.Warning,
            EInvoiceStatus.Deleted => Color.Dark,
            _ => Color.Default
        };
    }

    /// <summary>
    /// Returns the localized display text for each invoice status.
    /// </summary>
    private string GetStatusText(EInvoiceStatus status)
    {
        return status switch
        {
            EInvoiceStatus.Draft => L["Invoice_StatusDraft"].Value,
            EInvoiceStatus.Completed => L["Invoice_StatusIssued"].Value,
            EInvoiceStatus.Paid => L["Invoice_StatusPaid"].Value,
            EInvoiceStatus.Creditnoted => L["Invoice_StatusCancelled"].Value,
            EInvoiceStatus.Deleted => L["Invoice_StatusCancelled"].Value,
            _ => status.ToString()
        };
    }

    /// <summary>
    /// Returns MudBlazor color for log level chips.
    /// </summary>
    private static Color GetLogLevelColor(string level) => level switch
    {
        "Critical" => Color.Dark,
        "Error" => Color.Error,
        "Warning" => Color.Warning,
        "Information" => Color.Info,
        _ => Color.Default
    };

    /// <summary>
    /// Returns MudBlazor color for reminder status chips.
    /// Draft=Default, Sent=Success, Failed=Error, Cancelled=Warning.
    /// </summary>
    private static Color GetReminderStatusColor(EReminderStatus status) => status switch
    {
        EReminderStatus.Draft => Color.Default,
        EReminderStatus.Sent => Color.Success,
        EReminderStatus.Failed => Color.Error,
        EReminderStatus.Cancelled => Color.Warning,
        _ => Color.Default
    };

    /// <summary>
    /// Shortens logger category name for display (last 2 segments).
    /// </summary>
    private static string GetShortSource(string source)
    {
        var parts = source.Split('.');
        return parts.Length > 2 ? string.Join('.', parts[^2..]) : source;
    }
}
