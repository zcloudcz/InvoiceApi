@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Fakvio.Contracts.Dto.Alert
@using Fakvio.Contracts.Dto.AppLog
@using Fakvio.Contracts.Dto.Dashboard
@using Fakvio.Contracts.Dto.Invoice
@using Fakvio.Domain.Enums
@using Fakvio.Contracts.Dto.Tax
@using Fakvio.Contracts.Dto.Reminder
@using Fakvio.Contracts.Dto.User
@using Fakvio.UI.Shared.Models
@using Fakvio.UI.Shared.Components.Dashboard
@using Fakvio.UI.Shared.Services
@inject DashboardApiService DashboardService
@inject TaxApiService TaxService
@inject ReminderApiService ReminderService
@inject PaymentMatchingApiService PaymentApi
@inject AlertApiService AlertService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ReadinessApiService ReadinessService
@inject UserPreferencesApiService PreferencesService
@inject UserPreferencesState PreferencesState
@* Localization service for multi-language support *@
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Dashboard_Title"] - Fakvio</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">@L["Dashboard_Title"]</MudText>
<MudText Class="mb-8">@L["Dashboard_Welcome"]</MudText>

@* Loading indicator while dashboard data is being fetched *@
@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (_isSysAdmin && !_isImpersonating)
{
    @* ════════════════════════════════════════════════════════════════════
       SysAdmin Dashboard — shown when SysAdmin is NOT impersonating a company.
       Shows system-wide statistics: company counts, provisioning status, recent logs.
       ════════════════════════════════════════════════════════════════════ *@

    @if (_sysAdminDashboard != null)
    {
        @* Company statistics — 4 KPI cards (clickable → navigates to /companies) *@
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="rounded-lg cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/companies"))">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" Size="Size.Large" />
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@L["Dashboard_SysAdminTotal"]</MudChip>
                        </div>
                        <MudText Typo="Typo.h5" GutterBottom="true">@_sysAdminDashboard.TotalCompanies</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard_SysAdminCompanies"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="rounded-lg cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/companies"))">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Success" Size="Size.Large" />
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">@L["TenantSettings_Provisioned"]</MudChip>
                        </div>
                        <MudText Typo="Typo.h5" GutterBottom="true">@_sysAdminDashboard.ProvisionedCompanies</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard_SysAdminProvisioned"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="rounded-lg cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/companies"))">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Info" Size="Size.Large" />
                            <MudChip T="string" Color="Color.Info" Size="Size.Small">@L["Label_Active"]</MudChip>
                        </div>
                        <MudText Typo="Typo.h5" GutterBottom="true">@_sysAdminDashboard.ActiveCompanies</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard_SysAdminActive"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="rounded-lg cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/companies"))">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Color="Color.Warning" Size="Size.Large" />
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">@L["Dashboard_Pending"]</MudChip>
                        </div>
                        <MudText Typo="Typo.h5" GutterBottom="true">@_sysAdminDashboard.PendingCompanies</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dashboard_SysAdminPending"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @* Recent Warning/Error logs table *@
        @if (_sysAdminDashboard.RecentLogs.Count > 0)
        {
            <MudCard Elevation="2" Class="mt-6">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Dashboard_SysAdminRecentLogs"]</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/logs">@L["Btn_ViewAll"]</MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="_sysAdminDashboard.RecentLogs" Dense="true" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>@L["Log_Timestamp"]</MudTh>
                            <MudTh>@L["Log_Level"]</MudTh>
                            <MudTh>@L["Log_Source"]</MudTh>
                            <MudTh>@L["Log_Message"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@L["Log_Timestamp"].Value">
                                <MudText Typo="Typo.body2">@context.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                            </MudTd>
                            <MudTd DataLabel="@L["Log_Level"].Value">
                                <MudChip T="string" Size="Size.Small" Color="@GetLogLevelColor(context.Level)">
                                    @context.Level
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="@L["Log_Source"].Value">
                                <MudText Typo="Typo.body2" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis;">
                                    @GetShortSource(context.Source)
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="@L["Log_Message"].Value">
                                <MudText Typo="Typo.body2" Style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @context.Message
                                </MudText>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        }

        @* Log summary by level *@
        @if (_sysAdminDashboard.LogCountByLevel.Count > 0)
        {
            <MudGrid Class="mt-6">
                <MudItem xs="12">
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@L["Dashboard_SysAdminLogSummary"]</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <div class="d-flex flex-wrap gap-4">
                                @foreach (var entry in _sysAdminDashboard.LogCountByLevel.OrderByDescending(e => e.Key))
                                {
                                    <MudChip T="string" Size="Size.Medium" Color="@GetLogLevelColor(entry.Key)">
                                        @entry.Key: @entry.Value
                                    </MudChip>
                                }
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        }
    }
}
else
{
    @* Setup checklist (issue #210) — always on top, not a customizable widget: it is guidance,
       not data, and disappears by itself when the tenant is ready. *@
    <SetupChecklist />

    @* Modular dashboard: every block below is a widget from DashboardWidgetRegistry. The saved
       layout (visibility + order) is merged with the registry in _layout, so a widget added in a
       later release shows up for everybody without a migration. *@
    <div class="d-flex justify-end mb-2">
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Tune" OnClick="EditLayoutAsync">
            @L["Dashboard_EditLayout"]
        </MudButton>
    </div>

    <MudGrid>
        @foreach (var item in _layout.Where(l => l.Visible))
        {
            var def = DashboardWidgetRegistry.All.First(w => w.Id == item.Id);
            <MudItem xs="12" md="@def.Width" @key="item.Id">
                @switch (item.Id)
                {
                    case "kpis":
                        <KpiWidget Dashboard="_dashboard" UnmatchedPaymentsCount="_unmatchedPaymentsCount" AlertDashboard="_alertDashboard" />
                        break;
                    case "taxInsurance":
                        <InsuranceWidget Insurance="_insuranceAdvance" />
                        break;
                    case "revenueByMonth":
                        <RevenueByMonthWidget Dashboard="_dashboard" />
                        break;
                    case "incomeVsExpense":
                        <IncomeVsExpenseWidget Dashboard="_dashboard" />
                        break;
                    case "receivablesAging":
                        <ReceivablesAgingWidget Dashboard="_dashboard" />
                        break;
                    case "invoicesByStatus":
                        <InvoicesByStatusWidget Dashboard="_dashboard" />
                        break;
                    case "topClients":
                        <TopClientsWidget Dashboard="_dashboard" />
                        break;
                    case "overdue":
                        <OverdueWidget Dashboard="_dashboard" />
                        break;
                    case "recentInvoices":
                        <RecentInvoicesWidget Dashboard="_dashboard" />
                        break;
                    case "reminders":
                        <RemindersWidget Reminders="_reminderDashboard" />
                        break;
                }
            </MudItem>
        }
    </MudGrid>
}

@code {
    // Dashboard data loaded from the API
    private DashboardDto _dashboard = new();
    private SysAdminDashboardDto? _sysAdminDashboard;
    private InsuranceAdvanceDto? _insuranceAdvance;
    private ReminderDashboardDto? _reminderDashboard;
    private bool _loading = true;
    private bool _isSysAdmin = false;
    private bool _isImpersonating = false;

    // Count of bank transactions awaiting attention. Hidden tile when zero.
    private int _unmatchedPaymentsCount;

    // Alert dashboard data — null while loading or when the API returns an error.
    private AlertDashboardDto? _alertDashboard;

    // Widget layout for this user: registry merged with saved preferences (see DashboardLayoutMerger).
    private List<DashboardWidgetLayoutItemDto> _layout = DashboardLayoutMerger.Merge(DashboardWidgetRegistry.All, null);

    /// <summary>
    /// Loads dashboard data when the page initializes.
    /// Detects if the user is SysAdmin (without impersonation) to show the admin dashboard.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _loading = true;

            // Check if the current user is SysAdmin and whether they're impersonating
            var customAuth = AuthStateProvider as CustomAuthenticationStateProvider;
            if (customAuth != null)
            {
                var session = await customAuth.GetUserSessionAsync();
                if (session != null && session.Role == 2) // SysAdmin role = 2
                {
                    _isSysAdmin = true;
                    var impersonatedId = await customAuth.GetImpersonatedCompanyIdAsync();
                    _isImpersonating = impersonatedId.HasValue;
                }
            }

            if (_isSysAdmin && !_isImpersonating)
            {
                // SysAdmin without impersonation → load system-wide dashboard
                _sysAdminDashboard = await DashboardService.GetSysAdminDashboardAsync();
            }
            else
            {
                // Preferences are cached per session; a failure falls back to defaults (never breaks the page).
                var preferences = await PreferencesState.EnsureLoadedAsync();
                _layout = DashboardLayoutMerger.Merge(DashboardWidgetRegistry.All, preferences.DashboardLayout);

                // First-run onboarding: offer the setup wizard once per session (not for an
                // impersonating SysAdmin — the preferences belong to the real user).
                if (!_isSysAdmin && await ShouldOfferSetupWizardAsync(preferences))
                {
                    Navigation.NavigateTo("/setup");
                    return;
                }

                // Regular user or impersonating SysAdmin → load tenant dashboard
                _dashboard = await DashboardService.GetDashboardAsync();

                // Load insurance advance notification (non-blocking — null if not configured)
                try
                {
                    _insuranceAdvance = await TaxService.GetInsuranceAdvanceAsync();
                }
                catch
                {
                    // Ignore — insurance advance is optional
                }

                // Load reminder dashboard data (non-blocking — null if feature not configured)
                try
                {
                    _reminderDashboard = await ReminderService.GetDashboardDataAsync();
                }
                catch
                {
                    // Ignore — reminders may not be configured yet
                }

                // Unmatched payment count (non-blocking — feature is opt-in per company).
                try
                {
                    _unmatchedPaymentsCount = await PaymentApi.GetUnmatchedCountAsync();
                }
                catch
                {
                    // Ignore — payment matching may not be configured yet.
                }

                // Alert dashboard data (non-blocking — tile is hidden when null).
                try
                {
                    _alertDashboard = await AlertService.GetDashboardAsync();
                }
                catch
                {
                    // Ignore — alerts feature may not be provisioned yet.
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// True once per session when the issuer/bank setup is incomplete and the user has not
    /// dismissed the wizard. The readiness call is decoration — any failure means "no redirect".
    /// </summary>
    private async Task<bool> ShouldOfferSetupWizardAsync(UserPreferencesDto preferences)
    {
        if (PreferencesState.SetupWizardRedirectHandled)
            return false;
        PreferencesState.SetupWizardRedirectHandled = true;

        try
        {
            var report = await ReadinessService.GetReportAsync();
            return SetupWizardPolicy.ShouldRedirect(report, preferences);
        }
        catch
        {
            return false;
        }
    }

    /// <summary>Opens the "Upravit nástěnku" dialog and persists the chosen layout.</summary>
    private async Task EditLayoutAsync()
    {
        var parameters = new DialogParameters<EditDashboardLayoutDialog> { { x => x.Layout, _layout } };
        var dialog = await DialogService.ShowAsync<EditDashboardLayoutDialog>(
            L["Dashboard_EditLayout"].Value, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not List<DashboardWidgetLayoutItemDto> chosen)
            return;

        try
        {
            var current = await PreferencesState.EnsureLoadedAsync();
            var saved = await PreferencesService.UpdateAsync(new UserPreferencesDto
            {
                DefaultGridPageSize = current.DefaultGridPageSize,
                SetupWizardDismissedAt = current.SetupWizardDismissedAt,
                DashboardLayout = chosen
            });
            if (saved is not null)
                PreferencesState.Set(saved);
            _layout = DashboardLayoutMerger.Merge(DashboardWidgetRegistry.All, chosen);
            Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Returns MudBlazor color for log level chips.
    /// </summary>
    private static Color GetLogLevelColor(string level) => level switch
    {
        "Critical" => Color.Dark,
        "Error" => Color.Error,
        "Warning" => Color.Warning,
        "Information" => Color.Info,
        _ => Color.Default
    };

    /// <summary>
    /// Shortens logger category name for display (last 2 segments).
    /// </summary>
    private static string GetShortSource(string source)
    {
        var parts = source.Split('.');
        return parts.Length > 2 ? string.Join('.', parts[^2..]) : source;
    }
}
