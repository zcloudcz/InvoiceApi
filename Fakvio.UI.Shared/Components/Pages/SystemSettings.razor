@page "/system-settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SysAdmin")]
@using Fakvio.Contracts.Dto.SystemConfiguration
@inject SystemConfigurationApiService ConfigService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@inject ILogger<SystemSettings> _logger

<PageTitle>@L["SystemSettings_Title"] - Fakvio</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">@L["SystemSettings_Title"]</MudText>
<MudText Class="mb-6" Color="Color.Secondary">@L["SystemSettings_Subtitle"]</MudText>

@* Credential health warning banner — shown when encrypted credentials cannot be decrypted
   (e.g. after Data Protection key loss on restart, see issue #109).
   Loaded once on page init and cached — does NOT refresh on every navigation. *@
@if (_credentialHealth?.Healthy == false)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Icon="@Icons.Material.Filled.LockOpen">
        <MudText Typo="Typo.subtitle1"><strong>@L["CredentialHealth_Warning"]</strong></MudText>
        <MudText Class="mb-2">@L["CredentialHealth_Description"]</MudText>
        <MudList T="string" Dense="true">
            @foreach (var issue in _credentialHealth.Issues)
            {
                <MudListItem T="string" Icon="@Icons.Material.Filled.Warning">
                    @GetEntityLabel(issue.Entity)
                    @if (issue.CompanyId.HasValue)
                    {
                        <text> (@L["CredentialHealth_CompanyId"] @issue.CompanyId)</text>
                    }
                    <text> — @GetFieldLabel(issue.Field)</text>
                </MudListItem>
            }
        </MudList>
        <div class="d-flex gap-2 mt-2">
            <MudButton Variant="Variant.Text" Color="Color.Warning" Href="/system-settings">
                @L["CredentialHealth_GoToSystemSettings"]
            </MudButton>
            @if (_credentialHealth.Issues.Any(i => i.Entity == "CompanySystemSettings"))
            {
                <MudButton Variant="Variant.Text" Color="Color.Warning" Href="/companies">
                    @L["CredentialHealth_GoToCompanySettings"]
                </MudButton>
            }
            @if (_credentialHealth.Issues.Any(i => i.Entity == "PaymentMatchingSystemSettings"))
            {
                <MudButton Variant="Variant.Text" Color="Color.Warning" Href="/sysadmin/payment-matching">
                    @L["CredentialHealth_GoToPaymentSettings"]
                </MudButton>
            }
        </div>
    </MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    @* Header with Edit/Save/Cancel buttons *@
    <div class="d-flex flex-wrap align-center gap-2 mb-4">
        <MudSpacer />
        @if (!_isEditing)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit" OnClick="EnableEditing">
                @L["Btn_Edit"]
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="CancelEditing" Disabled="_saving">
                @L["Btn_Cancel"]
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSettings" Disabled="_saving">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @L["Btn_Save"]
            </MudButton>
        }
    </div>

    <MudGrid>
        @* Card 0: Application Settings (AppName, BlazorBaseUrl) *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
                            @L["SystemSettings_AppTitle"]
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isEditing)
                    {
                        <MudTextField @bind-Value="_editDto.AppName"
                                      Label="@L["SystemSettings_AppName"].Value"
                                      Placeholder="Fakvio" Class="mb-3"
                                      HelperText="@L["SystemSettings_AppNameHint"].Value" />
                        <MudTextField @bind-Value="_editDto.BlazorBaseUrl"
                                      Label="@L["SystemSettings_BlazorBaseUrl"].Value"
                                      Placeholder="https://app.fakvio.cz" Class="mb-3"
                                      HelperText="@L["SystemSettings_BlazorBaseUrlHint"].Value" />
                    }
                    else
                    {
                        <MudList T="string" Dense="true">
                            <MudListItem T="string">
                                <strong>@L["SystemSettings_AppName"]:</strong>
                                @(_config?.AppName ?? "Fakvio")
                            </MudListItem>
                            <MudListItem T="string">
                                <strong>@L["SystemSettings_BlazorBaseUrl"]:</strong>
                                @(string.IsNullOrEmpty(_config?.BlazorBaseUrl) ? "—" : _config.BlazorBaseUrl)
                            </MudListItem>
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Card 1: SMTP Settings *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Email" Class="mr-2" />
                            @L["SystemSettings_SmtpTitle"]
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isEditing)
                    {
                        <MudTextField @bind-Value="_editDto.SmtpHost"
                                      Label="@L["SystemSettings_SmtpHost"].Value"
                                      Placeholder="smtp.gmail.com" Class="mb-3" />
                        <MudNumericField @bind-Value="_editDto.SmtpPort"
                                         Label="@L["SystemSettings_SmtpPort"].Value"
                                         Min="1" Max="65535" Class="mb-3" />
                        <MudTextField @bind-Value="_editDto.SmtpUsername"
                                      Label="@L["SystemSettings_SmtpUsername"].Value" Class="mb-3" />
                        <MudTextField @bind-Value="_editDto.SmtpPassword"
                                      Label="@L["SystemSettings_SmtpPassword"].Value"
                                      InputType="InputType.Password" Class="mb-3"
                                      Placeholder="@(_config?.HasSmtpPassword == true ? L["SystemSettings_SmtpPasswordUnchanged"].Value : "")"
                                      HelperText="@L["SystemSettings_SmtpPasswordHint"].Value" />
                        <MudTextField @bind-Value="_editDto.SmtpSenderEmail"
                                      Label="@L["SystemSettings_SmtpSenderEmail"].Value"
                                      InputType="InputType.Email" Class="mb-3" />
                        <MudTextField @bind-Value="_editDto.SmtpSenderName"
                                      Label="@L["SystemSettings_SmtpSenderName"].Value" Class="mb-3" />
                        <MudSwitch @bind-Value="_editDto.SmtpUseSsl"
                                   Label="@L["SystemSettings_SmtpUseSsl"].Value"
                                   Color="Color.Primary" />
                    }
                    else
                    {
                        <MudList T="string" Dense="true">
                            <MudListItem T="string">
                                <strong>@L["SystemSettings_SmtpHost"]:</strong>
                                @(string.IsNullOrEmpty(_config?.SmtpHost) ? "—" : _config.SmtpHost)
                            </MudListItem>
                            <MudListItem T="string">
                                <strong>@L["SystemSettings_SmtpPort"]:</strong> @_config?.SmtpPort
                            </MudListItem>
                            <MudListItem T="string">
                                <strong>@L["SystemSettings_SmtpUsername"]:</strong>
                                @(string.IsNullOrEmpty(_config?.SmtpUsername) ? "—" : _config.SmtpUsername)
                            </MudListItem>
                            <MudListItem T="string">
                                <strong>@L["SystemSettings_SmtpPassword"]:</strong>
                                @(_config?.HasSmtpPassword == true ? "••••••••" : "—")
                            </MudListItem>
                            <MudListItem T="string">
                                <strong>@L["SystemSettings_SmtpSenderEmail"]:</strong>
                                @(string.IsNullOrEmpty(_config?.SmtpSenderEmail) ? "—" : _config.SmtpSenderEmail)
                            </MudListItem>
                            <MudListItem T="string">
                                <strong>@L["SystemSettings_SmtpSenderName"]:</strong>
                                @(_config?.SmtpSenderName ?? "—")
                            </MudListItem>
                            <MudListItem T="string">
                                <strong>@L["SystemSettings_SmtpUseSsl"]:</strong>
                                @if (_config?.SmtpUseSsl == true)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" />
                                }
                            </MudListItem>
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Card 2: JWT Settings *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Security" Class="mr-2" />
                            @L["SystemSettings_JwtTitle"]
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isEditing)
                    {
                        <MudNumericField @bind-Value="_editDto.JwtExpirationHours"
                                         Label="@L["SystemSettings_JwtExpiration"].Value"
                                         Min="1" Max="720"
                                         HelperText="@L["SystemSettings_JwtExpirationHint"].Value" />
                    }
                    else
                    {
                        <MudList T="string" Dense="true">
                            <MudListItem T="string">
                                <strong>@L["SystemSettings_JwtExpiration"]:</strong>
                                @(_config?.JwtExpirationHours ?? 24) @L["SystemSettings_Hours"]
                            </MudListItem>
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Card 3: AI Settings — system-wide default provider + API keys *@
        <MudItem xs="12">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.SmartToy" Class="mr-2" />
                            @L["SystemSettings_AiTitle"]
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isEditing)
                    {
                        <MudSelect @bind-Value="_editDto.AiDefaultProvider"
                                   Label="@L["SystemSettings_AiDefaultProvider"].Value"
                                   Clearable="true" Class="mb-4">
                            <MudSelectItem Value="@("Claude")">Claude (Anthropic)</MudSelectItem>
                            <MudSelectItem Value="@("OpenAI")">OpenAI</MudSelectItem>
                            <MudSelectItem Value="@("Gemini")">Gemini (Google)</MudSelectItem>
                            <MudSelectItem Value="@("Ollama")">Ollama (Local)</MudSelectItem>
                        </MudSelect>

                        <MudGrid>
                            @* Claude *@
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Claude (Anthropic)</MudText>
                                <MudTextField @bind-Value="_editDto.AiClaudeApiKey"
                                              Label="API Key" InputType="InputType.Password" Class="mb-2"
                                              Placeholder="@(_config?.HasAiClaudeApiKey == true ? L["SystemSettings_SmtpPasswordUnchanged"].Value : "")" />
                                <MudTextField @bind-Value="_editDto.AiClaudeModel"
                                              Label="Model" Placeholder="claude-sonnet-4-6" />
                            </MudItem>

                            @* OpenAI *@
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">OpenAI</MudText>
                                <MudTextField @bind-Value="_editDto.AiOpenAiApiKey"
                                              Label="API Key" InputType="InputType.Password" Class="mb-2"
                                              Placeholder="@(_config?.HasAiOpenAiApiKey == true ? L["SystemSettings_SmtpPasswordUnchanged"].Value : "")" />
                                <MudTextField @bind-Value="_editDto.AiOpenAiModel"
                                              Label="Model" Placeholder="gpt-4o" />
                            </MudItem>

                            @* Gemini *@
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Gemini (Google)</MudText>
                                <MudTextField @bind-Value="_editDto.AiGeminiApiKey"
                                              Label="API Key" InputType="InputType.Password" Class="mb-2"
                                              Placeholder="@(_config?.HasAiGeminiApiKey == true ? L["SystemSettings_SmtpPasswordUnchanged"].Value : "")" />
                                <MudTextField @bind-Value="_editDto.AiGeminiModel"
                                              Label="Model" Placeholder="gemini-2.0-flash" />
                            </MudItem>

                            @* Ollama *@
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Ollama (Local)</MudText>
                                <MudTextField @bind-Value="_editDto.AiOllamaBaseUrl"
                                              Label="Base URL" Placeholder="http://localhost:11434" Class="mb-2" />
                                <MudTextField @bind-Value="_editDto.AiOllamaModel"
                                              Label="Model" Placeholder="gemma3:12b" />
                            </MudItem>
                        </MudGrid>
                    }
                    else
                    {
                        <MudList T="string" Dense="true">
                            <MudListItem T="string">
                                <strong>@L["SystemSettings_AiDefaultProvider"]:</strong>
                                @(string.IsNullOrEmpty(_config?.AiDefaultProvider) ? "—" : _config.AiDefaultProvider)
                            </MudListItem>
                            <MudListItem T="string">
                                <strong>Claude API Key:</strong>
                                @(_config?.HasAiClaudeApiKey == true ? "••••••••" : "—")
                                @if (!string.IsNullOrEmpty(_config?.AiClaudeModel))
                                { <text> (@_config.AiClaudeModel)</text> }
                            </MudListItem>
                            <MudListItem T="string">
                                <strong>OpenAI API Key:</strong>
                                @(_config?.HasAiOpenAiApiKey == true ? "••••••••" : "—")
                                @if (!string.IsNullOrEmpty(_config?.AiOpenAiModel))
                                { <text> (@_config.AiOpenAiModel)</text> }
                            </MudListItem>
                            <MudListItem T="string">
                                <strong>Gemini API Key:</strong>
                                @(_config?.HasAiGeminiApiKey == true ? "••••••••" : "—")
                                @if (!string.IsNullOrEmpty(_config?.AiGeminiModel))
                                { <text> (@_config.AiGeminiModel)</text> }
                            </MudListItem>
                            <MudListItem T="string">
                                <strong>Ollama:</strong>
                                @(string.IsNullOrEmpty(_config?.AiOllamaBaseUrl) ? "—" : $"{_config.AiOllamaBaseUrl}")
                                @if (!string.IsNullOrEmpty(_config?.AiOllamaModel))
                                { <text> (@_config.AiOllamaModel)</text> }
                            </MudListItem>
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
        @* Card 4: Azure Blob Storage Settings *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Cloud" Class="mr-1" />
                            @L["Settings_AzureBlobStorage"]
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isEditing)
                    {
                        <MudTextField @bind-Value="_editDto.AzureBlobConnectionString"
                                      Label="@L["Settings_AzureBlobConnectionString"].Value"
                                      InputType="InputType.Password"
                                      Class="mb-3" />
                        <MudTextField @bind-Value="_editDto.AzureBlobContainerName"
                                      Label="@L["Settings_AzureBlobContainerName"].Value"
                                      HelperText="@L["Settings_AzureBlobContainerNameHelper"].Value"
                                      Placeholder="fakvio-files" />
                    }
                    else
                    {
                        <MudList T="string" Dense="true">
                            <MudListItem>
                                <strong>@L["Settings_AzureBlobConnectionString"]:</strong>
                                @(_config?.HasAzureBlobConnectionString == true ? "********" : "—")
                            </MudListItem>
                            <MudListItem>
                                <strong>@L["Settings_AzureBlobContainerName"]:</strong>
                                @(string.IsNullOrEmpty(_config?.AzureBlobContainerName) ? "fakvio-files (default)" : _config.AzureBlobContainerName)
                            </MudListItem>
                        </MudList>
                    }
                </MudCardContent>
                <MudCardActions>
                    @* Test Connection button — always visible (not just in edit mode) so SysAdmin
                       can verify the saved connection string at any time without switching to edit mode. *@
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.NetworkCheck"
                               OnClick="TestBlobConnectionAsync"
                               Disabled="_testingBlobConnection">
                        @if (_testingBlobConnection)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        @L["AzureBlob_TestConnection"]
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* Full-page overlay during save *@
    <MudOverlay Visible="_saving" DarkBackground="true" Absolute="false" ZIndex="9999">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </MudOverlay>
}

@code {
    private SystemConfigurationDto? _config;
    private UpdateSystemConfigurationDto _editDto = new();
    private bool _loading = true;
    private bool _isEditing = false;
    private bool _saving = false;
    /// <summary>True while the blob connection test is in progress — disables the button and shows spinner.</summary>
    private bool _testingBlobConnection = false;
    /// <summary>
    /// Credential health result — null until loaded, then cached for the lifetime of this page.
    /// We check once on page load and do not poll — the banner disappears when the user re-saves
    /// the affected field and navigates away and back.
    /// </summary>
    private CredentialHealthDto? _credentialHealth;

    protected override async Task OnInitializedAsync()
    {
        // Load config and credential health in parallel for faster page load.
        await Task.WhenAll(LoadConfig(), LoadCredentialHealth());
    }

    /// <summary>
    /// Loads the credential health report from the API.
    /// Silently ignores errors — a failed health check is non-critical.
    /// The banner simply stays hidden if the API call fails.
    /// </summary>
    private async Task LoadCredentialHealth()
    {
        try
        {
            _credentialHealth = await ConfigService.GetCredentialHealthAsync();
        }
        catch (Exception ex)
        {
            // Non-fatal — log and continue. The settings page remains usable.
            _logger.LogWarning(ex, "Failed to load credential health status");
        }
    }

    /// <summary>
    /// Returns a localized display name for a credential entity name.
    /// Falls back to the raw entity name when no localization key exists.
    /// </summary>
    private string GetEntityLabel(string entity) => entity switch
    {
        "SystemConfiguration" => L["CredentialHealth_Entity_SystemConfiguration"].Value,
        "CompanySystemSettings" => L["CredentialHealth_Entity_CompanySystemSettings"].Value,
        "PaymentMatchingSystemSettings" => L["CredentialHealth_Entity_PaymentMatchingSystemSettings"].Value,
        _ => entity
    };

    /// <summary>
    /// Returns a localized display name for an encrypted field name.
    /// Falls back to the raw field name when no localization key exists.
    /// </summary>
    private string GetFieldLabel(string field)
    {
        var key = $"CredentialHealth_Field_{field}";
        var localized = L[key];
        // If the localizer returns the key unchanged, no translation exists — use the raw name.
        return localized.ResourceNotFound ? field : localized.Value;
    }

    /// <summary>
    /// Loads the current system configuration from the API.
    /// </summary>
    private async Task LoadConfig()
    {
        try
        {
            _loading = true;
            _config = await ConfigService.GetAsync();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to load system configuration");
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Switches to edit mode — populates edit DTO from current config values.
    /// </summary>
    private void EnableEditing()
    {
        if (_config == null) return;

        _editDto = new UpdateSystemConfigurationDto
        {
            // Application settings
            AppName = _config.AppName,
            BlazorBaseUrl = _config.BlazorBaseUrl,
            // SMTP settings — SmtpPassword is null so it won't overwrite the existing
            // encrypted password. The user must explicitly type a new password to change it.
            // The server never sends the actual password — only HasSmtpPassword flag.
            SmtpHost = _config.SmtpHost,
            SmtpPort = _config.SmtpPort,
            SmtpUsername = _config.SmtpUsername,
            SmtpPassword = null,
            SmtpSenderEmail = _config.SmtpSenderEmail,
            SmtpSenderName = _config.SmtpSenderName,
            SmtpUseSsl = _config.SmtpUseSsl,
            // JWT settings
            JwtExpirationHours = _config.JwtExpirationHours,
            // AI settings — API keys are null (keep existing), models are pre-filled
            AiDefaultProvider = _config.AiDefaultProvider,
            AiClaudeApiKey = null,
            AiClaudeModel = _config.AiClaudeModel,
            AiOpenAiApiKey = null,
            AiOpenAiModel = _config.AiOpenAiModel,
            AiGeminiApiKey = null,
            AiGeminiModel = _config.AiGeminiModel,
            AiOllamaBaseUrl = _config.AiOllamaBaseUrl,
            AiOllamaModel = _config.AiOllamaModel,
            // Azure Blob Storage — connection string null (keep existing), container name pre-filled
            AzureBlobConnectionString = null,
            AzureBlobContainerPrefix = _config.AzureBlobContainerPrefix,
            AzureBlobContainerName = _config.AzureBlobContainerName
        };
        _isEditing = true;
    }

    /// <summary>
    /// Cancels editing — resets to view mode without saving.
    /// </summary>
    private void CancelEditing()
    {
        _isEditing = false;
    }

    /// <summary>
    /// Tests the Azure Blob Storage connection using the currently saved connection string.
    /// Does NOT require the user to be in edit mode — the saved (encrypted) string is used server-side.
    /// Shows a success or error toast with details.
    /// </summary>
    private async Task TestBlobConnectionAsync()
    {
        _testingBlobConnection = true;
        StateHasChanged();
        try
        {
            var result = await ConfigService.TestBlobConnectionAsync();
            if (result?.Success == true)
            {
                Snackbar.Add(L["AzureBlob_TestSuccess"].Value, Severity.Success);
            }
            else
            {
                // Show the error detail from the Azure SDK so SysAdmin can diagnose the problem.
                var detail = string.IsNullOrEmpty(result?.Error)
                    ? L["AzureBlob_TestFailed"].Value
                    : $"{L["AzureBlob_TestFailed"].Value}: {result.Error}";
                Snackbar.Add(detail, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Azure Blob Storage connection test HTTP error");
            Snackbar.Add($"{L["AzureBlob_TestFailed"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _testingBlobConnection = false;
        }
    }

    /// <summary>
    /// Saves the edited configuration to the API.
    /// </summary>
    private async Task SaveSettings()
    {
        _saving = true;
        StateHasChanged();
        try
        {
            var result = await ConfigService.UpdateAsync(_editDto);
            if (result != null)
            {
                _config = result;
                _isEditing = false;
                Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to save system configuration");
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
