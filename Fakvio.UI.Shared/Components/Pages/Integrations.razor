@*
    Integrations.razor — personal API keys for connecting AI clients (MCP) to Fakvio.

    An API key is a personal credential, so this page is for any authenticated user and
    always shows only that user's own keys (the API derives the owner from the JWT).

    The critical UX rule: the raw key exists ONLY in the create response. The server stores
    just a SHA-256 hash, so once this page stops showing it, nobody can recover it. Hence
    the one-time reveal panel — an explicit warning, a copy button, and ready-made config
    snippets that already contain the key.
*@
@page "/settings/integrations"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Fakvio.Contracts.Dto.CompanyMembership
@using Fakvio.Contracts.Dto.ApiKey
@using Fakvio.Contracts.Dto.OAuth
@inject CompanyMembershipApiService MembershipApi
@inject AuthenticationStateProvider Authentication
@inject ApiKeyApiService ApiKeyService
@inject OAuthGrantsApiService OAuthGrantsService
@inject IConfiguration Configuration
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject IUiErrorHandler ErrorHandler
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Integration_Title"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["Integration_Title"]</MudText>
<MudText Class="mb-4">@L["Integration_Subtitle"]</MudText>

@* ChatGPT handles OAuth itself. Show this path before API keys so a first-time user
   does not create and share a personal key that ChatGPT's web UI cannot use. *@
<MudPaper Class="pa-4 mb-6" Outlined="true">
    <MudText Typo="Typo.h5" GutterBottom="true">@L["Integration_ChatGptTitle"]</MudText>
    <MudText Class="mb-3">@L["Integration_ChatGptIntro"]</MudText>
    <ol class="mb-4">
        <li>@L["Integration_ChatGptStep1"]</li>
        <li>@L["Integration_ChatGptStep2"]</li>
        <li>@L["Integration_ChatGptStep3"]</li>
    </ol>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
               StartIcon="@Icons.Material.Filled.OpenInNew"
               Href="https://chatgpt.com/" Target="_blank">
        @L["Integration_ChatGptOpen"]
    </MudButton>
    <MudText Typo="Typo.subtitle2">@L["Integration_ChatGptServerLabel"]</MudText>
    <MudPaper Class="pa-2 mb-3 d-flex align-center gap-2" Outlined="true">
        <MudText Typo="Typo.body2" Style="font-family: monospace; overflow-wrap: anywhere;">@ChatGptMcpUrl</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                       Title="@L["Integration_CopySnippet"].Value"
                       OnClick="@(() => CopyAsync(ChatGptMcpUrl))" />
    </MudPaper>
    <MudAlert Severity="Severity.Info">@L["Integration_ChatGptAdminNote"]</MudAlert>
</MudPaper>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Integration_ApiKeysTitle"]</MudText>
<MudText Class="mb-3">@L["Integration_ApiKeysIntro"]</MudText>

@* ── One-time reveal ────────────────────────────────────────────────────────
   Rendered only right after a successful create. Dismissing it drops the key
   from memory — there is deliberately no way to bring it back. *@
@if (_createdKey is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" NoIcon="false">
        <MudText Typo="Typo.subtitle1">@L["Integration_RawKeyTitle"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@L["Integration_RawKeyWarning"]</MudText>

        <MudPaper Class="pa-2 mb-3 d-flex align-center gap-2" Outlined="true">
            <MudText Typo="Typo.body1" Style="font-family: monospace; word-break: break-all;">
                @_createdKey.Key
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                           Title="@L["Integration_CopyKey"].Value"
                           OnClick="@(() => CopyAsync(_createdKey.Key))" />
        </MudPaper>

        @* Both transports get the same block: title, hint, copy button, code. *@
        @foreach (var snippet in BuildSnippets(_createdKey.Key))
        {
            <div class="mb-3">
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.subtitle2">@snippet.Title</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                   Title="@L["Integration_CopySnippet"].Value"
                                   OnClick="@(() => CopyAsync(snippet.Json))" />
                </div>
                <MudText Typo="Typo.caption">@snippet.Helper</MudText>
                <MudPaper Class="pa-2 mt-1" Outlined="true">
                    <pre style="margin:0; white-space:pre-wrap; word-break:break-all; font-size:0.8rem;">@snippet.Json</pre>
                </MudPaper>
            </div>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Warning" Class="mt-3"
                   StartIcon="@Icons.Material.Filled.Check" OnClick="DismissCreatedKey">
            @L["Integration_KeySaved"]
        </MudButton>
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4 d-flex justify-end">
    <ResponsiveButton Label="@L["Integration_NewKey"].Value"
                      Disabled="@(_createdKey is not null)"
                      StartIcon="@Icons.Material.Filled.Add"
                      OnClick="OpenCreateDialog" />
</MudPaper>

@* FakvioGrid in client mode — the endpoint returns the full (short) list, no paging. *@
<FakvioGrid T="ApiKeyDto" GridKey="api-keys" Items="_keys" Loading="_loading">
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="@L["Label_Name"].Value" />
        <PropertyColumn Property="x => x.KeyPrefix" Title="@L["Integration_Prefix"].Value">
            <CellTemplate>
                @* Prefix only — the full key never leaves the create response. *@
                <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.Item.KeyPrefix…</MudText>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Scopes" Title="@L["Integration_Scope"].Value">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="Color.Default">@ScopeLabel(context.Item.Scopes)</MudChip>
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="@L["CompanyMembership_GrantedCompanies"].Value"><CellTemplate>@CompanyNames(context.Item)</CellTemplate></TemplateColumn>
        <PropertyColumn Property="x => x.CreatedAt" Title="@L["Integration_Created"].Value">
            <CellTemplate>@FormatDate(context.Item.CreatedAt)</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.ExpiresAt" Title="@L["Integration_Expiration"].Value">
            <CellTemplate>@(context.Item.ExpiresAt is null ? L["Integration_NeverExpires"].Value : FormatDate(context.Item.ExpiresAt.Value))</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.LastUsedAt" Title="@L["Integration_LastUsed"].Value">
            <CellTemplate>@(context.Item.LastUsedAt is null ? L["Integration_NeverUsed"].Value : FormatDate(context.Item.LastUsedAt.Value))</CellTemplate>
        </PropertyColumn>
        <TemplateColumn T="ApiKeyDto" Title="@L["Label_Status"].Value" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item)">@StatusLabel(context.Item)</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ApiKeyDto" Title="@L["Label_Actions"].Value" Sortable="false" Filterable="false" CellStyle="white-space:nowrap;">
            <CellTemplate>
                @* Revoking an already revoked key is a no-op on the server; hide the button instead. *@
                @if (context.Item.RevokedAt is null)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error"
                                   Title="@L["Integration_Revoke"].Value"
                                   OnClick="@(() => RevokeAsync(context.Item))" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudAlert Severity="Severity.Info">@L["Integration_NoKeys"]</MudAlert>
    </NoRecordsContent>
</FakvioGrid>

@* ── Připojené aplikace (ADR 0001 §4.8) ────────────────────────────────────────
   Hidden entirely while McpOAuth:Enabled is off (OAuthGrantsApiService turns the
   API's 404 into an empty list) — nothing to show for a feature that is not live. *@
@if (_grants.Count > 0)
{
    <MudText Typo="Typo.h5" GutterBottom="true" Class="mt-8">@L["Integration_ConnectedAppsTitle"]</MudText>
    <MudText Class="mb-4">@L["Integration_ConnectedAppsSubtitle"]</MudText>

    <FakvioGrid T="OAuthGrantDto" GridKey="oauth-grants" Items="_grants" Loading="_grantsLoading">
        <Columns>
            <PropertyColumn Property="x => x.CompanyName" Title="@L["User_Company"].Value" />
            <PropertyColumn Property="x => x.ClientId" Title="@L["Integration_ConnectedAppClient"].Value">
                <CellTemplate>
                    <MudText Typo="Typo.body2">@context.Item.ClientId</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.ClientName</MudText>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Scopes" Title="@L["Integration_Scope"].Value">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">@ScopeLabel(context.Item.Scopes)</MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.CreatedAt" Title="@L["Integration_Created"].Value">
                <CellTemplate>@FormatDate(context.Item.CreatedAt)</CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.LastUsedAt" Title="@L["Integration_LastUsed"].Value">
                <CellTemplate>@(context.Item.LastUsedAt is null ? L["Integration_NeverUsed"].Value : FormatDate(context.Item.LastUsedAt.Value))</CellTemplate>
            </PropertyColumn>
            <TemplateColumn T="OAuthGrantDto" Title="@L["Label_Actions"].Value" Sortable="false" Filterable="false" CellStyle="white-space:nowrap;">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small" Color="Color.Error"
                                   Title="@L["Integration_ConnectedAppRemove"].Value"
                                   OnClick="@(() => RevokeGrantAsync(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </FakvioGrid>
}

@* ── Create dialog ─────────────────────────────────────────────────────────── *@
<MudDialog @bind-Visible="_showCreateDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Integration_CreateDialogTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_formValid">
            <MudTextField @bind-Value="_newName" Label="@L["Label_Name"].Value"
                          Required="true" MaxLength="100" Immediate="true"
                          HelperText="@L["Integration_KeyNameHelper"].Value" />

            <MudSelect T="string" @bind-Value="_newScopes" Label="@L["Integration_Scope"].Value" Class="mt-3"
                       HelperText="@L["Integration_ScopeHelper"].Value">
                <MudSelectItem Value="@ScopeRead">@L["Integration_ScopeRead"]</MudSelectItem>
                <MudSelectItem Value="@ScopeReadWrite">@L["Integration_ScopeReadWrite"]</MudSelectItem>
            </MudSelect>

            @if (_isSysAdmin && _memberships.Count == 0)
            {
                <MudAlert Severity="Severity.Info">@L["CompanyMembership_PlatformAccess"]</MudAlert>
            }
            else
            {
            <MudSelect T="long" MultiSelection="true" SelectedValues="_selectedCompanies" SelectedValuesChanged="@(values => _selectedCompanies = values.ToArray())"
                       MultiSelectionTextFunc="SelectedCompanyNames"
                       Label="@L["CompanyMembership_GrantedCompanies"].Value" HelperText="@L["CompanyMembership_GrantHelp"].Value" Disabled="_saving">
                @foreach (var company in _memberships.Where(x => x.IsProvisioned))
                {
                    <MudSelectItem Value="company.CompanyId">@company.CompanyName</MudSelectItem>
                }
            </MudSelect>
            }
            <MudDatePicker @bind-Date="_newExpiresOn" Label="@L["Integration_Expiration"].Value" Class="mt-3"
                           Clearable="true" MinDate="DateTime.Today.AddDays(1)"
                           HelperText="@L["Integration_ExpirationHelper"].Value" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseCreateDialog">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync"
                   Disabled="@(!_formValid || _saving || (!_isSysAdmin && _selectedCompanies.Length == 0))">
            @L["Btn_Create"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Canonical web MCP endpoint to paste into ChatGPT's custom app form.</summary>
    private const string ChatGptMcpUrl = "https://mcp.fakvio.cz/mcp";

    /// <summary>Scope value sent to the API for a read-only key.</summary>
    private const string ScopeRead = "read";

    /// <summary>Scope value sent to the API for a read+write key.</summary>
    private const string ScopeReadWrite = "read,write";

    private List<CompanyMembershipDto> _memberships = [];
    private long[] _selectedCompanies = [];
    private long? _currentCompanyId;
    private bool _isSysAdmin;
    private IReadOnlyList<ApiKeyDto> _keys = [];
    private bool _loading;
    private bool _saving;

    private IReadOnlyList<OAuthGrantDto> _grants = [];
    private bool _grantsLoading;

    private MudForm? _form;
    private bool _showCreateDialog;
    private bool _formValid;
    private string _newName = string.Empty;
    private string _newScopes = ScopeRead;
    private DateTime? _newExpiresOn;

    /// <summary>
    /// The just-created key, held in memory only while the reveal panel is open.
    /// Never stored anywhere else — this is the only copy the user will ever see.
    /// </summary>
    private CreatedApiKeyDto? _createdKey;

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseButton = true
    };

    protected override Task OnInitializedAsync() => Task.WhenAll(ReloadAsync(), ReloadGrantsAsync(), LoadMembershipsAsync());

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _keys = await ApiKeyService.GetAllAsync();
        }
        catch (Exception ex)
        {
            ErrorHandler.Handle(ex, "Integrations.Load");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadGrantsAsync()
    {
        _grantsLoading = true;
        try
        {
            _grants = await OAuthGrantsService.GetAllAsync();
        }
        catch (Exception ex)
        {
            ErrorHandler.Handle(ex, "Integrations.LoadGrants");
        }
        finally
        {
            _grantsLoading = false;
        }
    }

    private async Task RevokeGrantAsync(OAuthGrantDto grant)
    {
        var confirmed = await DialogService.ShowMessageBox(
            L["Integration_ConnectedAppRemoveConfirmTitle"].Value,
            string.Format(L["Integration_ConnectedAppRemoveConfirmText"].Value, grant.ClientId),
            yesText: L["Integration_ConnectedAppRemove"].Value,
            cancelText: L["Btn_Cancel"].Value);

        if (confirmed != true)
            return;

        try
        {
            if (await OAuthGrantsService.RevokeAsync(grant.Id))
                Snackbar.Add(L["Integration_ConnectedAppRemoveSuccess"].Value, Severity.Success);

            await ReloadGrantsAsync();
        }
        catch (Exception ex)
        {
            ErrorHandler.Handle(ex, "Integrations.RevokeGrant");
        }
    }

    private string CompanyNames(ApiKeyDto key) =>
        _isSysAdmin && key.CompanyId is null && key.AllowedCompanyIds.Length == 0
            ? L["CompanyMembership_PlatformAccess"].Value
            : string.Join(", ", key.AllowedCompanyIds.Select(id => _memberships.FirstOrDefault(x => x.CompanyId == id)?.CompanyName ?? id.ToString()));
    private async Task LoadMembershipsAsync()
    {
        try
        {
            _memberships = await MembershipApi.ListAsync();
            if (Authentication is CustomAuthenticationStateProvider provider)
                _currentCompanyId = (await provider.GetUserSessionAsync())?.CompanyId;
            _currentCompanyId ??= _memberships.FirstOrDefault(x => x.IsDefault)?.CompanyId;
            var authentication = await Authentication.GetAuthenticationStateAsync();
            _isSysAdmin = authentication?.User.IsInRole("SysAdmin") == true;
        }
        catch (Exception ex) { ErrorHandler.Handle(ex, "Integrations.Companies"); }
    }

    private void OpenCreateDialog()
    {
        // The only recoverable copy must be acknowledged before another secret replaces it.
        if (_createdKey is not null) return;
        _selectedCompanies = _currentCompanyId is { } id && _memberships.Any(x => x.CompanyId == id && x.IsProvisioned) ? [id] : [];
        _newName = string.Empty;
        _newScopes = ScopeRead;
        _newExpiresOn = null;
        _formValid = false;
        _showCreateDialog = true;
    }

    private void CloseCreateDialog() => _showCreateDialog = false;

    private string SelectedCompanyNames(List<string> values) => string.Join(", ", values.Select(value =>
        long.TryParse(value, out var id) ? _memberships.FirstOrDefault(company => company.CompanyId == id)?.CompanyName ?? value : value));

    private async Task CreateAsync()
    {
        if (_saving || _form is null || (!_isSysAdmin && _selectedCompanies.Length == 0))
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        _saving = true;
        try
        {
            var created = await ApiKeyService.CreateAsync(new CreateApiKeyDto
            {
                Name = _newName,
                CompanyId = _selectedCompanies.Length == 0 ? null : _selectedCompanies.Contains(_currentCompanyId ?? 0) ? _currentCompanyId : _selectedCompanies[0],
                AllowedCompanyIds = _selectedCompanies,
                Scopes = _newScopes,
                // The picker yields a local midnight; the key should stay valid for the whole
                // chosen day, so it expires at the start of the following day (in UTC, which is
                // what the API compares against).
                ExpiresAt = _newExpiresOn?.Date.AddDays(1).ToUniversalTime()
            });

            if (created is null)
                return;

            _createdKey = created;
            _showCreateDialog = false;
            Snackbar.Add(L["Integration_CreateSuccess"].Value, Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ErrorHandler.Handle(ex, "Integrations.Create");
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Closes the reveal panel and forgets the raw key for good.</summary>
    private void DismissCreatedKey() => _createdKey = null;

    private async Task RevokeAsync(ApiKeyDto key)
    {
        var confirmed = await DialogService.ShowMessageBox(
            L["Integration_RevokeConfirmTitle"].Value,
            string.Format(L["Integration_RevokeConfirmText"].Value, key.Name, key.KeyPrefix),
            yesText: L["Integration_Revoke"].Value,
            cancelText: L["Btn_Cancel"].Value);

        if (confirmed != true)
            return;

        try
        {
            if (await ApiKeyService.RevokeAsync(key.Id))
                Snackbar.Add(L["Integration_RevokeSuccess"].Value, Severity.Success);

            // Reload either way: a false result means the key was already gone on the server,
            // so the grid is the stale side.
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ErrorHandler.Handle(ex, "Integrations.Revoke");
        }
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add(L["Integration_Copied"].Value, Severity.Success);
        }
        catch
        {
            // Clipboard API is unavailable in non-secure contexts; the text is on screen
            // anyway, so failing silently beats an alarming error next to the raw key.
        }
    }

    /// <summary>
    /// Base URL of the standalone MCP HTTP host (issue #240/#241), read from
    /// <c>McpSettings:BaseUrl</c> in <c>wwwroot/appsettings.json</c>. Deliberately NOT
    /// <see cref="ApiKeyApiService.ApiBaseUrl"/> — the MCP host is a separate deployment
    /// with its own address, and the two must never be confused (#363: the remote snippet
    /// used to paste the API's address here, which does not serve <c>/mcp</c>).
    /// Empty until that deployment exists (no production/test resource yet), in which case
    /// the remote snippet falls back to an obvious placeholder instead of a wrong-but-
    /// plausible-looking URL.
    /// The value is hand-edited into a deployed JSON file, so it is normalised here rather
    /// than at the point of use: stray whitespace or a trailing slash would otherwise end up
    /// in the copied snippet as <c>https://host//mcp</c>. Trimming to empty falls back to the
    /// placeholder, which is the correct outcome for a half-finished edit.
    /// </summary>
    private string? McpBaseUrl => Configuration["McpSettings:BaseUrl"]?.Trim().TrimEnd('/');

    /// <summary>
    /// Ready-to-paste MCP client configs with the key already filled in — one for the local
    /// stdio server (Claude Code / Claude Desktop), one for the remote HTTP transport.
    /// </summary>
    private (string Title, string Helper, string Json)[] BuildSnippets(string rawKey)
    {
        var hasMcpBaseUrl = !string.IsNullOrWhiteSpace(McpBaseUrl);
        var remoteUrl = hasMcpBaseUrl
            ? $"{McpBaseUrl}/mcp"
            : L["Integration_SnippetHttpUrlPlaceholder"].Value;
        var httpHelper = hasMcpBaseUrl
            ? L["Integration_SnippetHttpHelper"].Value
            : $"{L["Integration_SnippetHttpHelper"].Value} {L["Integration_SnippetHttpUrlMissingHint"].Value}";

        return
        [
            (L["Integration_SnippetStdio"].Value, L["Integration_SnippetStdioHelper"].Value,
                $$"""
                {
                  "mcpServers": {
                    "fakvio": {
                      "command": "fakvio-mcp",
                      "env": {
                        "FAKVIO_API_URL": "{{ApiKeyService.ApiBaseUrl}}",
                        "FAKVIO_API_TOKEN": "{{rawKey}}"
                      }
                    }
                  }
                }
                """),
            (L["Integration_SnippetHttp"].Value, httpHelper,
                $$"""
                {
                  "mcpServers": {
                    "fakvio": {
                      "type": "http",
                      "url": "{{remoteUrl}}",
                      "headers": {
                        "Authorization": "Bearer {{rawKey}}"
                      }
                    }
                  }
                }
                """)
        ];
    }

    private string ScopeLabel(string scopes) =>
        scopes.Contains("write", StringComparison.OrdinalIgnoreCase)
            ? L["Integration_ScopeReadWrite"].Value
            : L["Integration_ScopeRead"].Value;

    private string StatusLabel(ApiKeyDto key)
    {
        if (key.RevokedAt is not null) return L["Integration_StatusRevoked"].Value;
        if (!key.IsActive) return L["Integration_StatusExpired"].Value;
        return L["Label_Active"].Value;
    }

    private static Color StatusColor(ApiKeyDto key)
    {
        if (key.RevokedAt is not null) return Color.Error;
        if (!key.IsActive) return Color.Warning;
        return Color.Success;
    }

    /// <summary>API timestamps are UTC; show them in the user's own time zone.</summary>
    private static string FormatDate(DateTime utc) => utc.ToLocalTime().ToString("g");
}
