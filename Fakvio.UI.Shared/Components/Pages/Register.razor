@page "/register"
@using Fakvio.UI.Shared.Models
@using Fakvio.UI.Shared.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthApiService AuthApiService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IConfiguration Configuration
@* Localization service for multi-language support *@
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Register_Title"] - Fakvio</PageTitle>

@*
    Anonymous page — no [Authorize] attribute.
    Self-registration for new companies.
    Password is not set here — user receives an email to set it after registration.
*@

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-8">
        <MudStack Spacing="4">
            @* Header *@
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                @* App logo — grey version looks good on both dark and light paper backgrounds *@
                <MudImage Src="images/logo-grey.png" Alt="Fakvio" Width="64" Height="64" />
                <MudText Typo="Typo.h4" Align="Align.Center">Fakvio</MudText>
                <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Secondary">@L["Register_Title"]</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    @L["Register_Subtitle"]
                </MudText>
            </MudStack>

            @* Success message after registration — instructs user to check email *@
            @if (_isSuccess)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled">
                    @L["Register_SuccessSetPassword"]
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="@(() => Navigation.NavigateTo("/login"))">
                    @L["Btn_Login"]
                </MudButton>
            }
            else
            {
                @* Error message *@
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
                }

                @* Registration form — no password fields, IČO is required *@
                <MudStack Spacing="3">
                    @* Email *@
                    <MudTextField @bind-Value="_request.Email"
                                  Label="@L["Register_Email"].Value"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Required="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email" />

                    @* Name fields *@
                    <MudStack Row="true" Spacing="2">
                        <MudTextField @bind-Value="_request.FirstName"
                                      Label="@L["Register_FirstName"].Value"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />

                        <MudTextField @bind-Value="_request.LastName"
                                      Label="@L["Register_LastName"].Value"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />
                    </MudStack>

                    @* Company name *@
                    <MudTextField @bind-Value="_request.CompanyName"
                                  Label="@L["Register_CompanyName"].Value"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Business" />

                    @* IČO (required) with ARES button *@
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                        <MudTextField @bind-Value="_request.RegistrationNumber"
                                      Label="@L["Register_RegistrationNumber"].Value"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Numbers"
                                      Style="flex: 1" />

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@(_isLoadingAres || string.IsNullOrWhiteSpace(_request.RegistrationNumber))"
                                   OnClick="LoadFromAresAsync"
                                   Style="white-space: nowrap">
                            @if (_isLoadingAres)
                            {
                                <MudProgressCircular Class="mr-1" Size="Size.Small" Indeterminate="true" />
                                @L["Register_AresLoading"]
                            }
                            else
                            {
                                @L["Register_LoadAres"]
                            }
                        </MudButton>
                    </MudStack>

                    @* ARES result feedback *@
                    @if (!string.IsNullOrEmpty(_aresMessage))
                    {
                        <MudAlert Severity="@_aresSeverity" Dense="true">@_aresMessage</MudAlert>
                    }

                    @* Submit button *@
                    <MudButton ButtonType="ButtonType.Button"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth="true"
                               Disabled="@_isSubmitting"
                               OnClick="HandleRegisterAsync">
                        @if (_isSubmitting)
                        {
                            <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            <span>@L["Register_Registering"]</span>
                        }
                        else
                        {
                            <span>@L["Register_Submit"]</span>
                        }
                    </MudButton>
                </MudStack>

                @* Link to login page *@
                <MudText Typo="Typo.body2" Align="Align.Center">
                    <MudLink Href="/login" Color="Color.Primary">
                        @L["Register_AlreadyHaveAccount"]
                    </MudLink>
                </MudText>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private RegisterRequest _request = new();
    private string? _errorMessage;
    private bool _isSubmitting;
    private bool _isSuccess;
    private bool _isLoadingAres;
    private string? _aresMessage;
    private Severity _aresSeverity;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Redirect if already authenticated
        if (AuthenticationState != null)
        {
            var authState = await AuthenticationState;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo("/");
            }
        }
    }

    /// <summary>
    /// Handles registration form submission.
    /// Validates inputs, calls the API, and shows success/error messages.
    /// No password is collected — the user sets it after receiving the email.
    /// </summary>
    private async Task HandleRegisterAsync()
    {
        _errorMessage = null;

        // Basic field validation
        if (string.IsNullOrWhiteSpace(_request.Email) ||
            string.IsNullOrWhiteSpace(_request.FirstName) ||
            string.IsNullOrWhiteSpace(_request.LastName) ||
            string.IsNullOrWhiteSpace(_request.CompanyName) ||
            string.IsNullOrWhiteSpace(_request.RegistrationNumber))
        {
            _errorMessage = L["Msg_FillRequired"].Value;
            return;
        }

        _isSubmitting = true;

        try
        {
            var response = await AuthApiService.RegisterAsync(_request);

            if (response != null)
            {
                _isSuccess = true;
                Snackbar.Add(L["Register_SuccessSetPassword"].Value, Severity.Success);
            }
            else
            {
                _errorMessage = L["Register_Error"].Value;
            }
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = $"{L["Register_Error"].Value}: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    /// <summary>
    /// Calls the ARES API to auto-fill company details from IČO (registration number).
    /// Uses the existing /api/client/ares/{ico} endpoint.
    /// </summary>
    private async Task LoadFromAresAsync()
    {
        if (string.IsNullOrWhiteSpace(_request.RegistrationNumber)) return;

        _isLoadingAres = true;
        _aresMessage = null;

        try
        {
            // Use the existing ARES endpoint on the API
            var apiBaseUrl = Configuration["ApiSettings:BaseUrl"]!;
            using var httpClient = new HttpClient { BaseAddress = new Uri(apiBaseUrl) };
            var response = await httpClient.GetAsync($"/api/client/ares/{_request.RegistrationNumber}");

            if (response.IsSuccessStatusCode)
            {
                var aresData = await response.Content.ReadFromJsonAsync<AresResult>();
                if (aresData != null && !string.IsNullOrEmpty(aresData.CompanyName))
                {
                    _request.CompanyName = aresData.CompanyName;
                    _aresMessage = L["Register_AresSuccess"].Value;
                    _aresSeverity = Severity.Success;
                }
                else
                {
                    _aresMessage = L["Register_AresFailed"].Value;
                    _aresSeverity = Severity.Warning;
                }
            }
            else
            {
                _aresMessage = L["Register_AresFailed"].Value;
                _aresSeverity = Severity.Warning;
            }
        }
        catch
        {
            _aresMessage = L["Register_AresFailed"].Value;
            _aresSeverity = Severity.Error;
        }
        finally
        {
            _isLoadingAres = false;
        }
    }

    /// <summary>
    /// Simple DTO for ARES response deserialization (only CompanyName is needed here)
    /// </summary>
    private class AresResult
    {
        public string? CompanyName { get; set; }
    }
}
