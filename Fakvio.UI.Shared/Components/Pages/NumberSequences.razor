@page "/number-sequences"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Fakvio.Contracts.Dto.NumberSequence
@using Fakvio.Domain.Enums
@inject NumberSequenceApiService SequenceService
@inject ISnackbar Snackbar
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Nav_NumberSequences"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["Nav_NumberSequences"]</MudText>
<MudText Class="mb-4">@L["NumSeq_Subtitle"]</MudText>
@if (!_canManage) { <MudAlert Severity="Severity.Info" Class="mb-3">@L["Settings_ReadOnly"]</MudAlert> }

@* ========== Number Sequence Formats — MudDataGrid with inline actions ========== *@
<MudText Typo="Typo.h5" Class="mt-6 mb-2">@L["NumSeq_Formats"]</MudText>

<FakvioGrid T="NumberSequenceFormatDto"
            GridKey="numseq-formats"
            @ref="_formatsGrid"
            Items="@_filteredFormats"
            Loading="@_loadingFormats"
            RowClick="@(args => OpenEditFormatDialog(args.Item))">
    <ToolBarContent>
        @if (_canManage)
        {
            <ResponsiveButton Label="@L["NumSeq_NewFormat"].Value" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateFormatDialog" />
        }
        <MudSpacer />
        <MudSwitch T="bool" @bind-Value="_showDeletedFormats" Label="@L["Label_ShowDeleted"].Value"
                   Color="Color.Warning" />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="@L["Label_Name"].Value" />
        <PropertyColumn Property="x => x.FormatPattern" Title="@L["NumSeq_FormatPattern"].Value">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.Item.FormatPattern</MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.CounterDigits" Title="@L["NumSeq_CounterDigits"].Value" Filterable="false" />
        <PropertyColumn Property="x => x.ResetsYearly" Title="@L["NumSeq_ResetsYearly"].Value" Filterable="false">
            <CellTemplate>
                <MudCheckBox T="bool" Value="@context.Item.ResetsYearly" ReadOnly="true" Dense="true" />
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.ResetsMonthly" Title="@L["NumSeq_ResetsMonthly"].Value" Filterable="false">
            <CellTemplate>
                <MudCheckBox T="bool" Value="@context.Item.ResetsMonthly" ReadOnly="true" Dense="true" />
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.IsActive" Title="@L["Label_Status"].Value">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                    @(context.Item.IsActive ? L["Label_Active"] : L["Label_Inactive"])
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        @* Actions column — Edit + Deactivate/Activate per row *@
        <TemplateColumn T="NumberSequenceFormatDto" Title="@L["Label_Actions"].Value" Sortable="false" Filterable="false"
                        CellStyle="white-space:nowrap;">
            <CellTemplate>
                @if (_canManage)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   OnClick="@(() => OpenEditFormatDialog(context.Item))" Title="@L["Btn_Edit"].Value" />
                }
                @if (context.Item.IsActive)
                {
                    @if (_canManage)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeactivateFormat(context.Item))" Title="@L["Btn_Delete"].Value" />
                    }
                }
                else
                {
                    @if (_canManage)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Restore" Size="Size.Small" Color="Color.Success"
                                       OnClick="@(() => ActivateFormat(context.Item))" Title="@L["Btn_Restore"].Value" />
                    }
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudAlert Severity="Severity.Info">@L["NumSeq_NoFormats"]</MudAlert>
    </NoRecordsContent>
</FakvioGrid>

@* ========== Number Sequences — MudDataGrid with inline actions ========== *@
<MudText Typo="Typo.h5" Class="mt-6 mb-2">@L["NumSeq_Sequences"]</MudText>

<FakvioGrid T="NumberSequenceDto"
            GridKey="numseq-sequences"
            @ref="_sequencesGrid"
            Items="@_filteredSequences"
            Loading="@_loadingSequences"
            RowClick="@(args => OpenEditSequenceDialog(args.Item))">
    <ToolBarContent>
        @if (_canManage)
        {
            <ResponsiveButton Label="@L["NumSeq_NewSequence"].Value" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateSequenceDialog" />
        }
        <MudSpacer />
        <MudSwitch T="bool" @bind-Value="_showDeletedSequences" Label="@L["Label_ShowDeleted"].Value"
                   Color="Color.Warning" />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="@L["Label_Name"].Value" />
        <PropertyColumn Property="x => x.DocumentType" Title="@L["NumSeq_DocumentType"].Value">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.Item.DocumentType == EDocumentType.Invoice ? Color.Primary : Color.Warning)">
                    @(context.Item.DocumentType == EDocumentType.Invoice ? L["Template_DocumentTypeInvoice"] : L["Template_DocumentTypeCreditNote"])
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn T="NumberSequenceDto" Title="@L["NumSeq_Format"].Value" Sortable="false">
            <CellTemplate>@context.Item.NumberSequenceFormat?.FormatPattern</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Prefix" Title="@L["NumSeq_Prefix"].Value" />
        <PropertyColumn Property="x => x.Suffix" Title="@L["NumSeq_Suffix"].Value" />
        <PropertyColumn Property="x => x.CurrentNumber" Title="@L["NumSeq_CurrentNumber"].Value" Filterable="false" />
        <TemplateColumn T="NumberSequenceDto" Title="@L["NumSeq_Preview"].Value" Sortable="false" Filterable="false">
            <CellTemplate>
                @if (_previews.TryGetValue(context.Item.Id, out var preview))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@preview</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.IsDefault" Title="@L["NumSeq_Default"].Value" Filterable="false">
            <CellTemplate>
                @if (context.Item.IsDefault)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["NumSeq_IsDefault"]</MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        @* Actions column — Edit + SetDefault/Delete/Restore per row (conditional on state) *@
        <TemplateColumn T="NumberSequenceDto" Title="@L["Label_Actions"].Value" Sortable="false" Filterable="false"
                        CellStyle="white-space:nowrap;">
            <CellTemplate>
                @if (_canManage)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   OnClick="@(() => OpenEditSequenceDialog(context.Item))" Title="@L["Btn_Edit"].Value" />
                }
                @if (!context.Item.IsDefault && context.Item.IsActive)
                {
                    @if (_canManage)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning"
                                       OnClick="@(() => SetAsDefault(context.Item.Id))" Title="@L["NumSeq_SetDefault"].Value" />
                    }
                    @if (_canManage)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeactivateSequence(context.Item))" Title="@L["Btn_Delete"].Value" />
                    }
                }
                @if (!context.Item.IsActive)
                {
                    @if (_canManage)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Restore" Size="Size.Small" Color="Color.Success"
                                       OnClick="@(() => ActivateSequence(context.Item))" Title="@L["Btn_Restore"].Value" />
                    }
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudAlert Severity="Severity.Info">@L["NumSeq_NoSequences"]</MudAlert>
    </NoRecordsContent>
</FakvioGrid>

@* ========== Create Format Dialog ========== *@
<MudDialog @bind-Visible="_showFormatDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["NumSeq_NewFormat"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_formatForm" @bind-IsValid="_formatFormValid">
            <MudTextField @bind-Value="_newFormat.Name" Label="@L["Label_Name"].Value"
                          Required="true" MaxLength="200" Class="mb-3" />
            <MudTextField @bind-Value="_newFormat.FormatPattern" Label="@L["NumSeq_FormatPattern"].Value"
                          Required="true" MaxLength="100" Class="mb-3"
                          HelperText="@L["NumSeq_PatternHelper"].Value" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showFormatDialog = false)">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateFormat"
                   Disabled="@(!_formatFormValid)">
            @L["Btn_Create"]
        </MudButton>
    </DialogActions>
</MudDialog>

@* ========== Create Sequence Dialog ========== *@
<MudDialog @bind-Visible="_showSequenceDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["NumSeq_NewSequence"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_sequenceForm" @bind-IsValid="_sequenceFormValid">
            <MudTextField @bind-Value="_newSequence.Name" Label="@L["Label_Name"].Value"
                          Required="true" MaxLength="200" Class="mb-3" />
            <MudSelect @bind-Value="_newSequence.DocumentType" Label="@L["NumSeq_DocumentType"].Value"
                       Required="true" Class="mb-3">
                <MudSelectItem Value="@EDocumentType.Invoice">@L["Template_DocumentTypeInvoice"]</MudSelectItem>
                <MudSelectItem Value="@EDocumentType.CreditNote">@L["Template_DocumentTypeCreditNote"]</MudSelectItem>
            </MudSelect>
            <MudSelect @bind-Value="_newSequence.NumberSequenceFormatId" Label="@L["NumSeq_Format"].Value"
                       Required="true" Class="mb-3">
                @foreach (var format in _formats.Where(f => f.IsActive))
                {
                    <MudSelectItem Value="@format.Id">@format.Name (@format.FormatPattern)</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_newSequence.Prefix" Label="@L["NumSeq_Prefix"].Value"
                          MaxLength="50" Class="mb-3" />
            <MudTextField @bind-Value="_newSequence.Suffix" Label="@L["NumSeq_Suffix"].Value"
                          MaxLength="50" Class="mb-3" />
            <MudNumericField @bind-Value="_newSequence.StartingNumber" Label="@L["NumSeq_StartingNumber"].Value"
                             Min="1" Class="mb-3" />
            <MudSwitch T="bool" @bind-Value="_newSequence.IsDefault" Label="@L["NumSeq_SetAsDefault"].Value"
                       Color="Color.Primary" Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showSequenceDialog = false)">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSequence"
                   Disabled="@(!_sequenceFormValid)">
            @L["Btn_Create"]
        </MudButton>
    </DialogActions>
</MudDialog>

@* ========== Edit Format Dialog ========== *@
<MudDialog @bind-Visible="_showEditFormatDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["NumSeq_EditFormat"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_editFormatForm" @bind-IsValid="_editFormatFormValid">
            <MudTextField @bind-Value="_editFormat.Name" Label="@L["Label_Name"].Value"
                          Required="true" MaxLength="200" Class="mb-3" />
            <MudTextField @bind-Value="_editFormat.FormatPattern" Label="@L["NumSeq_FormatPattern"].Value"
                          Required="true" MaxLength="100" Class="mb-3"
                          HelperText="@L["NumSeq_PatternHelper"].Value" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showEditFormatDialog = false)">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UpdateFormat"
                   Disabled="@(!_editFormatFormValid)">
            @L["Btn_Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@* ========== Edit Sequence Dialog ========== *@
<MudDialog @bind-Visible="_showEditSequenceDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["NumSeq_EditSequence"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_editSequenceForm" @bind-IsValid="_editSequenceFormValid">
            <MudTextField @bind-Value="_editSequence.Name" Label="@L["Label_Name"].Value"
                          Required="true" MaxLength="200" Class="mb-3" />
            <MudTextField @bind-Value="_editSequence.Prefix" Label="@L["NumSeq_Prefix"].Value"
                          MaxLength="50" Class="mb-3" />
            <MudTextField @bind-Value="_editSequence.Suffix" Label="@L["NumSeq_Suffix"].Value"
                          MaxLength="50" Class="mb-3" />
            <MudNumericField @bind-Value="_editSequence.CurrentNumber" Label="@L["NumSeq_CurrentNumber"].Value"
                             Min="0" Class="mb-3" HideSpinButtons="true"
                             HelperText="@L["NumSeq_CurrentNumberHelp"].Value" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showEditSequenceDialog = false)">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UpdateSequence"
                   Disabled="@(!_editSequenceFormValid)">
            @L["Btn_Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _canManage;
    private FakvioGrid<NumberSequenceFormatDto>? _formatsGrid;
    private FakvioGrid<NumberSequenceDto>? _sequencesGrid;

    // Loading state
    private bool _loadingFormats = false;
    private bool _loadingSequences = false;

    // Data
    private List<NumberSequenceFormatDto> _formats = new();
    private List<NumberSequenceDto> _sequences = new();

    // Filter: show/hide deleted (inactive) records
    private bool _showDeletedFormats = false;
    private bool _showDeletedSequences = false;

    // Computed filtered lists — active only by default, all when "show deleted" is on
    private List<NumberSequenceFormatDto> _filteredFormats =>
        _showDeletedFormats ? _formats : _formats.Where(f => f.IsActive).ToList();
    private List<NumberSequenceDto> _filteredSequences =>
        _showDeletedSequences ? _sequences : _sequences.Where(s => s.IsActive).ToList();
    private Dictionary<long, string> _previews = new();

    // Dialog state
    private bool _showFormatDialog = false;
    private bool _showSequenceDialog = false;
    private bool _formatFormValid = false;
    private bool _sequenceFormValid = false;
    private MudForm? _formatForm;
    private MudForm? _sequenceForm;

    // New item models
    private CreateNumberSequenceFormatDto _newFormat = new();
    private CreateNumberSequenceDto _newSequence = new() { StartingNumber = 1 };

    // Edit format dialog state
    private bool _showEditFormatDialog = false;
    private bool _editFormatFormValid = false;
    private MudForm? _editFormatForm;
    private long _editFormatId;
    private UpdateNumberSequenceFormatDto _editFormat = new();

    // Edit sequence dialog state
    private bool _showEditSequenceDialog = false;
    private bool _editSequenceFormValid = false;
    private MudForm? _editSequenceForm;
    private long _editSequenceId;
    private UpdateNumberSequenceDto _editSequence = new();

    private DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        // Accountant is the display name of the Admin role used by the API.
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        _canManage = user.IsInRole("Admin") || user.IsInRole("SysAdmin");
        // Load both formats and sequences in parallel
        await Task.WhenAll(LoadFormats(), LoadSequences());
    }

    /// <summary>
    /// Loads all number sequence formats from the API.
    /// </summary>
    private async Task LoadFormats()
    {
        _loadingFormats = true;
        try
        {
            _formats = await SequenceService.GetAllFormatsAsync(includeInactive: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingFormats = false;
        }
    }

    /// <summary>
    /// Loads all number sequences and their preview numbers.
    /// </summary>
    private async Task LoadSequences()
    {
        _loadingSequences = true;
        try
        {
            _sequences = await SequenceService.GetAllSequencesAsync(includeInactive: true);

            // Load preview for each active sequence
            _previews.Clear();
            foreach (var seq in _sequences.Where(s => s.IsActive))
            {
                try
                {
                    var preview = await SequenceService.PreviewNextNumberAsync(seq.Id);
                    if (preview != null)
                        _previews[seq.Id] = preview;
                }
                catch
                {
                    // Preview is optional — don't fail if one sequence can't generate a preview
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingSequences = false;
        }
    }

    // --- Format CRUD ---

    private void OpenCreateFormatDialog()
    {
        if (!_canManage) return;
        _newFormat = new CreateNumberSequenceFormatDto();
        _showFormatDialog = true;
    }

    private async Task CreateFormat()
    {
        if (!_canManage) return;
        if (_formatForm == null) return;
        await _formatForm.Validate();
        if (!_formatFormValid) return;

        try
        {
            await SequenceService.CreateFormatAsync(_newFormat);
            Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
            _showFormatDialog = false;
            await LoadFormats();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    // --- Sequence CRUD ---

    private void OpenCreateSequenceDialog()
    {
        if (!_canManage) return;
        _newSequence = new CreateNumberSequenceDto { StartingNumber = 1 };
        _showSequenceDialog = true;
    }

    private async Task CreateSequence()
    {
        if (!_canManage) return;
        if (_sequenceForm == null) return;
        await _sequenceForm.Validate();
        if (!_sequenceFormValid) return;

        try
        {
            await SequenceService.CreateSequenceAsync(_newSequence);
            Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
            _showSequenceDialog = false;
            await LoadSequences();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Sets a sequence as default for its document type.
    /// Only one sequence can be default per document type.
    /// </summary>
    private async Task SetAsDefault(long id)
    {
        if (!_canManage) return;
        try
        {
            await SequenceService.SetAsDefaultAsync(id);
            Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
            await LoadSequences();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Deactivates a sequence with confirmation dialog.
    /// </summary>
    private async Task DeactivateSequence(NumberSequenceDto sequence)
    {
        if (!_canManage) return;
        bool? result = await DialogService.ShowMessageBox(
            L["Msg_ConfirmDeleteTitle"].Value,
            $"{L["NumSeq_ConfirmDeactivate"].Value} ({sequence.Name})",
            yesText: L["Btn_Delete"].Value, cancelText: L["Btn_Cancel"].Value);

        if (result == true)
        {
            try
            {
                await SequenceService.DeactivateSequenceAsync(sequence.Id);
                Snackbar.Add(L["Msg_DeleteSuccess"].Value, Severity.Success);
                await LoadSequences();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
            }
        }
    }

    // --- Format Delete / Restore ---

    private async Task DeactivateFormat(NumberSequenceFormatDto format)
    {
        if (!_canManage) return;
        bool? result = await DialogService.ShowMessageBox(
            L["Msg_ConfirmDeleteTitle"].Value,
            $"{L["NumSeq_ConfirmDeactivate"].Value} ({format.Name})",
            yesText: L["Btn_Delete"].Value, cancelText: L["Btn_Cancel"].Value);

        if (result == true)
        {
            try
            {
                await SequenceService.DeactivateFormatAsync(format.Id);
                Snackbar.Add(L["Msg_DeleteSuccess"].Value, Severity.Success);
                await LoadFormats();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ActivateFormat(NumberSequenceFormatDto format)
    {
        if (!_canManage) return;
        try
        {
            await SequenceService.ActivateFormatAsync(format.Id);
            Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
            await LoadFormats();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    // --- Sequence Restore ---

    private async Task ActivateSequence(NumberSequenceDto sequence)
    {
        if (!_canManage) return;
        try
        {
            await SequenceService.ActivateSequenceAsync(sequence.Id);
            Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
            await LoadSequences();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    // --- Format Edit ---

    /// <summary>
    /// Opens the edit format dialog pre-populated with the selected format's data.
    /// </summary>
    private void OpenEditFormatDialog(NumberSequenceFormatDto format)
    {
        if (!_canManage) return;
        _editFormatId = format.Id;
        _editFormat = new UpdateNumberSequenceFormatDto
        {
            Name = format.Name,
            FormatPattern = format.FormatPattern
        };
        _showEditFormatDialog = true;
    }

    /// <summary>
    /// Saves the edited format by calling the update API endpoint.
    /// </summary>
    private async Task UpdateFormat()
    {
        if (!_canManage) return;
        if (_editFormatForm == null) return;
        await _editFormatForm.Validate();
        if (!_editFormatFormValid) return;

        try
        {
            await SequenceService.UpdateFormatAsync(_editFormatId, _editFormat);
            Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
            _showEditFormatDialog = false;
            await LoadFormats();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    // --- Sequence Edit ---

    /// <summary>
    /// Opens the edit sequence dialog pre-populated with the selected sequence's data.
    /// Only Name, Prefix, and Suffix are editable — other fields are locked to prevent
    /// breaking existing numbering.
    /// </summary>
    private void OpenEditSequenceDialog(NumberSequenceDto sequence)
    {
        if (!_canManage) return;
        _editSequenceId = sequence.Id;
        _editSequence = new UpdateNumberSequenceDto
        {
            Name = sequence.Name,
            Prefix = sequence.Prefix ?? "",
            Suffix = sequence.Suffix ?? "",
            CurrentNumber = sequence.CurrentNumber
        };
        _showEditSequenceDialog = true;
    }

    /// <summary>
    /// Saves the edited sequence by calling the update API endpoint.
    /// </summary>
    private async Task UpdateSequence()
    {
        if (!_canManage) return;
        if (_editSequenceForm == null) return;
        await _editSequenceForm.Validate();
        if (!_editSequenceFormValid) return;

        try
        {
            await SequenceService.UpdateSequenceAsync(_editSequenceId, _editSequence);
            Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
            _showEditSequenceDialog = false;
            await LoadSequences();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }
}
