@page "/verify-email"
@using Fakvio.UI.Shared.Services
@inject AuthApiService AuthApiService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@* Localization service for multi-language support *@
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["VerifyEmail_Title"] - Fakvio</PageTitle>

@*
    Anonymous page — no [Authorize] attribute.
    Accessed via the verification link in the registration email (/verify-email?token=xxx).
    Follows the same pattern as SetPassword.razor (token validation → success/error states).

    Now shows three possible outcomes:
    1. Email verified + tenant provisioned → full success (green)
    2. Email verified + tenant provisioning FAILED → partial success (warning)
    3. Invalid/expired token → error (red)
*@

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-8">
        <MudStack Spacing="4">
            @* Header *@
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h4" Align="Align.Center">Fakvio</MudText>
                <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Secondary">
                    @L["VerifyEmail_Title"]
                </MudText>
            </MudStack>

            @* Loading state — while verifying the token *@
            @if (_isVerifying)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                <MudText Align="Align.Center">@L["VerifyEmail_Verifying"]</MudText>
            }
            @* Success state — email verified AND tenant provisioned *@
            else if (_isSuccess && _tenantProvisioned)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled">
                    @L["VerifyEmail_Success"]
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="@(() => Navigation.NavigateTo("/login"))">
                    @L["VerifyEmail_GoToLogin"]
                </MudButton>
            }
            @* Partial success — email verified but tenant provisioning failed *@
            else if (_isSuccess && !_tenantProvisioned)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled">
                    @L["VerifyEmail_Success"]
                </MudAlert>
                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-2">
                    @L["VerifyEmail_ProvisioningFailed"]
                </MudAlert>
                @if (!string.IsNullOrEmpty(_provisioningError))
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                        @_provisioningError
                    </MudAlert>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="@(() => Navigation.NavigateTo("/login"))">
                    @L["VerifyEmail_GoToLogin"]
                </MudButton>
            }
            @* Error state — invalid or expired token *@
            else
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                    @_errorMessage
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="@(() => Navigation.NavigateTo("/login"))">
                    @L["VerifyEmail_GoToLogin"]
                </MudButton>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    /// <summary>
    /// Email verification token from the URL query parameter (?token=xxx)
    /// </summary>
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool _isVerifying = true;
    private bool _isSuccess = false;
    private bool _tenantProvisioned = false;
    private string? _errorMessage;
    private string? _provisioningError;

    /// <summary>
    /// On page load, immediately verify the token via the API.
    /// The response now includes both email verification and tenant provisioning status,
    /// so the user sees exactly what happened (and SysAdmin can see the error details).
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Check if token is provided in the URL
        if (string.IsNullOrWhiteSpace(Token))
        {
            _errorMessage = L["VerifyEmail_Failed"].Value;
            _isVerifying = false;
            return;
        }

        try
        {
            // Call the API to verify the email token — returns full status with provisioning details
            var result = await AuthApiService.VerifyEmailAsync(Token);

            if (result.EmailVerified)
            {
                _isSuccess = true;
                _tenantProvisioned = result.TenantProvisioned;
                _provisioningError = result.ProvisioningError;

                if (result.TenantProvisioned)
                {
                    Snackbar.Add(L["VerifyEmail_Success"].Value, Severity.Success);
                }
                else
                {
                    // Email OK but provisioning failed — show warning
                    Snackbar.Add(L["VerifyEmail_ProvisioningFailed"].Value, Severity.Warning);
                }
            }
            else
            {
                _errorMessage = result.Message ?? L["VerifyEmail_Failed"].Value;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"{L["Msg_Error"].Value}: {ex.Message}";
        }
        finally
        {
            _isVerifying = false;
        }
    }
}
