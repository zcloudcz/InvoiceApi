@*
    CompanySettings.razor — SysAdmin page for managing multi-tenant infrastructure.

    Displays all CompanySystemSettings records (one per company/tenant) with status chips,
    and provides actions for tenant lifecycle management:
    - Create settings (register a new tenant configuration)
    - Edit settings (update maxUsers, adminNotes)
    - Provision (create tenant schema, apply migrations, seed code tables)
    - Activate / Deactivate (toggle tenant access)
    - Migrate (apply pending EF Core migrations to a tenant's schema)

    PostgreSQL multi-schema architecture: all tenants share one database,
    each tenant gets its own schema (e.g., "tenant_42").

    This page is SysAdmin-only — the [Authorize(Roles = "SysAdmin")] attribute restricts access.
*@
@page "/company-settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SysAdmin")]
@using Fakvio.Contracts.Dto.CompanySettings
@using Fakvio.Contracts.Dto.Client
@inject CompanySettingsApiService SettingsService
@inject CompanyApiService CompanyService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["TenantSettings_Title"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["TenantSettings_Title"]</MudText>
<MudText Class="mb-4">@L["TenantSettings_Subtitle"]</MudText>

@* ========== Main Grid: All Company Tenant Settings — MudDataGrid with inline actions ========== *@
<FakvioGrid T="CompanySystemSettingsDto"
            GridKey="company-settings"
            @ref="_dataGrid"
            Items="@_settings"
            Loading="@_loading"
            RowClick="@(args => OpenEditDialog(args.Item))">
    <ToolBarContent>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
            @L["TenantSettings_New"]
        </MudButton>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.CompanyName" Title="@L["Label_Name"].Value" />
        <PropertyColumn Property="x => x.SchemaName" Title="@L["TenantSettings_SchemaName"].Value">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.Item.SchemaName</MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.IsProvisioned" Title="@L["TenantSettings_Provisioned"].Value">
            <CellTemplate>
                @if (context.Item.IsProvisioned)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">
                        @L["TenantSettings_Yes"] (@context.Item.ProvisionedAt?.ToString("d"))
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                        @L["TenantSettings_No"]
                    </MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.IsActive" Title="@L["Label_Status"].Value">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                    @(context.Item.IsActive ? L["Label_Active"] : L["Label_Inactive"])
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.MaxUsers" Title="@L["TenantSettings_MaxUsers"].Value" Filterable="false">
            <CellTemplate>
                @(context.Item.MaxUsers?.ToString() ?? L["TenantSettings_Unlimited"].Value)
            </CellTemplate>
        </PropertyColumn>
        @* Actions column — Edit + Provision/Activate/Deactivate/Migrate per row (conditional on state) *@
        <TemplateColumn T="CompanySystemSettingsDto" Title="@L["Label_Actions"].Value" Sortable="false" Filterable="false"
                        CellStyle="white-space:nowrap;">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => OpenEditDialog(context.Item))" Title="@L["Btn_Edit"].Value" />
                @if (!context.Item.IsProvisioned)
                {
                    @* Not yet provisioned — show Provision button *@
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small"
                                   Color="Color.Primary" OnClick="@(() => ProvisionTenant(context.Item))"
                                   Title="@L["TenantSettings_Provision"].Value" />
                }
                else if (!context.Item.IsActive)
                {
                    @* Provisioned but inactive — show Activate button *@
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                   Color="Color.Success" OnClick="@(() => ActivateTenant(context.Item.CompanyId))"
                                   Title="@L["TenantSettings_Activate"].Value" />
                }
                else
                {
                    @* Provisioned and active — show Deactivate + Migrate buttons *@
                    <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small"
                                   Color="Color.Error" OnClick="@(() => DeactivateTenant(context.Item))"
                                   Title="@L["TenantSettings_Deactivate"].Value" />
                    <MudIconButton Icon="@Icons.Material.Filled.Storage" Size="Size.Small"
                                   Color="Color.Info" OnClick="@(() => MigrateTenant(context.Item.CompanyId))"
                                   Title="@L["TenantSettings_Migrate"].Value" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudAlert Severity="Severity.Info">@L["TenantSettings_NoRecords"]</MudAlert>
    </NoRecordsContent>
</FakvioGrid>

@* ========== Create Settings Dialog ========== *@
<MudDialog @bind-Visible="_showCreateDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["TenantSettings_New"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_createForm" @bind-IsValid="_createFormValid">
            @* Company selector — only shows companies that don't have settings yet *@
            <MudSelect @bind-Value="_createDto.CompanyId" Label="@L["User_Company"].Value"
                       Required="true" Class="mb-3">
                @foreach (var company in _availableCompanies)
                {
                    <MudSelectItem Value="@company.Id">@company.CompanyName</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_createDto.SchemaName" Label="@L["TenantSettings_SchemaName"].Value"
                          MaxLength="63" Class="mb-3"
                          HelperText="@L["TenantSettings_SchemaNameHelper"].Value" />
            <MudNumericField @bind-Value="_createDto.MaxUsers" Label="@L["TenantSettings_MaxUsers"].Value"
                             Min="1" Max="10000" Class="mb-3"
                             HelperText="@L["TenantSettings_MaxUsersHelper"].Value" />
            <MudTextField @bind-Value="_createDto.AdminNotes" Label="@L["TenantSettings_AdminNotes"].Value"
                          MaxLength="2000" Lines="3" Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showCreateDialog = false)">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSettings"
                   Disabled="@(!_createFormValid || _createDto.CompanyId == 0)">
            @L["Btn_Create"]
        </MudButton>
    </DialogActions>
</MudDialog>

@* ========== Edit Settings Dialog ========== *@
<MudDialog @bind-Visible="_showEditDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["TenantSettings_Edit"] — @_editCompanyName</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_editForm" @bind-IsValid="_editFormValid">
            @* Read-only info fields — schema name is immutable after creation *@
            <MudTextField Value="@_editSchemaName" Label="@L["TenantSettings_SchemaName"].Value"
                          ReadOnly="true" Class="mb-3" />
            <MudNumericField @bind-Value="_editDto.MaxUsers" Label="@L["TenantSettings_MaxUsers"].Value"
                             Min="1" Max="10000" Class="mb-3"
                             HelperText="@L["TenantSettings_MaxUsersHelper"].Value" />
            <MudTextField @bind-Value="_editDto.AdminNotes" Label="@L["TenantSettings_AdminNotes"].Value"
                          MaxLength="2000" Lines="3" Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showEditDialog = false)">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UpdateSettings"
                   Disabled="@(!_editFormValid)">
            @L["Btn_Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private FakvioGrid<CompanySystemSettingsDto>? _dataGrid;

    // ========== Loading State ==========
    private bool _loading = false;

    // ========== Data ==========
    private List<CompanySystemSettingsDto> _settings = new();
    private List<ClientDto> _allCompanies = new();
    private List<ClientDto> _availableCompanies = new(); // Companies without settings yet

    // ========== Dialog Options ==========
    private DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    // ========== Create Dialog State ==========
    private bool _showCreateDialog = false;
    private bool _createFormValid = false;
    private MudForm? _createForm;
    private CreateCompanySystemSettingsDto _createDto = new();

    // ========== Edit Dialog State ==========
    private bool _showEditDialog = false;
    private bool _editFormValid = false;
    private MudForm? _editForm;
    private long _editCompanyId;
    private string _editCompanyName = "";
    private string _editSchemaName = "";
    private UpdateCompanyAdminSettingsDto _editDto = new();

    /// <summary>
    /// Load all settings and companies when the page is first initialized.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    /// <summary>
    /// Loads all settings and available companies in parallel.
    /// Available companies = all issuers minus those that already have settings.
    /// </summary>
    private async Task LoadData()
    {
        _loading = true;
        try
        {
            // Load settings and companies in parallel
            var settingsTask = SettingsService.GetAllSettingsAsync();
            var companiesTask = CompanyService.GetAllAsync();
            await Task.WhenAll(settingsTask, companiesTask);

            _settings = settingsTask.Result;
            _allCompanies = companiesTask.Result;

            // Filter out companies that already have settings (can't create duplicates)
            var companyIdsWithSettings = _settings.Select(s => s.CompanyId).ToHashSet();
            _availableCompanies = _allCompanies
                .Where(c => !companyIdsWithSettings.Contains(c.Id))
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ========== Create Settings ==========

    /// <summary>
    /// Opens the Create Settings dialog with a fresh DTO.
    /// </summary>
    private void OpenCreateDialog()
    {
        _createDto = new CreateCompanySystemSettingsDto();
        _showCreateDialog = true;
    }

    /// <summary>
    /// Submits the Create Settings form — creates a new CompanySystemSettings record.
    /// This only registers the tenant configuration; provisioning is a separate step.
    /// </summary>
    private async Task CreateSettings()
    {
        if (_createForm == null) return;
        await _createForm.Validate();
        if (!_createFormValid || _createDto.CompanyId == 0) return;

        try
        {
            await SettingsService.CreateSettingsAsync(_createDto);
            Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
            _showCreateDialog = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    // ========== Edit Settings ==========

    /// <summary>
    /// Opens the Edit Settings dialog pre-populated with the selected settings data.
    /// Schema name is read-only (immutable after creation).
    /// </summary>
    private void OpenEditDialog(CompanySystemSettingsDto settings)
    {
        _editCompanyId = settings.CompanyId;
        _editCompanyName = settings.CompanyName;
        _editSchemaName = settings.SchemaName;
        // Pre-filled with the stored values: the admin endpoint writes both fields as sent,
        // so an emptied MaxUsers field (null) means "unlimited", not "keep".
        _editDto = new UpdateCompanyAdminSettingsDto
        {
            MaxUsers = settings.MaxUsers,
            AdminNotes = settings.AdminNotes
        };
        _showEditDialog = true;
    }

    /// <summary>
    /// Submits the Edit Settings form — updates the SysAdmin-only MaxUsers / AdminNotes pair.
    /// </summary>
    private async Task UpdateSettings()
    {
        if (_editForm == null) return;
        await _editForm.Validate();
        if (!_editFormValid) return;

        try
        {
            await SettingsService.UpdateAdminSettingsAsync(_editCompanyId, _editDto);
            Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
            _showEditDialog = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    // ========== Tenant Lifecycle Actions ==========

    /// <summary>
    /// Provisions a new tenant schema with a confirmation dialog.
    /// This is a long-running operation: CREATE SCHEMA → migrations → seed code tables → create issuer.
    /// </summary>
    private async Task ProvisionTenant(CompanySystemSettingsDto settings)
    {
        bool? result = await DialogService.ShowMessageBox(
            L["TenantSettings_ProvisionTitle"].Value,
            string.Format(L["TenantSettings_ProvisionConfirm"].Value, settings.CompanyName, settings.SchemaName),
            yesText: L["TenantSettings_Provision"].Value,
            cancelText: L["Btn_Cancel"].Value);

        if (result == true)
        {
            try
            {
                Snackbar.Add(L["TenantSettings_Provisioning"].Value, Severity.Info);

                var success = await SettingsService.ProvisionTenantAsync(settings.CompanyId);

                if (success)
                {
                    Snackbar.Add(L["TenantSettings_ProvisionSuccess"].Value, Severity.Success);
                    await LoadData();
                }
                else
                {
                    Snackbar.Add(L["TenantSettings_ProvisionFailed"].Value, Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
            }
        }
    }

    /// <summary>
    /// Activates a previously deactivated tenant.
    /// </summary>
    private async Task ActivateTenant(long companyId)
    {
        try
        {
            var success = await SettingsService.ActivateTenantAsync(companyId);

            if (success)
            {
                Snackbar.Add(L["TenantSettings_ActivateSuccess"].Value, Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(L["TenantSettings_ActivateFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Deactivates a tenant with a confirmation dialog.
    /// The database remains but all user access is blocked.
    /// </summary>
    private async Task DeactivateTenant(CompanySystemSettingsDto settings)
    {
        bool? result = await DialogService.ShowMessageBox(
            L["TenantSettings_DeactivateTitle"].Value,
            string.Format(L["TenantSettings_DeactivateConfirm"].Value, settings.CompanyName),
            yesText: L["TenantSettings_Deactivate"].Value,
            cancelText: L["Btn_Cancel"].Value);

        if (result == true)
        {
            try
            {
                var success = await SettingsService.DeactivateTenantAsync(settings.CompanyId);

                if (success)
                {
                    Snackbar.Add(L["TenantSettings_DeactivateSuccess"].Value, Severity.Success);
                    await LoadData();
                }
                else
                {
                    Snackbar.Add(L["TenantSettings_DeactivateFailed"].Value, Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
            }
        }
    }

    /// <summary>
    /// Applies pending EF Core migrations to a specific tenant's database.
    /// </summary>
    private async Task MigrateTenant(long companyId)
    {
        try
        {
            var success = await SettingsService.MigrateTenantAsync(companyId);

            if (success)
            {
                Snackbar.Add(L["TenantSettings_MigrateSuccess"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["TenantSettings_MigrateFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }
}
