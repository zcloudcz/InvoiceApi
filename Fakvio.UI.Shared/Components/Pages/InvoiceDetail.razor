    /// <summary>
    /// Restores a soft-deleted invoice back to Draft status.
    /// After a successful restore, reloads the invoice data so the UI
    /// reflects the updated status and re-enables editing actions.
    /// </summary>
    private async Task RestoreInvoice()
    {
        try
        {
            var result = await InvoiceService.RestoreAsync(Id);
            if (result != null)
            {
                Snackbar.Add(L["Invoice_Restored"].Value, Severity.Success);
                // Reload invoice data to refresh status chip and action buttons.
                _invoice = result;
            }
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    /// <summary>
    /// Downloads the invoice as PDF via JS interop.
    /// </summary>
    private async Task DownloadPdf()
    {
        if (_invoice == null) return;
        try
        {
            var pdfBytes = await InvoiceService.ExportToPdfAsync(Id);
            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                var base64 = Convert.ToBase64String(pdfBytes);
                var fileName = $"Invoice_{_invoice.DocumentNumber ?? Id.ToString()}.pdf";
                await JS.InvokeVoidAsync("downloadFile", fileName, base64, "application/pdf");
                Snackbar.Add(L["Invoice_PdfDownloaded"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Invoice_PdfFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error downloading PDF: {ex.Message}", Severity.Error); }
    }

    /// <summary>
    /// Sends invoice by email with PDF attachment.
    /// </summary>
    private async Task SendEmail()
    {
        if (_invoice == null || string.IsNullOrWhiteSpace(_emailRecipient)) return;

        try
        {
            _sendingEmail = true;
            var success = await InvoiceService.SendEmailAsync(Id, _emailRecipient);
            if (success)
            {
                Snackbar.Add(string.Format(L["Invoice_EmailSentTo"].Value, _emailRecipient), Severity.Success);
                _showEmailDialog = false;
                _emailRecipient = "";
                await LoadInvoice(); // Refresh to show updated email sent status
            }
            else
            {
                Snackbar.Add(L["Invoice_EmailFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error sending email: {ex.Message}", Severity.Error); }
        finally { _sendingEmail = false; }
    }

    /// <summary>
    /// Loads active PDF content templates for the template picker split button.
    /// Determines the template type based on the invoice's document type.
    /// </summary>
    private async Task LoadPdfTemplatesAsync()
    {
        try
        {
            var templateType = _invoice?.DocumentType == EDocumentType.CreditNote
                ? EContentTemplateType.CreditNotePdf
                : EContentTemplateType.InvoicePdf;
            _pdfTemplates = await ContentTemplateService.GetAllAsync(templateType, includeInactive: false);
            StateHasChanged();
        }
        catch
        {
            // Non-critical — template picker just won't show alternative templates
            _pdfTemplates = new List<ContentTemplateDto>();
        }
    }

    /// <summary>
    /// Downloads the invoice PDF using a specific content template.
    /// Called from the PDF template picker dropdown menu.
    /// </summary>
    private async Task DownloadPdfWithTemplate(long templateId)
    {
        if (_invoice == null) return;
        try
        {
            var pdfBytes = await InvoiceService.ExportToPdfAsync(Id, templateId);
            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                var base64 = Convert.ToBase64String(pdfBytes);
                var fileName = $"Invoice_{_invoice.DocumentNumber ?? Id.ToString()}.pdf";
                await JS.InvokeVoidAsync("downloadFile", fileName, base64, "application/pdf");
                Snackbar.Add(L["Invoice_PdfDownloaded"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Invoice_PdfFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error downloading PDF: {ex.Message}", Severity.Error); }
    }

    private void GoBack() => Navigation.NavigateTo("/invoices");

    // --- Validation helpers ---

    /// <summary>
    /// Validates that VariableSymbol contains only digits and is max 10 characters.
    /// Returns null if valid, or an error message string if invalid.
    /// </summary>
    private string? ValidateVariableSymbol(string? value)
    {
        if (string.IsNullOrEmpty(value)) return null; // optional field
        if (value.Length > 10) return L["Invoice_VSMaxLength"].Value;
        if (!value.All(char.IsDigit)) return L["Invoice_VSDigitsOnly"].Value;
        return null;
    }

    // --- Helpers ---

    private Color GetStatusColor(EInvoiceStatus status) => status switch
    {
        EInvoiceStatus.Draft => Color.Default,
        EInvoiceStatus.Completed => Color.Info,
        EInvoiceStatus.Paid => Color.Success,
        EInvoiceStatus.Creditnoted => Color.Warning,
        EInvoiceStatus.Deleted => Color.Dark,
        _ => Color.Default
    };

    private string GetStatusText(EInvoiceStatus status) => status switch
    {
        EInvoiceStatus.Draft => L["Invoice_StatusDraft"].Value,
        EInvoiceStatus.Completed => L["Invoice_StatusIssued"].Value,
        EInvoiceStatus.Paid => L["Invoice_StatusPaid"].Value,
        EInvoiceStatus.Creditnoted => L["Invoice_StatusCredited"].Value,
        EInvoiceStatus.Deleted => L["Invoice_StatusDeleted"].Value,
        _ => status.ToString()
    };
}
