    /// <summary>
    /// Downloads the invoice as PDF via JS interop.
    /// </summary>
    private async Task DownloadPdf()
    {
        if (_invoice == null) return;
        try
        {
            var pdfBytes = await InvoiceService.ExportToPdfAsync(Id);
            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                var base64 = Convert.ToBase64String(pdfBytes);
                var prefix = GetPdfFileNamePrefix(_invoice.DocumentType);
                var fileName = $"{prefix}_{_invoice.DocumentNumber ?? Id.ToString()}.pdf";
                await JS.InvokeVoidAsync("downloadFile", fileName, base64, "application/pdf");
                Snackbar.Add(L["Invoice_PdfDownloaded"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Invoice_PdfFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error downloading PDF: {ex.Message}", Severity.Error); }
    }

    /// <summary>
    /// Downloads the invoice as an ISDOC 6.0.2 XML file via JS interop.
    /// ISDOC is the Czech electronic invoice standard (importable in Pohoda, Money S3, Helios, etc.).
    /// The button is disabled in Draft state so we only export legally issued invoices.
    /// </summary>
    private async Task DownloadIsdoc()
    {
        if (_invoice == null) return;
        try
        {
            var isdocBytes = await InvoiceService.ExportIsdocAsync(Id);
            if (isdocBytes != null && isdocBytes.Length > 0)
            {
                var base64 = Convert.ToBase64String(isdocBytes);
                // File name matches the document number so the user can identify the file easily.
                var fileName = $"{_invoice.DocumentNumber ?? Id.ToString()}.isdoc";
                await JS.InvokeVoidAsync("downloadFile", fileName, base64, "application/xml");
                Snackbar.Add(L["Invoice_IsdocDownloaded"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Invoice_IsdocFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error downloading ISDOC: {ex.Message}", Severity.Error); }
    }

    /// <summary>
    /// Downloads the invoice as a UBL 2.1 / Peppol BIS Billing 3.0 XML file via JS interop
    /// (ADR 0002, F1.6). Unlike <see cref="DownloadIsdoc"/>, a refused export carries structured
    /// readiness issues (missing Peppol ID, incomplete address, …) — shown via
    /// <see cref="ReadinessIssueText"/>, the same wording <c>ReadinessBanner</c>/<c>SetupChecklist</c>
    /// already use for the very same codes, so the user reads one consistent sentence either way.
    /// </summary>
    private async Task DownloadUbl()
    {
        if (_invoice == null) return;
        try
        {
            var fileName = $"{_invoice.DocumentNumber ?? Id.ToString()}.xml";
            var result = await InvoiceService.ExportUblAsync(Id, fileName);

            if (result.IsSuccess && result.FileBytes != null)
            {
                var base64 = Convert.ToBase64String(result.FileBytes);
                await JS.InvokeVoidAsync("downloadFile", result.FileName ?? fileName, base64, "application/xml");
                Snackbar.Add(L["Invoice_UblDownloaded"].Value, Severity.Success);
            }
            else if (result.Issues.Count > 0)
            {
                var text = string.Join(" ", result.Issues.Select(i => ReadinessIssueText.Describe(L, i)));
                Snackbar.Add(text, Severity.Warning);
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? L["Invoice_UblFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error downloading UBL: {ex.Message}", Severity.Error); }
    }

    /// <summary>
    /// Sends invoice by email with PDF attachment.
    /// </summary>
    private async Task SendEmail()
    {
        if (_invoice == null || string.IsNullOrWhiteSpace(_emailRecipient)) return;

        try
        {
            _sendingEmail = true;
            var success = await InvoiceService.SendEmailAsync(Id, _emailRecipient);
            if (success)
            {
                Snackbar.Add(string.Format(L["Invoice_EmailSentTo"].Value, _emailRecipient), Severity.Success);
                _showEmailDialog = false;
                _emailRecipient = "";
                await LoadInvoice(); // Refresh to show updated email sent status
            }
            else
            {
                Snackbar.Add(L["Invoice_EmailFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error sending email: {ex.Message}", Severity.Error); }
        finally { _sendingEmail = false; }
    }

