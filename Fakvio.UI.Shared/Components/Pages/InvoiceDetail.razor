@page "/invoices/create"
@page "/invoices/{Id:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Fakvio.Contracts.Dto.Invoice
@using Fakvio.Contracts.Dto.Client
@using Fakvio.Contracts.Dto.Currency
@using Fakvio.Contracts.Dto.InvoiceTemplate
@using Fakvio.Contracts.Common
@using Fakvio.Contracts.Dto.ContentTemplate
@using Fakvio.Domain.Enums
@inject FakvioService InvoiceService
@inject ClientApiService ClientService
@inject CurrencyApiService CurrencyService
@inject InvoiceTemplateApiService TemplateService
@inject ContentTemplateApiService ContentTemplateService
@inject NumberSequenceApiService NumberSequenceService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

@* Dynamic page title: "New Credit Note" or "New Invoice" in create mode, "Credit Note Detail" or "Invoice Detail" in view mode *@
<PageTitle>@(_isCreateMode
    ? (_createDto.DocumentType == EDocumentType.CreditNote ? L["CreditNote_New"] : L["Invoice_New"])
    : (_invoice?.DocumentType == EDocumentType.CreditNote ? L["CreditNote_Detail"] : L["Invoice_Detail"]))</PageTitle>

@* Warn user before navigating away from dirty forms (create or edit mode) *@
<UnsavedChangesLock IsDirty="_isDirty" />

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (!_isCreateMode && (_errorMessage != null || _invoice == null))
{
    <MudAlert Severity="Severity.Error">@(_errorMessage ?? L["Msg_NotFound"])</MudAlert>
}
else if (_isCreateMode)
{
    @* ============================== CREATE MODE ============================== *@
    @* Header: Back button + title + Save/Cancel buttons *@
    <div class="d-flex flex-wrap align-center gap-2 mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" />
        <MudText Typo="Typo.h4" Class="mr-2">
            @(_createDto.DocumentType == EDocumentType.CreditNote ? L["CreditNote_New"] : L["Invoice_New"])
        </MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" OnClick="GoBack">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveNewInvoice">@L["Btn_Create"]</MudButton>
    </div>

    @* Create form — 3-column card layout for invoice fields *@
    <MudGrid>
        @* Left column: Document settings *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Invoice_Detail"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @* Client selector — reactive: auto-fills billing params from client settings *@
                    <MudSelect Value="_createDto.ClientId"
                               ValueChanged="@((long v) => OnClientChanged(v))"
                               Label="@L["Invoice_Client"].Value" Required="true" Class="mb-3">
                        @foreach (var client in _allClients)
                        {
                            <MudSelectItem Value="@client.Id">@client.CompanyName</MudSelectItem>
                        }
                    </MudSelect>
                    @* Document type selector *@
                    <MudSelect @bind-Value="_createDto.DocumentType" Label="@L["Template_DocumentType"].Value" Class="mb-3">
                        <MudSelectItem Value="@EDocumentType.Invoice">@L["Template_DocumentTypeInvoice"]</MudSelectItem>
                        <MudSelectItem Value="@EDocumentType.CreditNote">@L["Template_DocumentTypeCreditNote"]</MudSelectItem>
                    </MudSelect>
                    @* Original invoice selector — only shown for credit notes *@
                    @if (_createDto.DocumentType == EDocumentType.CreditNote)
                    {
                        <MudSelect @bind-Value="_createDto.OriginalInvoiceId" Label="@L["CreditNote_OriginalInvoice"].Value"
                                   Required="true" Class="mb-3">
                            @foreach (var inv in _completedInvoices)
                            {
                                <MudSelectItem Value="@((long?)inv.Id)">@inv.DocumentNumber - @inv.ClientName</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    @* Currency selector *@
                    <MudSelect @bind-Value="_createDto.CurrencyId" Label="@L["Template_Currency"].Value" Required="true" Class="mb-3">
                        @foreach (var currency in _currencies)
                        {
                            <MudSelectItem Value="@currency.Id">@currency.Code - @currency.Name</MudSelectItem>
                        }
                    </MudSelect>
                    @* Document number — shows preview of next auto-generated number as placeholder.
                       Leave empty for auto-generation (recommended), or type a custom number. *@
                    <MudTextField @bind-Value="_createDto.CustomDocumentNumber"
                                  Label="@L["Invoice_DocumentNumber"].Value"
                                  Placeholder="@_documentNumberPreview"
                                  HelperText="@L["Invoice_AutoGeneratedHint"].Value"
                                  Class="mb-3" />
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Middle column: Dates *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Invoice_Dates"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @* Issue date — reactive: recalculates due date when changed *@
                    <MudDatePicker Date="_createIssueDate"
                                   DateChanged="@(d => OnIssueDateChanged(d))"
                                   Label="@L["Table_IssueDate"].Value" Required="true" Class="mb-3" />
                    <MudDatePicker @bind-Date="_createDueDate" Label="@L["Table_DueDate"].Value" Required="true" Class="mb-3" />
                    <MudDatePicker @bind-Date="_createTaxableSupplyDate" Label="@L["Invoice_TaxableSupplyDate"].Value" Class="mb-3" />
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Right column: Payment settings *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Invoice_PaymentInfo"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <EnumSelect TEnum="EPaymentMethod"
                                NullableValue="_createDto.PaymentMethod"
                                NullableValueChanged="@(v => _createDto.PaymentMethod = v)"
                                Label="@L["Invoice_PaymentMethod"].Value"
                                Nullable="true" />
                    <MudTextField @bind-Value="_createDto.VariableSymbol" Label="@L["Invoice_VariableSymbol"].Value"
                                  MaxLength="10" Validation="@(new Func<string?, string?>(ValidateVariableSymbol))"
                                  HelperText="@L["Invoice_VSDigitsOnly"].Value" Class="mb-3" />
                    @* Bank account selector — shows issuer's accounts from the 1:N BankAccount collection.
                       On selection, populates BankAccountNumber/IBAN/SWIFT on the create DTO. *@
                    <BankAccountSelect BankAccounts="_issuerBankAccounts"
                                       SelectedAccountId="_selectedBankAccountId"
                                       OnBankAccountSelected="OnBankAccountSelected"
                                       Label="@L["BankAccount_SelectAccount"].Value" />
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Full-width: Invoice items editor *@
        <MudItem xs="12">
            <MudText Typo="Typo.h6" Class="mb-2">@L["Invoice_Items"]</MudText>
            <InvoiceItemEditor Items="_createDto.InvoiceItem"
                               ItemsChanged="@(items => _createDto.InvoiceItem = items)" />
        </MudItem>

        @* Full-width: Notes *@
        <MudItem xs="12">
            <MudTextField @bind-Value="_createDto.Notes" Label="@L["Invoice_Notes"].Value" Lines="3" />
        </MudItem>
    </MudGrid>
}
else
{
    @* ============================== VIEW / EDIT MODE ============================== *@
    @* Header: Back button + document number + status chip + action buttons *@
    <div class="d-flex flex-wrap align-center gap-2 mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" />
        <MudText Typo="Typo.h4" Class="mr-2">
            @(_invoice!.DocumentNumber ?? L["Invoice_Draft"].Value)
        </MudText>
        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_invoice?.Status ?? EInvoiceStatus.Draft)">
            @GetStatusText(_invoice.Status)
        </MudChip>
        @* Email sent indicator — shows a chip with sent date if invoice was emailed *@
        @if (_invoice.IsSentByEmail)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.MarkEmailRead">
                @L["Invoice_EmailSentAt"] @_invoice.LastSentByEmailAt?.ToShortDateString()
            </MudChip>
        }
        <MudSpacer />

        @* Action buttons depending on status *@
        @if (_invoice.Status == EInvoiceStatus.Draft && !_isEditing)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="EnableEditing">@L["Btn_Edit"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Send"
                       OnClick="IssueInvoice">@L["Invoice_Issue"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeleteInvoice">@L["Btn_Delete"]</MudButton>
        }
        @* Delete button for Completed invoices — server validates it's the last in sequence *@
        @if (_invoice.Status == EInvoiceStatus.Completed)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeleteInvoice">@L["Btn_Delete"]</MudButton>
        }
        @* Restore button — only visible for deleted invoices, allows undoing accidental deletes *@
        @if (_invoice.Status == EInvoiceStatus.Deleted)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.RestoreFromTrash"
                       OnClick="RestoreInvoice">@L["Invoice_Restore"]</MudButton>
        }
        @if (_isEditing)
        {
            <MudButton Variant="Variant.Text" OnClick="CancelEditing">@L["Btn_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveInvoice">@L["Btn_Save"]</MudButton>
        }
        @if (_invoice.Status == EInvoiceStatus.Completed)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check"
                       OnClick="MarkAsPaid">@L["Invoice_MarkAsPaid"]</MudButton>
        }
        @* PDF download with template selection — split button: primary = default, dropdown = template list *@
        <MudButtonGroup OverrideStyles="false">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       OnClick="DownloadPdf">@L["Btn_ExportPdf"]</MudButton>
            @if (_pdfTemplates.Count > 0)
            {
                <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Variant="Variant.Outlined" Color="Color.Secondary">
                    @foreach (var tmpl in _pdfTemplates)
                    {
                        <MudMenuItem OnClick="@(() => DownloadPdfWithTemplate(tmpl.Id))">@tmpl.Name</MudMenuItem>
                    }
                </MudMenu>
            }
        </MudButtonGroup>
        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Email"
                   OnClick="@(() => _showEmailDialog = true)">@L["Btn_SendEmail"]</MudButton>
    </div>

    @* Main content: responsive grid with info cards + items *@
    @if (_isEditing)
    {
        @* ============================== EDIT MODE — same 3-column layout as create mode ============================== *@
        <MudGrid>
            @* Left column: Document settings (readonly fields + editable currency) *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@L["Invoice_Detail"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @* Document number — readonly, cannot be changed after creation *@
                        <MudTextField Value="@_invoice.DocumentNumber" Label="@L["Invoice_DocumentNumber"].Value" ReadOnly="true" Class="mb-3" />
                        @* Client and issuer — readonly after creation *@
                        <MudTextField Value="@_invoice.ClientName" Label="@L["Invoice_Client"].Value" ReadOnly="true" Class="mb-3" />
                        <MudTextField Value="@_invoice.IssuerName" Label="@L["Invoice_Issuer"].Value" ReadOnly="true" Class="mb-3" />
                        @* Document type — readonly *@
                        <MudTextField Value="@(_invoice.DocumentType == EDocumentType.CreditNote
                            ? L["Template_DocumentTypeCreditNote"].Value : L["Template_DocumentTypeInvoice"].Value)"
                                      Label="@L["Template_DocumentType"].Value" ReadOnly="true" Class="mb-3" />
                        @* Currency — readonly (changing currency on existing invoice is risky) *@
                        <MudTextField Value="@($"{_invoice.CurrencyCode} ({_invoice.CurrencySymbol})")"
                                      Label="@L["Template_Currency"].Value" ReadOnly="true" Class="mb-3" />
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Middle column: Dates (editable) *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@L["Invoice_Dates"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @* Issue date — readonly after creation *@
                        <MudTextField Value="@_invoice.IssueDate?.ToShortDateString()" Label="@L["Table_IssueDate"].Value" ReadOnly="true" Class="mb-3" />
                        <MudDatePicker @bind-Date="_editDueDate" Label="@L["Table_DueDate"].Value" Class="mb-3" />
                        <MudDatePicker @bind-Date="_editTaxableSupplyDate" Label="@L["Invoice_TaxableSupplyDate"].Value" Class="mb-3" />
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Right column: Payment settings (editable) *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@L["Invoice_PaymentInfo"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <EnumSelect TEnum="EPaymentMethod"
                                    NullableValue="_editDto.PaymentMethod"
                                    NullableValueChanged="@(v => _editDto.PaymentMethod = v)"
                                    Label="@L["Invoice_PaymentMethod"].Value"
                                    Nullable="true" />
                        <MudTextField @bind-Value="_editDto.VariableSymbol" Label="@L["Invoice_VariableSymbol"].Value"
                                      MaxLength="10" Validation="@(new Func<string?, string?>(ValidateVariableSymbol))"
                                      HelperText="@L["Invoice_VSDigitsOnly"].Value" Class="mb-3" />
                        @* Bank account selector — shows issuer's accounts for editing *@
                        <BankAccountSelect BankAccounts="_issuerBankAccounts"
                                           SelectedAccountId="_selectedBankAccountId"
                                           OnBankAccountSelected="OnEditBankAccountSelected"
                                           Label="@L["BankAccount_SelectAccount"].Value" />
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Full-width: Editable items grid *@
            <MudItem xs="12">
                <MudText Typo="Typo.h6" Class="mb-2">@L["Invoice_Items"]</MudText>
                <InvoiceItemEditor Items="_editItems"
                                   ItemsChanged="@(items => _editItems = items)" />
            </MudItem>

            @* Full-width: Notes *@
            <MudItem xs="12">
                <MudTextField @bind-Value="_editDto.Notes" Label="@L["Invoice_Notes"].Value" Lines="3" />
            </MudItem>
        </MudGrid>
    }
    else
    {
        @* ============================== VIEW MODE — readonly info cards ============================== *@
        <MudGrid>
            @* Left column: Invoice info *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@L["Invoice_Detail"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string" Dense="true">
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Numbers">
                                <strong>@L["Invoice_DocumentNumber"]:</strong> @_invoice.DocumentNumber
                            </MudListItem>
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Business">
                                <strong>@L["Invoice_Client"]:</strong> @_invoice.ClientName
                            </MudListItem>
                            <MudListItem T="string" Icon="@Icons.Material.Filled.AccountBalance">
                                <strong>@L["Invoice_Issuer"]:</strong> @_invoice.IssuerName
                            </MudListItem>
                            <MudListItem T="string" Icon="@Icons.Material.Filled.CalendarToday">
                                <strong>@L["Table_IssueDate"]:</strong> @_invoice.IssueDate?.ToShortDateString()
                            </MudListItem>
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Event">
                                <strong>@L["Table_DueDate"]:</strong> @_invoice.DueDate?.ToShortDateString()
                            </MudListItem>
                            @if (_invoice.TaxableSupplyDate.HasValue)
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.DateRange">
                                    <strong>@L["Invoice_TaxableSupplyDate"]:</strong> @_invoice.TaxableSupplyDate.Value.ToShortDateString()
                                </MudListItem>
                            }
                            @* Show original invoice reference for credit notes *@
                            @if (_invoice.OriginalInvoiceId.HasValue)
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.Link">
                                    <strong>@L["CreditNote_OriginalInvoice"]:</strong>
                                    <MudLink Href="@($"/invoices/{_invoice.OriginalInvoiceId}")">
                                        @(_invoice.OriginalInvoiceNumber ?? _invoice.OriginalInvoiceId.ToString())
                                    </MudLink>
                                </MudListItem>
                            }
                        </MudList>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Middle column: Payment info *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@L["Invoice_PaymentInfo"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string" Dense="true">
                            @if (!string.IsNullOrEmpty(_invoice.VariableSymbol))
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.Tag">
                                    <strong>@L["Invoice_VariableSymbol"]:</strong> @_invoice.VariableSymbol
                                </MudListItem>
                            }
                            @if (_invoice.PaymentMethod.HasValue)
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.Payment">
                                    <strong>@L["Invoice_PaymentMethod"]:</strong> @_invoice.PaymentMethod
                                </MudListItem>
                            }
                            @if (!string.IsNullOrEmpty(_invoice.BankAccountNumber))
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.AccountBalance">
                                    <strong>@L["Invoice_BankAccount"]:</strong> @_invoice.BankAccountNumber
                                </MudListItem>
                            }
                            @if (!string.IsNullOrEmpty(_invoice.IBAN))
                            {
                                <MudListItem T="string">
                                    <strong>IBAN:</strong> @_invoice.IBAN
                                </MudListItem>
                            }
                            <MudListItem T="string" Icon="@Icons.Material.Filled.CurrencyExchange">
                                <strong>@L["Template_Currency"]:</strong> @_invoice.CurrencyCode (@_invoice.CurrencySymbol)
                            </MudListItem>
                        </MudList>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Right column: Totals summary *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@L["Invoice_Summary"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string" Dense="true">
                            <MudListItem T="string">
                                <strong>@L["Invoice_TotalBeforeVat"]:</strong> @_invoice.TotalBeforeVat.ToString("N2") @_invoice.CurrencyCode
                            </MudListItem>
                            <MudListItem T="string">
                                <strong>@L["Invoice_TotalVat"]:</strong> @_invoice.TotalVat.ToString("N2") @_invoice.CurrencyCode
                            </MudListItem>
                            <MudListItem T="string">
                                <MudText Typo="Typo.h5" Color="Color.Primary">
                                    @_invoice.TotalWithVat.ToString("N2") @_invoice.CurrencyCode
                                </MudText>
                            </MudListItem>
                        </MudList>
                        @if (_invoice.PaidAt.HasValue)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                                @L["Invoice_PaidOn"] @_invoice.PaidAt.Value.ToShortDateString()
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Full-width: Read-only items table *@
            <MudItem xs="12">
                <MudText Typo="Typo.h6" Class="mb-2">@L["Invoice_Items"]</MudText>
                <MudTable Items="@_invoice.InvoiceItem" Dense="true" Hover="true" Striped="true" Elevation="2">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>@L["InvoiceItem_Description"]</MudTh>
                        <MudTh Style="text-align:right">@L["InvoiceItem_Quantity"]</MudTh>
                        <MudTh>@L["InvoiceItem_Unit"]</MudTh>
                        <MudTh Style="text-align:right">@L["InvoiceItem_UnitPrice"]</MudTh>
                        <MudTh Style="text-align:right">@L["InvoiceItem_VatRate"]</MudTh>
                        <MudTh Style="text-align:right">@L["InvoiceItem_Total"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.OrderIndex</MudTd>
                        <MudTd>@context.Description</MudTd>
                        <MudTd Style="text-align:right">@context.Quantity.ToString("N2")</MudTd>
                        <MudTd>@context.Unit</MudTd>
                        <MudTd Style="text-align:right">@context.UnitPrice.ToString("N2")</MudTd>
                        <MudTd Style="text-align:right">@context.VatRatePercentage.ToString("N0")%</MudTd>
                        <MudTd Style="text-align:right"><strong>@context.TotalWithVat.ToString("N2")</strong></MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>

            @* Notes section *@
            @if (!string.IsNullOrEmpty(_invoice.Notes))
            {
                <MudItem xs="12">
                    <MudCard Elevation="2" Class="mt-2">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2">@L["Invoice_Notes"]</MudText>
                            <MudText>@_invoice.Notes</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }

            @* QR code section — QR Platba+F (payment + invoice) or QR Faktura (invoice only) *@
            @if (_invoice.Status != EInvoiceStatus.Draft)
            {
                <MudItem xs="12" md="4">
                    <MudCard Elevation="2" Class="mt-2">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">
                                    @(string.IsNullOrWhiteSpace(_invoice.IBAN) ? "QR Faktura" : "QR Platba+F")
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Style="text-align: center;">
                            @if (_qrCodeBase64 != null)
                            {
                                <img src="data:image/png;base64,@_qrCodeBase64" alt="QR Code"
                                     style="max-width: 250px; width: 100%; image-rendering: pixelated;" />
                                <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Default">
                                    @(string.IsNullOrWhiteSpace(_invoice.IBAN)
                                        ? @L["QR_InvoiceOnly"]
                                        : @L["QR_PaymentAndInvoice"])
                                </MudText>
                            }
                            else if (_qrLoading)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                            }
                            else
                            {
                                <MudText Color="Color.Warning">@L["QR_NotAvailable"]</MudText>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

    @* Email send dialog *@
    <MudDialog @bind-Visible="_showEmailDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Invoice_SendByEmail"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                @L["Invoice_SendingInvoice"] <strong>@_invoice.DocumentNumber</strong> @L["Invoice_ToClient"] <strong>@_invoice.ClientName</strong>
            </MudAlert>
            <MudTextField @bind-Value="_emailRecipient" Label="@L["Invoice_EmailRecipient"].Value" Required="true"
                          InputType="InputType.Email" HelperText="@L["Invoice_RecipientHelper"].Value" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _showEmailDialog = false)">@L["Btn_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendEmail"
                       Disabled="@(string.IsNullOrWhiteSpace(_emailRecipient) || _sendingEmail)">
                @if (_sendingEmail)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>@L["Invoice_Sending"]</span>
                }
                else
                {
                    <span>@L["Invoice_Send"]</span>
                }
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    /// <summary>
    /// Route parameter — invoice ID from URL.
    /// Id == 0 means create mode (/invoices/create), Id > 0 means view/edit mode (/invoices/{id}).
    /// </summary>
    [Parameter] public long Id { get; set; }

    /// <summary>
    /// Query parameter — when ?edit=true, auto-enters edit mode after loading.
    /// Used when creating from template so user can review/adjust the pre-filled data.
    /// </summary>
    [SupplyParameterFromQuery] public bool Edit { get; set; }

    /// <summary>
    /// Query parameter — when ?type=CreditNote, pre-sets document type to CreditNote in create mode.
    /// Used by the "New Credit Note" button from the credit notes list page.
    /// </summary>
    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeParam { get; set; }

    /// <summary>
    /// Query parameter — template ID to pre-fill the create form from a template.
    /// Used by the "New from Template" dialog: navigates here without creating a DB record.
    /// </summary>
    [SupplyParameterFromQuery(Name = "templateId")]
    public long? TemplateId { get; set; }

    /// <summary>
    /// Query parameter — client ID to pre-fill when creating from template.
    /// Passed together with templateId from the "New from Template" dialog.
    /// </summary>
    [SupplyParameterFromQuery(Name = "clientId")]
    public long? TemplateClientId { get; set; }

    private InvoiceDto? _invoice;
    private bool _loading = true;
    private string? _errorMessage; // Stores API error message for display instead of generic "Not Found"

    // Create mode state — true when Id == 0 (navigated to /invoices/create)
    private bool _isCreateMode => Id == 0;
    private CreateInvoiceDto _createDto = new();
    private DateTime? _createIssueDate = DateTime.Now;
    private DateTime? _createDueDate = DateTime.Now.AddDays(14);
    private DateTime? _createTaxableSupplyDate = DateTime.Now;
    private List<ClientDto> _allClients = new();
    private List<CurrencyDto> _currencies = new();
    private ClientDto? _issuer;

    // Bank account selection state — loaded from issuer's BankAccount collection
    private List<BankAccountDto> _issuerBankAccounts = new();
    private long? _selectedBankAccountId;

    // Document number preview — shows what the next auto-generated number will be
    private string? _documentNumberPreview;

    // Dirty tracking for unsaved changes warning
    private bool _isDirty = false;

    // Credit note: completed invoices available as OriginalInvoiceId (only loaded for CreditNote type)
    private List<InvoiceDto> _completedInvoices = new();

    // QR code state — loaded for completed/paid invoices in view mode
    private string? _qrCodeBase64;
    private bool _qrLoading = false;

    // PDF template list — loaded once, used for the PDF template picker split button
    private List<ContentTemplateDto> _pdfTemplates = new();

    // Tracks previous Id to detect parameter changes (e.g., /invoices/create → /invoices/1).
    // Blazor reuses components for the same @page route, so OnInitializedAsync only fires once.
    // OnParametersSetAsync fires every time [Parameter] values change.
    private long _previousId = -1;

    // Edit mode state (only for Draft invoices in view mode)
    private bool _isEditing = false;
    private UpdateInvoiceDto _editDto = new();
    private List<CreateInvoiceItemDto> _editItems = new();
    private DateTime? _editDueDate;
    private DateTime? _editTaxableSupplyDate;

    // Email dialog state
    private bool _showEmailDialog = false;
    private bool _sendingEmail = false;
    private string _emailRecipient = "";

    /// <summary>
    /// Called every time a [Parameter] value changes.
    /// Detects navigation between /invoices/create ↔ /invoices/{id} and reloads accordingly.
    /// Without this, saving a new invoice and navigating to /invoices/{newId} shows "Not Found"
    /// because Blazor reuses the same component instance and OnInitializedAsync only fires once.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        // Only reload when the Id parameter actually changes
        if (Id == _previousId) return;
        _previousId = Id;

        if (_isCreateMode)
        {
            // Create mode — load reference data (clients, issuer, currencies) in parallel
            await Task.WhenAll(LoadClients(), LoadIssuer(), LoadCurrencies());

            // If creating from template, load template data and pre-fill the form
            if (TemplateId.HasValue && TemplateId.Value > 0)
            {
                await InitCreateDtoFromTemplate(TemplateId.Value, TemplateClientId);
            }
            else
            {
                InitCreateDto();
            }

            // Load completed invoices for credit note OriginalInvoiceId dropdown (if creating a credit note)
            if (_createDto.DocumentType == EDocumentType.CreditNote)
            {
                await LoadCompletedInvoices();
            }

            // Pre-fill document number from the default sequence (user can still override)
            await LoadDocumentNumberPreview();
        }
        else
        {
            // View/edit mode — load existing invoice (transition from create → view after save)
            _isEditing = false;
            _isDirty = false;
            await LoadInvoice();
        }
    }

    /// <summary>
    /// Loads customers (non-issuers) for the client dropdown.
    /// </summary>
    private async Task LoadClients()
    {
        try { _allClients = await ClientService.GetAllAsync(includeInactive: false); }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    /// <summary>
    /// Loads the issuer (user's company) via GET /api/client/issuer.
    /// Also populates the bank account list for the BankAccountSelect dropdown.
    /// </summary>
    private async Task LoadIssuer()
    {
        try
        {
            _issuer = await ClientService.GetIssuerAsync();
            // Populate bank accounts from the issuer for the dropdown selector
            _issuerBankAccounts = _issuer?.BankAccount ?? new List<BankAccountDto>();
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    /// <summary>
    /// Loads active currencies for the currency dropdown.
    /// </summary>
    private async Task LoadCurrencies()
    {
        try { _currencies = await CurrencyService.GetActiveCurrenciesAsync(); }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    /// <summary>
    /// Loads completed/paid invoices for the OriginalInvoiceId dropdown when creating a credit note.
    /// Only shows invoices that can be credited (Completed or Paid status).
    /// </summary>
    private async Task LoadCompletedInvoices()
    {
        try
        {
            var result = await InvoiceService.GetPagedAsync(
                page: 1,
                pageSize: 200, // Reasonable limit for dropdown
                documentType: EDocumentType.Invoice,
                status: EInvoiceStatus.Completed);

            var paidResult = await InvoiceService.GetPagedAsync(
                page: 1,
                pageSize: 200,
                documentType: EDocumentType.Invoice,
                status: EInvoiceStatus.Paid);

            _completedInvoices = result.Items.Concat(paidResult.Items)
                .OrderByDescending(i => i.IssueDate)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Previews the next document number from the default sequence.
    /// Shown as Placeholder text on the document number field — NOT pre-filled into
    /// CustomDocumentNumber, so the backend always calls GenerateNextNumberAsync which
    /// properly increments the sequence counter. Also pre-fills VariableSymbol from digits.
    /// If a custom number sequence is set (e.g., from template), uses that instead.
    /// Silently does nothing if no default sequence is configured.
    /// </summary>
    private async Task LoadDocumentNumberPreview()
    {
        try
        {
            string? preview;

            if (_createDto.NumberSequenceId.HasValue && _createDto.NumberSequenceId.Value > 0)
            {
                // Template specified a custom number sequence — use that
                preview = await NumberSequenceService.PreviewNextNumberAsync(
                    _createDto.NumberSequenceId.Value, _createIssueDate ?? DateTime.Now);
            }
            else
            {
                // Use default sequence for the document type
                preview = await NumberSequenceService.PreviewByDocumentTypeAsync(
                    _createDto.DocumentType, _createIssueDate ?? DateTime.Now);
            }

            _documentNumberPreview = preview;

            // Pre-fill VariableSymbol from the preview number digits so the user sees it
            // immediately (Czech banking: max 10 digits only).
            // We do NOT pre-fill CustomDocumentNumber — leaving it null ensures the backend
            // calls GenerateNextNumberAsync which properly increments the sequence counter.
            // The preview is shown as Placeholder text on the document number field.
            if (!string.IsNullOrEmpty(preview) && string.IsNullOrEmpty(_createDto.VariableSymbol))
            {
                _createDto.VariableSymbol = new string(preview
                    .Where(char.IsDigit).Take(10).ToArray());
            }
        }
        catch
        {
            // Preview is non-critical — failure leaves the field empty (backend auto-generates)
            _documentNumberPreview = null;
        }
    }

    /// <summary>
    /// Initializes the create DTO with default values after reference data is loaded.
    /// If ?type=CreditNote query param is present, sets DocumentType to CreditNote.
    /// </summary>
    private void InitCreateDto()
    {
        // Determine document type from query parameter (e.g., ?type=CreditNote from nav link)
        var docType = TypeParam == "CreditNote" ? EDocumentType.CreditNote : EDocumentType.Invoice;

        // Auto-select the default bank account from the issuer's 1:N BankAccount collection
        var defaultAccount = _issuerBankAccounts.FirstOrDefault(a => a.IsDefault)
                             ?? _issuerBankAccounts.FirstOrDefault();
        _selectedBankAccountId = defaultAccount?.Id;

        _createDto = new CreateInvoiceDto
        {
            DocumentType = docType,
            CurrencyId = _currencies.FirstOrDefault()?.Id ?? 1,
            PaymentMethod = EPaymentMethod.BankTransfer,
            IssuerId = _issuer?.Id ?? 0,
            // Auto-fill bank account from the issuer's default bank account (1:N)
            BankAccountNumber = defaultAccount?.AccountNumber,
            IBAN = defaultAccount?.IBAN,
            SWIFT = defaultAccount?.SWIFT,
            InvoiceItem = new List<CreateInvoiceItemDto>()
        };
        _loading = false;
    }

    /// <summary>
    /// Initializes the create DTO by loading a template and pre-filling all fields from it.
    /// This is the "New from Template" flow — no DB record is created until user clicks Save.
    /// The template provides: DocumentType, Issuer, Currency, PaymentMethod, BankAccount,
    /// VariableSymbol, Notes, InvoiceItems, NumberSequenceId, and DueDateOffsetDays.
    /// </summary>
    private async Task InitCreateDtoFromTemplate(long templateId, long? clientId)
    {
        try
        {
            var template = await TemplateService.GetByIdAsync(templateId);
            if (template == null)
            {
                Snackbar.Add(L["Msg_NotFound"].Value, Severity.Warning);
                InitCreateDto(); // Fall back to empty form
                return;
            }

            // Calculate dates from template's DueDateOffsetDays
            var issueDate = DateTime.Now;
            var dueDate = issueDate.AddDays(template.DueDateOffsetDays);

            _createIssueDate = issueDate;
            _createDueDate = dueDate;
            _createTaxableSupplyDate = issueDate;

            // Resolve client: use provided clientId, or fall back to template's default, or 0
            var resolvedClientId = clientId ?? template.ClientId ?? 0;

            // Auto-select the default bank account from the issuer's 1:N BankAccount collection
            var defaultAccount = _issuerBankAccounts.FirstOrDefault(a => a.IsDefault)
                                 ?? _issuerBankAccounts.FirstOrDefault();
            _selectedBankAccountId = defaultAccount?.Id;

            _createDto = new CreateInvoiceDto
            {
                DocumentType = template.DocumentType,
                ClientId = resolvedClientId,
                IssuerId = template.IssuerId > 0 ? template.IssuerId : (_issuer?.Id ?? 0),
                IssueDate = issueDate,
                DueDate = dueDate,
                TaxableSupplyDate = issueDate,
                CurrencyId = template.CurrencyId,
                PaymentMethod = template.PaymentMethod ?? EPaymentMethod.BankTransfer,
                VariableSymbol = template.VariableSymbol,
                // Template bank account takes priority; if template has none, fall back to issuer's default
                BankAccountNumber = template.BankAccountNumber ?? defaultAccount?.AccountNumber,
                IBAN = defaultAccount?.IBAN,
                SWIFT = defaultAccount?.SWIFT,
                Notes = template.Notes,
                NumberSequenceId = template.NumberSequenceId,
                // Copy invoice items from template
                InvoiceItem = template.InvoiceItem.Select(item => new CreateInvoiceItemDto
                {
                    OrderIndex = item.OrderIndex,
                    Description = item.Description,
                    Quantity = item.Quantity,
                    Unit = item.Unit,
                    UnitPrice = item.UnitPrice,
                    VatRateId = item.VatRateId,
                    VatRatePercentage = item.VatRatePercentage,
                    ProductCode = item.ProductCode,
                    Notes = item.Notes
                }).ToList()
            };

            // If client is selected, auto-fill billing params from client settings too
            // Client's BillingSettings (DueDays + DueDateCalculationType) overrides template's offset
            if (resolvedClientId > 0)
            {
                var client = _allClients.FirstOrDefault(c => c.Id == resolvedClientId);
                if (client?.BillingSettings != null)
                {
                    var bs = client.BillingSettings;
                    // Client's DueDays + DueDateCalculationType overrides template's simple offset
                    RecalculateDueDate(bs.DueDays, bs.DueDateCalculationType);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
            InitCreateDto(); // Fall back to empty form on error
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Loads the invoice detail from the API by ID.
    /// If ?edit=true query parameter is present and invoice is Draft, auto-enters edit mode.
    /// </summary>
    private async Task LoadInvoice()
    {
        try
        {
            _loading = true;
            _invoice = await InvoiceService.GetByIdAsync(Id);

            // Auto-enter edit mode when redirected from "New from Template" dialog
            if (Edit && _invoice != null && _invoice.Status == EInvoiceStatus.Draft)
            {
                EnableEditing();
            }

            // Load PDF templates for the template picker split button
            if (_invoice != null)
            {
                _ = LoadPdfTemplatesAsync();
            }

            // Load QR code for completed/paid invoices (non-blocking, runs in background)
            if (_invoice != null && _invoice.Status != EInvoiceStatus.Draft)
            {
                _ = LoadQrCodeAsync();
            }
        }
        catch (Exception ex)
        {
            // Store error message for display in the template instead of generic "Nenalezeno".
            // ApiException carries the actual API error (403 Forbidden, 500 Server Error, etc.).
            _errorMessage = ex.Message;
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Loads the QR code image asynchronously for the current invoice.
    /// Runs in the background — does not block the main page rendering.
    /// </summary>
    private async Task LoadQrCodeAsync()
    {
        try
        {
            _qrLoading = true;
            StateHasChanged();

            var qrBytes = await InvoiceService.GetQrCodeAsync(Id);
            if (qrBytes != null && qrBytes.Length > 0)
            {
                _qrCodeBase64 = Convert.ToBase64String(qrBytes);
            }
        }
        catch (Exception ex)
        {
            // QR code generation failure is non-critical — just log and show "not available"
            _qrCodeBase64 = null;
            Snackbar.Add($"QR code generation failed: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _qrLoading = false;
            StateHasChanged();
        }
    }

    // --- Bank account selection handlers ---

    /// <summary>
    /// Handles bank account selection in CREATE mode.
    /// Populates BankAccountNumber, IBAN, and SWIFT on the create DTO from the selected account.
    /// </summary>
    private void OnBankAccountSelected(BankAccountDto? account)
    {
        _isDirty = true;
        if (account != null)
        {
            _selectedBankAccountId = account.Id;
            _createDto.BankAccountNumber = account.AccountNumber;
            _createDto.IBAN = account.IBAN;
            _createDto.SWIFT = account.SWIFT;
        }
        else
        {
            _selectedBankAccountId = null;
            _createDto.BankAccountNumber = null;
            _createDto.IBAN = null;
            _createDto.SWIFT = null;
        }
    }

    /// <summary>
    /// Handles bank account selection in EDIT mode.
    /// Populates BankAccountNumber, IBAN, and SWIFT on the edit DTO from the selected account.
    /// </summary>
    private void OnEditBankAccountSelected(BankAccountDto? account)
    {
        _isDirty = true;
        if (account != null)
        {
            _selectedBankAccountId = account.Id;
            _editDto.BankAccountNumber = account.AccountNumber;
            _editDto.IBAN = account.IBAN;
            _editDto.SWIFT = account.SWIFT;
        }
        else
        {
            _selectedBankAccountId = null;
            _editDto.BankAccountNumber = null;
            _editDto.IBAN = null;
            _editDto.SWIFT = null;
        }
    }

    // --- Create mode: reactive handlers ---

    /// <summary>
    /// Handles client selection change in create mode.
    /// Auto-fills billing parameters (PaymentMethod, BankAccount) and recalculates
    /// due date from the client's BillingSettings — saves the user manual entry.
    /// Only fills empty fields to avoid overwriting explicit user input.
    /// </summary>
    private void OnClientChanged(long clientId)
    {
        _createDto.ClientId = clientId;
        _isDirty = true;

        var client = _allClients.FirstOrDefault(c => c.Id == clientId);
        if (client?.BillingSettings != null)
        {
            var bs = client.BillingSettings;

            // Auto-fill payment method only if user hasn't set a custom value
            if (_createDto.PaymentMethod == null || _createDto.PaymentMethod == EPaymentMethod.BankTransfer)
            {
                _createDto.PaymentMethod = bs.DefaultPaymentMethod ?? EPaymentMethod.BankTransfer;
            }

            // NOTE: Bank account is NOT auto-filled from client — it comes from the issuer.
            // The invoice bank account is where the customer pays TO (= our company's account).

            // Recalculate due date using client's DueDays AND DueDateCalculationType
            RecalculateDueDate(bs.DueDays, bs.DueDateCalculationType);
        }
    }

    /// <summary>
    /// Handles issue date change in create mode.
    /// Recalculates due date using the selected client's BillingSettings (DueDays + DueDateCalculationType).
    /// Falls back to DaysFromIssue with 14 days if no client or no billing settings.
    /// </summary>
    private void OnIssueDateChanged(DateTime? newDate)
    {
        _createIssueDate = newDate;
        _isDirty = true;

        // Look up the selected client's billing settings for due date calculation
        var client = _allClients.FirstOrDefault(c => c.Id == _createDto.ClientId);
        var dueDays = client?.BillingSettings?.DueDays ?? 14;
        var calcType = client?.BillingSettings?.DueDateCalculationType ?? EDueDateCalculationType.DaysFromIssue;
        RecalculateDueDate(dueDays, calcType);
    }

    /// <summary>
    /// Recalculates due date using DueDateCalculator with the proper EDueDateCalculationType.
    /// Also syncs TaxableSupplyDate (DUZP) to the newly calculated due date —
    /// Czech accounting: when due date changes, tax date should follow.
    /// Called both when client changes and when issue date changes.
    /// </summary>
    /// <param name="dueDays">Number of days from client's BillingSettings (or default 14).</param>
    /// <param name="calculationType">Which algorithm to use (from client's BillingSettings).</param>
    private void RecalculateDueDate(int dueDays, EDueDateCalculationType calculationType = EDueDateCalculationType.DaysFromIssue)
    {
        if (_createIssueDate.HasValue)
        {
            // Use the shared DueDateCalculator to ensure consistent behavior with backend
            _createDueDate = DueDateCalculator.Calculate(_createIssueDate.Value, dueDays, calculationType);

            // Sync TaxableSupplyDate (DUZP) with IssueDate —
            // Czech accounting: datum zdanitelného plnění = datum vystavení
            _createTaxableSupplyDate = _createIssueDate;
        }
    }

    // --- Create mode: save ---

    /// <summary>
    /// Validates and saves a new invoice via POST /api/invoice.
    /// On success, navigates to the newly created invoice's detail page.
    /// </summary>
    private async Task SaveNewInvoice()
    {
        try
        {
            // Validate that a client is selected — the API would reject ClientId=0
            if (_createDto.ClientId <= 0)
            {
                Snackbar.Add(L["Invoice_NoClientSelected"].Value, Severity.Error);
                return;
            }

            // Validate that an issuer exists — the API would reject IssuerId=0
            if (_createDto.IssuerId <= 0)
            {
                Snackbar.Add(L["Invoice_NoIssuerFound"].Value, Severity.Error);
                return;
            }

            if (_createDto.InvoiceItem.Count == 0)
            {
                Snackbar.Add(L["Invoice_AddAtLeastOneItem"].Value, Severity.Warning);
                return;
            }

            // Map date pickers to DTO
            _createDto.IssueDate = _createIssueDate;
            _createDto.DueDate = _createDueDate;
            _createDto.TaxableSupplyDate = _createTaxableSupplyDate;

            var result = await InvoiceService.CreateAsync(_createDto);
            if (result != null)
            {
                // Reset dirty flag and force re-render BEFORE navigation.
                // This ensures the <UnsavedChangesLock> removes <NavigationLock> from the DOM
                // before NavigateTo fires — otherwise Blazor's NavigationLock intercepts the
                // navigation and shows the "leave page?" prompt even though we just saved.
                _isDirty = false;
                StateHasChanged();
                await Task.Yield(); // Let Blazor complete the render cycle

                Snackbar.Add(L["Invoice_Created"].Value, Severity.Success);
                // Navigate to the newly created invoice's detail page
                Navigation.NavigateTo($"/invoices/{result.Id}");
            }
            else
            {
                Snackbar.Add(L["Invoice_CreateFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    // --- Edit mode (existing invoices) ---

    /// <summary>
    /// Switches to edit mode — populates the edit DTO from current invoice data.
    /// Only available for Draft invoices. Client/Issuer cannot be changed after creation.
    /// Also loads issuer bank accounts for the BankAccountSelect dropdown.
    /// </summary>
    private async void EnableEditing()
    {
        if (_invoice == null || _invoice.Status != EInvoiceStatus.Draft) return;

        // Load issuer bank accounts if not already loaded (needed for the BankAccountSelect)
        if (_issuerBankAccounts.Count == 0)
        {
            try
            {
                var issuer = await ClientService.GetIssuerAsync();
                _issuerBankAccounts = issuer?.BankAccount ?? new List<BankAccountDto>();
            }
            catch { /* Non-critical — dropdown will be empty */ }
        }

        // Pre-select the bank account that matches the invoice's current BankAccountNumber
        _selectedBankAccountId = _issuerBankAccounts
            .FirstOrDefault(a => a.AccountNumber == _invoice.BankAccountNumber)?.Id;

        // Populate edit DTO from current invoice (only editable fields)
        _editDto = new UpdateInvoiceDto
        {
            DueDate = _invoice.DueDate,
            TaxableSupplyDate = _invoice.TaxableSupplyDate,
            VariableSymbol = _invoice.VariableSymbol,
            BankAccountNumber = _invoice.BankAccountNumber,
            IBAN = _invoice.IBAN,
            SWIFT = _invoice.SWIFT,
            PaymentMethod = _invoice.PaymentMethod,
            CurrencyId = _invoice.CurrencyId,
            Notes = _invoice.Notes
        };

        _editDueDate = _invoice.DueDate;
        _editTaxableSupplyDate = _invoice.TaxableSupplyDate;

        // Copy items for editing
        _editItems = _invoice.InvoiceItem.Select(i => new CreateInvoiceItemDto
        {
            OrderIndex = i.OrderIndex,
            Description = i.Description,
            Quantity = i.Quantity,
            Unit = i.Unit,
            UnitPrice = i.UnitPrice,
            VatRateId = i.VatRateId,
            VatRatePercentage = i.VatRatePercentage,
            ProductCode = i.ProductCode,
            Notes = i.Notes
        }).ToList();

        _isEditing = true;
        _isDirty = true; // Entering edit mode means the user intends to change something
    }

    /// <summary>
    /// Cancels edit mode without saving — reverts to readonly view.
    /// Resets dirty flag since the user explicitly chose to discard changes.
    /// </summary>
    private void CancelEditing()
    {
        _isEditing = false;
        _isDirty = false;
    }

    /// <summary>
    /// Saves the edited invoice via PUT /api/invoice/{id}.
    /// </summary>
    private async Task SaveInvoice()
    {
        if (_invoice == null) return;

        try
        {
            if (_editItems.Count == 0)
            {
                Snackbar.Add(L["Invoice_AddAtLeastOneItem"].Value, Severity.Warning);
                return;
            }

            _editDto.DueDate = _editDueDate;
            _editDto.TaxableSupplyDate = _editTaxableSupplyDate;
            _editDto.InvoiceItem = _editItems;

            var result = await InvoiceService.UpdateAsync(Id, _editDto);
            if (result != null)
            {
                _isDirty = false; // Reset dirty flag on successful save
                Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                _isEditing = false;
                _invoice = result; // Update displayed data with API response
            }
            else
            {
                Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    // --- Invoice actions ---

    private async Task IssueInvoice()
    {
        try
        {
            var result = await InvoiceService.IssueAsync(Id);
            if (result != null)
            {
                Snackbar.Add(L["Invoice_Issued"].Value, Severity.Success);
                _invoice = result;
            }
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    private async Task MarkAsPaid()
    {
        try
        {
            var result = await InvoiceService.MarkAsPaidAsync(Id);
            if (result != null)
            {
                Snackbar.Add(L["Invoice_MarkedAsPaid"].Value, Severity.Success);
                _invoice = result;
            }
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    private async Task DeleteInvoice()
    {
        try
        {
            if (await InvoiceService.DeleteAsync(Id))
            {
                Snackbar.Add(L["Invoice_Deleted"].Value, Severity.Success);
                Navigation.NavigateTo("/invoices");
            }
