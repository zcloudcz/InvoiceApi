@page "/invoices/create"
@page "/invoices/{Id:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Fakvio.Contracts.Dto.Alert
@using Fakvio.Contracts.Dto.Invoice
@using Fakvio.Contracts.Dto.Client
@using Fakvio.Contracts.Dto.Currency
@using Fakvio.Contracts.Dto.InvoiceTemplate
@using Fakvio.Contracts.Common
@using Fakvio.Contracts.Dto.ContentTemplate
@using Fakvio.Domain.Enums
@inject AlertApiService AlertService
@inject FakvioService InvoiceService
@inject ClientApiService ClientService
@inject CurrencyApiService CurrencyService
@inject InvoiceTemplateApiService TemplateService
@inject ContentTemplateApiService ContentTemplateService
@inject NumberSequenceApiService NumberSequenceService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L

@* Dynamic page title — adapts to document type in both create and view mode *@
<PageTitle>@GetPageTitle()</PageTitle>

@* Warn user before navigating away from dirty forms (create or edit mode) *@
<UnsavedChangesLock IsDirty="_isDirty" />
@if (_saving) { <MudProgressLinear Indeterminate="true" Class="mb-2" /> }

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (!_isCreateMode && (_errorMessage != null || _invoice == null))
{
    <MudAlert Severity="Severity.Error">@(_errorMessage ?? L["Msg_NotFound"])</MudAlert>
}
else if (_isCreateMode)
{
    @* ============================== CREATE MODE ============================== *@
    @* Header: Back button + title + Save/Cancel buttons *@
    <div class="d-flex flex-wrap align-center gap-2 mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" Title="@L["Btn_Back"].Value" />
        <MudText Typo="Typo.h4" Class="mr-2">
            @GetCreateModeTitle()
        </MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" OnClick="GoBack">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   Disabled="_saving" OnClick="SaveNewInvoice">@L["Btn_Create"]</MudButton>
    </div>

    @* Create form — 3-column card layout for invoice fields *@
    <MudGrid>
        @* Left column: Document settings *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Invoice_Detail"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @* Client selector — reactive: auto-fills billing params from client settings *@
                    <MudSelect T="long?" Value="@(_createDto.ClientId > 0 ? (long?)_createDto.ClientId : null)"
                               ValueChanged="@((long? v) => OnClientChanged(v ?? 0))"
                               Placeholder="@L["Invoice_SelectClient"].Value" Strict="true"
                               Label="@L["Invoice_Client"].Value" Required="true" Class="mb-3">
                        @foreach (var client in _allClients)
                        {
                            <MudSelectItem T="long?" Value="@((long?)client.Id)">@client.CompanyName</MudSelectItem>
                        }
                    </MudSelect>
                    @* Document type selector — all supported types *@
                    <MudSelect T="EDocumentType" Value="_createDto.DocumentType" ValueChanged="OnDocumentTypeChanged" Label="@L["Template_DocumentType"].Value" Class="mb-3">
                        <MudSelectItem Value="@EDocumentType.Invoice">@L["Template_DocumentTypeInvoice"]</MudSelectItem>
                        <MudSelectItem Value="@EDocumentType.CreditNote">@L["Template_DocumentTypeCreditNote"]</MudSelectItem>
                        <MudSelectItem Value="@EDocumentType.Proforma">@L["Template_DocumentTypeProforma"]</MudSelectItem>
                        <MudSelectItem Value="@EDocumentType.TaxReceiptForAdvance">@L["Template_DocumentTypeTaxReceiptForAdvance"]</MudSelectItem>
                    </MudSelect>
                    @* Original invoice selector — only shown for credit notes *@
                    @if (_createDto.DocumentType == EDocumentType.CreditNote)
                    {
                        <MudAutocomplete T="InvoiceDto" Value="_originalInvoice" ValueChanged="OnOriginalInvoiceChanged"
                                         SearchFunc="SearchOriginalInvoices" ToStringFunc="@(i => i == null ? string.Empty : $"{i.DocumentNumber} — {i.ClientName}")"
                                         Label="@L["CreditNote_OriginalInvoice"].Value" HelperText="@L["CreditNote_SearchOriginal"].Value"
                                         Required="true" MinCharacters="0" MaxItems="50" ResetValueOnEmptyText="true"
                                         ShowProgressIndicator="true" Class="mb-3" />
                        @if (_originalSearchFailed) { <MudAlert Severity="Severity.Error">@L["Common_LoadFailed"]</MudAlert> }
                    }
                    @* Currency selector — ValueChanged (not @bind-Value) so a currency change can
                       re-pick a matching bank account; see OnCreateCurrencyChanged. *@
                    <MudSelect T="long" Value="_createDto.CurrencyId" ValueChanged="@((long id) => OnCreateCurrencyChanged(id))" Label="@L["Template_Currency"].Value" Required="true" Class="mb-3">
                        @foreach (var currency in _currencies)
                        {
                            <MudSelectItem Value="@currency.Id">@currency.Code - @currency.Name</MudSelectItem>
                        }
                    </MudSelect>
                    @* Document number — shows preview of next auto-generated number as placeholder.
                       Leave empty for auto-generation (recommended), or type a custom number. *@
                    <MudTextField @bind-Value="_createDto.CustomDocumentNumber"
                                  Label="@L["Invoice_DocumentNumber"].Value"
                                  Placeholder="@_documentNumberPreview"
                                  HelperText="@L["Invoice_AutoGeneratedHint"].Value"
                                  Class="mb-3" />
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Middle column: Dates *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Invoice_Dates"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @* Issue date — reactive: recalculates due date when changed *@
                    <MudDatePicker Date="_createIssueDate"
                                   DateChanged="@(d => OnIssueDateChanged(d))"
                                   Label="@L["Table_IssueDate"].Value" Required="true" Class="mb-3" />
                    <MudDatePicker @bind-Date="_createDueDate" Label="@L["Table_DueDate"].Value" Required="true" Class="mb-3" />
                    <MudDatePicker @bind-Date="_createTaxableSupplyDate" Label="@L["Invoice_TaxableSupplyDate"].Value" Class="mb-3" />
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Right column: Payment settings *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Invoice_PaymentInfo"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <EnumSelect TEnum="EPaymentMethod"
                                NullableValue="_createDto.PaymentMethod"
                                NullableValueChanged="@(v => _createDto.PaymentMethod = v)"
                                Label="@L["Invoice_PaymentMethod"].Value"
                                Nullable="true" />
                    @* Variable symbol — leave empty for auto-generation (recommended).
                       Placeholder shows the expected auto-generated value (digits from document number preview).
                       If the user types a custom value it is treated as a manual override:
                       VariableSymbolIsManualOverride is set to true so the backend preserves it instead of
                       re-deriving VS from the generated DocumentNumber (issue #107). *@
                    <MudTextField Value="_createDto.VariableSymbol"
                                  ValueChanged="@((string? v) => { _createDto.VariableSymbol = v; _createDto.VariableSymbolIsManualOverride = !string.IsNullOrEmpty(v); })"
                                  Label="@L["Invoice_VariableSymbol"].Value"
                                  Placeholder="@_variableSymbolPreview"
                                  MaxLength="10" Validation="@(new Func<string?, string?>(ValidateVariableSymbol))"
                                  HelperText="@L["Invoice_VSDigitsOnly"].Value" Class="mb-3" />
                    @* Bank account selector — shows issuer's accounts from the 1:N BankAccount collection.
                       On selection, populates BankAccountNumber/IBAN/SWIFT on the create DTO. *@
                    <BankAccountSelect BankAccounts="_issuerBankAccounts"
                                       SelectedAccountId="_selectedBankAccountId"
                                       OnBankAccountSelected="OnBankAccountSelected"
                                       Label="@L["BankAccount_SelectAccount"].Value" />
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Full-width: Invoice items editor *@
        <MudItem xs="12">
            <MudText Typo="Typo.h6" Class="mb-2">@L["Invoice_Items"]</MudText>
@if (!string.IsNullOrEmpty(_createOssEligible))
            {
                <MudCheckBox T="bool" Value="_createApplyOss" ValueChanged="OnCreateApplyOssChanged" Color="Color.Primary"
                             Label="@L["Oss_ApplyToInvoice"].Value" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@string.Format(L["Oss_ApplyHint"].Value, _createOssEligible)</MudText>
            }
            <InvoiceItemEditor Items="_createDto.InvoiceItem" OssCountryCode="@(_createApplyOss ? _createOssEligible : null)"
                               ItemsChanged="@(items => _createDto.InvoiceItem = items)" />
        </MudItem>

        @* Full-width: Notes *@
        <MudItem xs="12">
            <MudTextField @bind-Value="_createDto.Notes" Label="@L["Invoice_Notes"].Value" Lines="3" />
        </MudItem>
    </MudGrid>
}
else
{
    @* ============================== VIEW / EDIT MODE ============================== *@
    @* Header: Back button + document number + status chip + action buttons *@
    <div class="d-flex flex-wrap align-center gap-2 mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" Title="@L["Btn_Back"].Value" />
        <MudText Typo="Typo.h4" Class="mr-2">
            @(_invoice!.DocumentNumber ?? L["Invoice_Draft"].Value)
        </MudText>
        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_invoice?.Status ?? EInvoiceStatus.Draft)">
            @GetStatusText(_invoice.Status)
        </MudChip>
        @* Email sent indicator — shows a chip with sent date if invoice was emailed *@
        @if (_invoice.IsSentByEmail)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.MarkEmailRead">
                @L["Invoice_EmailSentAt"] @_invoice.LastSentByEmailAt?.ToShortDateString()
            </MudChip>
        }
        <MudSpacer />

        @* Action buttons depending on status *@
        @if (_invoice.Status == EInvoiceStatus.Draft && !_isEditing)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="EnableEditing">@L["Btn_Edit"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Send"
                       OnClick="IssueInvoice">@L["Invoice_Issue"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeleteInvoice">@L["Btn_Delete"]</MudButton>
        }
        @* Completed invoice: revert to draft (for full editing) + delete (if last in sequence) *@
        @if (_invoice.Status == EInvoiceStatus.Completed)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Undo"
                       OnClick="RevertToDraft">@L["Invoice_RevertToDraft"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeleteInvoice">@L["Btn_Delete"]</MudButton>
        }
        @* Restore button — only visible for deleted invoices, allows undoing accidental deletes *@
        @if (_invoice.Status == EInvoiceStatus.Deleted)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.RestoreFromTrash"
                       OnClick="RestoreInvoice">@L["Invoice_Restore"]</MudButton>
        }
        @if (_isEditing)
        {
            <MudButton Variant="Variant.Text" OnClick="CancelEditing">@L["Btn_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving" OnClick="SaveInvoice">@L["Btn_Save"]</MudButton>
        }
        @if (_invoice.Status == EInvoiceStatus.Completed)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check"
                       OnClick="MarkAsPaid">@L["Invoice_MarkAsPaid"]</MudButton>
        }
        @if (_invoice.Status == EInvoiceStatus.Paid)
        {
            @* Visible only when the invoice is in Paid status — lets the user revert an accidental payment mark. *@
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.MoneyOff"
                       OnClick="MarkAsUnpaid">@L["Invoice_MarkAsUnpaid"]</MudButton>
        }
        @* PDF download with template selection — split button: primary = default, dropdown = template list *@
        <MudButtonGroup OverrideStyles="false">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       OnClick="DownloadPdf">@L["Btn_ExportPdf"]</MudButton>
            @if (_pdfTemplates.Count > 0)
            {
                <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Variant="Variant.Outlined" Color="Color.Secondary">
                    @foreach (var tmpl in _pdfTemplates)
                    {
                        <MudMenuItem OnClick="@(() => DownloadPdfWithTemplate(tmpl.Id))">@tmpl.Name</MudMenuItem>
                    }
                </MudMenu>
            }
        </MudButtonGroup>
        @* ISDOC download — disabled for Draft invoices because an unissued invoice has no legal ISDOC to export *@
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Download"
                   Disabled="@(_invoice.Status == EInvoiceStatus.Draft)"
                   OnClick="DownloadIsdoc">@L["Btn_ExportIsdoc"]</MudButton>
        @* UBL / Peppol eInvoice download (ADR 0002, F1.6) — disabled for Draft (nothing issued
           yet) and Proforma (not a tax document, [FAQ] I/34); UblExportService's own pre-flight
           still gates finer-grained problems (missing Peppol ID, incomplete address, …), shown
           via the issues list on failure instead of a generic error. *@
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Download"
                   Disabled="@(_invoice.Status == EInvoiceStatus.Draft || _invoice.DocumentType == EDocumentType.Proforma)"
                   OnClick="DownloadUbl">@L["Btn_ExportUbl"]</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Email"
                   OnClick="@(() => _showEmailDialog = true)">@L["Btn_SendEmail"]</MudButton>
    </div>

    @* Readiness banner (issue #215) — only while the document is still a Draft, because that
       is the state in which the "Vystavit" button below is one click away from the API's
       TENANT_NOT_READY refusal (issue #206). Scoped to this document's issuer so an unrelated
       second company with incomplete settings does not raise a false alarm here. *@
    @if (_invoice.Status == EInvoiceStatus.Draft)
    {
        <ReadinessBanner IssuerId="@(_invoice.IssuerId > 0 ? _invoice.IssuerId : (long?)null)" />
    }

    @* ── Alert banner — shown for proformas with an open OverpaidProforma alert ─────────
       The banner persists until the user resolves the alert via the "Vyřešit přeplatek"
       button, which calls POST /api/alert/{id}/resolve and refreshes the page state.
       Shown only when _overpaidAlert != null (i.e., the invoice has an unresolved alert). *@
    @if (_overpaidAlert != null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4"
                  Icon="@Icons.Material.Filled.Warning"
                  ContentAlignment="HorizontalAlignment.Left">
            <div class="d-flex flex-wrap align-center gap-2">
                <MudText>
                    <strong>@L["Alert_OverpaidBanner"]:</strong> @_overpaidAlert.Message
                </MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.CheckCircle"
                           OnClick="ResolveOverpaidAlert"
                           Disabled="_resolvingAlert">
                    @if (_resolvingAlert)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    @L["Alert_ResolveBtn"]
                </MudButton>
            </div>
        </MudAlert>
    }

    @* Main content: responsive grid with info cards + items *@
    @if (_isEditing)
    {
        @* ============================== EDIT MODE — same 3-column layout as create mode ============================== *@
        <MudGrid>
            @* Left column: Document settings (readonly fields + editable currency) *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@L["Invoice_Detail"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @* Document number — readonly, cannot be changed after creation *@
                        <MudTextField Value="@_invoice.DocumentNumber" Label="@L["Invoice_DocumentNumber"].Value" ReadOnly="true" Class="mb-3" />
                        @* Client and issuer — readonly after creation *@
                        <MudTextField Value="@_invoice.ClientName" Label="@L["Invoice_Client"].Value" ReadOnly="true" Class="mb-3" />
                        <MudTextField Value="@_invoice.IssuerName" Label="@L["Invoice_Issuer"].Value" ReadOnly="true" Class="mb-3" />
                        @* Document type — readonly (all types) *@
                        <MudTextField Value="@GetDocumentTypeLabel(_invoice.DocumentType)"
                                      Label="@L["Template_DocumentType"].Value" ReadOnly="true" Class="mb-3" />
                        @* Currency — readonly (changing currency on existing invoice is risky) *@
                        <MudTextField Value="@($"{_invoice.CurrencyCode} ({_invoice.CurrencySymbol})")"
                                      Label="@L["Template_Currency"].Value" ReadOnly="true" Class="mb-3" />
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Middle column: Dates (editable) *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@L["Invoice_Dates"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudDatePicker @bind-Date="_editIssueDate" Label="@L["Table_IssueDate"].Value" Class="mb-3" />
                        <MudDatePicker @bind-Date="_editDueDate" Label="@L["Table_DueDate"].Value" Class="mb-3" />
                        <MudDatePicker @bind-Date="_editTaxableSupplyDate" Label="@L["Invoice_TaxableSupplyDate"].Value" Class="mb-3" />
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Right column: Payment settings (editable) *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@L["Invoice_PaymentInfo"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <EnumSelect TEnum="EPaymentMethod"
                                    NullableValue="_editDto.PaymentMethod"
                                    NullableValueChanged="@(v => _editDto.PaymentMethod = v)"
                                    Label="@L["Invoice_PaymentMethod"].Value"
                                    Nullable="true" />
                        <MudTextField @bind-Value="_editDto.VariableSymbol" Label="@L["Invoice_VariableSymbol"].Value"
                                      MaxLength="10" Validation="@(new Func<string?, string?>(ValidateVariableSymbol))"
                                      HelperText="@L["Invoice_VSDigitsOnly"].Value" Class="mb-3" />
                        @* Bank account selector — shows issuer's accounts for editing *@
                        <BankAccountSelect BankAccounts="_issuerBankAccounts"
                                           SelectedAccountId="_selectedBankAccountId"
                                           OnBankAccountSelected="OnEditBankAccountSelected"
                                           Label="@L["BankAccount_SelectAccount"].Value" />
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Full-width: Editable items grid *@
            <MudItem xs="12">
                <MudText Typo="Typo.h6" Class="mb-2">@L["Invoice_Items"]</MudText>
@if (!string.IsNullOrEmpty(_editOssEligible))
                {
                    <MudCheckBox T="bool" Value="_editApplyOss" ValueChanged="OnEditApplyOssChanged" Color="Color.Primary"
                                 Label="@L["Oss_ApplyToInvoice"].Value" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@string.Format(L["Oss_ApplyHint"].Value, _editOssEligible)</MudText>
                }
                <InvoiceItemEditor Items="_editItems" OssCountryCode="@(_editApplyOss ? _editOssEligible : null)"
                                   ItemsChanged="@(items => _editItems = items)" />
            </MudItem>

            @* Full-width: Notes *@
            <MudItem xs="12">
                <MudTextField @bind-Value="_editDto.Notes" Label="@L["Invoice_Notes"].Value" Lines="3" />
            </MudItem>
        </MudGrid>
    }
    else
    {
        @* ============================== VIEW MODE — readonly info cards ============================== *@
        <MudGrid>
            @* Left column: Invoice info *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@L["Invoice_Detail"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string" Dense="true">
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Numbers">
                                <strong>@L["Invoice_DocumentNumber"]:</strong> @_invoice.DocumentNumber
                            </MudListItem>
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Business">
                                <strong>@L["Invoice_Client"]:</strong> @_invoice.ClientName
                            </MudListItem>
                            <MudListItem T="string" Icon="@Icons.Material.Filled.AccountBalance">
                                <strong>@L["Invoice_Issuer"]:</strong> @_invoice.IssuerName
                            </MudListItem>
                            <MudListItem T="string" Icon="@Icons.Material.Filled.CalendarToday">
                                <strong>@L["Table_IssueDate"]:</strong> @_invoice.IssueDate?.ToShortDateString()
                            </MudListItem>
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Event">
                                <strong>@L["Table_DueDate"]:</strong> @_invoice.DueDate?.ToShortDateString()
                            </MudListItem>
                            @if (_invoice.TaxableSupplyDate.HasValue)
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.DateRange">
                                    <strong>@L["Invoice_TaxableSupplyDate"]:</strong> @_invoice.TaxableSupplyDate.Value.ToShortDateString()
                                </MudListItem>
                            }
                            @* Show original invoice reference — label varies by document type *@
                            @if (_invoice.OriginalInvoiceId.HasValue)
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.Link">
                                    <strong>@GetOriginalInvoiceLabel(_invoice.DocumentType):</strong>
                                    <MudLink Href="@($"/invoices/{_invoice.OriginalInvoiceId}")">
                                        @(_invoice.OriginalInvoiceNumber ?? _invoice.OriginalInvoiceId.ToString())
                                    </MudLink>
                                </MudListItem>
                            }
                        </MudList>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Middle column: Payment info (editable for metadata edit mode) *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@L["Invoice_PaymentInfo"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string" Dense="true">
                            @if (!string.IsNullOrEmpty(_invoice.VariableSymbol))
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.Tag">
                                    <strong>@L["Invoice_VariableSymbol"]:</strong> @_invoice.VariableSymbol
                                </MudListItem>
                            }
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Payment">
                                <strong>@L["Invoice_PaymentMethod"]:</strong>
                                @if (_invoice.PaymentMethod.HasValue)
                                {
                                    @L[$"EPaymentMethod_{_invoice.PaymentMethod.Value}"]
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </MudListItem>
                            @if (!string.IsNullOrEmpty(_invoice.BankAccountNumber))
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.AccountBalance">
                                    <strong>@L["Invoice_BankAccount"]:</strong> @_invoice.BankAccountNumber
                                </MudListItem>
                            }
                            @if (!string.IsNullOrEmpty(_invoice.IBAN))
                            {
                                <MudListItem T="string">
                                    <strong>IBAN:</strong> @_invoice.IBAN
                                </MudListItem>
                            }
                            <MudListItem T="string" Icon="@Icons.Material.Filled.CurrencyExchange">
                                <strong>@L["Template_Currency"]:</strong> @_invoice.CurrencyCode (@_invoice.CurrencySymbol)
                            </MudListItem>
                        </MudList>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Right column: Totals summary *@
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@L["Invoice_Summary"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string" Dense="true">
                            @if (IssuerIsVatPayer)
                            {
                            <MudListItem T="string">
                                <strong>@L["Invoice_TotalBeforeVat"]:</strong> @_invoice.TotalBeforeVat.ToString("N2") @_invoice.CurrencyCode
                            </MudListItem>
                            <MudListItem T="string">
                                <strong>@L["Invoice_TotalVat"]:</strong> @_invoice.TotalVat.ToString("N2") @_invoice.CurrencyCode
                            </MudListItem>
                            }
                            <MudListItem T="string">
                                <MudText Typo="Typo.h5" Color="Color.Primary">
                                    @_invoice.TotalWithVat.ToString("N2") @_invoice.CurrencyCode
                                </MudText>
                            </MudListItem>
                        </MudList>
                        @if (_invoice.PaidAt.HasValue)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                                @L["Invoice_PaidOn"] @_invoice.PaidAt.Value.ToShortDateString()
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Full-width: Payments panel — progress bar + matched payments + manual match button.
               Wired only for invoices that have been issued (Completed / PartiallyPaid / Paid).
               Drafts and credit notes don't show this section. *@
            @if (_invoice.Status == EInvoiceStatus.Completed
                 || _invoice.Status == EInvoiceStatus.PartiallyPaid
                 || _invoice.Status == EInvoiceStatus.Paid)
            {
                <MudItem xs="12">
                    <InvoicePaymentsPanel Invoice="_invoice"
                                          RefreshTrigger="_paymentsRefreshTrigger"
                                          OnChanged="OnPaymentsChanged" />
                </MudItem>
            }

            @* ─── Proforma cross-link sections ──────────────────────────────────── *@
            @* Shown only when viewing a Proforma document *@
            @if (_invoice.DocumentType == EDocumentType.Proforma)
            {
                @* Tax Receipt for Advance section — DPP auto-issued or manually issued *@
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Class="mb-4">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@L["Proforma_TaxReceiptSection"]</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            @if (_loadingProformaLinks)
                            {
                                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                            }
                            else if (_taxReceipts.Count == 0)
                            {
                                @* No DPP yet — offer manual issue button *@
                                <MudText Color="Color.Secondary" Class="mb-2">@L["Proforma_NoTaxReceipts"]</MudText>
                                @* Manual issue available when proforma is Paid *@
                                @if (_invoice.Status == EInvoiceStatus.Paid)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Receipt"
                                               OnClick="IssueTaxReceiptManual">
                                        @L["Proforma_IssueTaxReceiptManual"]
                                    </MudButton>
                                }
                            }
                            else
                            {
                                @* List of linked DPP documents *@
                                <MudList T="string" Dense="true">
                                    @foreach (var dpp in _taxReceipts)
                                    {
                                        <MudListItem T="string" Icon="@Icons.Material.Filled.Receipt">
                                            <MudLink Href="@($"/invoices/{dpp.Id}")">
                                                @(dpp.DocumentNumber ?? $"#{dpp.Id}")
                                            </MudLink>
                                            <MudText Typo="Typo.caption" Class="ml-2">
                                                @dpp.IssueDate?.ToShortDateString() — @dpp.TotalWithVat.ToString("N2") @dpp.CurrencyCode
                                            </MudText>
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                @* Final invoices section — standard Invoices issued from this proforma *@
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Class="mb-4">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <div class="d-flex align-center gap-2">
                                    <MudText Typo="Typo.h6">@L["Proforma_FinalInvoices"]</MudText>
                                    @if (_remainingAdvance.HasValue && _remainingAdvance.Value > 0)
                                    {
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small">
                                            @L["Proforma_RemainingAdvance"]: @_remainingAdvance.Value.ToString("N2")
                                        </MudChip>
                                    }
                                </div>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            @if (_loadingProformaLinks)
                            {
                                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                            }
                            else if (_finalInvoices.Count == 0)
                            {
                                <MudText Color="Color.Secondary" Class="mb-2">@L["Proforma_NoFinalInvoices"]</MudText>
                            }
                            else
                            {
                                @if (_remainingAdvance == 0)
                                {
                                    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">
                                        @L["Proforma_FullyDeducted"]
                                    </MudAlert>
                                }
                                <MudList T="string" Dense="true">
                                    @foreach (var fi in _finalInvoices)
                                    {
                                        <MudListItem T="string" Icon="@Icons.Material.Filled.Description">
                                            <MudLink Href="@($"/invoices/{fi.Id}")">
                                                @(fi.DocumentNumber ?? $"#{fi.Id}")
                                            </MudLink>
                                            <MudText Typo="Typo.caption" Class="ml-2">
                                                @fi.IssueDate?.ToShortDateString() — @fi.TotalWithVat.ToString("N2") @fi.CurrencyCode
                                            </MudText>
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                            @* Issue Final Invoice button — only when proforma is Paid and advance not fully deducted *@
                            @if (_invoice.Status == EInvoiceStatus.Paid
                                 && (_remainingAdvance == null || _remainingAdvance > 0))
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.ArrowForward"
                                           OnClick="@(() => _showIssueFinalDialog = true)"
                                           Class="mt-2">
                                    @L["Proforma_IssueFinalInvoice"]
                                </MudButton>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }

            @* Full-width: Read-only items table *@
            <MudItem xs="12">
                <MudText Typo="Typo.h6" Class="mb-2">@L["Invoice_Items"]</MudText>
                <MudTable Items="@_invoice.InvoiceItem" Dense="true" Hover="true" Striped="true" Elevation="2">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>@L["InvoiceItem_Description"]</MudTh>
                        <MudTh Style="text-align:right">@L["InvoiceItem_Quantity"]</MudTh>
                        <MudTh>@L["InvoiceItem_Unit"]</MudTh>
                        <MudTh Style="text-align:right">@L["InvoiceItem_UnitPrice"]</MudTh>
                        @if (IssuerIsVatPayer)
                        {
                            <MudTh Style="text-align:right">@L["InvoiceItem_VatRate"]</MudTh>
                        }
                        <MudTh Style="text-align:right">@L["InvoiceItem_Total"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.OrderIndex</MudTd>
                        <MudTd>@context.Description</MudTd>
                        <MudTd Style="text-align:right">@context.Quantity.ToString("N2")</MudTd>
                        <MudTd>@context.Unit</MudTd>
                        <MudTd Style="text-align:right">@context.UnitPrice.ToString("N2")</MudTd>
                        @if (IssuerIsVatPayer)
                        {
                            <MudTd Style="text-align:right">@context.VatRatePercentage.ToString("N0")%</MudTd>
                        }
                        <MudTd Style="text-align:right"><strong>@context.TotalWithVat.ToString("N2")</strong></MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>

            @* Notes section *@
            @if (!string.IsNullOrEmpty(_invoice.Notes))
            {
                <MudItem xs="12">
                    <MudCard Elevation="2" Class="mt-2">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2">@L["Invoice_Notes"]</MudText>
                            <MudText>@_invoice.Notes</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }

            @* QR code section — QR Platba+F (payment + invoice) or QR Faktura (invoice only) *@
            @if (_invoice.Status != EInvoiceStatus.Draft)
            {
                <MudItem xs="12" md="4">
                    <MudCard Elevation="2" Class="mt-2">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">
                                    @(string.IsNullOrWhiteSpace(_invoice.IBAN) ? "QR Faktura" : "QR Platba+F")
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Style="text-align: center;">
                            @if (_qrCodeBase64 != null)
                            {
                                <img src="data:image/png;base64,@_qrCodeBase64" alt="QR Code"
                                     style="max-width: 250px; width: 100%; image-rendering: pixelated;" />
                                <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Default">
                                    @(string.IsNullOrWhiteSpace(_invoice.IBAN)
                                        ? @L["QR_InvoiceOnly"]
                                        : @L["QR_PaymentAndInvoice"])
                                </MudText>
                            }
                            else if (_qrLoading)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                            }
                            else
                            {
                                <MudText Color="Color.Warning">@L["QR_NotAvailable"]</MudText>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

    @* File attachments — entity-agnostic component, works for any entity *@
    <FileAttachmentManager EntityName="Invoice"
                           RecordId="_invoice.Id" />

    @* Email send dialog *@
    <MudDialog @bind-Visible="_showEmailDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["Invoice_SendByEmail"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                @L["Invoice_SendingInvoice"] <strong>@_invoice.DocumentNumber</strong> @L["Invoice_ToClient"] <strong>@_invoice.ClientName</strong>
            </MudAlert>
            <MudTextField @bind-Value="_emailRecipient" Label="@L["Invoice_EmailRecipient"].Value" Required="true"
                          InputType="InputType.Email" HelperText="@L["Invoice_RecipientHelper"].Value" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _showEmailDialog = false)">@L["Btn_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendEmail"
                       Disabled="@(string.IsNullOrWhiteSpace(_emailRecipient) || _sendingEmail)">
                @if (_sendingEmail)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>@L["Invoice_Sending"]</span>
                }
                else
                {
                    <span>@L["Invoice_Send"]</span>
                }
            </MudButton>
        </DialogActions>
    </MudDialog>

    @* ── "Issue Final Invoice" dialog — shown from the proforma detail page ── *@
    @* The user provides line items for the final invoice; advance deduction rows
       are appended automatically by the backend (proportional per VAT rate). *@
    <MudDialog @bind-Visible="_showIssueFinalDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">@L["IssueFinalInvoice_DialogTitle"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudGrid>
                @* Dates row *@
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_issueFinalIssueDate" Label="@L["IssueFinalInvoice_IssueDate"].Value" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_issueFinalDueDate" Label="@L["IssueFinalInvoice_DueDate"].Value" Class="mb-3" />
                </MudItem>
                @* Optional partial deduction amount *@
                <MudItem xs="12" md="6">
                    <MudNumericField T="decimal?" @bind-Value="_issueFinalDto.DeductionAmount"
                                     Label="@L["IssueFinalInvoice_DeductionAmount"].Value"
                                     Min="0" Format="N2" Class="mb-3"
                                     HelperText="@(_remainingAdvance.HasValue
                                         ? $"{L["Proforma_RemainingAdvance"].Value}: {_remainingAdvance.Value:N2}"
                                         : "")" />
                </MudItem>
                @* Notes *@
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_issueFinalDto.Notes" Label="@L["IssueFinalInvoice_Notes"].Value" Lines="2" Class="mb-3" />
                </MudItem>
                @* Invoice items *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["IssueFinalInvoice_AddItems"]</MudText>
                    <InvoiceItemEditor Items="_issueFinalItems"
                                       ItemsChanged="@(items => _issueFinalItems = items)" />
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _showIssueFinalDialog = false)">@L["Btn_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="IssueFinalInvoice"
                       Disabled="@(_issuingFinalInvoice || _issueFinalItems.Count == 0)">
                @if (_issuingFinalInvoice)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                }
                @L["Proforma_IssueFinalInvoice"]
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    /// <summary>
    /// Route parameter — invoice ID from URL.
    /// Id == 0 means create mode (/invoices/create), Id > 0 means view/edit mode (/invoices/{id}).
    /// </summary>
    [Parameter] public long Id { get; set; }

    /// <summary>
    /// Query parameter — when ?edit=true, auto-enters edit mode after loading.
    /// Used when creating from template so user can review/adjust the pre-filled data.
    /// </summary>
    [SupplyParameterFromQuery] public bool Edit { get; set; }

    /// <summary>
    /// Query parameter — when ?type=CreditNote, pre-sets document type to CreditNote in create mode.
    /// Used by the "New Credit Note" button from the credit notes list page.
    /// </summary>
    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeParam { get; set; }

    /// <summary>
    /// Query parameter — template ID to pre-fill the create form from a template.
    /// Used by the "New from Template" dialog: navigates here without creating a DB record.
    /// </summary>
    [SupplyParameterFromQuery(Name = "templateId")]
    public long? TemplateId { get; set; }

    /// <summary>
    /// Query parameter — client ID to pre-fill when creating from template.
    /// Passed together with templateId from the "New from Template" dialog.
    /// </summary>
    [SupplyParameterFromQuery(Name = "clientId")]
    public long? TemplateClientId { get; set; }

    /// <summary>
    /// Query parameter — original invoice ID (proforma) to pre-set when creating
    /// a TaxReceiptForAdvance manually from the proforma detail page.
    /// Sets OriginalInvoiceId on the create DTO.
    /// </summary>
    [SupplyParameterFromQuery(Name = "originalId")]
    public long? OriginalId { get; set; }

    private InvoiceDto? _invoice;
    private bool _loading = true;
    private string? _errorMessage; // Stores API error message for display instead of generic "Not Found"

    // Bumped after a manual match/unmatch so InvoicePaymentsPanel reloads its rows.
    private int _paymentsRefreshTrigger;

    /// <summary>Called when the payments panel reports a change (manual match / unmatch).</summary>
    private async Task OnPaymentsChanged()
    {
        await LoadInvoice();
        _paymentsRefreshTrigger++;
    }

    // Create mode state — true when Id == 0 (navigated to /invoices/create)
    private bool _isCreateMode => Id == 0;
    private CreateInvoiceDto _createDto = new();
    // Use DateTime.UtcNow.Date (UTC midnight) instead of DateTime.Now to prevent timezone offset
    // in JSON serialization. DateTime.Now has Kind=Local → serialized as "...+02:00" → server
    // converts to UTC → date shifts back by 1 day for CET/CEST timezones.
    private DateTime? _createIssueDate = DateTime.UtcNow.Date;
    private DateTime? _createDueDate = DateTime.UtcNow.Date.AddDays(14);
    private DateTime? _createTaxableSupplyDate = DateTime.UtcNow.Date;
    private List<ClientDto> _allClients = new();
    private List<CurrencyDto> _currencies = new();
    private ClientDto? _issuer;

    /// <summary>
    /// A non-VAT payer's invoice shows no VAT rate column and no VAT totals.
    /// Unknown issuer (still loading / failed) = show VAT, i.e. today's behaviour.
    /// </summary>
    private bool IssuerIsVatPayer => _issuer?.IsVatPayer ?? true;

    // Bank account selection state — loaded from issuer's BankAccount collection
    private List<BankAccountDto> _issuerBankAccounts = new();
    private long? _selectedBankAccountId;

    // True once the user has explicitly picked a bank account in the CREATE form (vs. the
    // auto-selected default). While false, changing the invoice currency is allowed to
    // re-pick a currency-matching account; once true, the user's choice is never overridden.
    private bool _bankAccountManuallySelectedInCreate;

    // Document number preview — shows what the next auto-generated number will be
    private string? _documentNumberPreview;

    // Variable symbol preview — derived from _documentNumberPreview digits.
    // Shown as Placeholder on the VS field so the user sees what the backend will generate.
    // We intentionally do NOT pre-fill _createDto.VariableSymbol from this value:
    //   • leaving VariableSymbol null (and VariableSymbolIsManualOverride = false) tells the
    //     backend to always re-derive VS from the generated DocumentNumber after applying
    //     the client's prefix/suffix — which is the correct behaviour (issue #107).
    //   • If the user manually types a VS, that field becomes their explicit override and
    //     VariableSymbolIsManualOverride is set to true so the backend preserves it.
    private string? _variableSymbolPreview;

    // Dirty tracking for unsaved changes warning
    private bool _isDirty = false;

    // Credit note: completed invoices available as OriginalInvoiceId (only loaded for CreditNote type)
    private InvoiceDto? _originalInvoice;
    private bool _originalSearchFailed;
    private bool _saving;

    // QR code state — loaded for completed/paid invoices in view mode
    private string? _qrCodeBase64;
    private bool _qrLoading = false;

    // PDF template list — loaded once, used for the PDF template picker split button
    private List<ContentTemplateDto> _pdfTemplates = new();

    // Tracks previous Id to detect parameter changes (e.g., /invoices/create → /invoices/1).
    // Blazor reuses components for the same @page route, so OnInitializedAsync only fires once.
    // OnParametersSetAsync fires every time [Parameter] values change.
    private long _previousId = -1;

    // Edit mode state (only for Draft invoices in view mode)
    private bool _isEditing = false;
    private UpdateInvoiceDto _editDto = new();
    private List<CreateInvoiceItemDto> _editItems = new();

    private DateTime? _editIssueDate;
    private DateTime? _editDueDate;
    private DateTime? _editTaxableSupplyDate;

    // Alert state — null = no open OverpaidProforma alert for this invoice
    private AlertDto? _overpaidAlert;
    private bool _resolvingAlert = false;

    // Email dialog state
    private bool _showEmailDialog = false;
    private bool _sendingEmail = false;
    private string _emailRecipient = "";

    // Proforma cross-link state (only loaded when viewing a Proforma)
    private List<InvoiceDto> _finalInvoices = [];    // final invoices issued from this proforma
    private List<InvoiceDto> _taxReceipts = [];      // DPP documents linked to this proforma
    private decimal? _remainingAdvance;              // remaining advance amount (null = not yet loaded)
    private bool _loadingProformaLinks = false;

    // "Issue Final Invoice" dialog state
    private bool _showIssueFinalDialog = false;
    private bool _issuingFinalInvoice = false;
    private IssueFinalInvoiceDto _issueFinalDto = new();
    private List<CreateInvoiceItemDto> _issueFinalItems = [];
    private DateTime? _issueFinalIssueDate = DateTime.UtcNow.Date;
    private DateTime? _issueFinalDueDate = DateTime.UtcNow.Date.AddDays(14);

    /// <summary>
    /// Called every time a [Parameter] value changes.
    /// Detects navigation between /invoices/create ↔ /invoices/{id} and reloads accordingly.
    /// Without this, saving a new invoice and navigating to /invoices/{newId} shows "Not Found"
    /// because Blazor reuses the same component instance and OnInitializedAsync only fires once.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        // Only reload when the Id parameter actually changes
        if (Id == _previousId) return;
        _previousId = Id;

        if (_isCreateMode)
        {
            // Create mode — load reference data (clients, issuer, currencies) in parallel
            await Task.WhenAll(LoadClients(), LoadIssuer(), LoadCurrencies());

            // If creating from template, load template data and pre-fill the form
            if (TemplateId.HasValue && TemplateId.Value > 0)
            {
                await InitCreateDtoFromTemplate(TemplateId.Value, TemplateClientId);
            }
            else
            {
                InitCreateDto();
            }

            // Load completed invoices for credit note OriginalInvoiceId dropdown (if creating a credit note)
            if (_createDto.DocumentType == EDocumentType.CreditNote)
            {
                if (_createDto.OriginalInvoiceId is long originalId)
                    _originalInvoice = await InvoiceService.GetByIdAsync(originalId);
            }

            // Pre-fill document number from the default sequence (user can still override)
            await LoadDocumentNumberPreview();
        }
        else
        {
            // View/edit mode — load existing invoice (transition from create → view after save)
            _isEditing = false;
            _isDirty = false;
            // Issuer is needed in view mode too — a non-VAT payer's invoice hides VAT rows.
            await Task.WhenAll(LoadInvoice(), LoadIssuer());
        }
    }

    /// <summary>
    /// Loads customers (non-issuers) for the client dropdown.
    /// </summary>
    private async Task LoadClients()
    {
        try { _allClients = await ClientService.GetAllAsync(includeInactive: false); }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    /// <summary>
    /// Loads the issuer (user's company) via GET /api/client/issuer.
    /// Also populates the bank account list for the BankAccountSelect dropdown.
    /// </summary>
    private async Task LoadIssuer()
    {
        try
        {
            _issuer = await ClientService.GetIssuerAsync();
            // Populate bank accounts from the issuer for the dropdown selector
            _issuerBankAccounts = _issuer?.BankAccount ?? new List<BankAccountDto>();
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    /// <summary>
    /// Loads active currencies for the currency dropdown.
    /// </summary>
    private async Task LoadCurrencies()
    {
        try { _currencies = await CurrencyService.GetActiveCurrenciesAsync(); }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
    }

    /// <summary>
    /// Loads completed/paid invoices for the OriginalInvoiceId dropdown when creating a credit note.
    /// Only shows invoices that can be credited (Completed or Paid status).
    /// </summary>
    private async Task OnDocumentTypeChanged(EDocumentType type)
    {
        _createDto.DocumentType = type;
        _originalInvoice = null;
        _createDto.OriginalInvoiceId = null;
        _originalSearchFailed = false;
        await RefreshOssCountryAsync();
        await LoadDocumentNumberPreview();
    }

    // EU OSS is OPT-IN (DEVGUIDE §4.16): the preview only says the invoice is ELIGIBLE (country or null);
    // the user ticks the checkbox when the supply really falls under OSS, then the item editor offers that
    // country's rates and the server validates them on save.
    private string? _createOssEligible;
    private bool _createApplyOss;
    private string? _editOssEligible;
    private bool _editApplyOss;

    private async Task RefreshOssCountryAsync()
    {
        _createOssEligible = _createDto.ClientId > 0
            ? await InvoiceService.GetOssCountryAsync(_createDto.ClientId, _createDto.IssuerId, _createDto.DocumentType)
            : null;
        if (_createOssEligible == null) _createApplyOss = false; // opt-in vanishes with eligibility
        _createDto.ApplyOss = _createApplyOss;
    }

    private void OnCreateApplyOssChanged(bool value)
    {
        _createApplyOss = value;
        _createDto.ApplyOss = value;
        _isDirty = true;
    }

    private void OnEditApplyOssChanged(bool value)
    {
        _editApplyOss = value;
        _editDto.ApplyOss = value;
    }

    private void OnOriginalInvoiceChanged(InvoiceDto? invoice)
    {
        _originalInvoice = invoice;
        _createDto.OriginalInvoiceId = invoice?.Id;
    }

    /// <summary>Search on the server so older invoices remain reachable without loading the entire ledger.</summary>
    private async Task<IEnumerable<InvoiceDto>> SearchOriginalInvoices(string search, CancellationToken cancellationToken)
    {
        _originalSearchFailed = false;
        try
        {
            cancellationToken.ThrowIfCancellationRequested();
            var issued = await InvoiceService.GetPagedAsync(pageSize: 50, search: search,
                documentType: EDocumentType.Invoice, status: EInvoiceStatus.Completed, throwOnError: true);
            cancellationToken.ThrowIfCancellationRequested();
            var paid = await InvoiceService.GetPagedAsync(pageSize: 50, search: search,
                documentType: EDocumentType.Invoice, status: EInvoiceStatus.Paid, throwOnError: true);
            cancellationToken.ThrowIfCancellationRequested();
            return issued.Items.Concat(paid.Items).OrderByDescending(i => i.IssueDate);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { return []; }
        catch (Exception)
        {
            _originalSearchFailed = true;
            return [];
        }
    }

    /// <summary>
    /// Previews the next document number from the default sequence.
    /// Shown as Placeholder text on the document number field — NOT pre-filled into
    /// CustomDocumentNumber, so the backend always calls GenerateNextNumberAsync which
    /// properly increments the sequence counter. Also pre-fills VariableSymbol from digits.
    /// If a custom number sequence is set (e.g., from template), uses that instead.
    /// Silently does nothing if no default sequence is configured.
    /// </summary>
    private async Task LoadDocumentNumberPreview()
    {
        try
        {
            string? preview;

            if (_createDto.NumberSequenceId.HasValue && _createDto.NumberSequenceId.Value > 0)
            {
                // Template specified a custom number sequence — use that
                preview = await NumberSequenceService.PreviewNextNumberAsync(
                    _createDto.NumberSequenceId.Value, _createIssueDate ?? DateTime.Now);
            }
            else
            {
                // Use default sequence for the document type
                preview = await NumberSequenceService.PreviewByDocumentTypeAsync(
                    _createDto.DocumentType, _createIssueDate ?? DateTime.Now);
            }

            _documentNumberPreview = preview;

            // Derive VS preview from the document number preview digits.
            // Shown as Placeholder text on the VS field — NOT pre-filled into _createDto.VariableSymbol.
            //
            // Rationale (issue #107): the preview is generated by the UI without knowing the
            // client's prefix/suffix (the preview API call does not include them). If we
            // pre-filled _createDto.VariableSymbol with these digits, the backend would receive
            // a VS without prefix and — because it only auto-derives VS when the field is null —
            // would persist the wrong value. By leaving _createDto.VariableSymbol null, the
            // backend always re-derives VS from the fully-resolved DocumentNumber (with prefix).
            // The preview here is display-only so the user can see what will be auto-generated.
            _variableSymbolPreview = string.IsNullOrEmpty(preview)
                ? null
                : new string(preview.Where(char.IsDigit).Take(10).ToArray());
        }
        catch
        {
            // Preview is non-critical — failure leaves the field empty (backend auto-generates)
            _documentNumberPreview = null;
        }
    }

    /// <summary>
    /// Initializes the create DTO with default values after reference data is loaded.
    /// Supports all document types via the ?type= query parameter.
    /// </summary>
    private void InitCreateDto()
    {
        // Map the ?type= query param to EDocumentType; default = Invoice
        var docType = TypeParam switch
        {
            "CreditNote"           => EDocumentType.CreditNote,
            "Proforma"             => EDocumentType.Proforma,
            "TaxReceiptForAdvance" => EDocumentType.TaxReceiptForAdvance,
            _                      => EDocumentType.Invoice
        };

        // Auto-select the default bank account from the issuer's 1:N BankAccount collection
        var defaultAccount = _issuerBankAccounts.FirstOrDefault(a => a.IsDefault)
                             ?? _issuerBankAccounts.FirstOrDefault();
        _selectedBankAccountId = defaultAccount?.Id;
        _bankAccountManuallySelectedInCreate = false;

        _createDto = new CreateInvoiceDto
        {
            DocumentType = docType,
            CurrencyId = _currencies.FirstOrDefault()?.Id ?? 1,
            PaymentMethod = EPaymentMethod.BankTransfer,
            IssuerId = _issuer?.Id ?? 0,
            // Auto-fill bank account from the issuer's default bank account (1:N)
            BankAccountNumber = defaultAccount?.AccountNumber,
            IBAN = defaultAccount?.IBAN,
            SWIFT = defaultAccount?.SWIFT,
            InvoiceItem = new List<CreateInvoiceItemDto>(),
            // Pre-link to source proforma when creating TaxReceiptForAdvance manually
            OriginalInvoiceId = OriginalId.HasValue && OriginalId.Value > 0 ? OriginalId : null
        };
        _loading = false;
    }

    /// <summary>
    /// Initializes the create DTO by loading a template and pre-filling all fields from it.
    /// This is the "New from Template" flow — no DB record is created until user clicks Save.
    /// The template provides: DocumentType, Issuer, Currency, PaymentMethod, BankAccount,
    /// Notes, InvoiceItems, NumberSequenceId, and DueDateOffsetDays.
    /// VariableSymbol is intentionally NOT pre-filled — it must be unique per invoice
    /// (Czech banking), so we leave it null and let the backend derive it from the new
    /// DocumentNumber after save. Pre-filling from the template would inherit the source
    /// invoice's VS (templates carry it from CreateTemplateFromInvoiceAsync) and trigger
    /// the duplicate-VS guard.
    /// </summary>
    private async Task InitCreateDtoFromTemplate(long templateId, long? clientId)
    {
        try
        {
            var template = await TemplateService.GetByIdAsync(templateId);
            if (template == null)
            {
                Snackbar.Add(L["Msg_NotFound"].Value, Severity.Warning);
                InitCreateDto(); // Fall back to empty form
                return;
            }

            // Calculate dates from template's DueDateOffsetDays
            var issueDate = DateTime.Now;
            var dueDate = issueDate.AddDays(template.DueDateOffsetDays);

            _createIssueDate = issueDate;
            _createDueDate = dueDate;
            _createTaxableSupplyDate = issueDate;

            // Resolve client: use provided clientId, or fall back to template's default, or 0
            var resolvedClientId = clientId ?? template.ClientId ?? 0;

            // Auto-select the default bank account from the issuer's 1:N BankAccount collection
            var defaultAccount = _issuerBankAccounts.FirstOrDefault(a => a.IsDefault)
                                 ?? _issuerBankAccounts.FirstOrDefault();
            // A template-supplied account is a deliberate choice: a later currency change must not replace it.
            _bankAccountManuallySelectedInCreate = !string.IsNullOrEmpty(template.BankAccountNumber);

            // Template's own account wins over the issuer's default — but AccountNumber, IBAN
            // and SWIFT must all come from the SAME source. Mixing e.g. the template's account
            // number with the default account's IBAN (the previous bug) can point an invoice at
            // an inconsistent combination of payment details.
            var hasTemplateAccount = !string.IsNullOrEmpty(template.BankAccountNumber);
            _selectedBankAccountId = hasTemplateAccount
                ? _issuerBankAccounts.FirstOrDefault(a => a.AccountNumber == template.BankAccountNumber)?.Id
                : defaultAccount?.Id;

            _createDto = new CreateInvoiceDto
            {
                DocumentType = template.DocumentType,
                ClientId = resolvedClientId,
                IssuerId = template.IssuerId > 0 ? template.IssuerId : (_issuer?.Id ?? 0),
                IssueDate = issueDate,
                DueDate = dueDate,
                TaxableSupplyDate = issueDate,
                CurrencyId = template.CurrencyId,
                PaymentMethod = template.PaymentMethod ?? EPaymentMethod.BankTransfer,
                // VariableSymbol left null on purpose — backend derives a unique VS from the
                // generated DocumentNumber. Carrying template.VariableSymbol over would clash
                // with the source invoice the template was created from.
                VariableSymbol = null,
                // Template bank account takes priority (all 3 fields from the template itself);
                // if template has none, fall back to issuer's default (all 3 from that account).
                BankAccountNumber = hasTemplateAccount ? template.BankAccountNumber : defaultAccount?.AccountNumber,
                IBAN = hasTemplateAccount ? template.IBAN : defaultAccount?.IBAN,
                SWIFT = hasTemplateAccount ? template.SWIFT : defaultAccount?.SWIFT,
                Notes = template.Notes,
                NumberSequenceId = template.NumberSequenceId,
                // Copy invoice items from template
                // Copy invoice items from template — preserve IsTextRow for text-only rows
                InvoiceItem = template.InvoiceItem.Select(Fakvio.UI.Shared.Models.InvoiceItemEditMapper.ToEditDto).ToList()
            };

            // If client is selected, auto-fill billing params from client settings too
            // Client's BillingSettings (DueDays + DueDateCalculationType) overrides template's offset
            if (resolvedClientId > 0)
            {
                var client = _allClients.FirstOrDefault(c => c.Id == resolvedClientId);
                if (client?.BillingSettings != null)
                {
                    var bs = client.BillingSettings;
                    // Client's DueDays + DueDateCalculationType overrides template's simple offset
                    RecalculateDueDate(bs.DueDays, bs.DueDateCalculationType);
                }
                await RefreshOssCountryAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
            InitCreateDto(); // Fall back to empty form on error
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Loads the invoice detail from the API by ID.
    /// If ?edit=true query parameter is present and invoice is Draft, auto-enters edit mode.
    /// </summary>
    private async Task LoadInvoice()
    {
        try
        {
            _loading = true;
            _invoice = await InvoiceService.GetByIdAsync(Id);

            // Auto-enter edit mode when redirected from "New from Template" dialog
            if (Edit && _invoice != null && _invoice.Status == EInvoiceStatus.Draft)
            {
                EnableEditing();
            }

            // Load PDF templates for the template picker split button
            if (_invoice != null)
            {
                _ = LoadPdfTemplatesAsync();
            }

            // Load QR code for completed/paid invoices (non-blocking, runs in background)
            if (_invoice != null && _invoice.Status != EInvoiceStatus.Draft)
            {
                _ = LoadQrCodeAsync();
            }

            // Load open OverpaidProforma alert for this invoice (non-blocking).
            // The banner is shown only when an open alert exists — no noise for normal invoices.
            if (_invoice != null)
            {
                _ = LoadOverpaidAlertAsync();
            }

            // Load proforma cross-links (tax receipts + final invoices) — non-blocking.
            // Only done for Proforma documents to avoid unnecessary API calls on other types.
            if (_invoice?.DocumentType == EDocumentType.Proforma)
            {
                _ = LoadProformaLinksAsync();
            }
        }
        catch (Exception ex)
        {
            // Store error message for display in the template instead of generic "Nenalezeno".
            // ApiException carries the actual API error (403 Forbidden, 500 Server Error, etc.).
            _errorMessage = ex.Message;
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Loads the first unresolved OverpaidProforma alert for the current invoice.
    /// Runs in the background and triggers a re-render when done.
    /// </summary>
    private async Task LoadOverpaidAlertAsync()
    {
        try
        {
            var alerts = await AlertService.GetAlertsAsync(unresolvedOnly: true);
            _overpaidAlert = alerts.FirstOrDefault(
                a => a.RelatedEntityType == "Invoice" && a.RelatedEntityId == Id);
        }
        catch
        {
            // Non-critical — banner simply won't show if the call fails.
            _overpaidAlert = null;
        }
        finally
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// Resolves the current overpaid alert by calling POST /api/alert/{id}/resolve.
    /// Shows snackbar feedback and clears the banner on success.
    /// </summary>
    private async Task ResolveOverpaidAlert()
    {
        if (_overpaidAlert == null) return;

        _resolvingAlert = true;
        try
        {
            await AlertService.ResolveAsync(_overpaidAlert.Id);
            _overpaidAlert = null;
            Snackbar.Add(L["Alert_Resolved"].Value, Severity.Success);
        }
        catch
        {
            Snackbar.Add(L["Alert_ResolveFailed"].Value, Severity.Error);
        }
        finally
        {
            _resolvingAlert = false;
        }
    }

    /// <summary>
    /// Loads the QR code image asynchronously for the current invoice.
    /// Runs in the background — does not block the main page rendering.
    /// </summary>
    private async Task LoadQrCodeAsync()
    {
        try
        {
            _qrLoading = true;
            StateHasChanged();

            var qrBytes = await InvoiceService.GetQrCodeAsync(Id);
            if (qrBytes != null && qrBytes.Length > 0)
            {
                _qrCodeBase64 = Convert.ToBase64String(qrBytes);
            }
        }
        catch (Exception ex)
        {
            // QR code generation failure is non-critical — just log and show "not available"
            _qrCodeBase64 = null;
            Snackbar.Add($"QR code generation failed: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _qrLoading = false;
            StateHasChanged();
        }
    }

    // --- Bank account selection handlers ---

    /// <summary>
    /// Handles bank account selection in CREATE mode.
    /// Populates BankAccountNumber, IBAN, and SWIFT on the create DTO from the selected account.
    /// </summary>
    private void OnBankAccountSelected(BankAccountDto? account)
    {
        _isDirty = true;
        // Any explicit pick (including clearing the selection) is "manual" from here on —
        // OnCreateCurrencyChanged must stop re-picking an account for the user.
        _bankAccountManuallySelectedInCreate = true;
        if (account != null)
        {
            _selectedBankAccountId = account.Id;
            _createDto.BankAccountNumber = account.AccountNumber;
            _createDto.IBAN = account.IBAN;
            _createDto.SWIFT = account.SWIFT;
        }
        else
        {
            _selectedBankAccountId = null;
            _createDto.BankAccountNumber = null;
            _createDto.IBAN = null;
            _createDto.SWIFT = null;
        }
    }

    /// <summary>
    /// Handles currency changes in CREATE mode. When the user hasn't manually picked a bank
    /// account yet, re-picks one matching the new currency (IsDefault match first, then any
    /// match, then falls back to the previous selection) — same preference order as the
    /// server-side resolver in InvoiceService.ApplyBankAccountDefaultsAsync.
    /// </summary>
    private void OnCreateCurrencyChanged(long currencyId)
    {
        _isDirty = true;
        _createDto.CurrencyId = currencyId;

        if (_bankAccountManuallySelectedInCreate)
            return;

        var currencyCode = _currencies.FirstOrDefault(c => c.Id == currencyId)?.Code;
        if (string.IsNullOrEmpty(currencyCode))
            return;

        var match = _issuerBankAccounts.FirstOrDefault(a => a.IsDefault && a.CurrencyCode == currencyCode)
                    ?? _issuerBankAccounts.FirstOrDefault(a => a.CurrencyCode == currencyCode);
        if (match == null)
            return; // No account for this currency — leave the current selection as-is.

        _selectedBankAccountId = match.Id;
        _createDto.BankAccountNumber = match.AccountNumber;
        _createDto.IBAN = match.IBAN;
        _createDto.SWIFT = match.SWIFT;
    }

    /// <summary>
    /// Handles bank account selection in EDIT mode.
    /// Populates BankAccountNumber, IBAN, and SWIFT on the edit DTO from the selected account.
    /// </summary>
    private void OnEditBankAccountSelected(BankAccountDto? account)
    {
        _isDirty = true;
        if (account != null)
        {
            _selectedBankAccountId = account.Id;
            _editDto.BankAccountNumber = account.AccountNumber;
            _editDto.IBAN = account.IBAN;
            _editDto.SWIFT = account.SWIFT;
        }
        else
        {
            _selectedBankAccountId = null;
            _editDto.BankAccountNumber = null;
            _editDto.IBAN = null;
            _editDto.SWIFT = null;
        }
    }

    // --- Create mode: reactive handlers ---

    /// <summary>
    /// Handles client selection change in create mode.
    /// Auto-fills billing parameters (PaymentMethod, BankAccount) and recalculates
    /// due date from the client's BillingSettings — saves the user manual entry.
    /// Only fills empty fields to avoid overwriting explicit user input.
    /// </summary>
    private async Task OnClientChanged(long clientId)
    {
        _createDto.ClientId = clientId;
        _isDirty = true;
        await RefreshOssCountryAsync();

        var client = _allClients.FirstOrDefault(c => c.Id == clientId);
        if (client?.BillingSettings != null)
        {
            var bs = client.BillingSettings;

            // Auto-fill payment method only if user hasn't set a custom value
            if (_createDto.PaymentMethod == null || _createDto.PaymentMethod == EPaymentMethod.BankTransfer)
            {
                _createDto.PaymentMethod = bs.DefaultPaymentMethod ?? EPaymentMethod.BankTransfer;
            }

            // NOTE: Bank account is NOT auto-filled from client — it comes from the issuer.
            // The invoice bank account is where the customer pays TO (= our company's account).

            // Recalculate due date using client's DueDays AND DueDateCalculationType
            RecalculateDueDate(bs.DueDays, bs.DueDateCalculationType);
        }
    }

    /// <summary>
    /// Handles issue date change in create mode.
    /// Recalculates due date using the selected client's BillingSettings (DueDays + DueDateCalculationType).
    /// Falls back to DaysFromIssue with 14 days if no client or no billing settings.
    /// </summary>
    private void OnIssueDateChanged(DateTime? newDate)
    {
        _createIssueDate = newDate;
        _isDirty = true;

        // Look up the selected client's billing settings for due date calculation
        var client = _allClients.FirstOrDefault(c => c.Id == _createDto.ClientId);
        var dueDays = client?.BillingSettings?.DueDays ?? 14;
        var calcType = client?.BillingSettings?.DueDateCalculationType ?? EDueDateCalculationType.DaysFromIssue;
        RecalculateDueDate(dueDays, calcType);
    }

    /// <summary>
    /// Recalculates due date using DueDateCalculator with the proper EDueDateCalculationType.
    /// Also syncs TaxableSupplyDate (DUZP) to the newly calculated due date —
    /// Czech accounting: when due date changes, tax date should follow.
    /// Called both when client changes and when issue date changes.
    /// </summary>
    /// <param name="dueDays">Number of days from client's BillingSettings (or default 14).</param>
    /// <param name="calculationType">Which algorithm to use (from client's BillingSettings).</param>
    private void RecalculateDueDate(int dueDays, EDueDateCalculationType calculationType = EDueDateCalculationType.DaysFromIssue)
    {
        if (_createIssueDate.HasValue)
        {
            // Use the shared DueDateCalculator to ensure consistent behavior with backend
            _createDueDate = DueDateCalculator.Calculate(_createIssueDate.Value, dueDays, calculationType);

            // Sync TaxableSupplyDate (DUZP) with IssueDate —
            // Czech accounting: datum zdanitelného plnění = datum vystavení
            _createTaxableSupplyDate = _createIssueDate;
        }
    }

    // --- Create mode: save ---

    /// <summary>
    /// Validates and saves a new invoice via POST /api/invoice.
    /// On success, navigates to the newly created invoice's detail page.
    /// </summary>
    /// <summary>
    /// Client-side mirror of InvoiceService.ValidateReverseChargeCodes (server messages are not localized):
    /// a Reverse Charge item needs a code, any other regime must not carry one. Shows a localized snackbar.
    /// </summary>
    private bool ValidateReverseCharge(IEnumerable<CreateInvoiceItemDto> items)
    {
        foreach (var item in items.Where(i => !i.IsTextRow))
        {
            var isRc = item.VatRegime == EVatRegime.ReverseCharge;
            if (isRc && !item.ReverseChargeCodeId.HasValue)
            {
                Snackbar.Add(L["Validation_ReverseChargeCodeRequired"].Value, Severity.Warning);
                return false;
            }
            if (!isRc && item.ReverseChargeCodeId.HasValue)
            {
                Snackbar.Add(L["Validation_ReverseChargeCodeNotAllowed"].Value, Severity.Warning);
                return false;
            }
        }
        return true;
    }

    private async Task SaveNewInvoice()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            // Validate that a client is selected — the API would reject ClientId=0
            if (_createDto.ClientId <= 0)
            {
                Snackbar.Add(L["Invoice_NoClientSelected"].Value, Severity.Error);
                return;
            }

            // Validate that an issuer exists — the API would reject IssuerId=0
            if (_createDto.IssuerId <= 0)
            {
                Snackbar.Add(L["Invoice_NoIssuerFound"].Value, Severity.Error);
                return;
            }

            if (_createDto.InvoiceItem.Count == 0)
            {
                Snackbar.Add(L["Invoice_AddAtLeastOneItem"].Value, Severity.Warning);
                return;
            }

            if (!ValidateReverseCharge(_createDto.InvoiceItem)) return;

            if (_createDto.DocumentType == EDocumentType.CreditNote && !_createDto.OriginalInvoiceId.HasValue)
            {
                Snackbar.Add(L["CreditNote_SelectOriginal"], Severity.Warning);
                return;
            }

            // Map date pickers to DTO
            _createDto.IssueDate = _createIssueDate;
            _createDto.DueDate = _createDueDate;
            _createDto.TaxableSupplyDate = _createTaxableSupplyDate;

            var result = await InvoiceService.CreateAsync(_createDto);
            if (result != null)
            {
                // Reset dirty flag and force re-render BEFORE navigation.
                // This ensures the <UnsavedChangesLock> removes <NavigationLock> from the DOM
                // before NavigateTo fires — otherwise Blazor's NavigationLock intercepts the
                // navigation and shows the "leave page?" prompt even though we just saved.
                _isDirty = false;
                StateHasChanged();
                await Task.Yield(); // Let Blazor complete the render cycle

                Snackbar.Add(L["Invoice_Created"].Value, Severity.Success);
                // Navigate to the newly created invoice's detail page
                Navigation.NavigateTo($"/invoices/{result.Id}");
            }
            else
            {
                Snackbar.Add(L["Invoice_CreateFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }

    // --- Edit mode (existing invoices) ---

    /// <summary>
    /// Switches to edit mode — populates the edit DTO from current invoice data.
    /// Only available for Draft invoices. Client/Issuer cannot be changed after creation.
    /// Also loads issuer bank accounts for the BankAccountSelect dropdown.
    /// </summary>
    private async void EnableEditing()
    {
        if (_invoice == null || _invoice.Status != EInvoiceStatus.Draft) return;

        // Load issuer bank accounts if not already loaded (needed for the BankAccountSelect)
        if (_issuerBankAccounts.Count == 0)
        {
            try
            {
                var issuer = await ClientService.GetIssuerAsync();
                _issuerBankAccounts = issuer?.BankAccount ?? new List<BankAccountDto>();
            }
            catch { /* Non-critical — dropdown will be empty */ }
        }

        // Pre-select the bank account that matches the invoice's current BankAccountNumber
        _selectedBankAccountId = _issuerBankAccounts
            .FirstOrDefault(a => a.AccountNumber == _invoice.BankAccountNumber)?.Id;

        // OSS: the invoice's current regime + whether it is (still) eligible for the opt-in.
        _editApplyOss = _invoice.OssCountryCode != null;
        _editOssEligible = _invoice.OssCountryCode
            ?? (_invoice.ClientId.HasValue
                ? await InvoiceService.GetOssCountryAsync(_invoice.ClientId.Value, _invoice.IssuerId, _invoice.DocumentType)
                : null);

        // Populate edit DTO from current invoice (only editable fields)
        _editDto = new UpdateInvoiceDto
        {
            ApplyOss = _editApplyOss,
            DueDate = _invoice.DueDate,
            TaxableSupplyDate = _invoice.TaxableSupplyDate,
            VariableSymbol = _invoice.VariableSymbol,
            BankAccountNumber = _invoice.BankAccountNumber,
            IBAN = _invoice.IBAN,
            SWIFT = _invoice.SWIFT,
            PaymentMethod = _invoice.PaymentMethod,
            CurrencyId = _invoice.CurrencyId,
            Notes = _invoice.Notes
        };

        _editIssueDate = _invoice.IssueDate;
        _editDueDate = _invoice.DueDate;
        _editTaxableSupplyDate = _invoice.TaxableSupplyDate;

        // Copy items for editing
        // Map existing items to editable DTOs — IsTextRow must be preserved
        // so the InvoiceItemEditor renders text rows correctly (italic, colspan).
        _editItems = _invoice.InvoiceItem.Select(Fakvio.UI.Shared.Models.InvoiceItemEditMapper.ToEditDto).ToList();

        _isEditing = true;
        _isDirty = true; // Entering edit mode means the user intends to change something
    }

    /// <summary>
    /// Cancels edit mode without saving — reverts to readonly view.
    /// Resets dirty flag since the user explicitly chose to discard changes.
    /// </summary>
    private void CancelEditing()
    {
        _isEditing = false;
        _isDirty = false;
    }

    /// <summary>
    /// Saves the edited invoice via PUT /api/invoice/{id}.
    /// </summary>
    private async Task SaveInvoice()
    {
        if (_invoice == null) return;

        if (_saving) return;
        _saving = true;
        try
        {
            if (_editItems.Count == 0)
            {
                Snackbar.Add(L["Invoice_AddAtLeastOneItem"].Value, Severity.Warning);
                return;
            }

            if (!ValidateReverseCharge(_editItems)) return;

            _editDto.IssueDate = _editIssueDate;
            _editDto.DueDate = _editDueDate;
            _editDto.TaxableSupplyDate = _editTaxableSupplyDate;
            _editDto.InvoiceItem = _editItems;

            var result = await InvoiceService.UpdateAsync(Id, _editDto);
            if (result != null)
            {
                _isDirty = false; // Reset dirty flag on successful save
                Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                _isEditing = false;
                _invoice = result; // Update displayed data with API response
            }
            else
            {
                Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
    }

    // --- Metadata edit (Completed invoices — non-financial fields) ---

    /// <summary>
    /// Enables editing of non-financial metadata on a Completed invoice.
    /// Only PaymentMethod, BankAccount, IBAN, SWIFT, and Notes can be changed.
    /// Reverts a Completed invoice back to Draft so the user can fully edit all fields.
    /// </summary>
    private async Task RevertToDraft()
    {
        if (_invoice == null) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", L["Invoice_RevertToDraftConfirm"].Value);
        if (!confirmed) return;

        try
        {
            var result = await InvoiceService.RevertToDraftAsync(Id);
            if (result != null)
            {
                _invoice = result;
                Snackbar.Add(L["Invoice_RevertedToDraft"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

