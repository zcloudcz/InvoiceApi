    /// <summary>
    /// Navigates back to the appropriate list page based on the document type.
    /// Proformas go to /invoices?type=Proforma, DPPs to /invoices?type=TaxReceiptForAdvance,
    /// CreditNotes to /invoices?type=CreditNote, everything else to /invoices.
    /// </summary>
    private void GoBack()
    {
        var docType = _isCreateMode ? _createDto.DocumentType : _invoice?.DocumentType;
        var url = docType switch
        {
            EDocumentType.CreditNote           => "/invoices?type=CreditNote",
            EDocumentType.Proforma             => "/invoices?type=Proforma",
            EDocumentType.TaxReceiptForAdvance => "/invoices?type=TaxReceiptForAdvance",
            _                                  => "/invoices"
        };
        Navigation.NavigateTo(url);
    }

    // --- Validation helpers ---

    /// <summary>
    /// Validates that VariableSymbol contains only digits and is max 10 characters.
    /// Returns null if valid, or an error message string if invalid.
    /// </summary>
    private string? ValidateVariableSymbol(string? value)
    {
        if (string.IsNullOrEmpty(value)) return null; // optional field
        if (value.Length > 10) return L["Invoice_VSMaxLength"].Value;
        if (!value.All(char.IsDigit)) return L["Invoice_VSDigitsOnly"].Value;
        return null;
    }

    // ── Proforma cross-link loading ─────────────────────────────────────────

    /// <summary>
    /// Loads both tax receipts and final invoices linked to the current proforma.
    /// Also loads the remaining advance amount. Runs non-blocking in the background.
    /// </summary>
    private async Task LoadProformaLinksAsync()
    {
        _loadingProformaLinks = true;
        StateHasChanged();
        try
        {
            // Run all three calls in parallel to keep load time low
            var taxReceiptsTask = InvoiceService.GetTaxReceiptsForProformaAsync(Id);
            var finalInvoicesTask = InvoiceService.GetFinalInvoicesForProformaAsync(Id);
            var remainingTask = InvoiceService.GetRemainingAdvanceAsync(Id);

            await Task.WhenAll(taxReceiptsTask, finalInvoicesTask, remainingTask);

            _taxReceipts = taxReceiptsTask.Result;
            _finalInvoices = finalInvoicesTask.Result;
            _remainingAdvance = remainingTask.Result;
        }
        catch
        {
            // Non-critical — cross-link sections simply show empty state on failure.
            _taxReceipts = [];
            _finalInvoices = [];
            _remainingAdvance = null;
        }
        finally
        {
            _loadingProformaLinks = false;
            StateHasChanged();
        }
    }

    // ── Proforma actions ────────────────────────────────────────────────────

    /// <summary>
    /// Issues a final Invoice from the current proforma.
    /// Calls POST /api/invoice/{proformaId}/issue-final, then navigates to the new invoice.
    /// </summary>
    private async Task IssueFinalInvoice()
    {
        if (_issueFinalItems.Count == 0)
        {
            Snackbar.Add(L["IssueFinalInvoice_AddAtLeastOneItem"].Value, Severity.Warning);
            return;
        }

        if (!ValidateReverseCharge(_issueFinalItems)) return;

        _issuingFinalInvoice = true;
        try
        {
            _issueFinalDto.IssueDate = _issueFinalIssueDate;
            _issueFinalDto.DueDate = _issueFinalDueDate;
            _issueFinalDto.InvoiceItem = _issueFinalItems;

            var result = await InvoiceService.IssueFinalInvoiceAsync(Id, _issueFinalDto);
            if (result != null)
            {
                Snackbar.Add(L["Proforma_IssueFinalSuccess"].Value, Severity.Success);
                _showIssueFinalDialog = false;
                // Navigate to the new final invoice so the user can review and edit it
                Navigation.NavigateTo($"/invoices/{result.Id}?edit=true");
            }
            else
            {
                Snackbar.Add(L["Proforma_IssueFinalFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _issuingFinalInvoice = false;
        }
    }

    /// <summary>
    /// Opens the "Issue Final Invoice" dialog pre-initialised with empty items and today's dates.
    /// The dialog is only opened (not closed) here — closing is done via Cancel button or dialog backdrop.
    /// </summary>
    private void IssueTaxReceiptManual()
    {
        // Manual DPP issue flows through the standard invoice create page with type=TaxReceiptForAdvance
        // and the proforma as the OriginalInvoiceId, exactly like the credit-note flow.
        // We navigate there instead of opening a separate dialog — consistent UX.
        Navigation.NavigateTo($"/invoices/create?type=TaxReceiptForAdvance&originalId={Id}");
    }

