@page "/content-templates"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Fakvio.Contracts.Dto.ContentTemplate
@using Fakvio.Domain.Enums
@inject ContentTemplateApiService TemplateService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ContentTemplate_Title"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["ContentTemplate_Title"]</MudText>
<MudText Class="mb-4">@L["ContentTemplate_Subtitle"]</MudText>

<MudPaper Class="pa-4">
    @* Toolbar section with Create button and filter chips *@
    <div class="d-flex justify-space-between align-center mb-4">
        @* Navigate to create page instead of opening a dialog *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo("/content-templates/create"))">
            @L["ContentTemplate_New"]
        </MudButton>
        @* Filter by template type group *@
        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection" SelectedValueChanged="OnFilterChanged">
            <MudChip T="string" Value="@("all")" Default="true">@L["Label_All"]</MudChip>
            <MudChip T="string" Value="@("pdf")" Color="Color.Info">PDF</MudChip>
            <MudChip T="string" Value="@("email")" Color="Color.Primary">Email</MudChip>
            <MudChip T="string" Value="@("system")" Color="Color.Warning">@L["ContentTemplate_System"]</MudChip>
        </MudChipSet>
    </div>

    @* MudDataGrid with client-side data, column filters, and inline actions *@
    <FakvioGrid T="ContentTemplateDto"
                GridKey="content-templates"
                @ref="_dataGrid"
                Items="@_filteredTemplates"
                Loading="@_loading"
                QuickFilter="@FilterFunc"
                RowClick="@(args => Navigation.NavigateTo($"/content-templates/{args.Item.Id}"))">
        <ToolBarContent>
            @* Search box for filtering by name, subject, or description *@
            <MudTextField @bind-Value="_searchString" Placeholder="@L["Btn_Search"].Value"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium" Class="mt-0" />
        </ToolBarContent>
        <Columns>
            @* PropertyColumn: sortable + filterable by default. CellTemplate uses context.Item. *@
            <PropertyColumn Property="x => x.Name" Title="@L["ContentTemplate_Name"].Value">
                <CellTemplate>
                    <MudText>@context.Item.Name</MudText>
                    @if (!string.IsNullOrEmpty(context.Item.Description))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Default">@context.Item.Description</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.TemplateType" Title="@L["ContentTemplate_Type"].Value" Sortable="false">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@GetTemplateTypeColor(context.Item.TemplateType)">
                        @GetTemplateTypeLabel(context.Item.TemplateType)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Language" Title="@L["ContentTemplate_Language"].Value" Sortable="false">
                <CellTemplate>@context.Item.Language.ToUpperInvariant()</CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Subject" Title="@L["ContentTemplate_Subject"].Value" />
            <PropertyColumn Property="x => x.IsDefault" Title="@L["ContentTemplate_IsDefault"].Value" Sortable="false" Filterable="false">
                <CellTemplate>
                    @if (context.Item.IsDefault)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" />
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.IsActive" Title="@L["Label_Status"].Value">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                        @(context.Item.IsActive ? L["Label_Active"].Value : L["Label_Inactive"].Value)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            @* Actions column — edit, delete, preview, download, upload *@
            <TemplateColumn T="ContentTemplateDto" Title="@L["Label_Actions"].Value" Sortable="false" Filterable="false" CellStyle="white-space:nowrap;">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   OnClick="@(() => Navigation.NavigateTo($"/content-templates/{context.Item.Id}"))" Title="@L["Btn_Edit"].Value" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => DeleteTemplate(context.Item.Id))" Title="@L["Btn_Delete"].Value" />
                    @* Preview template with real/sample data *@
                    <MudIconButton Icon="@Icons.Material.Filled.Preview" Size="Size.Small" Color="Color.Default"
                                   Disabled="@string.IsNullOrEmpty(context.Item.HtmlBody)"
                                   OnClick="@(() => PreviewTemplate(context.Item))"
                                   Title="@L["ContentTemplate_Preview"].Value" />
                    @* Download HTML body as .html file *@
                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Default"
                                   Disabled="@string.IsNullOrEmpty(context.Item.HtmlBody)"
                                   OnClick="@(() => DownloadHtml(context.Item))"
                                   Title="@L["ContentTemplate_DownloadHtml"].Value" />
                    @* Upload HTML file to replace template body *@
                    @{
                        // Capture the row item — inside MudFileUpload's ActivatorContent,
                        // "context" refers to the upload component, not the grid row.
                        var rowItem = context.Item;
                    }
                    <MudFileUpload T="IBrowserFile" Accept=".html,.htm"
                                   FilesChanged="@(file => HandleHtmlFileUpload(rowItem, file))"
                                   Class="d-inline-flex ma-0" Style="min-width:0;">
                        <ActivatorContent>
                            <MudIconButton Icon="@Icons.Material.Filled.Upload" Size="Size.Small" Color="Color.Default"
                                           Title="@L["ContentTemplate_UploadHtml"].Value" />
                        </ActivatorContent>
                    </MudFileUpload>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText>@L["ContentTemplate_NoRecords"]</MudText>
        </NoRecordsContent>
    </FakvioGrid>
</MudPaper>

@* Dialog for email template HTML preview *@
<MudDialog @bind-Visible="_showPreviewDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["ContentTemplate_PreviewTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_previewHtml))
        {
            <div class="pa-4" style="border: 1px solid #e0e0e0; border-radius: 4px; min-height: 200px; background: white; color: black;">
                @((MarkupString)_previewHtml)
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showPreviewDialog = false)">@L["Btn_Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private FakvioGrid<ContentTemplateDto>? _dataGrid;
    private List<ContentTemplateDto> _templates = new();
    private List<ContentTemplateDto> _filteredTemplates = new();
    private bool _loading = true;
    private string _searchString = "";
    private string _activeFilter = "all";

    // Preview state
    private bool _showPreviewDialog = false;
    private string? _previewHtml;

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplates();
    }

    private async Task LoadTemplates()
    {
        try
        {
            _loading = true;
            _templates = await TemplateService.GetAllAsync(includeInactive: true);
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Applies the group filter (all / pdf / email / system) to the templates list.
    /// </summary>
    private void ApplyFilter()
    {
        _filteredTemplates = _activeFilter switch
        {
            "pdf" => _templates.Where(t => IsPdfType(t.TemplateType)).ToList(),
            "email" => _templates.Where(t => IsDocumentEmailType(t.TemplateType)).ToList(),
            "system" => _templates.Where(t => IsSystemEmailType(t.TemplateType)).ToList(),
            _ => _templates
        };
    }

    /// <summary>
    /// Called when the filter chip selection changes.
    /// </summary>
    private void OnFilterChanged(string value)
    {
        _activeFilter = value ?? "all";
        ApplyFilter();
    }

    /// <summary>
    /// Client-side search filter for the table.
    /// </summary>
    private bool FilterFunc(ContentTemplateDto template)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        var search = _searchString.ToLower();
        return template.Name?.ToLower().Contains(search) == true
            || template.Subject?.ToLower().Contains(search) == true
            || template.Description?.ToLower().Contains(search) == true;
    }

    private async Task DeleteTemplate(long id)
    {
        try
        {
            var success = await TemplateService.DeleteAsync(id);
            if (success)
            {
                Snackbar.Add(L["Msg_DeleteSuccess"].Value, Severity.Success);
                await LoadTemplates();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    // ========== Preview ==========

    /// <summary>
    /// Previews a template: PDF templates download a rendered PDF, email templates open a dialog.
    /// </summary>
    private async Task PreviewTemplate(ContentTemplateDto template)
    {
        try
        {
            if (IsPdfType(template.TemplateType))
            {
                // PDF preview — download rendered PDF
                var pdfBytes = await TemplateService.PreviewPdfAsync(template.Id);
                if (pdfBytes != null && pdfBytes.Length > 0)
                {
                    var base64 = Convert.ToBase64String(pdfBytes);
                    var fileName = $"Preview_{SanitizeFileName(template.Name)}.pdf";
                    await JS.InvokeVoidAsync("downloadFile", fileName, base64, "application/pdf");
                }
                else
                {
                    Snackbar.Add(L["ContentTemplate_PreviewNoData"].Value, Severity.Warning);
                }
            }
            else
            {
                // Email preview — show rendered HTML in dialog
                var html = await TemplateService.PreviewHtmlAsync(template.Id);
                if (!string.IsNullOrEmpty(html))
                {
                    _previewHtml = html;
                    _showPreviewDialog = true;
                }
                else
                {
                    Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    // ========== Download / Upload HTML ==========

    /// <summary>
    /// Downloads the template's HTML body as a .html file via JS interop.
    /// </summary>
    private async Task DownloadHtml(ContentTemplateDto template)
    {
        if (string.IsNullOrEmpty(template.HtmlBody)) return;

        var safeName = SanitizeFileName(template.Name);
        var fileName = $"{safeName}.html";
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(template.HtmlBody));
        await JS.InvokeVoidAsync("downloadFile", fileName, base64, "text/html");
    }

    /// <summary>
    /// Handles an uploaded .html/.htm file — reads its content and updates the template via API.
    /// </summary>
    private async Task HandleHtmlFileUpload(ContentTemplateDto template, IBrowserFile file)
    {
        var ext = Path.GetExtension(file.Name)?.ToLowerInvariant();
        if (ext != ".html" && ext != ".htm")
        {
            Snackbar.Add(L["ContentTemplate_InvalidFile"].Value, Severity.Warning);
            return;
        }

        try
        {
            // Read uploaded HTML content (max 5 MB)
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream, System.Text.Encoding.UTF8);
            var htmlContent = await reader.ReadToEndAsync();

            // Update the template with the new HTML body via API
            var updateDto = new UpdateContentTemplateDto
            {
                Name = template.Name,
                Subject = template.Subject,
                HtmlBody = htmlContent,
                TemplateType = template.TemplateType,
                IsDefault = template.IsDefault,
                Language = template.Language,
                Description = template.Description
            };

            var result = await TemplateService.UpdateAsync(template.Id, updateDto);
            if (result != null)
            {
                Snackbar.Add(L["ContentTemplate_HtmlUploaded"].Value, Severity.Success);
                await LoadTemplates(); // Refresh list
            }
            else
            {
                Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Removes characters that are invalid in file names.
    /// </summary>
    private static string SanitizeFileName(string name)
    {
        var invalid = Path.GetInvalidFileNameChars();
        return string.Concat(name.Where(c => !invalid.Contains(c)));
    }

    // ========== Type helpers ==========

    /// <summary>
    /// Returns true for email template types (have a Subject field).
    /// </summary>
    private static bool IsEmailType(EContentTemplateType type)
        => (int)type >= 10;

    /// <summary>
    /// Returns true for PDF template types.
    /// </summary>
    private static bool IsPdfType(EContentTemplateType type)
        => (int)type >= 1 && (int)type <= 9;

    /// <summary>
    /// Returns true for document email types (invoice/credit note emails).
    /// </summary>
    private static bool IsDocumentEmailType(EContentTemplateType type)
        => (int)type >= 10 && (int)type <= 19;

    /// <summary>
    /// Returns true for system email types (invitation, reminder, password reset).
    /// </summary>
    private static bool IsSystemEmailType(EContentTemplateType type)
        => (int)type >= 20;

    /// <summary>
    /// Returns a color for the template type chip in the table.
    /// </summary>
    private static Color GetTemplateTypeColor(EContentTemplateType type) => type switch
    {
        EContentTemplateType.InvoicePdf => Color.Info,
        EContentTemplateType.CreditNotePdf => Color.Info,
        // Advance invoice (pro-forma) — green to match its PDF accent colour
        EContentTemplateType.AdvanceInvoicePdf => Color.Success,
        // Tax receipt for advance — uses a tertiary/purple colour; fall back to Info
        EContentTemplateType.TaxReceiptForAdvancePdf => Color.Tertiary,
        EContentTemplateType.InvoiceEmail => Color.Primary,
        EContentTemplateType.CreditNoteEmail => Color.Primary,
        EContentTemplateType.AdvanceInvoiceEmail => Color.Success,
        EContentTemplateType.TaxReceiptForAdvanceEmail => Color.Tertiary,
        EContentTemplateType.InvitationEmail => Color.Warning,
        EContentTemplateType.ReminderEmail => Color.Error,
        EContentTemplateType.PasswordResetEmail => Color.Warning,
        _ => Color.Default
    };

    /// <summary>
    /// Returns a localized label for the template type.
    /// </summary>
    private string GetTemplateTypeLabel(EContentTemplateType type) => type switch
    {
        EContentTemplateType.InvoicePdf => L["ContentType_InvoicePdf"].Value,
        EContentTemplateType.CreditNotePdf => L["ContentType_CreditNotePdf"].Value,
        EContentTemplateType.AdvanceInvoicePdf => L["ContentType_AdvanceInvoicePdf"].Value,
        EContentTemplateType.TaxReceiptForAdvancePdf => L["ContentType_TaxReceiptForAdvancePdf"].Value,
        EContentTemplateType.InvoiceEmail => L["ContentType_InvoiceEmail"].Value,
        EContentTemplateType.CreditNoteEmail => L["ContentType_CreditNoteEmail"].Value,
        EContentTemplateType.AdvanceInvoiceEmail => L["ContentType_AdvanceInvoiceEmail"].Value,
        EContentTemplateType.TaxReceiptForAdvanceEmail => L["ContentType_TaxReceiptForAdvanceEmail"].Value,
        EContentTemplateType.InvitationEmail => L["ContentType_InvitationEmail"].Value,
        EContentTemplateType.ReminderEmail => L["ContentType_ReminderEmail"].Value,
        EContentTemplateType.PasswordResetEmail => L["ContentType_PasswordResetEmail"].Value,
        _ => type.ToString()
    };
}
