@page "/content-templates"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Fakvio.Contracts.Dto.ContentTemplate
@using Fakvio.Domain.Enums
@inject ContentTemplateApiService TemplateService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ContentTemplate_Title"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["ContentTemplate_Title"]</MudText>
<MudText Class="mb-4">@L["ContentTemplate_Subtitle"]</MudText>

<MudPaper Class="pa-4">
    @* Toolbar section with Create button and filter chips *@
    <div class="d-flex justify-space-between align-center mb-4">
        @* Navigate to create page instead of opening a dialog *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo("/content-templates/create"))">
            @L["ContentTemplate_New"]
        </MudButton>
        @* Filter by template type group *@
        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection" SelectedValueChanged="OnFilterChanged">
            <MudChip T="string" Value="@("all")" Default="true">@L["Label_All"]</MudChip>
            <MudChip T="string" Value="@("pdf")" Color="Color.Info">PDF</MudChip>
            <MudChip T="string" Value="@("email")" Color="Color.Primary">Email</MudChip>
            <MudChip T="string" Value="@("system")" Color="Color.Warning">@L["ContentTemplate_System"]</MudChip>
        </MudChipSet>
    </div>

    @* AppDataGrid replaces MudTable for consistent table behavior and built-in action column *@
    <AppDataGrid TItem="ContentTemplateDto"
                 Items="@_filteredTemplates"
                 Loading="@_loading"
                 NoRecordsText="@L["ContentTemplate_NoRecords"].Value"
                 Filter="@FilterFunc"
                 OnRowClick="@(t => Navigation.NavigateTo($"/content-templates/{t.Id}"))"
                 OnEdit="@(t => Navigation.NavigateTo($"/content-templates/{t.Id}"))"
                 OnDelete="@(item => DeleteTemplate(item.Id))">
        <ToolBarContent>
            @* Search box for filtering by name, subject, or description *@
            <MudTextField @bind-Value="_searchString" Placeholder="@L["Btn_Search"].Value"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium" Class="mt-0" />
        </ToolBarContent>
        <Columns>
            @* Define header cells for each column (Actions column auto-generated by AppDataGrid) *@
            <MudTh>@L["ContentTemplate_Name"]</MudTh>
            <MudTh>@L["ContentTemplate_Type"]</MudTh>
            <MudTh>@L["ContentTemplate_Language"]</MudTh>
            <MudTh>@L["ContentTemplate_Subject"]</MudTh>
            <MudTh>@L["ContentTemplate_IsDefault"]</MudTh>
            <MudTh>@L["Label_Status"]</MudTh>
        </Columns>
        <RowContent>
            @* Define data cells for each column (Actions cell auto-generated by AppDataGrid) *@
            <MudTd DataLabel="@L["ContentTemplate_Name"].Value">
                <MudText>@context.Name</MudText>
                @if (!string.IsNullOrEmpty(context.Description))
                {
                    <MudText Typo="Typo.caption" Color="Color.Default">@context.Description</MudText>
                }
            </MudTd>
            <MudTd DataLabel="@L["ContentTemplate_Type"].Value">
                <MudChip T="string" Size="Size.Small" Color="@GetTemplateTypeColor(context.TemplateType)">
                    @GetTemplateTypeLabel(context.TemplateType)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@L["ContentTemplate_Language"].Value">
                @context.Language.ToUpperInvariant()
            </MudTd>
            <MudTd DataLabel="@L["ContentTemplate_Subject"].Value">
                @(context.Subject ?? "—")
            </MudTd>
            <MudTd DataLabel="@L["ContentTemplate_IsDefault"].Value">
                @if (context.IsDefault)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" />
                }
            </MudTd>
            <MudTd DataLabel="@L["Label_Status"].Value">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? L["Label_Active"].Value : L["Label_Inactive"].Value)
                </MudChip>
            </MudTd>
        </RowContent>
    </AppDataGrid>
</MudPaper>

@code {
    private List<ContentTemplateDto> _templates = new();
    private List<ContentTemplateDto> _filteredTemplates = new();
    private bool _loading = true;
    private string _searchString = "";
    private string _activeFilter = "all";

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplates();
    }

    private async Task LoadTemplates()
    {
        try
        {
            _loading = true;
            _templates = await TemplateService.GetAllAsync(includeInactive: true);
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Applies the group filter (all / pdf / email / system) to the templates list.
    /// </summary>
    private void ApplyFilter()
    {
        _filteredTemplates = _activeFilter switch
        {
            "pdf" => _templates.Where(t => IsPdfType(t.TemplateType)).ToList(),
            "email" => _templates.Where(t => IsDocumentEmailType(t.TemplateType)).ToList(),
            "system" => _templates.Where(t => IsSystemEmailType(t.TemplateType)).ToList(),
            _ => _templates
        };
    }

    /// <summary>
    /// Called when the filter chip selection changes.
    /// </summary>
    private void OnFilterChanged(string value)
    {
        _activeFilter = value ?? "all";
        ApplyFilter();
    }

    /// <summary>
    /// Client-side search filter for the table.
    /// </summary>
    private bool FilterFunc(ContentTemplateDto template)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        var search = _searchString.ToLower();
        return template.Name?.ToLower().Contains(search) == true
            || template.Subject?.ToLower().Contains(search) == true
            || template.Description?.ToLower().Contains(search) == true;
    }

    private async Task DeleteTemplate(long id)
    {
        try
        {
            var success = await TemplateService.DeleteAsync(id);
            if (success)
            {
                Snackbar.Add(L["Msg_DeleteSuccess"].Value, Severity.Success);
                await LoadTemplates();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    // ========== Type helpers ==========

    /// <summary>
    /// Returns true for email template types (have a Subject field).
    /// </summary>
    private static bool IsEmailType(EContentTemplateType type)
        => (int)type >= 10;

    /// <summary>
    /// Returns true for PDF template types.
    /// </summary>
    private static bool IsPdfType(EContentTemplateType type)
        => (int)type >= 1 && (int)type <= 9;

    /// <summary>
    /// Returns true for document email types (invoice/credit note emails).
    /// </summary>
    private static bool IsDocumentEmailType(EContentTemplateType type)
        => (int)type >= 10 && (int)type <= 19;

    /// <summary>
    /// Returns true for system email types (invitation, reminder, password reset).
    /// </summary>
    private static bool IsSystemEmailType(EContentTemplateType type)
        => (int)type >= 20;

    /// <summary>
    /// Returns a color for the template type chip in the table.
    /// </summary>
    private static Color GetTemplateTypeColor(EContentTemplateType type) => type switch
    {
        EContentTemplateType.InvoicePdf => Color.Info,
        EContentTemplateType.CreditNotePdf => Color.Info,
        EContentTemplateType.InvoiceEmail => Color.Primary,
        EContentTemplateType.CreditNoteEmail => Color.Primary,
        EContentTemplateType.InvitationEmail => Color.Warning,
        EContentTemplateType.ReminderEmail => Color.Error,
        EContentTemplateType.PasswordResetEmail => Color.Warning,
        _ => Color.Default
    };

    /// <summary>
    /// Returns a localized label for the template type.
    /// </summary>
    private string GetTemplateTypeLabel(EContentTemplateType type) => type switch
    {
        EContentTemplateType.InvoicePdf => L["ContentType_InvoicePdf"].Value,
        EContentTemplateType.CreditNotePdf => L["ContentType_CreditNotePdf"].Value,
        EContentTemplateType.InvoiceEmail => L["ContentType_InvoiceEmail"].Value,
        EContentTemplateType.CreditNoteEmail => L["ContentType_CreditNoteEmail"].Value,
        EContentTemplateType.InvitationEmail => L["ContentType_InvitationEmail"].Value,
        EContentTemplateType.ReminderEmail => L["ContentType_ReminderEmail"].Value,
        EContentTemplateType.PasswordResetEmail => L["ContentType_PasswordResetEmail"].Value,
        _ => type.ToString()
    };
}
