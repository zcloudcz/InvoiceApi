@page "/received-invoices"
@attribute [Authorize]

@using Fakvio.Contracts.Dto.ReceivedInvoice
@using Fakvio.Contracts.Dto.Client
@using Fakvio.Domain.Enums
@using Fakvio.UI.Shared.Services
@using Fakvio.UI.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization

@inject ReceivedInvoiceApiService ReceivedInvoiceService
@inject FileAttachmentApiService FileAttachmentService
@inject ClientApiService ClientService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

<PageTitle>@L["ReceivedInvoice_Title"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@L["ReceivedInvoice_Title"]</MudText>

@* ── Filter Bar ─────────────────────────────────────────────────────── *@
@* IssueDate / DueDate filters live on the column headers (DateColumnFilter)
   with operator support (=, >, <, between). No duplicate page-level pickers. *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_search"
                          Label="@L["Common_Search"]"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          DebounceInterval="300"
                          TextChanged="OnSearchChanged" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <EnumSelect TEnum="EReceivedInvoiceStatus"
                        NullableValue="_statusFilter"
                        NullableValueChanged="OnStatusChanged"
                        Label="@L["Common_Status"]"
                        Nullable="true" />
        </MudItem>
    </MudGrid>
    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="6" Class="d-flex flex-wrap gap-2">
            @* ResponsiveButtons: collapse to icon-only on phones *@
            <ResponsiveButton Label="@L["ReceivedInvoice_New"].Value"
                              StartIcon="@Icons.Material.Filled.Add"
                              OnClick="CreateNew" />
            <ResponsiveButton Label="@L["Nav_ImportInvoices"].Value"
                              StartIcon="@Icons.Material.Filled.UploadFile"
                              Variant="Variant.Outlined"
                              Href="/received-invoices/import?target=ReceivedInvoice" />
        </MudItem>
    </MudGrid>
</MudPaper>

@* ── Bulk Operations Toolbar ────────────────────────────────────────── *@
@if (_selectedInvoices.Count > 0)
{
    <MudPaper Class="pa-3 mb-3 d-flex flex-wrap align-center gap-2" Elevation="2">
        <MudChip T="string" Color="Color.Info" Size="Size.Small">@_selectedInvoices.Count @L["Bulk_Selected"]</MudChip>
        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="BulkApprove"
                   Disabled="_bulkProcessing">@L["ReceivedInvoice_Approve"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Paid" OnClick="BulkMarkPaid"
                   Disabled="_bulkProcessing">@L["Invoice_MarkAsPaid"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Delete" OnClick="BulkDelete"
                   Disabled="_bulkProcessing">@L["Common_Delete"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Download" OnClick="BulkDownloadAttachments"
                   Disabled="_bulkProcessing">@L["ReceivedInvoice_DownloadAttachments"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Download" OnClick="BulkIsdoc"
                   Disabled="_bulkProcessing">@L["Bulk_Isdoc"]</MudButton>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearSelection">@L["Bulk_ClearSelection"]</MudButton>
        @if (_bulkProcessing)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
        }
    </MudPaper>
}

@* ── Data Grid — FakvioGrid = universal grid wrapper (see DEVGUIDE 7.10) ── *@
<FakvioGrid T="ReceivedInvoiceDto"
            GridKey="received-invoices"
            ServerData="LoadServerData"
            @ref="_dataGrid"
            Loading="_loading"
            MultiSelection="true"
            SelectedItems="_selectedInvoices"
            SelectedItemsChanged="@(items => { _selectedInvoices = items; StateHasChanged(); })"
            RowClick="@(args => Navigation.NavigateTo($"/received-invoices/{args.Item.Id}"))">
    <Columns>
        @* Checkbox column for bulk selection — required in MudBlazor v8 MudDataGrid *@
        <SelectColumn T="ReceivedInvoiceDto" />

        @* Document number — show dash when null *@
        <PropertyColumn Property="x => x.DocumentNumber" Title="@L["Invoice_DocumentNumber"].Value">
            <CellTemplate>
                @(context.Item.DocumentNumber ?? "—")
            </CellTemplate>
        </PropertyColumn>

        @* Supplier name — sortable, filterable *@
        <PropertyColumn Property="x => x.SupplierName" Title="@L["ReceivedInvoice_Supplier"].Value" />

        @* Issue date — short date format *@
        <PropertyColumn Property="x => x.IssueDate" Title="@L["Invoice_IssueDate"].Value" Format="d" HideSmall="true">
            <FilterTemplate>
                <DateColumnFilter T="ReceivedInvoiceDto" Context="context" ValueFunc="x => x.IssueDate" FilterKey="IssueDate" />
            </FilterTemplate>
        </PropertyColumn>

        @* Due date — highlight overdue invoices in red *@
        <PropertyColumn Property="x => x.DueDate" Title="@L["Invoice_DueDate"].Value" HideSmall="true">
            <FilterTemplate>
                <DateColumnFilter T="ReceivedInvoiceDto" Context="context" ValueFunc="x => x.DueDate" FilterKey="DueDate" />
            </FilterTemplate>
            <CellTemplate>
                @if (context.Item.DueDate.HasValue)
                {
                    var isOverdue = context.Item.Status == EReceivedInvoiceStatus.Approved
                                    && context.Item.DueDate < DateTime.UtcNow;
                    <MudText Color="@(isOverdue ? Color.Error : Color.Default)">
                        @context.Item.DueDate.Value.ToString("d")
                    </MudText>
                }
                else
                {
                    <span>—</span>
                }
            </CellTemplate>
        </PropertyColumn>

        @* Total with VAT — bold with currency symbol *@
        <PropertyColumn Property="x => x.TotalWithVat" Title="@L["Invoice_TotalWithVat"].Value"
                        SortBy="x => x.TotalWithVat">
            <CellTemplate>
                <strong>@context.Item.TotalWithVat.ToString("N2") @context.Item.CurrencySymbol</strong>
            </CellTemplate>
        </PropertyColumn>

        @* Status — colored chip *@
        <PropertyColumn Property="x => x.Status" Title="@L["Common_Status"].Value" Filterable="true">
            <CellTemplate>
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@GetStatusColor(context.Item.Status)">
                    @L[$"EReceivedInvoiceStatus_{context.Item.Status}"]
                </MudChip>
            </CellTemplate>
        </PropertyColumn>

        @* Attachments column — download single file directly, multiple as ZIP *@
        <TemplateColumn T="ReceivedInvoiceDto" Title="@L["ReceivedInvoice_Attachments"].Value"
                        Sortable="false" Filterable="false" CellStyle="white-space:nowrap;">
            <CellTemplate>
                @if (context.Item.AttachmentCount > 0)
                {
                    <MudBadge Content="@context.Item.AttachmentCount" Color="Color.Info"
                              Overlap="true" Bordered="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Download"
                                       Size="Size.Small"
                                       Title="@L["ReceivedInvoice_DownloadAttachments"]"
                                       Disabled="_downloadingAttachments"
                                       OnClick="@(() => DownloadAttachments(context.Item))" />
                    </MudBadge>
                }
            </CellTemplate>
        </TemplateColumn>

        @* Actions column — conditional buttons based on invoice status *@
        <TemplateColumn T="ReceivedInvoiceDto" Title="@L["Common_Actions"].Value"
                        Sortable="false" Filterable="false" CellStyle="white-space:nowrap;">
            <CellTemplate>
                @if (context.Item.Status == EReceivedInvoiceStatus.Received)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   Title="@L["ReceivedInvoice_Approve"]"
                                   OnClick="@(() => Approve(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   Title="@L["ReceivedInvoice_Reject"]"
                                   OnClick="@(() => Reject(context.Item))" />
                }
                @if (context.Item.Status == EReceivedInvoiceStatus.Approved)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Paid"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   Title="@L["Invoice_MarkAsPaid"]"
                                   OnClick="@(() => MarkAsPaid(context.Item))" />
                }
                @if (context.Item.Status == EReceivedInvoiceStatus.Received
                     || context.Item.Status == EReceivedInvoiceStatus.Rejected)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Title="@L["Common_Delete"]"
                                   OnClick="@(() => Delete(context.Item))" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</FakvioGrid>

@code {
    // FakvioGrid reference — used for ReloadAsync() calls after actions
    private FakvioGrid<ReceivedInvoiceDto>? _dataGrid;
    private bool _loading;
    private bool _bulkProcessing;
    private bool _downloadingAttachments;
    private string? _search;
    private EReceivedInvoiceStatus? _statusFilter;
    private HashSet<ReceivedInvoiceDto> _selectedInvoices = new();

    /// <summary>
    /// Server-side data loading callback for MudDataGrid.
    /// Converts MudBlazor's GridState into our ReceivedInvoiceFilterDto.
    /// MudDataGrid uses SortDefinitions instead of SortLabel/SortDirection.
    /// </summary>
    private async Task<GridData<ReceivedInvoiceDto>> LoadServerData(GridState<ReceivedInvoiceDto> state)
    {
        _loading = true;
        StateHasChanged();

        try
        {
            // Extract sort info from GridState — MudDataGrid uses SortDefinitions collection
            string? sortBy = null;
            string sortDirection = "desc";
            var sortDef = state.SortDefinitions.FirstOrDefault();
            if (sortDef != null)
            {
                sortBy = sortDef.SortBy;
                sortDirection = sortDef.Descending ? "desc" : "asc";
            }

            // Date ranges come exclusively from the IssueDate / DueDate column filters.
            var (issueFrom, issueTo) = state.GetDateRange("IssueDate");
            var (dueFrom, dueTo) = state.GetDateRange("DueDate");

            // Column filters (ColumnFilterRow) — one line per filterable column.
            // Page-level EnumSelect takes precedence over the Status column filter.
            var documentNumberFilter = state.GetStringFilter("DocumentNumber");
            var supplierNameFilter = state.GetStringFilter("SupplierName");
            var statusFilter = _statusFilter ?? state.GetEnumFilter<ReceivedInvoiceDto, EReceivedInvoiceStatus>("Status");

            var result = await ReceivedInvoiceService.GetPagedAsync(
                page: state.Page + 1, // MudDataGrid is 0-based, API is 1-based
                pageSize: state.PageSize,
                search: _search,
                sortBy: sortBy,
                sortDirection: sortDirection,
                status: statusFilter,
                documentNumber: documentNumberFilter,
                supplierName: supplierNameFilter,
                issueDateFrom: issueFrom,
                issueDateTo: issueTo,
                dueDateFrom: dueFrom,
                dueDateTo: dueTo);

            return new GridData<ReceivedInvoiceDto>
            {
                TotalItems = result.TotalCount,
                Items = result.Items
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading received invoices: {ex.Message}", Severity.Error);
            return new GridData<ReceivedInvoiceDto> { Items = new List<ReceivedInvoiceDto>(), TotalItems = 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        if (_dataGrid is not null)
            await _dataGrid.ReloadAsync();
    }

    private async Task OnStatusChanged(EReceivedInvoiceStatus? value)
    {
        _statusFilter = value;
        if (_dataGrid is not null)
            await _dataGrid.ReloadAsync();
    }

    private void CreateNew()
    {
        Navigation.NavigateTo("/received-invoices/create");
    }

    private async Task Approve(ReceivedInvoiceDto invoice)
    {
        var result = await ReceivedInvoiceService.ApproveAsync(invoice.Id);
        if (result is not null)
        {
            Snackbar.Add(L["ReceivedInvoice_Approved"].Value, Severity.Success);
            await _dataGrid!.ReloadAsync();
        }
    }

    private async Task MarkAsPaid(ReceivedInvoiceDto invoice)
    {
        var result = await ReceivedInvoiceService.MarkAsPaidAsync(invoice.Id);
        if (result is not null)
        {
            Snackbar.Add(L["Invoice_MarkedAsPaid"].Value, Severity.Success);
            await _dataGrid!.ReloadAsync();
        }
    }

    private async Task Reject(ReceivedInvoiceDto invoice)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", L["ReceivedInvoice_RejectConfirm"].Value);
        if (!confirmed) return;

        var result = await ReceivedInvoiceService.RejectAsync(invoice.Id);
        if (result is not null)
        {
            Snackbar.Add(L["ReceivedInvoice_Rejected"].Value, Severity.Warning);
            await _dataGrid!.ReloadAsync();
        }
    }

    private async Task Delete(ReceivedInvoiceDto invoice)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", L["Common_DeleteConfirm"].Value);
        if (!confirmed) return;

        var deleted = await ReceivedInvoiceService.DeleteAsync(invoice.Id);
        if (deleted)
        {
            Snackbar.Add(L["Common_Deleted"].Value, Severity.Success);
            await _dataGrid!.ReloadAsync();
        }
    }

    // ─── Attachment download ─────────────────────────────────────────────

    /// <summary>
    /// Downloads attachments of one invoice from the grid row.
    /// One attachment → direct download with the original file name and type.
    /// Multiple attachments → one ZIP named by the invoice document number.
    /// </summary>
    private async Task DownloadAttachments(ReceivedInvoiceDto invoice)
    {
        _downloadingAttachments = true;
        try
        {
            if (invoice.AttachmentCount == 1)
            {
                // Single file: fetch metadata to get the id + original name, then
                // reuse the single-download endpoint (no pointless ZIP wrapping).
                var attachments = await FileAttachmentService.GetByEntityAsync("ReceivedInvoice", invoice.Id);
                var single = attachments.FirstOrDefault();
                if (single is null)
                {
                    Snackbar.Add(L["ReceivedInvoice_NoAttachments"].Value, Severity.Warning);
                    return;
                }

                var bytes = await FileAttachmentService.DownloadAsync(single.Id);
                if (bytes is null) return;

                await JS.InvokeVoidAsync("downloadFile",
                    single.OriginalFileName, Convert.ToBase64String(bytes), single.ContentType);
            }
            else
            {
                var zipBytes = await FileAttachmentService.DownloadAllAsync("ReceivedInvoice", invoice.Id);
                if (zipBytes is null) return;

                var zipName = $"Prilohy_{invoice.DocumentNumber ?? invoice.Id.ToString()}.zip";
                await JS.InvokeVoidAsync("downloadFile",
                    zipName, Convert.ToBase64String(zipBytes), "application/zip");
            }
        }
        catch (ApiException)
        {
            // 404 — attachments disappeared between grid load and click
            Snackbar.Add(L["ReceivedInvoice_NoAttachments"].Value, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _downloadingAttachments = false;
        }
    }

    /// <summary>
    /// Bulk downloads attachments of all selected invoices as one ZIP
    /// (folder per invoice). Invoices without attachments are skipped.
    /// </summary>
    private async Task BulkDownloadAttachments()
    {
        var eligible = _selectedInvoices.Where(i => i.AttachmentCount > 0).ToList();
        if (eligible.Count == 0)
        {
            Snackbar.Add(L["Bulk_NoneEligible"].Value, Severity.Warning);
            return;
        }

        _bulkProcessing = true;
        StateHasChanged();
        try
        {
            var zipBytes = await ReceivedInvoiceService.BulkDownloadAttachmentsAsync(eligible.Select(i => i.Id));
            if (zipBytes is not null)
            {
                await JS.InvokeVoidAsync("downloadFile",
                    $"Prilohy_{DateTime.Now:yyyyMMdd}.zip", Convert.ToBase64String(zipBytes), "application/zip");
            }
        }
        catch (ApiException)
        {
            Snackbar.Add(L["ReceivedInvoice_NoAttachments"].Value, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _bulkProcessing = false;
        }
    }

    /// <summary>
    /// Bulk downloads ISDOC exports for all selected received invoices as one
    /// ZIP archive. Invoices that fail to export server-side are skipped.
    /// </summary>
    private async Task BulkIsdoc()
    {
        if (_selectedInvoices.Count == 0) return;

        _bulkProcessing = true;
        StateHasChanged();
        try
        {
            var zipBytes = await ReceivedInvoiceService.BulkExportIsdocAsync(
                _selectedInvoices.Select(i => i.Id).Distinct());
            if (zipBytes != null && zipBytes.Length > 0)
            {
                await JS.InvokeVoidAsync("downloadFile",
                    $"Isdoc_{DateTime.Now:yyyyMMdd}.zip", Convert.ToBase64String(zipBytes), "application/zip");
                Snackbar.Add(L["Invoice_IsdocDownloaded"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Invoice_IsdocFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _bulkProcessing = false;
        }
    }

    // ─── Bulk Operations ───────────────────────────────────────────────────

    private void ClearSelection()
    {
        _selectedInvoices = new HashSet<ReceivedInvoiceDto>();
        StateHasChanged();
    }

    /// <summary>
    /// Bulk approves all selected Received invoices.
    /// </summary>
    private async Task BulkApprove()
    {
        var eligible = _selectedInvoices
            .Where(i => i.Status == EReceivedInvoiceStatus.Received).ToList();
        if (eligible.Count == 0)
        {
            Snackbar.Add(L["Bulk_NoneEligible"].Value, Severity.Warning);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            string.Format(L["Bulk_ConfirmApprove"].Value, eligible.Count));
        if (!confirmed) return;

        _bulkProcessing = true;
        StateHasChanged();
        int ok = 0, fail = 0;
        try
        {
            foreach (var inv in eligible)
            {
                var result = await ReceivedInvoiceService.ApproveAsync(inv.Id);
                if (result != null) ok++; else fail++;
            }
            ShowBulkSnackbar(ok, fail);
            ClearSelection();
            await _dataGrid!.ReloadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
        finally { _bulkProcessing = false; }
    }

    /// <summary>
    /// Bulk marks all selected Approved invoices as paid.
    /// </summary>
    private async Task BulkMarkPaid()
    {
        var eligible = _selectedInvoices
            .Where(i => i.Status == EReceivedInvoiceStatus.Approved).ToList();
        if (eligible.Count == 0)
        {
            Snackbar.Add(L["Bulk_NoneEligible"].Value, Severity.Warning);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            string.Format(L["Bulk_ConfirmPaid"].Value, eligible.Count));
        if (!confirmed) return;

        _bulkProcessing = true;
        StateHasChanged();
        int ok = 0, fail = 0;
        try
        {
            foreach (var inv in eligible)
            {
                var result = await ReceivedInvoiceService.MarkAsPaidAsync(inv.Id);
                if (result != null) ok++; else fail++;
            }
            ShowBulkSnackbar(ok, fail);
            ClearSelection();
            await _dataGrid!.ReloadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
        finally { _bulkProcessing = false; }
    }

    /// <summary>
    /// Bulk deletes all selected Received/Rejected invoices.
    /// </summary>
    private async Task BulkDelete()
    {
        var eligible = _selectedInvoices
            .Where(i => i.Status == EReceivedInvoiceStatus.Received
                     || i.Status == EReceivedInvoiceStatus.Rejected).ToList();
        if (eligible.Count == 0)
        {
            Snackbar.Add(L["Bulk_NoneEligible"].Value, Severity.Warning);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            string.Format(L["Bulk_ConfirmDelete"].Value, eligible.Count));
        if (!confirmed) return;

        _bulkProcessing = true;
        StateHasChanged();
        int ok = 0, fail = 0;
        try
        {
            foreach (var inv in eligible)
            {
                var deleted = await ReceivedInvoiceService.DeleteAsync(inv.Id);
                if (deleted) ok++; else fail++;
            }
            ShowBulkSnackbar(ok, fail);
            ClearSelection();
            await _dataGrid!.ReloadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
        finally { _bulkProcessing = false; }
    }

    private void ShowBulkSnackbar(int ok, int fail)
    {
        if (fail == 0)
            Snackbar.Add(string.Format(L["Bulk_AllSuccess"].Value, ok), Severity.Success);
        else if (ok > 0)
            Snackbar.Add(string.Format(L["Bulk_PartialSuccess"].Value, ok, fail), Severity.Warning);
        else
            Snackbar.Add(L["Bulk_NoneEligible"].Value, Severity.Error);
    }

    // ─── Helpers ────────────────────────────────────────────────────────────

    /// <summary>
    /// Returns MudBlazor color for each received invoice status.
    /// </summary>
    private static Color GetStatusColor(EReceivedInvoiceStatus status) => status switch
    {
        EReceivedInvoiceStatus.Received => Color.Default,
        EReceivedInvoiceStatus.Approved => Color.Info,
        EReceivedInvoiceStatus.Paid => Color.Success,
        EReceivedInvoiceStatus.Rejected => Color.Warning,
        EReceivedInvoiceStatus.Deleted => Color.Error,
        _ => Color.Default
    };
}
