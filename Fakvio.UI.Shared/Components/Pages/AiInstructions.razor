@page "/ai-instructions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SysAdmin")]
@using Fakvio.Contracts.Dto.SystemConfiguration
@inject AiInstructionsApiService AiService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@inject ILogger<AiInstructions> _logger
@inject IDialogService DialogService


<PageTitle>@L["AiInstructions_Title"] - Fakvio</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">@L["AiInstructions_Title"]</MudText>
<MudText Class="mb-6" Color="Color.Secondary">@L["AiInstructions_Subtitle"]</MudText>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    @* Header toolbar with action buttons *@
    <div class="d-flex flex-wrap align-center gap-2 mb-4">
        @* Status chip — shows whether custom or default is active *@
        @if (_instructions?.IsCustomActive == true)
        {
            <MudChip T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.Edit"
                     Size="Size.Small">
                @L["AiInstructions_UsingCustom"]
            </MudChip>
        }
        else
        {
            <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle"
                     Size="Size.Small">
                @L["AiInstructions_UsingDefault"]
            </MudChip>
        }

        <MudSpacer />

        @* Preview button — shows the full assembled prompt *@
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Preview"
                   OnClick="ShowPreview"
                   Disabled="_saving || _loadingPreview">
            @if (_loadingPreview)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @L["AiInstructions_Preview"]
        </MudButton>

        @* Reset to default — clears both fields *@
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.RestartAlt"
                   OnClick="ConfirmReset"
                   Disabled="_saving">
            @L["AiInstructions_ResetToDefault"]
        </MudButton>

        @* Save button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Save"
                   Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @L["Btn_Save"]
        </MudButton>
    </div>

    <MudGrid>
        @* Card 1: Custom prompt (replaces hardcoded defaults) *@
        <MudItem xs="12">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.SmartToy" Class="mr-2" />
                            @L["AiInstructions_CustomPromptLabel"]
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTextField @bind-Value="_editDto.CustomPrompt"
                                  Lines="15"
                                  Variant="Variant.Outlined"
                                  Placeholder="Leave empty to use the hardcoded defaults..."
                                  HelperText="@L["AiInstructions_CustomPromptHint"].Value"
                                  Class="mb-0"
                                  Style="font-family: monospace; font-size: 13px;" />
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Card 2: Appendix (extra rules appended after main sections) *@
        <MudItem xs="12">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.PostAdd" Class="mr-2" />
                            @L["AiInstructions_AppendixLabel"]
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTextField @bind-Value="_editDto.Appendix"
                                  Lines="8"
                                  Variant="Variant.Outlined"
                                  Placeholder="Leave empty for no appendix..."
                                  HelperText="@L["AiInstructions_AppendixHint"].Value"
                                  Class="mb-0"
                                  Style="font-family: monospace; font-size: 13px;" />
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* Preview dialog is shown inline via MudDialog *@
    @if (_showPreview && _previewText != null)
    {
        <MudCard Elevation="4" Class="mb-4" Style="border: 2px solid var(--mud-palette-primary);">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Preview" Class="mr-2" />
                        @L["AiInstructions_PreviewTitle"]
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   OnClick='() => _showPreview = false' />
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    @L["AiInstructions_PreviewNote"]
                </MudAlert>
                <pre style="white-space: pre-wrap; font-family: monospace; font-size: 12px; background: var(--mud-palette-background-grey); padding: 16px; border-radius: 4px; overflow-x: auto;">@_previewText</pre>
            </MudCardContent>
        </MudCard>
    }

    @* Full-page overlay during save *@
    <MudOverlay Visible="_saving" DarkBackground="true" Absolute="false" ZIndex="9999">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </MudOverlay>
}

@code {
    private AiInstructionsDto? _instructions;
    private UpdateAiInstructionsDto _editDto = new();
    private bool _loading = true;
    private bool _saving = false;
    private bool _loadingPreview = false;
    private bool _showPreview = false;
    private string? _previewText;

    protected override async Task OnInitializedAsync()
    {
        await LoadInstructions();
    }

    /// <summary>Loads the current AI instructions from the API.</summary>
    private async Task LoadInstructions()
    {
        try
        {
            _loading = true;
            _instructions = await AiService.GetAsync();
            // Pre-fill the edit DTO with the current values.
            _editDto = new UpdateAiInstructionsDto
            {
                CustomPrompt = _instructions?.CustomPrompt,
                Appendix = _instructions?.Appendix
            };
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to load AI instructions");
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Saves the edited AI instructions to the API.</summary>
    private async Task Save()
    {
        _saving = true;
        StateHasChanged();
        try
        {
            var result = await AiService.UpdateAsync(_editDto);
            if (result != null)
            {
                _instructions = result;
                // Sync edit DTO to match saved state (e.g., empty → null normalization).
                _editDto = new UpdateAiInstructionsDto
                {
                    CustomPrompt = result.CustomPrompt,
                    Appendix = result.Appendix
                };
                Snackbar.Add(L["AiInstructions_SaveSuccess"].Value, Severity.Success);
                // Refresh preview if it's currently shown.
                if (_showPreview) await LoadPreview();
            }
            else
            {
                Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to save AI instructions");
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Shows a confirmation dialog before resetting to defaults.
    /// Prevents accidental loss of custom instructions.
    /// </summary>
    private async Task ConfirmReset()
    {
        // MudBlazor's built-in ShowMessageBox is the simplest confirmation pattern —
        // no custom dialog component needed.
        var confirmed = await DialogService.ShowMessageBox(
            L["AiInstructions_ResetToDefault"].Value,
            L["AiInstructions_ResetConfirm"].Value,
            yesText: L["Btn_Save"].Value,
            cancelText: L["Btn_Cancel"].Value);

        if (confirmed == true)
        {
            await Reset();
        }
    }

    /// <summary>Resets both fields to defaults (calls DELETE endpoint).</summary>
    private async Task Reset()
    {
        _saving = true;
        StateHasChanged();
        try
        {
            var success = await AiService.ResetToDefaultAsync();
            if (success)
            {
                // Reload to get the updated (null) values.
                await LoadInstructions();
                _showPreview = false;
                _previewText = null;
                Snackbar.Add(L["AiInstructions_ResetSuccess"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to reset AI instructions");
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Loads and shows the full assembled prompt preview.</summary>
    private async Task ShowPreview()
    {
        _showPreview = true;
        await LoadPreview();
    }

    private async Task LoadPreview()
    {
        _loadingPreview = true;
        StateHasChanged();
        try
        {
            var preview = await AiService.GetPreviewAsync();
            _previewText = preview?.FullPrompt;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to load AI instructions preview");
            _previewText = $"Error loading preview: {ex.Message}";
        }
        finally
        {
            _loadingPreview = false;
        }
    }
}
