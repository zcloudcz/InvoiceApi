@page "/set-password"
@using Fakvio.Contracts.Dto.User
@inject UserApiService UserService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@* Localization service for multi-language support *@
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["SetPassword_Title"] - Fakvio</PageTitle>

@*
    Anonymous page — no [Authorize] attribute.
    Accessed via invitation link with ?token=xxx query parameter.
    The user sets their password here after being invited by an admin.
*@

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-8">
        <MudStack Spacing="4">
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                @* App logo — grey version looks good on both dark and light paper backgrounds *@
                <MudImage Src="images/logo-grey.png" Alt="Fakvio" Width="64" Height="64" />
                <MudText Typo="Typo.h4" Align="Align.Center">Fakvio</MudText>
                <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Secondary">@L["SetPassword_Title"]</MudText>
            </MudStack>

            @* Show loading spinner while validating the token *@
            @if (_isValidating)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                <MudText Align="Align.Center">@L["SetPassword_ValidatingToken"]</MudText>
            }
            @* Show error if token is missing, invalid, or expired *@
            else if (!_isTokenValid)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                    @_errorMessage
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="@(() => Navigation.NavigateTo("/login"))">
                    @L["SetPassword_GoToLogin"]
                </MudButton>
            }
            @* Show the outcome after the password was set.
               The password and the workspace are two separate outcomes: the password may be
               set while tenant provisioning failed. In that case we must NOT show a plain
               "Done, log in" — the user would log into a workspace that does not exist. *@
            else if (_isSuccess)
            {
                @if (_workspaceReady)
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Filled">
                        @L["SetPassword_SuccessMessage"]
                    </MudAlert>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               OnClick="@(() => Navigation.NavigateTo("/login"))">
                        @L["Btn_Login"]
                    </MudButton>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                        @L["SetPassword_WorkspaceNotReady"]
                    </MudAlert>
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        @L["SetPassword_WorkspaceNotReadyHint"]
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                               OnClick="@(() => Navigation.NavigateTo("/login"))">
                        @L["Btn_Login"]
                    </MudButton>
                }
            }
            @* Show password form when token is valid *@
            else
            {
                <MudText Align="Align.Center" Color="Color.Secondary">
                    @L["SetPassword_Subtitle"]
                </MudText>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
                }

                <MudTextField @bind-Value="_newPassword"
                              Label="@L["SetPassword_NewPassword"].Value"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Required="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock" />

                <MudTextField @bind-Value="_confirmPassword"
                              Label="@L["SetPassword_ConfirmPassword"].Value"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Required="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true"
                           Disabled="@_isSubmitting"
                           OnClick="HandleSetPassword">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                        <span>@L["SetPassword_SettingPassword"]</span>
                    }
                    else
                    {
                        <span>@L["Btn_SetPassword"]</span>
                    }
                </MudButton>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    // Query parameter: the invitation token from the email link
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string _newPassword = "";
    private string _confirmPassword = "";
    private string? _errorMessage;
    private bool _isValidating = true;
    private bool _isTokenValid = false;
    private bool _isSubmitting = false;
    private bool _isSuccess = false;

    // Is the tenant workspace (database schema) ready after the password was set?
    // False = the password is set, but provisioning failed — show a warning, not "Done".
    private bool _workspaceReady = false;

    /// <summary>
    /// On page load, validate the invitation token.
    /// If valid, show the password form. If invalid/expired, show error.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Check if token is provided in the URL
        if (string.IsNullOrWhiteSpace(Token))
        {
            _errorMessage = L["SetPassword_TokenMissing"].Value;
            _isValidating = false;
            return;
        }

        try
        {
            // Validate token via API call (anonymous)
            _isTokenValid = await UserService.ValidateInvitationTokenAsync(Token);

            if (!_isTokenValid)
            {
                _errorMessage = L["SetPassword_TokenExpired"].Value;
            }
        }
        catch (RateLimitExceededException)
        {
            // RC.4 — the per-IP rate limiter rejected this attempt (429); distinct from an
            // actually expired/invalid invitation token.
            _errorMessage = L["RateLimit_TooManyAttempts"].Value;
        }
        catch (Exception ex)
        {
            _errorMessage = $"{L["Msg_Error"].Value}: {ex.Message}";
        }
        finally
        {
            _isValidating = false;
        }
    }

    /// <summary>
    /// Handles the password form submission.
    /// Validates that passwords match and meet minimum requirements,
    /// then calls the API to set the password.
    /// </summary>
    private async Task HandleSetPassword()
    {
        _errorMessage = null;

        // Client-side validation: passwords must match
        if (_newPassword != _confirmPassword)
        {
            _errorMessage = L["SetPassword_PasswordMismatch"].Value;
            return;
        }

        // Client-side validation: minimum password length
        if (_newPassword.Length < 6)
        {
            _errorMessage = L["SetPassword_MinLength"].Value;
            return;
        }

        _isSubmitting = true;

        try
        {
            var dto = new SetPasswordDto
            {
                Token = Token!,
                NewPassword = _newPassword
            };

            var result = await UserService.SetPasswordAsync(dto);

            if (result.PasswordSet)
            {
                _isSuccess = true;
                _workspaceReady = result.WorkspaceReady;

                if (_workspaceReady)
                {
                    Snackbar.Add(L["SetPassword_Success"].Value, Severity.Success);
                }
                else
                {
                    // Password is set but the workspace is not — tell the user, do not celebrate.
                    Snackbar.Add(L["SetPassword_WorkspaceNotReady"].Value, Severity.Warning);
                }
            }
            else
            {
                _errorMessage = L["SetPassword_SetFailed"].Value;
            }
        }
        catch (RateLimitExceededException)
        {
            // RC.4 — the per-IP rate limiter rejected this attempt (429); distinct from a
            // genuinely invalid/expired token (SetPassword_SetFailed).
            _errorMessage = L["RateLimit_TooManyAttempts"].Value;
        }
        catch (Exception ex)
        {
            _errorMessage = $"{L["Msg_Error"].Value}: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
