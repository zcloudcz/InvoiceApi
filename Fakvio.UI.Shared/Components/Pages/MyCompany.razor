    private async Task ActivateInvoiceMailbox()
    {
        _invoiceMailbox = await InvoiceMailboxApi.ActivateAsync();
        if (_invoiceMailbox != null)
            Snackbar.Add("Email pro příjem faktur aktivován.", Severity.Success);
    }

    private async Task DeactivateInvoiceMailbox()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Opravdu deaktivovat email pro příjem faktur?");
        if (!confirmed) return;

        _invoiceMailbox = await InvoiceMailboxApi.DeactivateAsync();
        Snackbar.Add("Email pro příjem faktur deaktivován.", Severity.Success);
    }

    private async Task RegenerateInvoiceMailbox()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Vygenerovat nový alias? Starý alias přestane fungovat okamžitě.");
        if (!confirmed) return;

        _invoiceMailbox = await InvoiceMailboxApi.RegenerateAsync();
        if (_invoiceMailbox != null)
            Snackbar.Add($"Nový alias: {_invoiceMailbox.FullEmailAddress}", Severity.Success);
    }

    private async Task CopyInvoiceMailboxEmail()
    {
        if (_invoiceMailbox != null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _invoiceMailbox.FullEmailAddress);
            Snackbar.Add("Email zkopírován do schránky.", Severity.Info);
        }
    }
