@*
    MyCompany.razor — Company profile page for regular users (non-SysAdmin).
    Allows authenticated users to view and edit their own company info, addresses,
    contacts, and billing settings. Uses ClientApiService (tenant DB) to load
    the issuer (the user's own company) via GET /api/client/issuer.

    Key difference from CompanyDetail.razor (SysAdmin):
    - Uses ClientApiService instead of CompanyApiService
    - No tenant provisioning, no user invitation, no company creation
    - Route: /my-company (not /companies/{id})
*@
@page "/my-company"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Fakvio.Contracts.Dto.Client
@using Fakvio.Contracts.Dto.CompanySettings
@using Fakvio.Contracts.Dto.CloudStorage
@using Fakvio.Contracts.Dto.InvoiceEmail
@using Fakvio.Domain.Enums
@inject ClientApiService ClientService
@inject InvoiceMailboxApiService InvoiceMailboxApi
@inject CompanySettingsApiService SettingsService
@inject CloudStorageApiService CloudStorageApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["MyCompany_Title"]</PageTitle>

@* Warn user before navigating away from dirty forms *@
<UnsavedChangesLock IsDirty="_isDirty" />

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (_errorMessage != null || _company == null)
{
    <MudAlert Severity="Severity.Error">@(_errorMessage ?? L["Msg_NotFound"])</MudAlert>
}
else
{
    @* Header: company name + Active chip + Edit/Save/Cancel buttons *@
    <div class="d-flex flex-wrap align-center gap-2 mb-4">
        <MudText Typo="Typo.h4" Class="mr-2">@_company.CompanyName</MudText>
        <MudChip T="string" Size="Size.Small" Color="@(_company.IsActive ? Color.Success : Color.Default)">
            @(_company.IsActive ? L["Label_Active"].Value : L["Label_Inactive"].Value)
        </MudChip>
        <MudSpacer />

        @if (!_isEditing)
        {
            @* View mode — Edit button *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="EnableEditing">@L["Btn_Edit"]</MudButton>
        }
        else
        {
            @* Edit mode — Save/Cancel buttons *@
            <MudButton Variant="Variant.Text" OnClick="CancelEditing" Disabled="_saving">@L["Btn_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveCompany" Disabled="_saving">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @L["Btn_Save"]
            </MudButton>
        }
    </div>

    @* Company information cards — 3-column layout *@
    <MudGrid>
        @* Card 1: Basic company info (RegistrationNumber, CompanyName, TaxNumber, IsVatPayer) *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Client_CompanyInfo"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isEditing)
                    {
                        @* Registration number + ARES fetch button *@
                        <div class="d-flex gap-2 mb-3">
                            <MudTextField @bind-Value="_editClient.RegistrationNumber"
                                          Label="@L["Client_RegistrationNumber"].Value"
                                          Class="flex-grow-1" />
                            <MudButton Variant="Variant.Filled" Color="Color.Info"
                                       StartIcon="@Icons.Material.Filled.Download"
                                       OnClick="FetchFromAres" Disabled="@_fetchingAres" Class="align-self-end">
                                @if (_fetchingAres)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <span>ARES</span>
                                }
                            </MudButton>
                        </div>
                        <MudTextField @bind-Value="_editClient.CompanyName" Label="@L["Client_CompanyName"].Value"
                                      Required="true" Class="mb-3" />
                        <MudTextField @bind-Value="_editClient.TradingName" Label="@L["Client_TradingName"].Value"
                                      Class="mb-3" />
                        <MudTextField @bind-Value="_editClient.TaxNumber" Label="@L["Client_TaxNumber"].Value"
                                      Class="mb-3" />
                        <MudSwitch @bind-Value="_editClient.IsVatPayer" Label="@L["Client_IsVatPayer"].Value"
                                   Color="Color.Primary" />
                        @* Language preference for documents (PDFs, emails) generated for this company *@
                        <MudSelect T="string" @bind-Value="_editClient.Language" Label="@L["Client_Language"].Value" Class="mt-3">
                            <MudSelectItem Value="@("cs")">Čeština (cs)</MudSelectItem>
                            <MudSelectItem Value="@("en")">English (en)</MudSelectItem>
                        </MudSelect>
                    }
                    else
                    {
                        @* Read-only display of company info *@
                        <MudList T="string" Dense="true">
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Business">
                                <strong>@L["Client_Company"]</strong> @_company.CompanyName
                            </MudListItem>
                            @if (!string.IsNullOrEmpty(_company.TradingName))
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.Badge">
                                    <strong>@L["Client_TradingNameLabel"]</strong> @_company.TradingName
                                </MudListItem>
                            }
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Numbers">
                                <strong>@L["Client_RegNoLabel"]</strong> @_company.RegistrationNumber
                            </MudListItem>
                            @if (!string.IsNullOrEmpty(_company.TaxNumber))
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.Receipt">
                                    <strong>@L["Client_TaxNoLabel"]</strong> @_company.TaxNumber
                                </MudListItem>
                            }
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Percent">
                                <strong>@L["Client_VatPayerLabel"]</strong>
                                @(_company.IsVatPayer ? L["Label_Yes"].Value : L["Label_No"].Value)
                            </MudListItem>
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Language">
                                <strong>@L["Client_Language"]:</strong> @GetLanguageDisplayName(_company.Language)
                            </MudListItem>
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Card 2: Contacts (email, phone) *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Client_Contact"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isEditing)
                    {
                        <MudTextField @bind-Value="_emailContact" Label="@L["Label_Email"].Value"
                                      InputType="InputType.Email" Class="mb-3" />
                        <MudTextField @bind-Value="_phoneContact" Label="@L["Client_Phone"].Value" Class="mb-3" />
                    }
                    else
                    {
                        @if (_company.Contact != null && _company.Contact.Any())
                        {
                            @foreach (var contact in _company.Contact)
                            {
                                <MudText>
                                    <MudIcon Icon="@(contact.ContactType == EContactType.Email
                                                     ? Icons.Material.Filled.Email
                                                     : Icons.Material.Filled.Phone)"
                                             Size="Size.Small" Class="mr-1" />
                                    @contact.ContactValue
                                </MudText>
                            }
                        }
                        else
                        {
                            <MudText Color="Color.Secondary">@L["Client_NoContacts"]</MudText>
                        }
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Card 3: Billing Settings (PaymentMethod, DueDays — bank accounts moved to separate section below) *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Billing_Title"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isEditing)
                    {
                        <EnumSelect TEnum="EPaymentMethod"
                                    NullableValue="_billingSettings.DefaultPaymentMethod"
                                    NullableValueChanged="@(v => _billingSettings.DefaultPaymentMethod = v)"
                                    Label="@L["Billing_PaymentMethod"].Value"
                                    Nullable="true" />
                        <MudNumericField @bind-Value="_billingSettings.DueDays"
                                         Label="@L["Billing_DueDays"].Value"
                                         Min="0" Max="365" Class="mt-3" />
                        <EnumSelect TEnum="EDueDateCalculationType"
                                    Value="_billingSettings.DueDateCalculationType"
                                    ValueChanged="@(v => _billingSettings.DueDateCalculationType = v)"
                                    Label="@L["Billing_DueDateCalcType"].Value" />
                    }
                    else if (_company.BillingSettings != null)
                    {
                        <MudList T="string" Dense="true">
                            @if (_company.BillingSettings.DefaultPaymentMethod.HasValue)
                            {
                                <MudListItem T="string">
                                    <strong>@L["Billing_PaymentMethod"]:</strong> @_company.BillingSettings.DefaultPaymentMethod
                                </MudListItem>
                            }
                            <MudListItem T="string">
                                <strong>@L["Billing_DueDays"]:</strong> @_company.BillingSettings.DueDays
                            </MudListItem>
                        </MudList>
                    }
                    else
                    {
                        <MudText Color="Color.Secondary">@L["Billing_NotConfigured"]</MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* ── Tax Settings Card ────────────────────────────────────────────── *@
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">@L["Client_TaxSection"]</MudText>
        @if (_isEditing)
        {
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" Value="_editClient.TaxRegime"
                               ValueChanged="@(v => { _editClient.TaxRegime = v; _isDirty = true; })"
                               Label="@L["Client_TaxRegime"].Value" Clearable="true">
                        <MudSelectItem T="string" Value="@("FlatRateTax")">@L["ETaxRegime_FlatRateTax"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("LumpSumExpenses80")">@L["ETaxRegime_LumpSumExpenses80"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("LumpSumExpenses60")">@L["ETaxRegime_LumpSumExpenses60"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("LumpSumExpenses40")">@L["ETaxRegime_LumpSumExpenses40"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("LumpSumExpenses30")">@L["ETaxRegime_LumpSumExpenses30"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("TaxRecords")">@L["ETaxRegime_TaxRecords"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("FullAccounting")">@L["ETaxRegime_FullAccounting"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" Value="_editClient.ActivityType"
                               ValueChanged="@(v => { _editClient.ActivityType = v; _isDirty = true; })"
                               Label="@L["Client_ActivityType"].Value" Clearable="true">
                        <MudSelectItem T="string" Value="@("CraftTrade")">@L["EActivityType_CraftTrade"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("NonCraftTrade")">@L["EActivityType_NonCraftTrade"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("RegulatedProfession")">@L["EActivityType_RegulatedProfession"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Rental")">@L["EActivityType_Rental"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSwitch T="bool" Value="_editClient.IsMainActivity"
                               ValueChanged="@(v => { _editClient.IsMainActivity = v; _isDirty = true; })"
                               Label="@L["Client_IsMainActivity"].Value" Color="Color.Primary" />
                </MudItem>
                @if (_editClient.TaxRegime == "FlatRateTax")
                {
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="string" Value="_editClient.FlatRateBand"
                                   ValueChanged="@(v => { _editClient.FlatRateBand = v; _isDirty = true; })"
                                   Label="@L["Client_FlatRateBand"].Value" Clearable="true">
                            <MudSelectItem T="string" Value="@("Band1")">@L["EFlatRateBand_Band1"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Band2")">@L["EFlatRateBand_Band2"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Band3")">@L["EFlatRateBand_Band3"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Client_TaxRegime"]</MudText>
                    <MudText>@(GetLocalizedEnum("ETaxRegime", _company.TaxRegime))</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Client_ActivityType"]</MudText>
                    <MudText>@(GetLocalizedEnum("EActivityType", _company.ActivityType))</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Client_IsMainActivity"]</MudText>
                    <MudText>@(_company.IsMainActivity ? L["Label_Yes"].Value : L["Label_No"].Value)</MudText>
                </MudItem>
                @if (!string.IsNullOrEmpty(_company.FlatRateBand))
                {
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Client_FlatRateBand"]</MudText>
                        <MudText>@(GetLocalizedEnum("EFlatRateBand", _company.FlatRateBand))</MudText>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudPaper>

    @* Full-width section: 1:N Addresses managed by the shared AddressListEditor component *@
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        @if (_isEditing)
        {
            <AddressListEditor Addresses="_addresses"
                               AddressesChanged="@(v => { _addresses = v; _isDirty = true; })" />
        }
        else
        {
            @* Read-only view of all addresses *@
            <AddressListEditor Addresses="@MapAddressesToCreateDto()" ReadOnly="true" />
        }
    </MudPaper>

    @* Full-width section: 1:N Bank Accounts managed by the shared BankAccountListEditor component *@
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        @if (_isEditing)
        {
            <BankAccountListEditor BankAccounts="_bankAccounts"
                                   BankAccountsChanged="@(v => { _bankAccounts = v; _isDirty = true; })" />
        }
        else
        {
            @* Read-only view of all bank accounts *@
            <BankAccountListEditor BankAccounts="@MapBankAccountsForReadOnly()" ReadOnly="true" />
        }
    </MudPaper>

    @* ── Email Settings section (Admin only) ─────────────────────────────────── *@
    @* Only users with Admin role can configure company SMTP settings.
       Regular Users see the rest of the page but NOT this section. *@
    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudPaper Elevation="2" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-2">@L["Smtp_Title"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@L["Smtp_InfoText"]</MudText>

                @if (_smtpLoading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                }
                else
                {
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_smtpHost" Label="@L["Smtp_Host"].Value"
                                          Placeholder="smtp.example.com" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField @bind-Value="_smtpPort" Label="@L["Smtp_Port"].Value"
                                             Min="1" Max="65535" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_smtpUsername" Label="@L["Smtp_Username"].Value" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_smtpPassword" Label="@L["Smtp_Password"].Value"
                                          InputType="InputType.Password"
                                          Placeholder="@(_hasSmtpPassword ? L["Smtp_PasswordPlaceholder"].Value : "")"
                                          Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_smtpSenderEmail" Label="@L["Smtp_SenderEmail"].Value"
                                          InputType="InputType.Email" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_smtpSenderName" Label="@L["Smtp_SenderName"].Value" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSwitch @bind-Value="_smtpUseSsl" Label="@L["Smtp_UseSsl"].Value"
                                       Color="Color.Primary" />
                        </MudItem>
                    </MudGrid>

                    <div class="d-flex gap-2 mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SaveSmtpSettings" Disabled="_smtpSaving">
                            @if (_smtpSaving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            @L["Btn_Save"]
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.Email"
                                   OnClick="TestSmtp" Disabled="@(_smtpTesting || string.IsNullOrWhiteSpace(_smtpHost))">
                            @if (_smtpTesting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            @L["Smtp_TestButton"]
                        </MudButton>
                    </div>
                }
            </MudPaper>
        </Authorized>
    </AuthorizeView>

    @* ─── Cloud Storage Section (Admin-only) ─────────────────────────── *@
    <AuthorizeView Roles="Admin,SysAdmin">
        <Authorized>
            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">@L["CloudStorage_Title"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    @L["CloudStorage_Description"]
                </MudText>

                @if (_cloudStorageLoading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else
                {
                    <MudGrid>
                        @foreach (var status in _cloudStorageStatuses)
                        {
                            <MudItem xs="12" md="6">
                                <MudCard Outlined="true">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.h6">
                                                @(status.Provider == ECloudStorageProvider.GoogleDrive
                                                    ? L["CloudStorage_GoogleDrive"]
                                                    : L["CloudStorage_OneDrive"])
                                            </MudText>
                                        </CardHeaderContent>
                                        <CardHeaderActions>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(status.IsConnected ? Color.Success : Color.Default)">
                                                @(status.IsConnected
                                                    ? L["CloudStorage_Connected"]
                                                    : L["CloudStorage_Disconnected"])
                                            </MudChip>
                                        </CardHeaderActions>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        @if (status.IsConnected)
                                        {
                                            <MudText Typo="Typo.body2" Class="mb-1">
                                                <strong>@L["CloudStorage_FolderLabel"]:</strong>
                                                @(string.IsNullOrEmpty(status.FolderName)
                                                    ? L["CloudStorage_NoFolder"]
                                                    : status.FolderName)
                                            </MudText>
                                            @if (status.TokenExpiresAt.HasValue)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @L["CloudStorage_TokenExpires"]: @status.TokenExpiresAt.Value.ToString("g")
                                                </MudText>
                                            }
                                        }
                                    </MudCardContent>
                                    <MudCardActions>
                                        @if (status.IsConnected)
                                        {
                                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Folder"
                                                       OnClick="@(() => OpenFolderPicker(status.Provider))">
                                                @L["CloudStorage_ChangeFolder"]
                                            </MudButton>
                                            <MudButton Variant="Variant.Text" Color="Color.Info"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Wifi"
                                                       OnClick="@(() => TestCloudConnection(status.Provider))">
                                                @L["CloudStorage_TestConnection"]
                                            </MudButton>
                                            <MudButton Variant="Variant.Text" Color="Color.Error"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.LinkOff"
                                                       OnClick="@(() => DisconnectCloud(status.Provider))">
                                                @L["CloudStorage_Disconnect"]
                                            </MudButton>
                                        }
                                        else
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Link"
                                                       OnClick="@(() => ConnectCloud(status.Provider))">
                                                @L["CloudStorage_Connect"]
                                            </MudButton>
                                        }
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudPaper>
        </Authorized>
    </AuthorizeView>

    @* ─── AI Assistant Settings Section (Admin/SysAdmin) ─────────────────── *@
    @* Company-level AI provider configuration. When configured, the AI chat assistant
       uses these API keys instead of the system-wide defaults.
       Follows the same 2-tier pattern as SMTP: Company → System fallback. *@
    <AuthorizeView Roles="Admin,SysAdmin">
        <Authorized>
            <MudPaper Elevation="2" Class="pa-4 mb-4 mt-4">
                <MudText Typo="Typo.h6" Class="mb-2">@L["Ai_Title"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@L["Ai_InfoText"]</MudText>

                @if (_aiLoading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                }
                else
                {
                    @* Default provider selector *@
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSelect @bind-Value="_aiDefaultProvider" Label="@L["Ai_DefaultProvider"].Value"
                                       Placeholder="@L["Ai_SystemDefault"].Value"
                                       Clearable="true" Class="mb-3">
                                <MudSelectItem Value="@("Claude")">Claude</MudSelectItem>
                                <MudSelectItem Value="@("OpenAI")">OpenAI</MudSelectItem>
                                <MudSelectItem Value="@("Gemini")">Gemini</MudSelectItem>
                                <MudSelectItem Value="@("Ollama")">Ollama</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    @* Claude settings *@
                    <MudExpansionPanels MultiExpansion="true" Class="mb-3">
                        <MudExpansionPanel Text="Claude (Anthropic)">
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_aiClaudeApiKey" Label="@L["Ai_ApiKey"].Value"
                                                  InputType="InputType.Password"
                                                  Placeholder="@(_hasAiClaudeApiKey ? L["Ai_ApiKeyPlaceholder"].Value : "sk-ant-...")"
                                                  Class="mb-3" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_aiClaudeModel" Label="@L["Ai_Model"].Value"
                                                  Placeholder="claude-sonnet-4-6" Class="mb-3" />
                                </MudItem>
                            </MudGrid>
                        </MudExpansionPanel>

                        @* OpenAI settings *@
                        <MudExpansionPanel Text="OpenAI">
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_aiOpenAiApiKey" Label="@L["Ai_ApiKey"].Value"
                                                  InputType="InputType.Password"
                                                  Placeholder="@(_hasAiOpenAiApiKey ? L["Ai_ApiKeyPlaceholder"].Value : "sk-...")"
                                                  Class="mb-3" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_aiOpenAiModel" Label="@L["Ai_Model"].Value"
                                                  Placeholder="gpt-4o" Class="mb-3" />
                                </MudItem>
                            </MudGrid>
                        </MudExpansionPanel>

                        @* Gemini settings *@
                        <MudExpansionPanel Text="Gemini (Google)">
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_aiGeminiApiKey" Label="@L["Ai_ApiKey"].Value"
                                                  InputType="InputType.Password"
                                                  Placeholder="@(_hasAiGeminiApiKey ? L["Ai_ApiKeyPlaceholder"].Value : "")"
                                                  Class="mb-3" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_aiGeminiModel" Label="@L["Ai_Model"].Value"
                                                  Placeholder="gemini-2.0-flash" Class="mb-3" />
                                </MudItem>
                            </MudGrid>
                        </MudExpansionPanel>

                        @* Ollama settings *@
                        <MudExpansionPanel Text="Ollama (Local)">
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_aiOllamaBaseUrl" Label="@L["Ai_OllamaBaseUrl"].Value"
                                                  Placeholder="http://localhost:11434" Class="mb-3" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_aiOllamaModel" Label="@L["Ai_Model"].Value"
                                                  Placeholder="gemma3:12b" Class="mb-3" />
                                </MudItem>
                            </MudGrid>
                        </MudExpansionPanel>
                    </MudExpansionPanels>

                    <div class="d-flex gap-2 mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SaveAiSettings" Disabled="_aiSaving">
                            @if (_aiSaving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            @L["Btn_Save"]
                        </MudButton>
                    </div>
                }
            </MudPaper>
        </Authorized>
    </AuthorizeView>

    @* ─── Invoice Email Mailbox (Admin/SysAdmin) ─────────────────────────── *@
    @* Per-tenant email alias for receiving invoices (PDF/ISDOC) by email.
       Emails sent to this address are automatically parsed and imported. *@
    <AuthorizeView Roles="Admin,SysAdmin">
        <Authorized>
            <MudPaper Elevation="2" Class="pa-4 mb-4 mt-4">
                <MudText Typo="Typo.h6" Class="mb-2">Email pro příjem faktur</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Aktivujte unikátní emailovou adresu pro automatický příjem faktur. Faktury zaslané na tuto adresu
                    budou automaticky zpracovány — rozpoznány z příloh (PDF, ISDOC) a importovány jako přijaté nebo vydané faktury.
                </MudText>

                @if (_invoiceMailboxLoading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                }
                else if (_invoiceMailbox == null || !_invoiceMailbox.IsActive)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                        Email pro příjem faktur není aktivní.
                    </MudAlert>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Email"
                               OnClick="ActivateInvoiceMailbox">
                        Aktivovat
                    </MudButton>
                }
                else
                {
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField Value="@_invoiceMailbox.FullEmailAddress"
                                         Label="Email adresa" ReadOnly="true"
                                         Adornment="Adornment.End"
                                         AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                                         OnAdornmentClick="@CopyInvoiceMailboxEmail"
                                         Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2">
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Aktivní</MudChip>
                                @if (_invoiceMailbox.EmailsReceivedCount > 0)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Přijato @_invoiceMailbox.EmailsReceivedCount emailů
                                        @if (_invoiceMailbox.LastEmailReceivedAt.HasValue)
                                        {
                                            <text> — poslední @_invoiceMailbox.LastEmailReceivedAt.Value.ToString("d.M.yyyy HH:mm")</text>
                                        }
                                    </MudText>
                                }
                            </MudStack>
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="RegenerateInvoiceMailbox">
                            Nový alias
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.PowerOff"
                                   OnClick="DeactivateInvoiceMailbox">
                            Deaktivovat
                        </MudButton>
                    </MudStack>
                }
            </MudPaper>
        </Authorized>
    </AuthorizeView>

    @* Full-page overlay during save operations *@
    <MudOverlay Visible="_saving" DarkBackground="true" Absolute="false" ZIndex="9999">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </MudOverlay>
}

@code {
    private ClientDto? _company;
    private bool _loading = true;
    private string? _errorMessage; // Stores API error message for display instead of generic "Not Found"
    private bool _saving = false;
    private bool _isEditing = false;
    private bool _isDirty = false;
    private bool _fetchingAres = false;

    // Form data for edit mode
    private CreateClientDto _editClient = new();
    private CreateBillingSettingsDto _billingSettings = new();
    private List<CreateAddressDto> _addresses = new();
    // Bank accounts use BankAccountDto so the per-account Id is preserved when
    // entering edit mode. The dialog needs Id to bind the mailbox card to the
    // correct backend record (via /api/payment-matching/mailbox/{bankAccountId}).
    private List<BankAccountDto> _bankAccounts = new();
    private string _emailContact = "";
    private string _phoneContact = "";

    // SMTP settings form fields (Admin-only section)
    private bool _smtpLoading = true;
    private bool _smtpSaving = false;
    private bool _smtpTesting = false;
    private bool _hasSmtpPassword = false;
    private string? _smtpHost;
    private int? _smtpPort = 587;
    private string? _smtpUsername;
    private string? _smtpPassword;
    private string? _smtpSenderEmail;
    private string? _smtpSenderName;
    private bool _smtpUseSsl = true;
    private CompanySystemSettingsDto? _companySettings;

    // Cloud storage settings
    private bool _cloudStorageLoading = true;
    private List<CloudStorageStatusDto> _cloudStorageStatuses = new();

    // Invoice email mailbox
    private bool _invoiceMailboxLoading = true;
    private InvoiceMailboxDto? _invoiceMailbox;

    // AI Assistant settings form fields (Admin-only section)
    private bool _aiLoading = true;
    private bool _aiSaving = false;
    private string? _aiDefaultProvider;
    private string? _aiClaudeApiKey;
    private string? _aiClaudeModel;
    private bool _hasAiClaudeApiKey = false;
    private string? _aiOpenAiApiKey;
    private string? _aiOpenAiModel;
    private bool _hasAiOpenAiApiKey = false;
    private string? _aiGeminiApiKey;
    private string? _aiGeminiModel;
    private bool _hasAiGeminiApiKey = false;
    private string? _aiOllamaBaseUrl;
    private string? _aiOllamaModel;

    /// <summary>
    /// Loads the user's company (issuer), SMTP settings, and cloud storage status on first render.
    /// Uses ClientApiService.GetIssuerAsync() which auto-resolves from JWT CompanyId.
    /// SMTP and cloud storage settings are loaded separately — they may not exist for new companies.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadCompany();
        await LoadSmtpSettings();
        await LoadAiSettings();
        await LoadCloudStorageStatus();
        await LoadInvoiceMailbox();
    }

    /// <summary>
    /// Loads the issuer (current user's company) from the API.
    /// </summary>
    private async Task LoadCompany()
    {
        try
        {
            _loading = true;
            _company = await ClientService.GetIssuerAsync();
        }
        catch (Exception ex)
        {
            // Store error message for display in the template instead of generic "Nenalezeno".
            _errorMessage = ex.Message;
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Switches to edit mode — populates form fields from current company data.
    /// Maps all addresses (not just primary) into the editable list.
    /// </summary>
    private void EnableEditing()
    {
        if (_company == null) return;

        // Populate basic company info
        _editClient = new CreateClientDto
        {
            RegistrationNumber = _company.RegistrationNumber,
            TaxNumber = _company.TaxNumber,
            CompanyName = _company.CompanyName,
            TradingName = _company.TradingName,
            IsVatPayer = _company.IsVatPayer,
            IsIssuer = true, // Company is always an issuer
            Language = _company.Language,
            FetchFromAres = false,
            // Tax regime fields
            TaxRegime = _company.TaxRegime,
            ActivityType = _company.ActivityType,
            IsMainActivity = _company.IsMainActivity,
            FlatRateBand = _company.FlatRateBand
        };

        // Populate ALL addresses (1:N) into the editable list
        _addresses = _company.Address.Select(a => new CreateAddressDto
        {
            AddressType = a.AddressType,
            Street = a.Street,
            City = a.City,
            PostalCode = a.PostalCode,
            Country = a.Country,
            AddressLine2 = a.AddressLine2,
            IsPrimary = a.IsPrimary
        }).ToList();

        // Populate ALL bank accounts (1:N) into the editable list.
        // Carry the Id through so the BankAccountDialog can render the
        // per-account mailbox card for already-persisted accounts.
        _bankAccounts = _company.BankAccount.Select(b => new BankAccountDto
        {
            Id = b.Id,
            Label = b.Label,
            BankName = b.BankName,
            AccountNumber = b.AccountNumber,
            IBAN = b.IBAN,
            SWIFT = b.SWIFT,
            CurrencyCode = b.CurrencyCode,
            IsDefault = b.IsDefault
        }).ToList();

        // Populate billing settings
        if (_company.BillingSettings != null)
        {
            _billingSettings = new CreateBillingSettingsDto
            {
                DueDateCalculationType = _company.BillingSettings.DueDateCalculationType,
                DueDays = _company.BillingSettings.DueDays,
                InvoiceNumberPrefix = _company.BillingSettings.InvoiceNumberPrefix,
                InvoiceNumberSuffix = _company.BillingSettings.InvoiceNumberSuffix,
                CreditNoteNumberPrefix = _company.BillingSettings.CreditNoteNumberPrefix,
                CreditNoteNumberSuffix = _company.BillingSettings.CreditNoteNumberSuffix,
                DefaultPaymentMethod = _company.BillingSettings.DefaultPaymentMethod,
                BankAccountNumber = _company.BillingSettings.BankAccountNumber,
                Notes = _company.BillingSettings.Notes
            };
        }
        else
        {
            _billingSettings = new CreateBillingSettingsDto
            {
                DueDays = 14,
                DueDateCalculationType = EDueDateCalculationType.DaysFromIssue
            };
        }

        // Populate contacts
        var emailContactDto = _company.Contact.FirstOrDefault(c => c.ContactType == EContactType.Email);
        _emailContact = emailContactDto?.ContactValue ?? "";
        var phoneContactDto = _company.Contact.FirstOrDefault(c => c.ContactType == EContactType.Phone);
        _phoneContact = phoneContactDto?.ContactValue ?? "";

        _isEditing = true;
        _isDirty = true;
    }

    /// <summary>
    /// Cancels editing — resets dirty flag and reloads original data from server.
    /// </summary>
    private async Task CancelEditing()
    {
        _isEditing = false;
        _isDirty = false;
        await LoadCompany();
    }

    /// <summary>
    /// Saves the company profile via PUT /api/client/{id}.
    /// Sends all addresses, contacts, and billing settings as a complete replacement.
    /// </summary>
    private async Task SaveCompany()
    {
        if (_company == null) return;

        _saving = true;
        StateHasChanged();
        try
        {
            var updateDto = new UpdateClientDto
            {
                CompanyName = _editClient.CompanyName,
                TradingName = _editClient.TradingName,
                TaxNumber = _editClient.TaxNumber,
                IsVatPayer = _editClient.IsVatPayer,
                IsIssuer = true,
                IsActive = true,
                Language = _editClient.Language,
                RefreshFromAres = _editClient.FetchFromAres,
                // Tax regime fields
                TaxRegime = _editClient.TaxRegime,
                ActivityType = _editClient.ActivityType,
                IsMainActivity = _editClient.IsMainActivity,
                FlatRateBand = _editClient.FlatRateBand,
                // Send ALL addresses (1:N) — backend uses replace-all strategy
                Address = _addresses.Select(a => new UpdateAddressDto
                {
                    AddressType = a.AddressType,
                    Street = a.Street,
                    City = a.City,
                    PostalCode = a.PostalCode,
                    Country = a.Country,
                    AddressLine2 = a.AddressLine2,
                    IsPrimary = a.IsPrimary
                }).ToList(),
                // Build contacts from form fields
                Contact = BuildUpdateContacts(),
                // Send ALL bank accounts (1:N) — backend uses replace-all strategy
                BankAccount = _bankAccounts.Select(b => new UpdateBankAccountDto
                {
                    Label = b.Label,
                    BankName = b.BankName,
                    AccountNumber = b.AccountNumber,
                    IBAN = b.IBAN,
                    SWIFT = b.SWIFT,
                    CurrencyCode = b.CurrencyCode,
                    IsDefault = b.IsDefault
                }).ToList(),
                // Billing settings
                BillingSettings = new UpdateBillingSettingsDto
                {
                    DueDateCalculationType = _billingSettings.DueDateCalculationType,
                    DueDays = _billingSettings.DueDays,
                    InvoiceNumberPrefix = _billingSettings.InvoiceNumberPrefix,
                    InvoiceNumberSuffix = _billingSettings.InvoiceNumberSuffix,
                    CreditNoteNumberPrefix = _billingSettings.CreditNoteNumberPrefix,
                    CreditNoteNumberSuffix = _billingSettings.CreditNoteNumberSuffix,
                    DefaultPaymentMethod = _billingSettings.DefaultPaymentMethod,
                    BankAccountNumber = _billingSettings.BankAccountNumber,
                    Notes = _billingSettings.Notes
                }
            };

            var result = await ClientService.UpdateAsync(_company.Id, updateDto);
            if (result != null)
            {
                _isDirty = false;
                Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                _isEditing = false;
                await LoadCompany(); // Refresh displayed data
            }
            else
            {
                Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Fetches company data from Czech ARES business registry by registration number.
    /// Fills in company name, tax number, VAT status, and primary address from ARES data.
    /// </summary>
    private async Task FetchFromAres()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_editClient.RegistrationNumber))
            {
                Snackbar.Add(L["Client_RegistrationNumber"].Value, Severity.Warning);
                return;
            }

            _fetchingAres = true;
            var aresData = await ClientService.FetchFromAresAsync(_editClient.RegistrationNumber);

            if (aresData != null)
            {
                _editClient.CompanyName = aresData.CompanyName;
                _editClient.TaxNumber = aresData.TaxNumber;
                _editClient.IsVatPayer = aresData.IsVatPayer;

                // Merge ARES address data into the address list
                var primaryAddress = aresData.Address.FirstOrDefault(a => a.IsPrimary)
                    ?? aresData.Address.FirstOrDefault();
                if (primaryAddress != null)
                {
                    // Find existing primary address in the list and update it,
                    // or add a new one if none exists
                    var existingPrimary = _addresses.FirstOrDefault(a => a.IsPrimary);
                    if (existingPrimary != null)
                    {
                        existingPrimary.Street = primaryAddress.Street;
                        existingPrimary.City = primaryAddress.City;
                        existingPrimary.PostalCode = primaryAddress.PostalCode;
                        existingPrimary.Country = primaryAddress.Country;
                    }
                    else
                    {
                        _addresses.Add(new CreateAddressDto
                        {
                            AddressType = EAddressType.Primary,
                            Street = primaryAddress.Street,
                            City = primaryAddress.City,
                            PostalCode = primaryAddress.PostalCode,
                            Country = primaryAddress.Country,
                            IsPrimary = true
                        });
                    }
                }

                Snackbar.Add(L["Ares_DataLoaded"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Ares_NotFound"].Value, Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _fetchingAres = false;
        }
    }

    /// <summary>
    /// Builds a list of UpdateContactDto from the form fields.
    /// Used in the update path to send contacts to the API.
    /// </summary>
    private List<UpdateContactDto> BuildUpdateContacts()
    {
        var contacts = new List<UpdateContactDto>();

        if (!string.IsNullOrWhiteSpace(_emailContact))
        {
            contacts.Add(new UpdateContactDto
            {
                ContactType = EContactType.Email,
                ContactValue = _emailContact,
                IsPrimary = true
            });
        }

        if (!string.IsNullOrWhiteSpace(_phoneContact))
        {
            contacts.Add(new UpdateContactDto
            {
                ContactType = EContactType.Phone,
                ContactValue = _phoneContact,
                IsPrimary = contacts.Count == 0
            });
        }

        return contacts;
    }

    /// <summary>
    /// Maps the company's AddressDto list to CreateAddressDto list for the read-only view.
    /// The AddressListEditor uses CreateAddressDto as its data model.
    /// </summary>
    private List<CreateAddressDto> MapAddressesToCreateDto()
    {
        if (_company?.Address == null) return new();

        return _company.Address.Select(a => new CreateAddressDto
        {
            AddressType = a.AddressType,
            Street = a.Street,
            City = a.City,
            PostalCode = a.PostalCode,
            Country = a.Country,
            AddressLine2 = a.AddressLine2,
            IsPrimary = a.IsPrimary
        }).ToList();
    }

    /// <summary>
    /// Returns a defensive copy of the company's bank accounts for the read-only
    /// BankAccountListEditor view. Cloning prevents the read-only view from
    /// accidentally mutating the loaded ClientDto graph.
    /// </summary>
    private List<BankAccountDto> MapBankAccountsForReadOnly()
    {
        if (_company?.BankAccount == null) return new();

        return _company.BankAccount.Select(b => new BankAccountDto
        {
            Id = b.Id,
            Label = b.Label,
            BankName = b.BankName,
            AccountNumber = b.AccountNumber,
            IBAN = b.IBAN,
            SWIFT = b.SWIFT,
            CurrencyCode = b.CurrencyCode,
            IsDefault = b.IsDefault
        }).ToList();
    }

    // ─── SMTP Settings Methods (Admin only) ──────────────────────────────────

    /// <summary>
    /// Loads the company's SMTP settings from CompanySystemSettings.
    /// Silently handles missing settings — not all companies have CompanySystemSettings yet.
    /// </summary>
    private async Task LoadSmtpSettings()
    {
        try
        {
            _smtpLoading = true;
            if (_company == null) return;

            _companySettings = await SettingsService.GetByCompanyIdAsync(_company.Id);
            if (_companySettings != null)
            {
                // Populate SMTP form fields from the loaded settings
                _smtpHost = _companySettings.SmtpHost;
                _smtpPort = _companySettings.SmtpPort ?? 587;
                _smtpUsername = _companySettings.SmtpUsername;
                _smtpSenderEmail = _companySettings.SmtpSenderEmail;
                _smtpSenderName = _companySettings.SmtpSenderName;
                _smtpUseSsl = _companySettings.SmtpUseSsl ?? true;
                _hasSmtpPassword = _companySettings.HasSmtpPassword;
                // Password is NEVER returned from the API — keep field empty
                _smtpPassword = null;
            }
        }
        catch
        {
            // CompanySystemSettings may not exist yet — that's okay.
            // The SMTP section will show empty fields.
            _companySettings = null;
        }
        finally
        {
            _smtpLoading = false;
        }
    }

    /// <summary>
    /// Saves the SMTP settings via PUT /api/company/{companyId}/settings.
    /// Password handling: null = keep existing, empty = clear, non-empty = update.
    /// </summary>
    private async Task SaveSmtpSettings()
    {
        if (_company == null) return;

        _smtpSaving = true;
        try
        {
            var dto = new UpdateCompanySystemSettingsDto
            {
                SmtpHost = _smtpHost,
                SmtpPort = _smtpPort,
                SmtpUsername = _smtpUsername,
                // Only send password if the user typed something new.
                // null = keep existing password unchanged on the server.
                SmtpPassword = string.IsNullOrEmpty(_smtpPassword) ? null : _smtpPassword,
                SmtpSenderEmail = _smtpSenderEmail,
                SmtpSenderName = _smtpSenderName,
                SmtpUseSsl = _smtpUseSsl
            };

            var result = await SettingsService.UpdateSettingsAsync(_company.Id, dto);
            if (result != null)
            {
                Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                _hasSmtpPassword = result.HasSmtpPassword;
                _smtpPassword = null; // Clear password field after save
            }
            else
            {
                Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _smtpSaving = false;
        }
    }

    /// <summary>
    /// Tests the company's SMTP settings by sending a test email to the current user.
    /// The API endpoint POST /api/company/{id}/test-smtp sends a test email
    /// using the company's SMTP configuration.
    /// </summary>
    private async Task TestSmtp()
    {
        if (_company == null) return;

        _smtpTesting = true;
        try
        {
            var success = await SettingsService.TestSmtpAsync(_company.Id);
            if (success)
            {
                Snackbar.Add(L["Smtp_TestSuccess"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Smtp_TestFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Smtp_TestFailed"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _smtpTesting = false;
        }
    }

    // ─── AI Assistant Settings Methods (Admin only) ────────────────────────────

    /// <summary>
    /// Loads the company's AI settings from CompanySystemSettings.
    /// Reuses _companySettings loaded by LoadSmtpSettings (both come from the same record).
    /// </summary>
    private async Task LoadAiSettings()
    {
        try
        {
            _aiLoading = true;
            if (_company == null) return;

            // Reuse _companySettings if already loaded by LoadSmtpSettings
            if (_companySettings == null)
            {
                _companySettings = await SettingsService.GetByCompanyIdAsync(_company.Id);
            }

            if (_companySettings != null)
            {
                // Populate AI form fields from the loaded settings
                _aiDefaultProvider = _companySettings.AiDefaultProvider;
                _aiClaudeModel = _companySettings.AiClaudeModel;
                _hasAiClaudeApiKey = _companySettings.HasAiClaudeApiKey;
                _aiOpenAiModel = _companySettings.AiOpenAiModel;
                _hasAiOpenAiApiKey = _companySettings.HasAiOpenAiApiKey;
                _aiGeminiModel = _companySettings.AiGeminiModel;
                _hasAiGeminiApiKey = _companySettings.HasAiGeminiApiKey;
                _aiOllamaBaseUrl = _companySettings.AiOllamaBaseUrl;
                _aiOllamaModel = _companySettings.AiOllamaModel;
                // API keys are NEVER returned — keep fields empty
                _aiClaudeApiKey = null;
                _aiOpenAiApiKey = null;
                _aiGeminiApiKey = null;
            }
        }
        catch
        {
            // CompanySystemSettings may not exist yet — that's okay.
        }
        finally
        {
            _aiLoading = false;
        }
    }

    /// <summary>
    /// Saves the AI settings via PUT /api/company/{companyId}/settings.
    /// API key handling: null = keep existing, empty = clear, non-empty = update.
    /// </summary>
    private async Task SaveAiSettings()
    {
        if (_company == null) return;

        _aiSaving = true;
        try
        {
            var dto = new UpdateCompanySystemSettingsDto
            {
                AiDefaultProvider = _aiDefaultProvider,
                // Only send API key if the user typed something new.
                // null = keep existing key unchanged on the server.
                AiClaudeApiKey = string.IsNullOrEmpty(_aiClaudeApiKey) ? null : _aiClaudeApiKey,
                AiClaudeModel = _aiClaudeModel,
                AiOpenAiApiKey = string.IsNullOrEmpty(_aiOpenAiApiKey) ? null : _aiOpenAiApiKey,
                AiOpenAiModel = _aiOpenAiModel,
                AiGeminiApiKey = string.IsNullOrEmpty(_aiGeminiApiKey) ? null : _aiGeminiApiKey,
                AiGeminiModel = _aiGeminiModel,
                AiOllamaBaseUrl = _aiOllamaBaseUrl,
                AiOllamaModel = _aiOllamaModel
            };

            var result = await SettingsService.UpdateSettingsAsync(_company.Id, dto);
            if (result != null)
            {
                Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                // Update the "has key" flags from the response
                _hasAiClaudeApiKey = result.HasAiClaudeApiKey;
                _hasAiOpenAiApiKey = result.HasAiOpenAiApiKey;
                _hasAiGeminiApiKey = result.HasAiGeminiApiKey;
                // Clear API key fields after save (same pattern as SMTP password)
                _aiClaudeApiKey = null;
                _aiOpenAiApiKey = null;
                _aiGeminiApiKey = null;
            }
            else
            {
                Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _aiSaving = false;
        }
    }

    // ─── Cloud Storage Methods ───────────────────────────────────────────────

    /// <summary>
    /// Loads the cloud storage connection status for all providers.
    /// </summary>
    private async Task LoadCloudStorageStatus()
    {
        try
        {
            _cloudStorageLoading = true;
            _cloudStorageStatuses = await CloudStorageApi.GetStatusAsync();
        }
        catch (Exception ex)
        {
            _cloudStorageStatuses = new List<CloudStorageStatusDto>();
            Snackbar.Add($"Failed to load cloud storage status: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _cloudStorageLoading = false;
        }
    }

    /// <summary>
    /// Opens an OAuth popup window to connect a cloud storage provider.
    /// The popup navigates to the provider's OAuth page; on success, the callback page
    /// posts a message back to this window, which triggers a status reload.
    /// </summary>
    private async Task ConnectCloud(ECloudStorageProvider provider)
    {
        try
        {
            // Build the redirect URI for the OAuth callback page
            var callbackUri = Navigation.ToAbsoluteUri("/cloud-storage/callback").ToString();
            var authUrl = await CloudStorageApi.GetAuthorizationUrlAsync(provider, callbackUri);

            if (string.IsNullOrEmpty(authUrl))
            {
                Snackbar.Add("Failed to get authorization URL", Severity.Error);
                return;
            }

            // Open OAuth authorization URL in a popup window
            // The state parameter carries the provider name so the callback knows which provider
            var fullUrl = authUrl + $"&state={provider}";
            await JS.InvokeVoidAsync("eval",
                $"window.open('{fullUrl}', 'cloud_auth', 'width=600,height=700,left=200,top=100');");

            // Listen for the success message from the popup callback page
            // The callback page does: window.opener.postMessage('cloud-storage-connected','*')
            // We can't directly listen from Blazor Server, so we'll prompt user to refresh
            Snackbar.Add("Please complete authorization in the popup window, then refresh this page.",
                Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Disconnects a cloud storage provider after confirmation.
    /// </summary>
    private async Task DisconnectCloud(ECloudStorageProvider provider)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", L["CloudStorage_DisconnectConfirm"].Value);
        if (!confirmed) return;

        try
        {
            var success = await CloudStorageApi.DisconnectAsync(provider);
            if (success)
            {
                Snackbar.Add(L["CloudStorage_DisconnectSuccess"].Value, Severity.Success);
                await LoadCloudStorageStatus();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Tests the connection to a cloud storage provider.
    /// </summary>
    private async Task TestCloudConnection(ECloudStorageProvider provider)
    {
        try
        {
            var success = await CloudStorageApi.TestConnectionAsync(provider);
            Snackbar.Add(
                success ? L["CloudStorage_TestSuccess"].Value : L["CloudStorage_TestFailed"].Value,
                success ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["CloudStorage_TestFailed"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Opens the folder picker dialog for a cloud storage provider.
    /// </summary>
    private async Task OpenFolderPicker(ECloudStorageProvider provider)
    {
        var status = _cloudStorageStatuses.FirstOrDefault(s => s.Provider == provider);

        var parameters = new DialogParameters<FolderPicker>
        {
            { x => x.Provider, provider },
            { x => x.CurrentFolderId, status?.FolderId }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<FolderPicker>(L["CloudStorage_SelectFolder"].Value, parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CloudStorageSetFolderRequest folderRequest)
        {
            try
            {
                var success = await CloudStorageApi.SetFolderAsync(provider, folderRequest);
                if (success)
                {
                    Snackbar.Add(L["CloudStorage_FolderSet"].Value, Severity.Success);
                    await LoadCloudStorageStatus();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }

    /// <summary>
    /// Returns a human-readable display name for an ISO 639-1 language code.
    /// </summary>
    private static string GetLanguageDisplayName(string language) => language switch
    {
        "cs" => "Čeština (cs)",
        "en" => "English (en)",
        _ => language
    };

    /// <summary>
    /// Looks up localized display name for an enum value.
    /// Key format: "{EnumTypeName}_{EnumValue}" (e.g., "ETaxRegime_FlatRateTax").
    /// Returns "—" for null/empty values.
    /// </summary>
    private string GetLocalizedEnum(string enumTypeName, string? value)
    {
        if (string.IsNullOrEmpty(value)) return "—";
        var key = $"{enumTypeName}_{value}";
        var localized = L[key];
        return localized.ResourceNotFound ? value : localized.Value;
    }

