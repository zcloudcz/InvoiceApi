@page "/logs"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SysAdmin")]
@using Fakvio.Contracts.Dto.AppLog
@using Fakvio.UI.Shared.Models
@inject AppLogApiService LogService
@inject IUiErrorHandler ErrorHandler
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Log_Title"] - Fakvio</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">@L["Log_Title"]</MudText>
<MudText Class="mb-6" Color="Color.Secondary">@L["Log_Subtitle"]</MudText>

@* Filters row *@
@* Date range is no longer here — the Timestamp column header has its own DateColumnFilter
   with operator support (=, >, <, between). One source of truth, no duplication. *@
<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6">
        <MudSelect T="string" Value="_levelFilter" ValueChanged="OnLevelChanged"
                   Label="@L["Log_Level"].Value" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem T="string" Value="@("Information")">Information</MudSelectItem>
            <MudSelectItem T="string" Value="@("Warning")">Warning</MudSelectItem>
            <MudSelectItem T="string" Value="@("Error")">Error</MudSelectItem>
            <MudSelectItem T="string" Value="@("Critical")">Critical</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="_searchFilter" Label="@L["Log_Search"].Value"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyUp="OnSearchKeyUp" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="false" />
    </MudItem>
</MudGrid>

@* Log entries data grid — FakvioGrid = universal grid wrapper (see DEVGUIDE 7.10) *@
<FakvioGrid T="AppLogDto"
            GridKey="logs"
            ServerData="LoadServerData"
            @ref="_dataGrid"
            Loading="@_loading"
            RowClick="@(args => OpenDetailAsync(args.Item))"
            PageSizeOptions="new int[] { 25, 50, 100 }">
    <Columns>
        <PropertyColumn Property="x => x.Timestamp" Title="@L["Log_Timestamp"].Value">
            <FilterTemplate>
                <DateColumnFilter T="AppLogDto" Context="context" ValueFunc="x => (DateTime?)x.Timestamp" FilterKey="Timestamp" />
            </FilterTemplate>
            <CellTemplate>
                <MudText Typo="Typo.body2">@context.Item.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Level" Title="@L["Log_Level"].Value">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@GetLevelColor(context.Item.Level)">
                    @context.Item.Level
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Source" Title="@L["Log_Source"].Value" HideSmall="true">
            <CellTemplate>
                <MudText Typo="Typo.body2" Style="max-width: 250px; overflow: hidden; text-overflow: ellipsis;">
                    @GetShortSource(context.Item.Source)
                </MudText>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Message" Title="@L["Log_Message"].Value">
            <CellTemplate>
                <MudText Typo="Typo.body2" Style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    @context.Item.Message
                </MudText>
            </CellTemplate>
        </PropertyColumn>
    </Columns>
    <NoRecordsContent>
        <MudAlert Severity="Severity.Info">@L["Log_NoEntries"]</MudAlert>
    </NoRecordsContent>
</FakvioGrid>

@code {
    // Reference to the FakvioGrid — used to trigger ReloadAsync() when filters change
    private FakvioGrid<AppLogDto>? _dataGrid;

    // Loading flag — MudDataGrid's Loading attribute shows a progress bar automatically
    private bool _loading;

    // Filter state — these are passed to the API when MudDataGrid requests a page of data.
    // Date range is owned by the Timestamp column's DateColumnFilter, not by this page.
    private string? _levelFilter;
    private string? _searchFilter;

    // No OnInitializedAsync needed — MudDataGrid calls ServerData automatically on first render

    /// <summary>
    /// ServerData callback invoked by MudDataGrid whenever it needs data (initial load, page change, sort, filter).
    /// Translates MudDataGrid's GridState into our API call and returns a GridData result.
    ///
    /// Filter sources (in priority order per column):
    ///  - Level: page-level MudSelect (_levelFilter) takes precedence; column filter row also supported.
    ///  - Source / Message: column filter row via state.GetStringFilter() → sent as server-side ILike.
    ///  - Timestamp: DateColumnFilter custom component → state.GetDateRange("Timestamp").
    ///  - Search box: _searchFilter → fulltext ILike across Message, Source, Exception, CorrelationId.
    ///
    /// Note: state.Page is 0-based, but our API expects 1-based page numbers.
    /// </summary>
    private async Task<GridData<AppLogDto>> LoadServerData(GridState<AppLogDto> state)
    {
        _loading = true;
        StateHasChanged();
        try
        {
            // Date range comes exclusively from the Timestamp column's DateColumnFilter
            // (operator + from + to). No page-level pickers anymore.
            var (timestampFrom, timestampTo) = state.GetDateRange("Timestamp");

            // Column filter row string filters — read the value the user typed into the
            // Source / Message filter cell. MudDataGrid stores them as plain strings on
            // FilterDefinition.Value, keyed by Column.PropertyName.
            // These are sent to the API as ILike (case-insensitive Contains) filters.
            var sourceColumnFilter = state.GetStringFilter<AppLogDto>("Source");
            var messageColumnFilter = state.GetStringFilter<AppLogDto>("Message");

            // Level: prefer the page-level MudSelect (_levelFilter), fall back to what the
            // column filter row might have set (edge case — the column has a CellTemplate with
            // a chip, so the filter row shows a plain text box which the user could use).
            var effectiveLevelFilter = !string.IsNullOrWhiteSpace(_levelFilter)
                ? _levelFilter
                : state.GetStringFilter<AppLogDto>("Level");

            // Call the API with all active filter values and the page/size from the grid state
            var result = await LogService.GetPagedAsync(
                page: state.Page + 1,
                pageSize: state.PageSize,
                level: effectiveLevelFilter,
                source: sourceColumnFilter,
                message: messageColumnFilter,
                search: _searchFilter,
                from: timestampFrom,
                to: timestampTo);

            // Return the data in the format MudDataGrid expects
            return new GridData<AppLogDto>
            {
                Items = result?.Items ?? new List<AppLogDto>(),
                TotalItems = result?.TotalCount ?? 0
            };
        }
        catch (Exception ex)
        {
            // Central handler: shows the snackbar AND forwards non-ApiException errors to AppLog.
            ErrorHandler.Handle(ex, "Logs.LoadServerData");
            return new GridData<AppLogDto> { Items = new List<AppLogDto>(), TotalItems = 0 };
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    // ─── Filter event handlers ───────────────────────────────────────────────
    // Each handler updates the filter state and tells the grid to reload from page 1.

    private async Task OnLevelChanged(string? level)
    {
        _levelFilter = level;
        // ReloadServerData resets the grid back to page 0 and fetches fresh data
        if (_dataGrid != null) await _dataGrid.ReloadAsync();
    }

    private async Task OnSearchKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (_dataGrid != null) await _dataGrid.ReloadAsync();
        }
    }

    // ─── Detail dialog ────────────────────────────────────────────────────────

    /// <summary>
    /// Opens a read-only popup showing the full detail of the clicked log entry.
    /// </summary>
    private async Task OpenDetailAsync(AppLogDto log)
    {
        var parameters = new DialogParameters<LogDetailDialog>
        {
            { x => x.Log, log }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };
        await DialogService.ShowAsync<LogDetailDialog>(L["Log_Details"].Value, parameters, options);
    }

    // ─── Helper methods ──────────────────────────────────────────────────────

    /// <summary>
    /// Returns MudBlazor color for each log level (used for the colored chip in each row).
    /// </summary>
    private static Color GetLevelColor(string level) => level switch
    {
        "Critical" => Color.Dark,
        "Error" => Color.Error,
        "Warning" => Color.Warning,
        "Information" => Color.Info,
        "Debug" => Color.Default,
        _ => Color.Default
    };

    /// <summary>
    /// Shortens the logger category name for display (shows last 2 segments).
    /// Example: "Fakvio.Infrastructure.Service.EmailService" → "Service.EmailService"
    /// </summary>
    private static string GetShortSource(string source)
    {
        var parts = source.Split('.');
        return parts.Length > 2 ? string.Join('.', parts[^2..]) : source;
    }
}
