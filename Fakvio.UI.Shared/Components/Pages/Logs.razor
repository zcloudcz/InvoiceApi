@page "/logs"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SysAdmin")]
@using Fakvio.Contracts.Dto.AppLog
@inject AppLogApiService LogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Log_Title"] - Fakvio</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">@L["Log_Title"]</MudText>
<MudText Class="mb-6" Color="Color.Secondary">@L["Log_Subtitle"]</MudText>

@* Filters row *@
<MudGrid Class="mb-4">
    <MudItem xs="12" sm="3">
        <MudSelect T="string" Value="_levelFilter" ValueChanged="OnLevelChanged"
                   Label="@L["Log_Level"].Value" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem T="string" Value="@("Information")">Information</MudSelectItem>
            <MudSelectItem T="string" Value="@("Warning")">Warning</MudSelectItem>
            <MudSelectItem T="string" Value="@("Error")">Error</MudSelectItem>
            <MudSelectItem T="string" Value="@("Critical")">Critical</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudTextField @bind-Value="_searchFilter" Label="@L["Log_Search"].Value"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyUp="OnSearchKeyUp" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="false" />
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudDatePicker Date="_dateFrom" DateChanged="OnDateFromChanged"
                       Label="@L["Log_DateFrom"].Value" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Clearable="true" />
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudDatePicker Date="_dateTo" DateChanged="OnDateToChanged"
                       Label="@L["Log_DateTo"].Value" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Clearable="true" />
    </MudItem>
</MudGrid>

@* Log entries data grid — uses ServerData for built-in server-side pagination *@
<MudDataGrid T="AppLogDto"
             ServerData="LoadServerData"
             @ref="_dataGrid"
             Dense="true" Hover="true" Striped="true"
             Loading="@_loading" LoadingProgressColor="Color.Primary"
             RowClick="@(args => { _selectedLog = args.Item; })"
             RowStyleFunc="@((item, idx) => "cursor: pointer;")"
             SortMode="SortMode.Single"
             Filterable="false"
             ColumnResizeMode="ResizeMode.Column">
    <Columns>
        <PropertyColumn Property="x => x.Timestamp" Title="@L["Log_Timestamp"].Value">
            <CellTemplate>
                <MudText Typo="Typo.body2">@context.Item.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Level" Title="@L["Log_Level"].Value">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@GetLevelColor(context.Item.Level)">
                    @context.Item.Level
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Source" Title="@L["Log_Source"].Value">
            <CellTemplate>
                <MudText Typo="Typo.body2" Style="max-width: 250px; overflow: hidden; text-overflow: ellipsis;">
                    @GetShortSource(context.Item.Source)
                </MudText>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Message" Title="@L["Log_Message"].Value">
            <CellTemplate>
                <MudText Typo="Typo.body2" Style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    @context.Item.Message
                </MudText>
            </CellTemplate>
        </PropertyColumn>
    </Columns>
    <NoRecordsContent>
        <MudAlert Severity="Severity.Info">@L["Log_NoEntries"]</MudAlert>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="AppLogDto" PageSizeOptions="new int[] { 25, 50, 100 }" RowsPerPageString="@L["Table_RowsPerPage"].Value" />
    </PagerContent>
</MudDataGrid>

@* Detail expansion card — shown when a row is clicked *@
@if (_selectedLog != null)
{
    <MudCard Elevation="3" Class="mt-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">@L["Log_Details"]</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _selectedLog = null)" />
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText><strong>@L["Log_Timestamp"]:</strong> @_selectedLog.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")</MudText>
                    <MudText><strong>@L["Log_Level"]:</strong> <MudChip T="string" Size="Size.Small" Color="@GetLevelColor(_selectedLog.Level)">@_selectedLog.Level</MudChip></MudText>
                    <MudText><strong>@L["Log_Source"]:</strong> @_selectedLog.Source</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (_selectedLog.UserId.HasValue)
                    {
                        <MudText><strong>User ID:</strong> @_selectedLog.UserId</MudText>
                    }
                    @if (_selectedLog.CompanyId.HasValue)
                    {
                        <MudText><strong>Company ID:</strong> @_selectedLog.CompanyId</MudText>
                    }
                    @if (!string.IsNullOrEmpty(_selectedLog.RequestPath))
                    {
                        <MudText><strong>Request:</strong> @_selectedLog.RequestPath</MudText>
                    }
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mt-2">@L["Log_Message"]:</MudText>
                    <MudText Style="white-space: pre-wrap; word-break: break-all; background: #f5f5f5; padding: 12px; border-radius: 4px;">
                        @_selectedLog.Message
                    </MudText>
                </MudItem>
                @if (!string.IsNullOrEmpty(_selectedLog.Exception))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="mt-2">@L["Log_Exception"]:</MudText>
                        <MudText Style="white-space: pre-wrap; word-break: break-all; background: #fff3f3; padding: 12px; border-radius: 4px; font-family: monospace; font-size: 0.85rem;">
                            @_selectedLog.Exception
                        </MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
    </MudCard>
}

@code {
    // Reference to the MudDataGrid — used to trigger ReloadServerData() when filters change
    private MudDataGrid<AppLogDto>? _dataGrid;

    // Loading flag — MudDataGrid's Loading attribute shows a progress bar automatically
    private bool _loading;

    // Filter state — these are passed to the API when MudDataGrid requests a page of data
    private string? _levelFilter;
    private string? _searchFilter;
    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    // The currently selected log entry, shown in the detail expansion card below the grid
    private AppLogDto? _selectedLog;

    // No OnInitializedAsync needed — MudDataGrid calls ServerData automatically on first render

    /// <summary>
    /// ServerData callback invoked by MudDataGrid whenever it needs data (initial load, page change, etc.).
    /// Translates MudDataGrid's GridState into our API call and returns a GridData result.
    /// Note: state.Page is 0-based, but our API expects 1-based page numbers.
    /// </summary>
    private async Task<GridData<AppLogDto>> LoadServerData(GridState<AppLogDto> state)
    {
        _loading = true;
        StateHasChanged();
        try
        {
            // Call the API with current filter values and the page/size from the grid state
            var result = await LogService.GetPagedAsync(
                state.Page + 1, state.PageSize, _levelFilter, _searchFilter, _dateFrom, _dateTo);

            // Return the data in the format MudDataGrid expects
            return new GridData<AppLogDto>
            {
                Items = result.Items,
                TotalItems = result.TotalCount
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
            return new GridData<AppLogDto> { Items = new List<AppLogDto>(), TotalItems = 0 };
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    // ─── Filter event handlers ───────────────────────────────────────────────
    // Each handler updates the filter state and tells the grid to reload from page 1.

    private async Task OnLevelChanged(string? level)
    {
        _levelFilter = level;
        // ReloadServerData resets the grid back to page 0 and fetches fresh data
        if (_dataGrid != null) await _dataGrid.ReloadServerData();
    }

    private async Task OnSearchKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (_dataGrid != null) await _dataGrid.ReloadServerData();
        }
    }

    private async Task OnDateFromChanged(DateTime? date)
    {
        _dateFrom = date;
        if (_dataGrid != null) await _dataGrid.ReloadServerData();
    }

    private async Task OnDateToChanged(DateTime? date)
    {
        _dateTo = date;
        if (_dataGrid != null) await _dataGrid.ReloadServerData();
    }

    // ─── Helper methods ──────────────────────────────────────────────────────

    /// <summary>
    /// Returns MudBlazor color for each log level (used for the colored chip in each row).
    /// </summary>
    private static Color GetLevelColor(string level) => level switch
    {
        "Critical" => Color.Dark,
        "Error" => Color.Error,
        "Warning" => Color.Warning,
        "Information" => Color.Info,
        "Debug" => Color.Default,
        _ => Color.Default
    };

    /// <summary>
    /// Shortens the logger category name for display (shows last 2 segments).
    /// Example: "Fakvio.Infrastructure.Service.EmailService" → "Service.EmailService"
    /// </summary>
    private static string GetShortSource(string source)
    {
        var parts = source.Split('.');
        return parts.Length > 2 ? string.Join('.', parts[^2..]) : source;
    }
}
