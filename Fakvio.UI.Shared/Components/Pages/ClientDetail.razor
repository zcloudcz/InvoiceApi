@page "/clients/create"
@page "/clients/{Id:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Fakvio.Contracts.Dto.Client
@using Fakvio.Contracts.Dto.Invoice
@using Fakvio.Contracts.Common.Pagination
@using Fakvio.Domain.Enums
@using Fakvio.UI.Shared.Models
@inject ClientApiService ClientService
@inject FakvioService InvoiceService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(_isCreateMode ? L["Client_New"] : L["Client_Detail"])</PageTitle>

@* Warn user before navigating away from dirty forms *@
<UnsavedChangesLock IsDirty="_isDirty" />

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (!_isCreateMode && (_errorMessage != null || _client == null))
{
    <MudAlert Severity="Severity.Error">@(_errorMessage ?? L["Msg_NotFound"])</MudAlert>
}
else
{
    @* Header: Back button + client name + Active chip + action buttons *@
    <div class="d-flex flex-wrap align-center gap-2 mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" />
        <MudText Typo="Typo.h4" Class="mr-2">
            @if (_isCreateMode) { @L["Client_New"] } else { @_client!.CompanyName }
        </MudText>
        @if (!_isCreateMode && _client != null)
        {
            <MudChip T="string" Size="Size.Small" Color="@(_client.IsActive ? Color.Success : Color.Default)">
                @(_client.IsActive ? L["Label_Active"].Value : L["Label_Inactive"].Value)
            </MudChip>
        }
        <MudSpacer />

        @if (_isCreateMode)
        {
            @* Create mode — Save/Cancel buttons *@
            <MudButton Variant="Variant.Text" OnClick="GoBack">@L["Btn_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveClient">@L["Btn_Create"]</MudButton>
        }
        else if (!_isEditing)
        {
            @* View mode — Edit/Delete buttons *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="EnableEditing">@L["Btn_Edit"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeleteClient">@L["Btn_Delete"]</MudButton>
        }
        else
        {
            @* Edit mode — Save/Cancel buttons *@
            <MudButton Variant="Variant.Text" OnClick="CancelEditing">@L["Btn_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveClient">@L["Btn_Save"]</MudButton>
        }
    </div>

    @* Client information cards — shared layout for create/view/edit *@
    <MudGrid>
        @* Card 1: Basic company info *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Client_CompanyInfo"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isFormMode)
                    {
                        @* Editable fields for create/edit modes *@
                        <MudGrid>
                            <MudItem xs="@(_isFormMode ? 8 : 12)">
                                <MudTextField @bind-Value="_editClient.RegistrationNumber" Label="@L["Client_RegistrationNumber"].Value" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Download"
                                           OnClick="FetchFromAres" FullWidth="true" Disabled="_fetchingAres">
                                    @if (_fetchingAres)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                    else
                                    {
                                        <span>ARES</span>
                                    }
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                        <MudTextField @bind-Value="_editClient.CompanyName" Label="@L["Client_CompanyName"].Value" Required="true" Class="mb-3" />
                        <MudTextField @bind-Value="_editClient.TradingName" Label="@L["Client_TradingName"].Value" Class="mb-3" />
                        <MudTextField @bind-Value="_editClient.TaxNumber" Label="@L["Client_TaxNumber"].Value" Class="mb-3" />
                        <MudSwitch @bind-Value="_editClient.IsVatPayer" Label="@L["Client_IsVatPayer"].Value" Color="Color.Primary" />
                        @* Language preference for documents (PDFs, emails) generated for this client *@
                        <MudSelect T="string" @bind-Value="_editClient.Language" Label="@L["Client_Language"].Value" Class="mt-3">
                            <MudSelectItem Value="@("cs")">Čeština (cs)</MudSelectItem>
                            <MudSelectItem Value="@("en")">English (en)</MudSelectItem>
                        </MudSelect>
                        <MudColorPicker @bind-Text="_editClient.Color"
                                        Label="@L["Client_Color"].Value"
                                        ColorPickerMode="ColorPickerMode.HEX"
                                        Clearable="true"
                                        Class="mt-3"
                                        Placeholder="#FF5722"
                                        Adornment="Adornment.Start"
                                        AdornmentIcon="@Icons.Material.Filled.Palette" />
                    }
                    else
                    {
                        @* Read-only display *@
                        <MudList T="string" Dense="true">
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Business">
                                <strong>@L["Client_Company"]</strong> @_client!.CompanyName
                            </MudListItem>
                            @if (!string.IsNullOrEmpty(_client?.TradingName))
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.Badge">
                                    <strong>@L["Client_TradingNameLabel"]</strong> @_client.TradingName
                                </MudListItem>
                            }
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Numbers">
                                <strong>@L["Client_RegNoLabel"]</strong> @_client.RegistrationNumber
                            </MudListItem>
                            @if (!string.IsNullOrEmpty(_client.TaxNumber))
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.Receipt">
                                    <strong>@L["Client_TaxNoLabel"]</strong> @_client.TaxNumber
                                </MudListItem>
                            }
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Percent">
                                <strong>@L["Client_VatPayerLabel"]</strong> @(_client.IsVatPayer ? L["Label_Yes"].Value : L["Label_No"].Value)
                            </MudListItem>
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Language">
                                <strong>@L["Client_Language"]:</strong> @GetLanguageDisplayName(_client.Language)
                            </MudListItem>
                            @if (!string.IsNullOrEmpty(_client.Color))
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.Palette">
                                    <strong>@L["Client_Color"]:</strong>
                                    <MudChip T="string" Size="Size.Small"
                                             Style="@($"background-color:{_client.Color}; color:white;")">
                                        @_client.Color
                                    </MudChip>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Card 2: Contacts (address section moved to full-width AddressListEditor below) *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Client_Contact"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isFormMode)
                    {
                        <MudTextField @bind-Value="_emailContact" Label="@L["Label_Email"].Value" InputType="InputType.Email" Class="mb-3" />
                        <MudTextField @bind-Value="_phoneContact" Label="@L["Client_Phone"].Value" Class="mb-3" />
                    }
                    else
                    {
                        @if (_client!.Contact != null && _client.Contact.Any())
                        {
                            @foreach (var contact in _client.Contact)
                            {
                                <MudText>
                                    <MudIcon Icon="@(contact.ContactType == EContactType.Email ? Icons.Material.Filled.Email : Icons.Material.Filled.Phone)"
                                             Size="Size.Small" Class="mr-1" />
                                    @contact.ContactValue
                                </MudText>
                            }
                        }
                        else
                        {
                            <MudText Color="Color.Secondary">@L["Client_NoContacts"]</MudText>
                        }
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Full-width: Billing Settings — collapsible panel *@
        <MudItem xs="12">
            <MudExpansionPanels Class="mb-4">
                <MudExpansionPanel Text="@L["Billing_Title"].Value" Icon="@Icons.Material.Filled.Payment">
                    @if (_isFormMode)
                    {
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <EnumSelect TEnum="EDueDateCalculationType"
                                            Value="_billingSettings.DueDateCalculationType"
                                            ValueChanged="@(v => _billingSettings.DueDateCalculationType = v)"
                                            Label="@L["Billing_DueDateCalcType"].Value" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudNumericField @bind-Value="_billingSettings.DueDays"
                                                 Label="@L["Billing_DueDays"].Value"
                                                 Min="0" Max="365" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_billingSettings.InvoiceNumberPrefix"
                                              Label="@L["Billing_InvoiceNumberPrefix"].Value" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_billingSettings.InvoiceNumberSuffix"
                                              Label="@L["Billing_InvoiceNumberSuffix"].Value" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_billingSettings.CreditNoteNumberPrefix"
                                              Label="@L["Billing_CreditNotePrefix"].Value" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_billingSettings.CreditNoteNumberSuffix"
                                              Label="@L["Billing_CreditNoteSuffix"].Value" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <EnumSelect TEnum="EPaymentMethod"
                                            NullableValue="_billingSettings.DefaultPaymentMethod"
                                            NullableValueChanged="@(v => _billingSettings.DefaultPaymentMethod = v)"
                                            Label="@L["Billing_PaymentMethod"].Value"
                                            Nullable="true" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <BankAccountInput Value="@_billingSettings.BankAccountNumber"
                                                  ValueChanged="@(v => _billingSettings.BankAccountNumber = v)"
                                                  Label="@L["Billing_BankAccount"].Value" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_billingSettings.Notes"
                                              Label="@L["Billing_Notes"].Value" Lines="3" />
                            </MudItem>
                        </MudGrid>
                    }
                    else if (_client!.BillingSettings != null)
                    {
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudText><strong>@L["Billing_DueDateCalcType"]:</strong> @_client.BillingSettings.DueDateCalculationType</MudText>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudText><strong>@L["Billing_DueDays"]:</strong> @_client.BillingSettings.DueDays</MudText>
                            </MudItem>
                            @if (!string.IsNullOrEmpty(_client.BillingSettings.InvoiceNumberPrefix))
                            {
                                <MudItem xs="12" md="6">
                                    <MudText><strong>@L["Billing_InvoiceNumberPrefix"]:</strong> @_client.BillingSettings.InvoiceNumberPrefix</MudText>
                                </MudItem>
                            }
                            @if (_client.BillingSettings.DefaultPaymentMethod.HasValue)
                            {
                                <MudItem xs="12" md="6">
                                    <MudText><strong>@L["Billing_PaymentMethod"]:</strong> @_client.BillingSettings.DefaultPaymentMethod</MudText>
                                </MudItem>
                            }
                            @if (!string.IsNullOrEmpty(_client.BillingSettings.BankAccountNumber))
                            {
                                <MudItem xs="12" md="6">
                                    <MudText><strong>@L["Billing_BankAccount"]:</strong> @_client.BillingSettings.BankAccountNumber</MudText>
                                </MudItem>
                            }
                            @if (!string.IsNullOrEmpty(_client.BillingSettings.Notes))
                            {
                                <MudItem xs="12">
                                    <MudText><strong>@L["Billing_Notes"]:</strong> @_client.BillingSettings.Notes</MudText>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else
                    {
                        <MudText Color="Color.Secondary">@L["Billing_NotConfigured"]</MudText>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudItem>
    </MudGrid>

    @* Full-width section: 1:N Addresses managed by the shared AddressListEditor component *@
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        @if (_isFormMode)
        {
            <AddressListEditor Addresses="_addresses"
                               AddressesChanged="@(v => { _addresses = v; _isDirty = true; })" />
        }
        else
        {
            @* Read-only view: map AddressDto → CreateAddressDto for the component *@
            <AddressListEditor Addresses="@(_client!.Address.Select(a => new CreateAddressDto
            {
                AddressType = a.AddressType,
                Street = a.Street,
                City = a.City,
                PostalCode = a.PostalCode,
                Country = a.Country,
                AddressLine2 = a.AddressLine2,
                IsPrimary = a.IsPrimary
            }).ToList())" ReadOnly="true" />
        }
    </MudPaper>

    @* Invoice history for this client — only shown for existing clients *@
    @if (!_isCreateMode)
    {
        <MudText Typo="Typo.h5" Class="mt-8 mb-4">@L["Client_InvoiceHistory"]</MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_invoiceSearch" Label="@L["Client_SearchInvoices"].Value" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                                  DebounceInterval="300" OnDebounceIntervalElapsed="SearchClientInvoices" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    @* MudBlazor v8: OnChange removed — use Value + ValueChanged to update filter and reload data *@
                    <MudSelect Value="_invoiceStatusFilter"
                               ValueChanged="@(async (EInvoiceStatus? v) => { _invoiceStatusFilter = v; await SearchClientInvoices(); })"
                               Label="@L["Label_Status"].Value">
                        <MudSelectItem Value="@((EInvoiceStatus?)null)">@L["Invoice_FilterAll"]</MudSelectItem>
                        <MudSelectItem Value="@((EInvoiceStatus?)EInvoiceStatus.Draft)">@L["Invoice_FilterDraft"]</MudSelectItem>
                        <MudSelectItem Value="@((EInvoiceStatus?)EInvoiceStatus.Completed)">@L["Invoice_FilterIssued"]</MudSelectItem>
                        <MudSelectItem Value="@((EInvoiceStatus?)EInvoiceStatus.Paid)">@L["Invoice_FilterPaid"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* MudDataGrid replaces MudTable for richer column features (filtering, resizing, sorting) *@
        <MudDataGrid T="InvoiceDto"
                     ServerData="LoadClientInvoices"
                     @ref="_invoiceGrid"
                     Dense="true" Hover="true" Striped="true"
                     Loading="@_invoiceLoading" LoadingProgressColor="Color.Primary"
                     SortMode="SortMode.Single"
                     ColumnResizeMode="ResizeMode.Column"
             DragDropColumnReordering="true"
                     Hideable="true">
            <Columns>
                @* Document number column with chip display *@
                <PropertyColumn Property="x => x.DocumentNumber" Title="@L["Table_Number"].Value" Sortable="true">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Description">
                            @context.Item.DocumentNumber
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
                @* Issue date — short date format *@
                <PropertyColumn Property="x => x.IssueDate" Title="@L["Table_IssueDate"].Value" Sortable="true" Format="d">
                    <FilterTemplate>
                        <DateColumnFilter T="InvoiceDto" Context="context" ValueFunc="x => x.IssueDate" FilterKey="IssueDate" />
                    </FilterTemplate>
                </PropertyColumn>
                @* Due date — short date format *@
                <PropertyColumn Property="x => x.DueDate" Title="@L["Table_DueDate"].Value" Sortable="true" Format="d">
                    <FilterTemplate>
                        <DateColumnFilter T="InvoiceDto" Context="context" ValueFunc="x => x.DueDate" FilterKey="DueDate" />
                    </FilterTemplate>
                </PropertyColumn>
                @* Total with VAT — bold amount + currency code *@
                <PropertyColumn Property="x => x.TotalWithVat" Title="@L["Invoice_TotalWithVat"].Value" Sortable="true">
                    <CellTemplate>
                        <strong>@context.Item.TotalWithVat.ToString("N2") @context.Item.CurrencyCode</strong>
                    </CellTemplate>
                </PropertyColumn>
                @* Status column with colored chip *@
                <PropertyColumn Property="x => x.Status" Title="@L["Label_Status"].Value" Sortable="false">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">
                            @GetStatusText(context.Item.Status)
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
            </Columns>
            <NoRecordsContent>
                <MudText>@L["Client_NoInvoices"]</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="InvoiceDto" PageSizeOptions="new int[] { 10, 25, 50 }"
                                  RowsPerPageString="@L["Table_RowsPerPage"].Value" />
            </PagerContent>
        </MudDataGrid>
        <GridStatePersistence T="InvoiceDto" DataGrid="_invoiceGrid" GridKey="client-invoices" />
    }

    @* File attachments — entity-agnostic component, works for any entity *@
    @if (!_isCreateMode)
    {
        <FileAttachmentManager EntityName="Client"
                               RecordId="_client!.Id"
                               ReadOnly="@(!_isEditing)" />
    }
}

@code {
    /// <summary>
    /// Route parameter — client ID from URL.
    /// Id == 0 means create mode (/clients/create), Id > 0 means view/edit mode (/clients/{id}).
    /// </summary>
    [Parameter] public long Id { get; set; }

    private ClientDto? _client;
    private bool _loading = true;
    private string? _errorMessage; // Stores API error message for display instead of generic "Not Found"
    private bool _invoiceLoading = false;
    private bool _fetchingAres = false;

    // Mode flags
    private bool _isCreateMode => Id == 0;
    private bool _isEditing = false;
    private bool _isDirty = false; // Dirty tracking for unsaved changes warning
    // True when fields should be editable (create mode or edit mode)
    private bool _isFormMode => _isCreateMode || _isEditing;

    // Form data for create/edit modes
    private CreateClientDto _editClient = new();
    private List<CreateAddressDto> _addresses = new(); // 1:N address list (replaces single _address)
    private CreateBillingSettingsDto _billingSettings = new();
    private string _emailContact = "";
    private string _phoneContact = "";

    // Tracks previous Id to detect parameter changes (e.g., /clients/create → /clients/1).
    // Blazor reuses components for the same @page route, so OnInitializedAsync only fires once.
    // OnParametersSetAsync fires every time [Parameter] values change.
    private long _previousId = -1;

    // Invoice history filter state — MudDataGrid replaces MudTable
    private MudDataGrid<InvoiceDto>? _invoiceGrid;
    private string _invoiceSearch = "";
    private EInvoiceStatus? _invoiceStatusFilter;

    /// <summary>
    /// Called every time a [Parameter] value changes.
    /// Detects navigation between /clients/create ↔ /clients/{id} and reloads accordingly.
    /// Without this, navigating from create to detail shows "Not Found" because Blazor
    /// reuses the same component instance and OnInitializedAsync only fires once.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        // Only reload when the Id parameter actually changes
        if (Id == _previousId) return;
        _previousId = Id;

        if (_isCreateMode)
        {
            InitCreateForm();
            _loading = false;
        }
        else
        {
            _isEditing = false;
            _isDirty = false;
            await LoadClient();
        }
    }

    /// <summary>
    /// Initializes the create form with sensible defaults for a new customer.
    /// </summary>
    private void InitCreateForm()
    {
        _editClient = new CreateClientDto
        {
            FetchFromAres = true,
            IsVatPayer = false,
            IsIssuer = false
        };
        // Initialize with one default billing address — users can add more via AddressListEditor
        _addresses = new List<CreateAddressDto>
        {
            new CreateAddressDto
            {
                AddressType = EAddressType.Billing,
                Country = "Česká republika",
                IsPrimary = true
            }
        };
        _billingSettings = new CreateBillingSettingsDto
        {
            DueDays = 14,
            DueDateCalculationType = EDueDateCalculationType.DaysFromIssue
        };
        _emailContact = "";
        _phoneContact = "";
    }

    /// <summary>
    /// Loads the client detail from the API.
    /// </summary>
    private async Task LoadClient()
    {
        try
        {
            _loading = true;
            _client = await ClientService.GetByIdAsync(Id);
        }
        catch (Exception ex)
        {
            // Store error message for display in the template instead of generic "Nenalezeno".
            // ApiException carries the actual API error (403 Forbidden, 500 Server Error, etc.).
            _errorMessage = ex.Message;
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Switches to edit mode — populates form fields from existing client data.
    /// </summary>
    private void EnableEditing()
    {
        if (_client == null) return;

        _editClient = new CreateClientDto
        {
            RegistrationNumber = _client.RegistrationNumber,
            TaxNumber = _client.TaxNumber,
            CompanyName = _client.CompanyName,
            TradingName = _client.TradingName,
            IsVatPayer = _client.IsVatPayer,
            IsIssuer = _client.IsIssuer,
            Language = _client.Language,
            Color = _client.Color,
            FetchFromAres = false,
            // Tax regime fields
            TaxRegime = _client.TaxRegime,
            ActivityType = _client.ActivityType,
            IsMainActivity = _client.IsMainActivity,
            FlatRateBand = _client.FlatRateBand
        };

        // Map ALL addresses (1:N) into the editable list — not just the primary one
        _addresses = _client.Address.Select(a => new CreateAddressDto
        {
            AddressType = a.AddressType,
            Street = a.Street,
            City = a.City,
            PostalCode = a.PostalCode,
            Country = a.Country,
            AddressLine2 = a.AddressLine2,
            IsPrimary = a.IsPrimary
        }).ToList();

        // Populate billing settings
        if (_client.BillingSettings != null)
        {
            _billingSettings = new CreateBillingSettingsDto
            {
                DueDateCalculationType = _client.BillingSettings.DueDateCalculationType,
                DueDays = _client.BillingSettings.DueDays,
                InvoiceNumberPrefix = _client.BillingSettings.InvoiceNumberPrefix,
                InvoiceNumberSuffix = _client.BillingSettings.InvoiceNumberSuffix,
                CreditNoteNumberPrefix = _client.BillingSettings.CreditNoteNumberPrefix,
                CreditNoteNumberSuffix = _client.BillingSettings.CreditNoteNumberSuffix,
                DefaultPaymentMethod = _client.BillingSettings.DefaultPaymentMethod,
                BankAccountNumber = _client.BillingSettings.BankAccountNumber,
                Notes = _client.BillingSettings.Notes
            };
        }
        else
        {
            _billingSettings = new CreateBillingSettingsDto
            {
                DueDays = 14,
                DueDateCalculationType = EDueDateCalculationType.DaysFromIssue
            };
        }

        var emailContactDto = _client.Contact.FirstOrDefault(c => c.ContactType == EContactType.Email);
        _emailContact = emailContactDto?.ContactValue ?? "";
        var phoneContactDto = _client.Contact.FirstOrDefault(c => c.ContactType == EContactType.Phone);
        _phoneContact = phoneContactDto?.ContactValue ?? "";

        _isEditing = true;
        _isDirty = true; // Entering edit mode marks the form as dirty
    }

    /// <summary>
    /// Cancels editing — reloads original data from the server.
    /// Resets dirty flag since user explicitly chose to discard changes.
    /// </summary>
    private async Task CancelEditing()
    {
        _isEditing = false;
        _isDirty = false;
        await LoadClient();
    }

    /// <summary>
    /// Saves client data — creates a new client or updates an existing one.
    /// On create success, navigates to the new client's detail page.
    /// </summary>
    private async Task SaveClient()
    {
        try
        {
            // Build address and contact lists from form data
            BuildAddressAndContacts();

            if (_isCreateMode)
            {
                // Attach billing settings
                _editClient.BillingSettings = _billingSettings;

                var result = await ClientService.CreateAsync(_editClient);
                if (result != null)
                {
                    // Reset dirty flag and force re-render BEFORE navigation.
                    // This ensures <UnsavedChangesLock> removes <NavigationLock> from the DOM
                    // before NavigateTo fires — avoids the "leave page?" prompt after save.
                    _isDirty = false;
                    StateHasChanged();
                    await Task.Yield();

                    Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                    Navigation.NavigateTo($"/clients/{result.Id}");
                }
                else
                {
                    Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
                }
            }
            else
            {
                // Update existing client via PUT /api/client/{id}
                var updateDto = new UpdateClientDto
                {
                    CompanyName = _editClient.CompanyName,
                    TradingName = _editClient.TradingName,
                    TaxNumber = _editClient.TaxNumber,
                    IsVatPayer = _editClient.IsVatPayer,
                    IsIssuer = _editClient.IsIssuer,
                    IsActive = true,
                    Language = _editClient.Language,
                    Color = _editClient.Color ?? "",
                    RefreshFromAres = _editClient.FetchFromAres,
                    // Tax regime fields
                    TaxRegime = _editClient.TaxRegime,
                    ActivityType = _editClient.ActivityType,
                    IsMainActivity = _editClient.IsMainActivity,
                    FlatRateBand = _editClient.FlatRateBand
                };

                // Send ALL addresses (1:N) — backend uses replace-all strategy
                updateDto.Address = _addresses.Select(a => new UpdateAddressDto
                {
                    AddressType = a.AddressType,
                    Street = a.Street,
                    City = a.City,
                    PostalCode = a.PostalCode,
                    Country = a.Country,
                    AddressLine2 = a.AddressLine2,
                    IsPrimary = a.IsPrimary
                }).ToList();

                // Contacts
                updateDto.Contact = new List<UpdateContactDto>();
                if (!string.IsNullOrWhiteSpace(_emailContact))
                {
                    updateDto.Contact.Add(new UpdateContactDto
                    {
                        ContactType = EContactType.Email,
                        ContactValue = _emailContact,
                        IsPrimary = true
                    });
                }
                if (!string.IsNullOrWhiteSpace(_phoneContact))
                {
                    updateDto.Contact.Add(new UpdateContactDto
                    {
                        ContactType = EContactType.Phone,
                        ContactValue = _phoneContact,
                        IsPrimary = updateDto.Contact.Count == 0
                    });
                }

                // Billing settings
                updateDto.BillingSettings = new UpdateBillingSettingsDto
                {
                    DueDateCalculationType = _billingSettings.DueDateCalculationType,
                    DueDays = _billingSettings.DueDays,
                    InvoiceNumberPrefix = _billingSettings.InvoiceNumberPrefix,
                    InvoiceNumberSuffix = _billingSettings.InvoiceNumberSuffix,
                    CreditNoteNumberPrefix = _billingSettings.CreditNoteNumberPrefix,
                    CreditNoteNumberSuffix = _billingSettings.CreditNoteNumberSuffix,
                    DefaultPaymentMethod = _billingSettings.DefaultPaymentMethod,
                    BankAccountNumber = _billingSettings.BankAccountNumber,
                    Notes = _billingSettings.Notes
                };

                var result = await ClientService.UpdateAsync(Id, updateDto);
                if (result != null)
                {
                    _isDirty = false; // Reset dirty flag on successful save
                    Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                    _isEditing = false;
                    await LoadClient(); // Refresh displayed data
                }
                else
                {
                    Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Builds address and contact lists on the CreateClientDto from form fields.
    /// Used for create mode only — edit mode builds UpdateClientDto directly.
    /// </summary>
    private void BuildAddressAndContacts()
    {
        if (!_isCreateMode) return;

        // Attach the full 1:N address list (managed by AddressListEditor)
        _editClient.Address = _addresses;

        _editClient.Contact = new List<CreateContactDto>();
        if (!string.IsNullOrWhiteSpace(_emailContact))
        {
            _editClient.Contact.Add(new CreateContactDto
            {
                ContactType = EContactType.Email,
                ContactValue = _emailContact,
                IsPrimary = true
            });
        }
        if (!string.IsNullOrWhiteSpace(_phoneContact))
        {
            _editClient.Contact.Add(new CreateContactDto
            {
                ContactType = EContactType.Phone,
                ContactValue = _phoneContact,
                IsPrimary = _editClient.Contact.Count == 0
            });
        }
    }

    /// <summary>
    /// Deletes the client and navigates back to the list page.
    /// </summary>
    private async Task DeleteClient()
    {
        try
        {
            if (await ClientService.DeleteAsync(Id))
            {
                Snackbar.Add(L["Msg_DeleteSuccess"].Value, Severity.Success);
                Navigation.NavigateTo("/clients");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Fetches company data from Czech ARES business registry by registration number (IČO).
    /// </summary>
    private async Task FetchFromAres()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_editClient.RegistrationNumber))
            {
                Snackbar.Add(L["Client_RegistrationNumber"].Value, Severity.Warning);
                return;
            }

            _fetchingAres = true;
            var aresData = await ClientService.FetchFromAresAsync(_editClient.RegistrationNumber);

            if (aresData != null)
            {
                _editClient.CompanyName = aresData.CompanyName;
                _editClient.TaxNumber = aresData.TaxNumber;
                _editClient.IsVatPayer = aresData.IsVatPayer;

                // Merge ARES address into the address list — update existing primary or add new
                var aresAddr = aresData.Address.FirstOrDefault(a => a.IsPrimary)
                    ?? aresData.Address.FirstOrDefault();
                if (aresAddr != null)
                {
                    var existingPrimary = _addresses.FirstOrDefault(a => a.IsPrimary);
                    if (existingPrimary != null)
                    {
                        // Update the existing primary address with ARES data
                        existingPrimary.Street = aresAddr.Street;
                        existingPrimary.City = aresAddr.City;
                        existingPrimary.PostalCode = aresAddr.PostalCode;
                        existingPrimary.Country = aresAddr.Country;
                    }
                    else
                    {
                        // No primary address exists — add ARES address as primary
                        _addresses.Add(new CreateAddressDto
                        {
                            AddressType = EAddressType.Primary,
                            Street = aresAddr.Street,
                            City = aresAddr.City,
                            PostalCode = aresAddr.PostalCode,
                            Country = aresAddr.Country,
                            IsPrimary = true
                        });
                    }
                }

                Snackbar.Add(L["Ares_DataLoaded"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Ares_NotFound"].Value, Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _fetchingAres = false;
        }
    }

    // --- Invoice history ---

    /// <summary>
    /// Server-side data loading for the client's invoice history grid.
    /// GridState provides sort definitions instead of SortLabel/SortDirection used by MudTable.
    /// </summary>
    private async Task<GridData<InvoiceDto>> LoadClientInvoices(GridState<InvoiceDto> state)
    {
        _invoiceLoading = true;
        StateHasChanged();

        try
        {
            // Extract sort info from GridState — MudDataGrid uses SortDefinitions collection
            var sortDef = state.SortDefinitions.FirstOrDefault();
            var sortBy = sortDef?.SortBy;
            var sortDirection = sortDef?.Descending == true ? "desc" : "asc";

            // Date column filters — extracted from GridState and forwarded to the API
            var (issueFrom, issueTo) = state.GetDateRange("IssueDate");
            var (dueFrom, dueTo) = state.GetDateRange("DueDate");

            var result = await InvoiceService.GetPagedAsync(
                page: state.Page + 1,
                pageSize: state.PageSize,
                search: _invoiceSearch,
                sortBy: sortBy,
                sortDirection: sortDirection,
                clientId: Id,
                status: _invoiceStatusFilter,
                issueDateFrom: issueFrom,
                issueDateTo: issueTo,
                dueDateFrom: dueFrom,
                dueDateTo: dueTo);

            return new GridData<InvoiceDto>
            {
                Items = result.Items,
                TotalItems = result.TotalCount
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
            return new GridData<InvoiceDto> { Items = new List<InvoiceDto>(), TotalItems = 0 };
        }
        finally
        {
            _invoiceLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Triggers a server data reload on the invoice grid when search/filter changes.
    /// </summary>
    private async Task SearchClientInvoices()
    {
        if (_invoiceGrid != null) await _invoiceGrid.ReloadServerData();
    }

