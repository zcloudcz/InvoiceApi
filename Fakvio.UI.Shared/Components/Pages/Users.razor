@page "/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,SysAdmin")]
@using Fakvio.Contracts.Dto.User
@using Fakvio.Contracts.Dto.Client
@using Fakvio.Domain.Enums
@inject UserApiService UserService
@inject ClientApiService ClientService
@inject ISnackbar Snackbar
@* Localization service for multi-language support *@
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["User_Title"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["User_Title"]</MudText>
<MudText Class="mb-4">@L["User_Subtitle"]</MudText>

@* AppDataGrid provides consistent Dense+Hover+Striped+pointer styling across all grid pages *@
<AppDataGrid TItem="UserDto"
             Items="@_users"
             Loading="@_loading"
             Filter="@FilterFunc"
             OnRowClick="@(OpenEditDialog)"
             OnEdit="@(OpenEditDialog)"
             OnDelete="@((u) => DeleteUser(u.Id))"
             NoRecordsText="@L["User_NoRecords"].Value">
    <ToolBarContent>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog" Class="mr-4">
            @L["User_New"]
        </MudButton>
        <MudTextField @bind-Value="_searchString" Placeholder="@L["Btn_Search"].Value" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <Columns>
        <MudTh>@L["Label_Email"]</MudTh>
        <MudTh>@L["User_FullName"]</MudTh>
        <MudTh>@L["User_Role"]</MudTh>
        <MudTh>@L["User_Company"]</MudTh>
        <MudTh>@L["User_LastLogin"]</MudTh>
        <MudTh>@L["Label_Status"]</MudTh>
    </Columns>
    <RowContent>
        <MudTd DataLabel="@L["Label_Email"].Value">@context.Email</MudTd>
        <MudTd DataLabel="@L["User_FullName"].Value">@context.FullName</MudTd>
        <MudTd DataLabel="@L["User_Role"].Value">
            <MudChip T="string" Size="Size.Small" Color="@GetRoleColor(context.Role)">
                @GetRoleText(context.Role)
            </MudChip>
        </MudTd>
        <MudTd DataLabel="@L["User_Company"].Value">@(context.CompanyName ?? "—")</MudTd>
        <MudTd DataLabel="@L["User_LastLogin"].Value">
            @(context.LastLoginAt?.ToString("dd.MM.yyyy HH:mm") ?? L["User_Never"].Value)
        </MudTd>
        <MudTd DataLabel="@L["Label_Status"].Value">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                @(context.IsActive ? L["Label_Active"].Value : L["Label_Inactive"].Value)
            </MudChip>
        </MudTd>
    </RowContent>
    <RowActions>
        @* Change password icon — extra action specific to Users page *@
        <MudIconButton Icon="@Icons.Material.Filled.Key" Size="Size.Small" Color="Color.Info"
                       OnClick="@(() => OpenChangePasswordDialog(context))" title="@L["User_ChangePassword"].Value" />
    </RowActions>
</AppDataGrid>

<MudDialog @bind-Visible="_showDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editMode ? L["User_Edit"] : L["User_New"])</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_currentUser.Email" Label="@L["Label_Email"].Value" InputType="InputType.Email" Required="true" />
            </MudItem>
            @* In create mode, offer the option to send invitation email instead of setting password manually *@
            @if (!_editMode)
            {
                <MudItem xs="12">
                    <MudSwitch @bind-Value="_sendInvitation" Label="@L["User_SendInvitation"].Value"
                               Color="Color.Info" />
                </MudItem>
                @* Only show password field when NOT sending invitation *@
                @if (!_sendInvitation)
                {
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_currentUser.Password" Label="@L["Label_Password"].Value" InputType="InputType.Password" Required="true" />
                    </MudItem>
                }
            }
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_currentUser.FirstName" Label="@L["User_FirstName"].Value" Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_currentUser.LastName" Label="@L["User_LastName"].Value" Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="_currentUser.Role" Label="@L["User_Role"].Value" Required="true">
                    <MudSelectItem Value="@EUserRole.User">@L["User_RoleUser"]</MudSelectItem>
                    <MudSelectItem Value="@EUserRole.Admin">@L["User_RoleAdmin"]</MudSelectItem>
                    <MudSelectItem Value="@EUserRole.SysAdmin">@L["User_RoleSysAdmin"]</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                @* ToStringFunc maps the selected long? ID back to the company name for display *@
                <MudSelect @bind-Value="_selectedCompanyId" Label="@L["User_Company"].Value" Clearable="true"
                           ToStringFunc="@(id => _companies.FirstOrDefault(c => c.Id == id)?.CompanyName ?? "")">
                    @foreach (var company in _companies.Where(c => c.IsIssuer))
                    {
                        <MudSelectItem Value="@((long?)company.Id)">@company.CompanyName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSwitch @bind-Value="_currentUser.IsActive" Label="@L["Label_Active"].Value" Color="Color.Primary" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog">@L["Btn_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveUser">
            @(_editMode ? L["Btn_Save"] : L["Btn_Create"])
        </MudButton>
    </DialogActions>
</MudDialog>

@* Admin password reset dialog — does not require the old password *@
<MudDialog @bind-Visible="_showPasswordDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["User_ResetPassword"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Class="mb-4">
            @L["User_ResetPasswordInfo"]
        </MudAlert>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_adminResetPassword.NewPassword" Label="@L["User_NewPassword"].Value" InputType="InputType.Password" Required="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ClosePasswordDialog">@L["Btn_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ChangePassword">@L["Btn_SetPassword"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<UserDto> _users = new();
    private List<ClientDto> _companies = new();
    private bool _loading = true;
    private bool _showDialog = false;
    private bool _showPasswordDialog = false;
    private bool _editMode = false;
    private string _searchString = "";
    private CreateUserDto _currentUser = new();
    private long _editingUserId = 0;
    private long? _selectedCompanyId = null;
    private AdminResetPasswordDto _adminResetPassword = new();
    private long _changingPasswordUserId = 0;
    // When true, the user will receive an invitation email instead of setting password manually
    private bool _sendInvitation = true;

    private DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            _users = await UserService.GetAllAsync();
            _companies = await ClientService.GetAllAsync(includeInactive: false);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterFunc(UserDto user)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        var search = _searchString.ToLower();
        return user.Email?.ToLower().Contains(search) == true
            || user.FullName?.ToLower().Contains(search) == true
            || user.CompanyName?.ToLower().Contains(search) == true;
    }

    private void OpenCreateDialog()
    {
        _currentUser = new CreateUserDto
        {
            Role = EUserRole.User,
            IsActive = true
        };
        _selectedCompanyId = null;
        _editMode = false;
        _sendInvitation = true; // Default: send invitation email
        _showDialog = true;
    }

    private void OpenEditDialog(UserDto user)
    {
        _currentUser = new CreateUserDto
        {
            Email = user.Email,
            FirstName = user.FirstName,
            LastName = user.LastName,
            Role = user.Role,
            IsActive = user.IsActive,
            Password = "" // Not used in edit mode
        };
        _selectedCompanyId = user.CompanyId;
        _editMode = true;
        _editingUserId = user.Id;
        _showDialog = true;
    }

    private void OpenChangePasswordDialog(UserDto user)
    {
        _adminResetPassword = new AdminResetPasswordDto();
        _changingPasswordUserId = user.Id;
        _showPasswordDialog = true;
    }

    private void CloseDialog()
    {
        _showDialog = false;
    }

    private void ClosePasswordDialog()
    {
        _showPasswordDialog = false;
    }

    private async Task SaveUser()
    {
        try
        {
            _currentUser.CompanyId = _selectedCompanyId;

            if (_editMode)
            {
                var updateDto = new UpdateUserDto
                {
                    Email = _currentUser.Email,
                    FirstName = _currentUser.FirstName,
                    LastName = _currentUser.LastName,
                    Role = _currentUser.Role,
                    CompanyId = _currentUser.CompanyId,
                    IsActive = _currentUser.IsActive
                };

                var result = await UserService.UpdateAsync(_editingUserId, updateDto);
                if (result != null)
                {
                    Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                    _showDialog = false;
                    await LoadData();
                }
            }
            else
            {
                if (_sendInvitation)
                {
                    // Use invitation flow — create user and send email with password setup link
                    var inviteDto = new InviteUserDto
                    {
                        Email = _currentUser.Email,
                        FirstName = _currentUser.FirstName,
                        LastName = _currentUser.LastName,
                        Role = _currentUser.Role,
                        CompanyId = _currentUser.CompanyId
                    };
                    var result = await UserService.InviteUserAsync(inviteDto);
                    if (result != null)
                    {
                        Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                        _showDialog = false;
                        await LoadData();
                    }
                    else
                    {
                        Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
                    }
                }
                else
                {
                    // Standard flow — create user with manual password
                    var result = await UserService.CreateAsync(_currentUser);
                    if (result != null)
                    {
                        Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                        _showDialog = false;
                        await LoadData();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteUser(long id)
    {
        try
        {
            var success = await UserService.DeleteAsync(id);
            if (success)
            {
                Snackbar.Add(L["Msg_DeleteSuccess"].Value, Severity.Success);
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    private async Task ChangePassword()
    {
        try
        {
            // Use admin reset — no old password required
            var success = await UserService.AdminResetPasswordAsync(_changingPasswordUserId, _adminResetPassword);
            if (success)
            {
                Snackbar.Add(L["Msg_SaveSuccess"].Value, Severity.Success);
                _showPasswordDialog = false;
            }
            else
            {
                Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    private Color GetRoleColor(EUserRole role)
    {
        return role switch
        {
            EUserRole.User => Color.Default,
            EUserRole.Admin => Color.Info,
            EUserRole.SysAdmin => Color.Secondary,
            _ => Color.Default
        };
    }

    /// <summary>
    /// Returns localized role text for each user role.
    /// </summary>
    private string GetRoleText(EUserRole role)
    {
        return role switch
        {
            EUserRole.User => L["User_RoleUser"].Value,
            EUserRole.Admin => L["User_RoleAdmin"].Value,
            EUserRole.SysAdmin => L["User_RoleSysAdmin"].Value,
            _ => role.ToString()
        };
    }
}
