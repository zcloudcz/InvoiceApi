@page "/login"
@using Fakvio.UI.Shared.Models
@using Fakvio.UI.Shared.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthApiService AuthApiService
@inject UserApiService UserApiService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@* Localization service for multi-language support *@
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Login_Title"] - Fakvio</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-8">
        <MudStack Spacing="4">
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                @* App logo — grey version looks good on both dark and light paper backgrounds *@
                <MudImage Src="images/logo-grey.png" Alt="Fakvio" Width="64" Height="64" />
                <MudText Typo="Typo.h4" Align="Align.Center">Fakvio</MudText>
                <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Secondary">@L["Login_Title"]</MudText>
            </MudStack>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
            }

            <EditForm Model="@_loginRequest" OnValidSubmit="HandleLoginAsync" FormName="LoginForm">
                <DataAnnotationsValidator />

                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_loginRequest.Email"
                                  Label="@L["Label_Email"].Value"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Required="true"
                                  For="@(() => _loginRequest.Email)"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email" />

                    <MudTextField @bind-Value="_loginRequest.Password"
                                  Label="@L["Label_Password"].Value"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Required="true"
                                  For="@(() => _loginRequest.Password)"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Lock" />

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth="true"
                               Disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            <span>@L["Login_LoggingIn"]</span>
                        }
                        else
                        {
                            <span>@L["Btn_Login"]</span>
                        }
                    </MudButton>

                    @* "Forgot Password?" link — opens inline form to request reset email *@
                    <MudLink Color="Color.Primary" Typo="Typo.body2"
                             Style="cursor:pointer; text-align:right;"
                             OnClick="@(() => _showForgotPassword = true)">
                        @L["Login_ForgotPassword"]
                    </MudLink>
                </MudStack>
            </EditForm>

            @* ── Forgot Password inline form ── *@
            @if (_showForgotPassword)
            {
                <MudDivider />
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary">@L["ForgotPassword_Title"]</MudText>

                    @if (_forgotPasswordSent)
                    {
                        <MudAlert Severity="Severity.Success">@L["ForgotPassword_Sent"]</MudAlert>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ForgotPassword_Subtitle"]</MudText>
                        <MudTextField @bind-Value="_forgotEmail"
                                      Label="@L["Label_Email"].Value"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email" />

                        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                            <MudButton Variant="Variant.Text"
                                       OnClick="@(() => _showForgotPassword = false)">
                                @L["Btn_Cancel"]
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@_isSendingReset"
                                       OnClick="HandleForgotPasswordAsync">
                                @if (_isSendingReset)
                                {
                                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                }
                                @L["ForgotPassword_Send"]
                            </MudButton>
                        </MudStack>
                    }
                </MudStack>
            }

            <MudDivider />

            @* OAuth provider buttons — alternative login methods *@
            @* <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                @L["Login_OrContinueWith"]
            </MudText>
            <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                <MudIconButton Icon="@Icons.Custom.Brands.Google"
                               Color="Color.Default"
                               Variant="Variant.Outlined"
                               OnClick="@(() => LoginWithProvider("Google"))"
                               title="Google" />
                <MudIconButton Icon="@Icons.Custom.Brands.Microsoft"
                               Color="Color.Default"
                               Variant="Variant.Outlined"
                               OnClick="@(() => LoginWithProvider("Microsoft"))"
                               title="Microsoft" />
                <MudIconButton Icon="@Icons.Custom.Brands.Facebook"
                               Color="Color.Default"
                               Variant="Variant.Outlined"
                               OnClick="@(() => LoginWithProvider("Facebook"))"
                               title="Facebook" />
                <MudIconButton Icon="@Icons.Custom.Brands.Apple"
                               Color="Color.Default"
                               Variant="Variant.Outlined"
                               OnClick="@(() => LoginWithProvider("Apple"))"
                               title="Apple" />
            </MudStack> 

            <MudDivider />*@

            @* Registration link *@
            <MudText Typo="Typo.body2" Align="Align.Center">
                <MudLink Href="/register" Color="Color.Primary">
                    @L["Login_NoAccount"]
                </MudLink>
            </MudText>

            @* <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
                @L["Login_DefaultCredentials"]
            </MudText> *@
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private LoginRequest _loginRequest = new();
    private string? _errorMessage;
    private bool _isLoading;

    // Forgot Password state
    private bool _showForgotPassword;
    private string _forgotEmail = "";
    private bool _isSendingReset;
    private bool _forgotPasswordSent;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Redirect if already authenticated
        if (AuthenticationState != null)
        {
            var authState = await AuthenticationState;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo("/");
            }
        }
    }

    private async Task HandleLoginAsync()
    {
        _errorMessage = null;
        _isLoading = true;

        try
        {
            // Call API to authenticate user
            var response = await AuthApiService.LoginAsync(_loginRequest);

            if (response == null)
            {
                _errorMessage = L["Login_Error"].Value;
                return;
            }

            // ── Two-Factor Authentication redirect ──────────────────────────
            // If the server indicates 2FA is required, redirect to the verification page
            // instead of completing the login. The JWT is not issued until the code is verified.
            if (response.RequiresTwoFactor && !string.IsNullOrEmpty(response.TwoFactorSessionToken))
            {
                var method = response.TwoFactorMethod ?? 1;
                Navigation.NavigateTo(
                    $"/login/verify-2fa?token={Uri.EscapeDataString(response.TwoFactorSessionToken)}&method={method}");
                return;
            }

            // Store session and update authentication state
            var customAuthStateProvider = (CustomAuthenticationStateProvider)AuthStateProvider;
            await customAuthStateProvider.MarkUserAsAuthenticatedAsync(response);

            // Redirect to home page
            // Use forceLoad to ensure full page reload with new auth state
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (InvalidOperationException)
        {
            // NavigateTo with forceLoad can throw after initiating navigation — this is expected
        }
        catch (Exception ex)
        {
            _errorMessage = string.Format(L["Login_ErrorGeneric"].Value, ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Handles the "Forgot Password" form submission.
    /// Calls the anonymous endpoint which always returns success (no email enumeration).
    /// </summary>
    private async Task HandleForgotPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_forgotEmail)) return;

        _isSendingReset = true;
        try
        {
            await UserApiService.ForgotPasswordAsync(_forgotEmail.Trim());
            _forgotPasswordSent = true;
        }
        catch
        {
            // Even on error, show success — don't reveal anything to potential attacker
            _forgotPasswordSent = true;
        }
        finally
        {
            _isSendingReset = false;
        }
    }

    /// <summary>
    /// Navigates to the API's external login endpoint for the specified OAuth provider.
    /// The API will redirect the browser to the provider's login page.
    /// </summary>
    private void LoginWithProvider(string provider)
    {
        var apiBaseUrl = Configuration["ApiSettings:BaseUrl"]!;
        Navigation.NavigateTo(
            $"{apiBaseUrl}/api/auth/external-login?provider={provider}&returnUrl=/auth-callback",
            forceLoad: true);
    }
}
