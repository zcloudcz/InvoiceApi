@page "/invoice-templates"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Fakvio.Contracts.Dto.InvoiceTemplate
@using Fakvio.Contracts.Dto.Invoice
@using Fakvio.Contracts.Dto.Client
@using Fakvio.Contracts.Dto.Currency
@using Fakvio.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using Fakvio.UI.Shared.Services
@* Use typed API services instead of raw HttpClient — they handle BaseAddress, auth, logging *@
@inject InvoiceTemplateApiService TemplateService
@inject ClientApiService ClientService
@inject CurrencyApiService CurrencyService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Template_Title"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@L["Template_Title"]</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_searchString" Label="@L["Btn_Search"].Value" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                          DebounceInterval="300" OnDebounceIntervalElapsed="SearchTemplates" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            @* MudBlazor v8: OnChange removed — use Value + ValueChanged to update filter and reload data *@
            <MudSelect Value="_filterDocumentType"
                       ValueChanged="@(async (EDocumentType? v) => { _filterDocumentType = v; await SearchTemplates(); })"
                       Label="@L["Template_DocumentType"].Value">
                <MudSelectItem Value="@((EDocumentType?)null)">@L["Invoice_FilterAll"]</MudSelectItem>
                <MudSelectItem Value="@((EDocumentType?)EDocumentType.Invoice)">@L["Template_DocumentTypeInvoice"]</MudSelectItem>
                <MudSelectItem Value="@((EDocumentType?)EDocumentType.CreditNote)">@L["Template_DocumentTypeCreditNote"]</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            @* MudBlazor v8: OnChange removed — use Value + ValueChanged to update filter and reload data *@
            <MudSelect Value="_filterActive"
                       ValueChanged="@(async (bool? v) => { _filterActive = v; await SearchTemplates(); })"
                       Label="@L["Label_Status"].Value">
                <MudSelectItem Value="@((bool?)null)">@L["Invoice_FilterAll"]</MudSelectItem>
                <MudSelectItem Value="@((bool?)true)">@L["Label_Active"]</MudSelectItem>
                <MudSelectItem Value="@((bool?)false)">@L["Label_Inactive"]</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3" Class="d-flex align-end justify-end">
            @* Navigate to create page instead of opening a dialog *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="@(() => Navigation.NavigateTo("/invoice-templates/create"))" StartIcon="@Icons.Material.Filled.Add">
                @L["Template_New"]
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* MudDataGrid with server-side pagination, column filters, and inline actions *@
<MudDataGrid T="InvoiceTemplateDto"
             ServerData="LoadData"
             @ref="_dataGrid"
             Dense="true"
             Hover="true"
             Striped="true"
             Loading="@_loading"
             LoadingProgressColor="Color.Primary"
             RowClick="@(args => Navigation.NavigateTo($"/invoice-templates/{args.Item.Id}"))"
             RowStyleFunc="@((item, idx) => "cursor: pointer;")"
             FilterMode="DataGridFilterMode.ColumnFilterRow"
             SortMode="SortMode.Single"
             Filterable="true"
             ColumnResizeMode="ResizeMode.Column">
    <Columns>
        @* PropertyColumn: sortable + filterable by default. CellTemplate uses context.Item. *@
        <PropertyColumn Property="x => x.Name" Title="@L["Label_Name"].Value">
            <CellTemplate>
                <MudText Typo="Typo.body2"><strong>@context.Item.Name</strong></MudText>
                @if (!string.IsNullOrEmpty(context.Item.Description))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.Description</MudText>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.DocumentType" Title="@L["Template_DocumentType"].Value" Sortable="false">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@(context.Item.DocumentType == EDocumentType.Invoice ? Color.Primary : Color.Warning)">
                    @(context.Item.DocumentType == EDocumentType.Invoice ? L["Template_DocumentTypeInvoice"] : L["Template_DocumentTypeCreditNote"])
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.ClientName" Title="@L["Invoice_Client"].Value" Sortable="false" />
        <PropertyColumn Property="x => x.CurrencyCode" Title="@L["Template_Currency"].Value" Sortable="false" Filterable="false" />
        <PropertyColumn Property="x => x.UsageCount" Title="@L["Template_UsageCount"].Value">
            <CellTemplate>@context.Item.UsageCount×</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.LastUsedAt" Title="@L["Template_LastUsed"].Value" Format="d">
            <CellTemplate>
                @if (context.Item.LastUsedAt.HasValue)
                {
                    @context.Item.LastUsedAt.Value.ToShortDateString()
                }
                else
                {
                    <MudText Color="Color.Secondary">@L["Template_Never"]</MudText>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.IsActive" Title="@L["Label_Status"].Value">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                    @(context.Item.IsActive ? L["Label_Active"] : L["Label_Inactive"])
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        @* Actions column — edit, delete, and create invoice from template *@
        <TemplateColumn T="InvoiceTemplateDto" Title="@L["Label_Actions"].Value" Sortable="false" Filterable="false" CellStyle="white-space:nowrap;">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => Navigation.NavigateTo($"/invoice-templates/{context.Item.Id}"))" Title="@L["Btn_Edit"].Value" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteTemplate(context.Item))" Title="@L["Btn_Delete"].Value" />
                @* Create invoice from template — extra action specific to InvoiceTemplates page *@
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Success"
                               OnClick="@(() => OpenCreateInvoiceDialog(context.Item))" Title="@L["Template_CreateInvoiceTooltip"].Value" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>@L["Template_NoRecords"]</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="InvoiceTemplateDto" />
    </PagerContent>
</MudDataGrid>

@* Dialog for creating an invoice from a template — kept as small popup *@
<MudDialog @bind-Visible="_showCreateInvoiceDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Template_CreateInvoice"]</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedTemplate != null)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                @L["Template_TemplateLabel"] <strong>@_selectedTemplate.Name</strong>
            </MudAlert>

            <MudForm @ref="_invoiceForm" @bind-IsValid="_invoiceFormValid">
                <MudSelect @bind-Value="_createFromTemplateDto.ClientId" Label="@L["Invoice_Client"].Value" Required="true">
                    @foreach (var client in _clients)
                    {
                        <MudSelectItem Value="@client.Id">@client.CompanyName</MudSelectItem>
                    }
                </MudSelect>

                <MudDatePicker @bind-Date="_issueDate" Label="@L["Invoice_IssueDate"].Value" Class="mt-3" />
                <MudDatePicker @bind-Date="_dueDate" Label="@L["Invoice_DueDate"].Value" Class="mt-3" />

                <MudTextField @bind-Value="_createFromTemplateDto.Notes" Label="@L["Template_Notes"].Value"
                              Lines="3" Class="mt-3" />

                <MudSwitch T="bool" @bind-Value="_createFromTemplateDto.AutoComplete" Label="@L["Template_AutoComplete"].Value"
                           Color="Color.Primary" Class="mt-3" />
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseCreateInvoiceDialog">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="CreateInvoiceFromTemplate"
                   Disabled="@(!_invoiceFormValid)">
            @L["Template_CreateInvoice"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudDataGrid<InvoiceTemplateDto>? _dataGrid;
    private MudForm? _invoiceForm;
    private bool _loading = false;
    private bool _showCreateInvoiceDialog = false;
    private bool _invoiceFormValid = false;
    private string _searchString = "";
    private EDocumentType? _filterDocumentType = null;
    private bool? _filterActive = true;

    // "Create Invoice from Template" dialog state
    private InvoiceTemplateDto? _selectedTemplate;
    private CreateInvoiceFromTemplateDto _createFromTemplateDto = new();
    private DateTime? _issueDate = DateTime.Now;
    private DateTime? _dueDate = DateTime.Now.AddDays(14);

    // Reference data for the "Create Invoice from Template" dialog
    private List<ClientDto> _clients = new();

    private DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true
    };

    /// <summary>
    /// Loads clients for the "Create Invoice from Template" dialog on page init.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
    }

    /// <summary>
    /// Loads active clients (non-issuers) for the client dropdown via ClientApiService.
    /// </summary>
    private async Task LoadClients()
    {
        try
        {
            var allClients = await ClientService.GetAllAsync();
            _clients = allClients.Where(c => !c.IsIssuer).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Loads paged template data via InvoiceTemplateApiService.
    /// Called by MudDataGrid when the page, sort, or filter changes.
    /// GridState&lt;T&gt; replaces old TableState — uses SortDefinitions for sort info.
    /// </summary>
    private async Task<GridData<InvoiceTemplateDto>> LoadData(GridState<InvoiceTemplateDto> state)
    {
        _loading = true;
        StateHasChanged();

        try
        {
            // Extract sort info from GridState — MudDataGrid uses SortDefinitions collection
            var sortDef = state.SortDefinitions.FirstOrDefault();
            var sortBy = sortDef?.SortBy ?? "Name";
            var isDescending = sortDef?.Descending ?? false;

            var response = await TemplateService.GetPagedAsync(
                page: state.Page + 1, // MudDataGrid is 0-based, API is 1-based
                pageSize: state.PageSize,
                search: _searchString,
                documentType: _filterDocumentType,
                isActive: _filterActive,
                sortBy: sortBy,
                isDescending: isDescending);

            return new GridData<InvoiceTemplateDto>
            {
                Items = response.Items,
                TotalItems = response.TotalCount
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }

        return new GridData<InvoiceTemplateDto> { Items = new List<InvoiceTemplateDto>(), TotalItems = 0 };
    }

    private async Task SearchTemplates()
    {
        if (_dataGrid != null)
        {
            await _dataGrid.ReloadServerData();
        }
    }

    private void OpenCreateInvoiceDialog(InvoiceTemplateDto template)
    {
        _selectedTemplate = template;
        _createFromTemplateDto = new CreateInvoiceFromTemplateDto
        {
            // Pre-fill client from template if one is set as default
            ClientId = template.ClientId ?? 0,
            IssueDate = _issueDate,
            DueDate = _dueDate
        };
        _showCreateInvoiceDialog = true;
    }

    private void CloseCreateInvoiceDialog()
    {
        _showCreateInvoiceDialog = false;
        _selectedTemplate = null;
        _createFromTemplateDto = new();
    }

    /// <summary>
    /// Creates an invoice from a template via InvoiceTemplateApiService.
    /// </summary>
    private async Task CreateInvoiceFromTemplate()
    {
        if (_selectedTemplate == null || _invoiceForm == null)
            return;

        await _invoiceForm.Validate();
        if (!_invoiceFormValid)
            return;

        try
        {
            _createFromTemplateDto.IssueDate = _issueDate;
            _createFromTemplateDto.DueDate = _dueDate;

            // Use typed service instead of raw HttpClient
            var invoice = await TemplateService.CreateInvoiceFromTemplateAsync(
                _selectedTemplate.Id, _createFromTemplateDto);

            if (invoice != null)
            {
                Snackbar.Add(L["Invoice_Created"].Value, Severity.Success);
                CloseCreateInvoiceDialog();
                await SearchTemplates(); // Update usage count
                Navigation.NavigateTo("/invoices");
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Deletes a template after user confirmation via InvoiceTemplateApiService.
    /// </summary>
    private async Task DeleteTemplate(InvoiceTemplateDto template)
    {
        bool? result = await DialogService.ShowMessageBox(
            L["Msg_ConfirmDeleteTitle"].Value,
            $"{L["Template_ConfirmDelete"].Value} ({template.Name})",
            yesText: L["Btn_Delete"].Value, cancelText: L["Btn_Cancel"].Value);

        if (result == true)
        {
            try
            {
                var deleted = await TemplateService.DeleteAsync(template.Id);

                if (deleted)
                {
                    Snackbar.Add(L["Msg_DeleteSuccess"].Value, Severity.Success);
                    await SearchTemplates();
                }
                else
                {
                    Snackbar.Add(L["Msg_Error"].Value, Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
            }
        }
    }
}
