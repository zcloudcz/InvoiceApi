    /// <summary>
    /// Server-side data loading callback for MudDataGrid.
    /// Passes all current filter values to the API.
    /// </summary>
    /// <summary>
    /// Server-side data loading callback for MudDataGrid.
    /// GridState contains page, pageSize, sort definitions.
    /// Column-level filters from FilterMode.ColumnFilterRow are handled client-side by MudDataGrid
    /// (after server returns data), while toolbar filters are sent to the API.
    /// </summary>
    private async Task<GridData<InvoiceDto>> LoadServerData(GridState<InvoiceDto> state)
    {
        _loading = true;
        _loadFailed = false;
        StateHasChanged();

        try
        {
            // Extract sort info from GridState — MudDataGrid uses SortDefinitions collection
            string? sortBy = null;
            string sortDirection = "desc";
            var sortDef = state.SortDefinitions.FirstOrDefault();
            if (sortDef != null)
            {
                sortBy = sortDef.SortBy;
                sortDirection = sortDef.Descending ? "desc" : "asc";
            }

            // Date column filters — read structured DateFilterValue out of the GridState
            // and forward as named API parameters. Each tuple is (From, To); both null = no filter.
            var (issueFrom, issueTo) = state.GetDateRange("IssueDate");
            var (dueFrom, dueTo) = state.GetDateRange("DueDate");
            var (taxableFrom, taxableTo) = state.GetDateRange("TaxableSupplyDate");

            // Column filters (ColumnFilterRow) — one line per filterable column.
            var documentNumberFilter = state.GetStringFilter("DocumentNumber");
            var clientNameFilter = state.GetStringFilter("ClientName");
            var statusFilter = state.GetEnumFilter<InvoiceDto, EInvoiceStatus>("Status");

            var result = await InvoiceService.GetPagedAsync(
                page: state.Page + 1,
                pageSize: state.PageSize,
                search: _searchString,
                sortBy: sortBy,
                sortDirection: sortDirection,
                documentNumber: documentNumberFilter,
                clientName: clientNameFilter,
                status: statusFilter,
                documentType: _filterDocumentType,
                issueDateFrom: issueFrom,
                issueDateTo: issueTo,
                dueDateFrom: dueFrom,
                dueDateTo: dueTo,
                taxableSupplyDateFrom: taxableFrom,
                taxableSupplyDateTo: taxableTo, throwOnError: true);

            return new GridData<InvoiceDto>
            {
                Items = result.Items,
                TotalItems = result.TotalCount
            };
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            Snackbar.Add(L["Common_LoadFailed"], Severity.Error);
            return new GridData<InvoiceDto> { Items = new List<InvoiceDto>(), TotalItems = 0 };
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

