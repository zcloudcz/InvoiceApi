    // --- Helpers ---

    /// <summary>
    /// A document is overdue when it is still (partly) unpaid - issued/approved or partially
    /// paid - and its due date has passed. Drafts, paid and deleted documents never are.
    /// </summary>
    private static bool IsOverdue(InvoiceDto invoice) =>
        invoice.Status is EInvoiceStatus.Completed or EInvoiceStatus.PartiallyPaid
        && invoice.DueDate < DateTime.UtcNow;

    // --- Attachments (received invoices) ---

    /// <summary>
    /// Downloads attachments of one invoice from the grid row.
    /// One attachment: direct download with the original file name and type.
    /// Multiple attachments: one ZIP named by the invoice document number.
    /// </summary>
    private async Task DownloadAttachments(InvoiceDto invoice)
    {
        _downloadingAttachments = true;
        try
        {
            if (invoice.AttachmentCount == 1)
            {
                // Single file: fetch metadata to get the id + original name, then
                // reuse the single-download endpoint (no pointless ZIP wrapping).
                var attachments = await FileAttachmentService.GetByEntityAsync(_policy.AttachmentEntityName, invoice.Id);
                var single = attachments.FirstOrDefault();
                if (single is null)
                {
                    Snackbar.Add(L["ReceivedInvoice_NoAttachments"].Value, Severity.Warning);
                    return;
                }

                var bytes = await FileAttachmentService.DownloadAsync(single.Id);
                if (bytes is null) return;

                await JS.InvokeVoidAsync("downloadFile",
                    single.OriginalFileName, Convert.ToBase64String(bytes), single.ContentType);
            }
            else
            {
                var zipBytes = await FileAttachmentService.DownloadAllAsync(_policy.AttachmentEntityName, invoice.Id);
                if (zipBytes is null) return;

                var zipName = $"Prilohy_{invoice.DocumentNumber ?? invoice.Id.ToString()}.zip";
                await JS.InvokeVoidAsync("downloadFile",
                    zipName, Convert.ToBase64String(zipBytes), "application/zip");
            }
        }
        catch (ApiException)
        {
            // 404 - attachments disappeared between grid load and click
            Snackbar.Add(L["ReceivedInvoice_NoAttachments"].Value, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _downloadingAttachments = false;
        }
    }

    /// <summary>
    /// Bulk downloads attachments of all selected invoices as one ZIP
    /// (folder per invoice). Invoices without attachments are skipped.
    /// </summary>
    private async Task BulkDownloadAttachments()
    {
        var eligible = _selectedInvoices.Where(i => i.AttachmentCount > 0).ToList();
        if (eligible.Count == 0)
        {
            Snackbar.Add(L["Bulk_NoneEligible"].Value, Severity.Warning);
            return;
        }

        _bulkProcessing = true;
        StateHasChanged();
        try
        {
            var zipBytes = await InvoiceService.BulkDownloadReceivedAttachmentsAsync(eligible.Select(i => i.Id));
            if (zipBytes is not null)
            {
                await JS.InvokeVoidAsync("downloadFile",
                    $"Prilohy_{DateTime.Now:yyyyMMdd}.zip", Convert.ToBase64String(zipBytes), "application/zip");
            }
        }
        catch (ApiException)
        {
            Snackbar.Add(L["ReceivedInvoice_NoAttachments"].Value, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _bulkProcessing = false;
        }
    }

    /// <summary>
    /// Returns a background-color CSS style for the row based on the client's display color.
    /// Uses low opacity (15%) so the text remains readable over the tinted background.
    /// </summary>
    /// <summary>
    /// Returns a background-color CSS style for the row based on the client's display color.
    /// Converts hex color to rgba with low opacity so text remains readable.
    /// Uses !important to override MudBlazor's striped row styling.
    /// </summary>
    /// <summary>
    /// Row style function for MudDataGrid — combines cursor pointer + client color highlighting.
    /// MudDataGrid RowStyleFunc signature: (InvoiceDto item, int index) → string.
    /// </summary>
    private string DataGridRowStyle(InvoiceDto item, int index)
    {
        var style = "cursor: pointer;";
        if (!string.IsNullOrEmpty(item.ClientColor))
            style += $" background-color: {HexToRgba(item.ClientColor, 0.12)} !important;";
        return style;
    }

    private string GetClientRowStyle(InvoiceDto invoice)
    {
        if (string.IsNullOrEmpty(invoice.ClientColor)) return "";
        return $"background-color: {HexToRgba(invoice.ClientColor, 0.12)} !important;";
    }

    /// <summary>
    /// Converts a CSS hex color (e.g., "#FF5722") to rgba with given opacity.
    /// </summary>
    private static string HexToRgba(string hex, double opacity)
    {
        hex = hex.TrimStart('#');
        if (hex.Length < 6) return $"rgba(0,0,0,{opacity})";
        var r = Convert.ToInt32(hex[..2], 16);
        var g = Convert.ToInt32(hex[2..4], 16);
        var b = Convert.ToInt32(hex[4..6], 16);
        return $"rgba({r},{g},{b},{opacity})";
    }
}
