@page "/invoices"
@page "/received-invoices"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@using Fakvio.Contracts.Dto.Invoice
@using Fakvio.Contracts.Dto.Client
@using Fakvio.Contracts.Dto.InvoiceTemplate
@using Fakvio.Contracts.Common.Pagination
@using Fakvio.Contracts.Dto.ContentTemplate
@using Fakvio.Contracts.Dto.Alert
@using Fakvio.Domain.Enums
@using Fakvio.UI.Shared.Models
@inject FakvioService InvoiceService
@inject FileAttachmentApiService FileAttachmentService
@inject ClientApiService ClientService
@inject InvoiceTemplateApiService TemplateService
@inject ContentTemplateApiService ContentTemplateService
@inject AlertApiService AlertService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L

@* One grid for issued documents (/invoices) and received invoices (/received-invoices).
   Every difference between the document types comes from DocumentTypeUiPolicy (_policy). *@
<PageTitle>@PageHeading</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@PageHeading</MudText>
@if (PageSubtitle != null)
{
    <MudText Class="mb-4">@PageSubtitle</MudText>
}

<MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Class="mb-4"
           StartIcon="@Icons.Material.Filled.Download" OnClick="OpenAccountingExportDialog">
    @L["AccountingExport_Open"]
</MudButton>

@* Bulk operations toolbar — visible only when multi-select has items checked *@
@if (_selectedInvoices.Count > 0)
{
    <MudPaper Class="pa-3 mb-2 d-flex flex-wrap align-center gap-2" Elevation="2" Style="background-color: var(--mud-palette-info-lighten);">
        <MudChip T="string" Color="Color.Info" Size="Size.Small">@_selectedInvoices.Count @L["Bulk_Selected"]</MudChip>
        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Send" OnClick="BulkComplete"
                   Disabled="_bulkProcessing">@L[_policy.BulkCompleteLabelKey]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Check" OnClick="BulkMarkPaid"
                   Disabled="_bulkProcessing">@L["Bulk_MarkPaid"]</MudButton>
        @if (_policy.SupportsPdf)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="BulkPdf"
                       Disabled="_bulkProcessing">@L["Bulk_Pdf"]</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Download" OnClick="BulkIsdoc"
                   Disabled="_bulkProcessing">@L["Bulk_Isdoc"]</MudButton>
        @* Shown for every issued type (also Proforma, as before); BulkUbl itself reports "none eligible" there. *@
        @if (!_policy.IsReceived)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Download" OnClick="BulkUbl"
                       Disabled="_bulkProcessing">@L["Bulk_Ubl"]</MudButton>
        }
        @if (_policy.SupportsEmail)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Email" OnClick="BulkEmail"
                       Disabled="_bulkProcessing">@L["Bulk_Email"]</MudButton>
        }
        @if (_policy.SupportsBulkAttachmentDownload)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Download" OnClick="BulkDownloadAttachments"
                       Disabled="_bulkProcessing">@L["ReceivedInvoice_DownloadAttachments"]</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Delete" OnClick="BulkDelete"
                   Disabled="_bulkProcessing">@L["Bulk_Delete"]</MudButton>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearSelection">@L["Bulk_ClearSelection"]</MudButton>
        @if (_bulkProcessing)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
        }
    </MudPaper>
}

@* FakvioGrid = universal grid wrapper (see DEVGUIDE 7.10) *@
<FakvioGrid T="InvoiceDto"
            @key="_policy.GridKey"
            GridKey="@_policy.GridKey"
            ServerData="LoadServerData"
            @ref="_dataGrid"
            Loading="@_loading"
            MultiSelection="true"
            SelectedItems="_selectedInvoices"
            SelectedItemsChanged="@(items => { _selectedInvoices = items; StateHasChanged(); })"
            RowClick="@(args => OnInvoiceRowClick(args.Item))"
            RowStyleFunc="@DataGridRowStyle">
    <ToolBarContent>
        @* Global search field — searches across document number, client name, notes *@
        <MudTextField @bind-Value="_searchString" Placeholder="@L["Invoice_SearchPlaceholder"].Value"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium" Class="mt-0" Immediate="true"
                      DebounceInterval="300" OnDebounceIntervalElapsed="SearchInvoices" />
        <MudSpacer />
        @* Split button: Primary click = new document, dropdown = from template/import *@
        <MudButtonGroup OverrideStyles="false">
            @* ResponsiveButton: collapses to icon-only "+" on phones *@
            <ResponsiveButton Label="@NewButtonLabel"
                              StartIcon="@Icons.Material.Filled.Add"
                              OnClick="@NavigateToCreate" />
            <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown"
                     Variant="Variant.Filled" Color="Color.Primary">
                @if (_policy.SupportsTemplates)
                {
                    <MudMenuItem OnClick="OpenFromTemplateDialog"
                                 Icon="@Icons.Material.Filled.ContentPaste">
                        @L["Invoice_NewFromTemplate"]
                    </MudMenuItem>
                }
                <MudMenuItem OnClick="@(() => Navigation.NavigateTo(_policy.ImportUrl))"
                             Icon="@Icons.Material.Filled.UploadFile">
                    @L["Nav_ImportInvoices"]
                </MudMenuItem>
            </MudMenu>
        </MudButtonGroup>
    </ToolBarContent>
    <Columns>
        @* Checkbox column for bulk selection — required in MudBlazor v8 MudDataGrid *@
        <SelectColumn T="InvoiceDto" />

        @* Document number — sortable, filterable *@
        <PropertyColumn Property="x => x.DocumentNumber" Title="@L["Table_Number"].Value" SortBy="x => x.DocumentNumber">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Description">
                    @* A received draft may not have the supplier's number yet. *@
                    @(context.Item.DocumentNumber ?? "-")
                </MudChip>
            </CellTemplate>
        </PropertyColumn>

        @* Client name — sortable, filterable *@
        <PropertyColumn Property="x => x.ClientName" Title="@L[_policy.CounterpartyLabelKey].Value" />

        @* Issue date — sortable, filterable *@
        <PropertyColumn Property="x => x.IssueDate" Title="@L["Table_IssueDate"].Value" HideSmall="true"
                        Format="d">
            <FilterTemplate>
                <DateColumnFilter T="InvoiceDto" Context="context" ValueFunc="x => x.IssueDate" FilterKey="IssueDate" />
            </FilterTemplate>
        </PropertyColumn>

        @* Taxable supply date (DUZP) — only visible when issuer is VAT payer *@
        @if (_issuerIsVatPayer)
        {
            <PropertyColumn Property="x => x.TaxableSupplyDate" Title="@L["Invoice_TaxableSupplyDate"].Value" HideSmall="true"
                            Format="d">
                <FilterTemplate>
                    <DateColumnFilter T="InvoiceDto" Context="context" ValueFunc="x => x.TaxableSupplyDate" FilterKey="TaxableSupplyDate" />
                </FilterTemplate>
            </PropertyColumn>
        }

        @* Due date — sortable, filterable *@
        <PropertyColumn Property="x => x.DueDate" Title="@L["Table_DueDate"].Value" HideSmall="true"
                        Format="d">
            <FilterTemplate>
                <DateColumnFilter T="InvoiceDto" Context="context" ValueFunc="x => x.DueDate" FilterKey="DueDate" />
            </FilterTemplate>
            @* Overdue = still unpaid (issued/approved or partially paid) and past its due date. *@
            <CellTemplate>
                @if (context.Item.DueDate.HasValue)
                {
                    <MudText Color="@(IsOverdue(context.Item) ? Color.Error : Color.Default)">
                        @context.Item.DueDate.Value.ToString("d")
                    </MudText>
                }
            </CellTemplate>
        </PropertyColumn>

        @* Total with VAT — sortable, filterable *@
        <PropertyColumn Property="x => x.TotalWithVat" Title="@L["Invoice_TotalWithVat"].Value"
                        SortBy="x => x.TotalWithVat" Filterable="false">
            <CellTemplate>
                <strong>@context.Item.TotalWithVat.ToString("N2") @context.Item.CurrencyCode</strong>
            </CellTemplate>
        </PropertyColumn>

        @* Status — filterable chip *@
        <PropertyColumn Property="x => x.Status" Title="@L["Label_Status"].Value" Filterable="true">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@DocumentTypeUiPolicy.StatusColor(context.Item.Status)">
                    @L[_policy.StatusLabelKey(context.Item.Status)]
                </MudChip>
            </CellTemplate>
        </PropertyColumn>

        @* Alert indicator — shown when the invoice has an open (unresolved) alert *@
        @if (_policy.ShowsAlertColumn)
        {
            <TemplateColumn T="InvoiceDto" Title="" Sortable="false" Filterable="false" HeaderStyle="width:32px;">
                <CellTemplate>
                    @if (_alertedInvoiceIds.Contains(context.Item.Id))
                    {
                        <MudTooltip Text="@L["Alert_Tooltip"].Value">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
        }

        @* Email sent indicator *@
        @if (_policy.ShowsEmailSentColumn)
        {
            <TemplateColumn T="InvoiceDto" Title="@L["Invoice_EmailColumn"].Value" HideSmall="true" Sortable="false" Filterable="false">
                <CellTemplate>
                    @if (context.Item.IsSentByEmail)
                    {
                        <MudTooltip Text="@context.Item.LastSentByEmailAt?.ToString("g")">
                            <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Color="Color.Success" Size="Size.Small" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudText Color="Color.Secondary">—</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
        }

        @* Attachments column (received invoices) - one file downloads directly, several as a ZIP *@
        @if (_policy.ShowsAttachmentsColumn)
        {
            <TemplateColumn T="InvoiceDto" Title="@L["ReceivedInvoice_Attachments"].Value"
                            Sortable="false" Filterable="false" CellStyle="white-space:nowrap;">
                <CellTemplate>
                    @if (context.Item.AttachmentCount > 0)
                    {
                        <MudBadge Content="@context.Item.AttachmentCount" Color="Color.Info"
                                  Overlap="true" Bordered="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Download"
                                           Size="Size.Small"
                                           title="@L["ReceivedInvoice_DownloadAttachments"]"
                                           Disabled="_downloadingAttachments"
                                           OnClick="@(() => DownloadAttachments(context.Item))" />
                        </MudBadge>
                    }
                </CellTemplate>
            </TemplateColumn>
        }

        @* Row actions column — conditional buttons based on invoice status *@
        <TemplateColumn T="InvoiceDto" Title="@L["Label_Actions"].Value" Sortable="false" Filterable="false"
                        CellStyle="white-space:nowrap;">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Info"
                               OnClick="@(() => Navigation.NavigateTo(_policy.DetailUrl(context.Item.Id)))" title="@L["Btn_View"].Value" />
                @if (_policy.CanComplete(context.Item.Status))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Small" Color="Color.Success"
                                   OnClick="@(() => IssueInvoice(context.Item.Id))" title="@L[_policy.CompleteLabelKey].Value" />
                }
                @* Quick delete is Draft-only for every type; other statuses go through the detail page or bulk delete. *@
                @if (context.Item.Status == EInvoiceStatus.Draft)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => DeleteInvoice(context.Item.Id))" title="@L["Btn_Delete"].Value" />
                }
                @if (_policy.CanMarkPaid(context.Item.Status))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                   OnClick="@(() => MarkAsPaid(context.Item.Id))" title="@L["Invoice_MarkAsPaid"].Value" />
                }
                @if (_policy.CanRestore(context.Item.Status))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.RestoreFromTrash" Size="Size.Small" Color="Color.Warning"
                                   OnClick="@(() => RestoreInvoice(context.Item.Id))" title="@L["Invoice_Restore"].Value" />
                }
                @if (_policy.SupportsPdf)
                {
                    <MudMenu Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" Color="Color.Secondary"
                             title="@L["Invoice_DownloadPdf"].Value" Dense="true">
                        <MudMenuItem OnClick="@(() => DownloadPdf(context.Item))">@L["Pdf_DefaultTemplate"]</MudMenuItem>
                        @foreach (var tmpl in _pdfTemplates)
                        {
                            <MudMenuItem OnClick="@(() => DownloadPdfWithTemplate(context.Item, tmpl.Id))">@tmpl.Name</MudMenuItem>
                        }
                    </MudMenu>
                }
                @if (_policy.SupportsEmail)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Tertiary"
                                   OnClick="@(() => OpenEmailDialog(context.Item))" title="@L["Invoice_SendByEmail"].Value" />
                }
                @* Copy icon - duplicates the invoice as a new Draft.
                   Hidden when the type does not support copy (CreditNote, received)
                   and for Deleted invoices (must be restored first). *@
                @if (_policy.SupportsCopy && context.Item.Status != EInvoiceStatus.Deleted)
                {
                    <MudTooltip Text="@L["Invoice_Copy"].Value">
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => CopyInvoice(context.Item.Id))" />
                    </MudTooltip>
                }
                @* Three-dot menu for secondary actions — currently holds "Create from template"
                   so it is discoverable but does not clutter the primary action row. *@
                @if (_policy.SupportsTemplates)
                {
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Color="Color.Default"
                             title="@L["Label_Actions"].Value" Dense="true">
                        <MudMenuItem OnClick="@(() => OpenCreateTemplateDialog(context.Item))"
                                     Icon="@Icons.Material.Filled.BookmarkAdd">
                            @L["Invoice_CreateFromTemplate"]
                        </MudMenuItem>
                    </MudMenu>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        @if (_loadFailed)
        {
            <MudAlert Severity="Severity.Error">@L["Common_LoadFailed"]
                <MudButton OnClick="SearchInvoices">@L["Common_Retry"]</MudButton>
            </MudAlert>
        }
        else if (!_loading) { <MudAlert Severity="Severity.Info">@L["Invoice_NoRecords"]</MudAlert> }
    </NoRecordsContent>
</FakvioGrid>

@* Template creation dialog - create a reusable template from an existing invoice (small popup) *@
<MudDialog @bind-Visible="_showCreateTemplateDialog" Options="_templateDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Invoice_CreateFromTemplate"]</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedInvoice != null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                @L["Invoice_CreatingTemplate"] <strong>@_selectedInvoice.DocumentNumber</strong>
            </MudAlert>
            <MudTextField @bind-Value="_templateName" Label="@L["Invoice_TemplateName"].Value"
                          Required="true" MaxLength="200" Class="mb-3"
                          HelperText="@L["Invoice_TemplateNameHelper"].Value" />
            <MudTextField @bind-Value="_templateDescription" Label="@L["Label_Description"].Value"
                          Lines="3" MaxLength="2000" Class="mb-3"
                          HelperText="@L["Invoice_TemplateDescHelper"].Value" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseCreateTemplateDialog">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateTemplate"
                   Disabled="@string.IsNullOrWhiteSpace(_templateName)">
            @L["Invoice_CreateTemplate"]
        </MudButton>
    </DialogActions>
</MudDialog>

@* "Create Invoice from Template" dialog — simplified: pick template + client, then open detail in edit mode *@
<MudDialog @bind-Visible="_showFromTemplateDialog" Options="_fromTemplateDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Invoice_NewFromTemplate"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_fromTemplateForm" @bind-IsValid="_fromTemplateFormValid">
            @* Template selector — reactive: auto-fills client from template's default ClientId *@
            <MudSelect Value="_selectedTemplateId"
                       ValueChanged="@((long v) => OnTemplateSelected(v))"
                       Label="@L["Invoice_SelectTemplate"].Value"
                       Required="true" Class="mb-3">
                @foreach (var tmpl in _templates)
                {
                    <MudSelectItem Value="@tmpl.Id">@tmpl.Name</MudSelectItem>
                }
            </MudSelect>
            @* Client selector — required, pre-filled if template has a default client *@
            <MudSelect @bind-Value="_fromTemplateDto.ClientId" Label="@L["Invoice_Client"].Value"
                       Required="true" Class="mb-3">
                @foreach (var client in _allClients)
                {
                    <MudSelectItem Value="@client.Id">@client.CompanyName</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseFromTemplateDialog">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateInvoiceFromTemplate"
                   Disabled="@(!_fromTemplateFormValid || _selectedTemplateId <= 0)">
            @L["Btn_Create"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// Query parameter — controls which document type is shown:
    ///   ?type=CreditNote           → Dobropisy
    ///   ?type=Proforma             → Zálohové faktury (proformy)
    ///   ?type=TaxReceiptForAdvance → Daňové doklady o přijaté platbě
    ///   (no param)                 → Standardní faktury (Invoice)
    /// </summary>
    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeFilter { get; set; }

    private FakvioGrid<InvoiceDto>? _dataGrid;
    private bool _loading = false;
    private bool _loadFailed;

    // Everything that differs per document type (texts, urls, which buttons exist) comes from this policy.
    // It is re-resolved from the url whenever the route changes (see ApplyRouteAsync).
    private DocumentTypeUiPolicy _policy = DocumentTypeUiPolicy.For(EDocumentType.Invoice);

    // Computed page labels - resolved from localization via the policy's resource keys
    private string PageHeading => L[_policy.ListTitleKey].Value;

    // Received invoices have no subtitle (null key)
    private string? PageSubtitle => _policy.ListSubtitleKey is { } key ? L[key].Value : null;

    private string NewButtonLabel => L[_policy.NewLabelKey].Value;

    /// <summary>
    /// Navigates to the create page of the current document type.
    /// Standard Invoice has no param (keeps backward compat with existing links/bookmarks).
    /// </summary>
    private void NavigateToCreate() => Navigation.NavigateTo(_policy.CreateUrl);

    // Whether the issuer (logged-in company) is a VAT payer — controls DUZP column visibility
    private bool _issuerIsVatPayer = false;

    // Filter state — only global search remains, column filters are handled by MudDataGrid client-side
    private string _searchString = "";
    // Document type is set automatically from URL query param — not user-selectable
    private EDocumentType? _filterDocumentType = null;

    // Reference data — clients used for "Create from template" dialog
    private List<ClientDto> _allClients = new();

    // PDF template list — loaded once, used for the PDF template picker menu
    private List<ContentTemplateDto> _pdfTemplates = new();

    // Multi-select state for bulk operations
    private HashSet<InvoiceDto> _selectedInvoices = new();
    private bool _bulkProcessing = false;

    // True while a single-row attachment download runs (disables the download buttons)
    private bool _downloadingAttachments;

    // Template dialog state (small popup — stays as dialog)
    private bool _showCreateTemplateDialog = false;
    private InvoiceDto? _selectedInvoice;
    private string _templateName = "";
    private string? _templateDescription;

    // "Create from Template" dialog state — simplified to template + client selection only
    private bool _showFromTemplateDialog = false;
    private bool _fromTemplateFormValid = false;
    private MudForm? _fromTemplateForm;
    private List<InvoiceTemplateDto> _templates = new();
    private long _selectedTemplateId = 0;
    private CreateInvoiceFromTemplateDto _fromTemplateDto = new();

    // Dialog options for small popups (template creation)
    private DialogOptions _templateDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
    private DialogOptions _fromTemplateDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

    // IDs of invoices that have at least one open alert — used to show the warning icon in the grid.
    // Loaded once on init; refreshes if the user resolves an alert from InvoiceDetail.
    private HashSet<long> _alertedInvoiceIds = [];

    protected override async Task OnInitializedAsync()
    {
        // Load clients, templates, PDF templates, issuer info, and alert IDs in parallel.
        // None of these depend on the document type, so they are loaded once per component
        // instance. The type filter itself is resolved in OnParametersSetAsync below.
        //
        // The document type MUST be resolved before the first await: Blazor renders the page at
        // that await, the grid mounts and immediately asks for its first page. With the type
        // still unknown that request went out without a DocumentType and the grid showed every
        // issued type mixed together. A non-list url (only possible in tests) = plain invoices.
        var uri = new Uri(Navigation.Uri);
        _policy = DocumentTypeUiPolicy.ForListRoute(uri.AbsolutePath, TypeFromQuery(uri))
                  ?? DocumentTypeUiPolicy.For(EDocumentType.Invoice);
        _filterDocumentType = _policy.Type;

        // Navigating /invoices <-> /received-invoices (or between ?type= values) reuses this
        // component instance and may not re-run OnParametersSet (no parameter value changes when
        // only the path differs), so the location itself is observed too. Subscribed before the
        // first await so Dispose() always finds the handler it has to remove.
        Navigation.LocationChanged += OnLocationChanged;

        await Task.WhenAll(
            LoadClients(), LoadTemplates(), LoadPdfTemplates(), LoadIssuerAsync(), LoadAlertedIdsAsync());
    }

    private static string? TypeFromQuery(Uri uri) => System.Web.HttpUtility.ParseQueryString(uri.Query)["type"];

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Read the query ourselves: the [SupplyParameterFromQuery] value may not be updated yet.
        var type = TypeFromQuery(new Uri(Navigation.Uri));
        _ = InvokeAsync(async () =>
        {
            await ApplyRouteAsync(type);
            StateHasChanged();
        });
    }

    /// <summary>
    /// Resolves the document type (and with it the whole UI policy) from the URL.
    ///
    /// WHY here and not in OnInitializedAsync: /invoices, /invoices?type=Proforma, /invoices?type=CreditNote
    /// and /received-invoices all share this component, so navigating between them does NOT
    /// create a new instance - Blazor only re-runs the parameter lifecycle. Resolving the filter on
    /// init therefore left the grid showing the previously selected type until the user pressed F5
    /// (issue #376).
    ///
    /// OnParametersSetAsync also runs before the first render, so the initial page load
    /// is covered by the same code path.
    /// </summary>
    protected override Task OnParametersSetAsync() => ApplyRouteAsync(TypeFilter);

    private async Task ApplyRouteAsync(string? typeFilter)
    {
        // null = the location is not a list route (we are being navigated away from): ignore it.
        var policy = DocumentTypeUiPolicy.ForListRoute(new Uri(Navigation.Uri).AbsolutePath, typeFilter);

        // Parameters are set on every re-render, not just when the URL changes - reload
        // only when the type actually differs, otherwise every render would refetch.
        if (policy is null || policy.Type == _filterDocumentType)
            return;

        var sideChanged = policy.IsReceived != _policy.IsReceived;

        _policy = policy;
        _filterDocumentType = policy.Type;

        // The selection belongs to the previous view (other type, other bulk rules).
        _selectedInvoices = new HashSet<InvoiceDto>();

        // Started first, awaited last: the rows must not wait for the PDF template list.
        var pdfTemplates = LoadPdfTemplates();

        // When the side changes, the grid gets a new @key (issued and received grids keep
        // separate column state), so the NEW grid instance loads by itself; reloading the old
        // one would only fire a request with the old settings.
        if (!sideChanged && _dataGrid != null)
            await _dataGrid.ReloadAsync();

        await pdfTemplates;
    }

    /// <summary>
    /// Loads the set of invoice IDs that have at least one unresolved alert.
    /// Used to show a warning icon on the corresponding grid rows.
    /// Non-blocking — an empty set means no icons are shown.
    /// </summary>
    private async Task LoadAlertedIdsAsync()
    {
        try
        {
            var alerts = await AlertService.GetAlertsAsync(unresolvedOnly: true);
            _alertedInvoiceIds = alerts
                .Where(a => a.RelatedEntityType == "Invoice")
                .Select(a => a.RelatedEntityId)
