    // --- "Create Invoice from Template" dialog ---

    /// <summary>
    /// Handles template selection in the "New from Template" dialog.
    /// When a template is selected, auto-fills the client dropdown if the template
    /// has a default ClientId configured — saves the user one click.
    /// </summary>
    private void OnTemplateSelected(long templateId)
    {
        _selectedTemplateId = templateId;

        // Pre-fill client from template's default ClientId if available
        var template = _templates.FirstOrDefault(t => t.Id == templateId);
        if (template?.ClientId is > 0)
        {
            _fromTemplateDto.ClientId = template.ClientId.Value;
        }
    }

    /// <summary>
    /// Opens the "Create from Template" dialog — resets form state and shows the dialog.
    /// Simplified: only template + client selection, dates default on the backend.
    /// </summary>
    private void OpenFromTemplateDialog()
    {
        _selectedTemplateId = 0;
        _fromTemplateDto = new CreateInvoiceFromTemplateDto();
        _showFromTemplateDialog = true;
    }

    private void CloseFromTemplateDialog()
    {
        _showFromTemplateDialog = false;
    }

    /// <summary>
    /// Navigates to the create page with template + client as query params.
    /// No DB record is created — the create form loads the template data and pre-fills the fields.
    /// The invoice is only saved when the user clicks Save on the detail page.
    /// </summary>
    private void CreateInvoiceFromTemplate()
    {
        if (_selectedTemplateId <= 0 || _fromTemplateDto.ClientId <= 0) return;

        CloseFromTemplateDialog();

        // Navigate to create page with template and client pre-filled via query params
        Navigation.NavigateTo(
            $"/invoices/create?templateId={_selectedTemplateId}&clientId={_fromTemplateDto.ClientId}");
    }

    // --- PDF with template selection ---

    /// <summary>
    /// Downloads the invoice PDF using a specific content template ID.
    /// Called from the PDF template picker menu in the row actions.
    /// </summary>
    private async Task DownloadPdfWithTemplate(InvoiceDto invoice, long templateId)
    {
        try
        {
            var pdfBytes = await InvoiceService.ExportToPdfAsync(invoice.Id, templateId);
            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                var base64 = Convert.ToBase64String(pdfBytes);
                // Use localized file name prefix based on document type (Invoice vs CreditNote)
                var prefix = invoice.DocumentType == EDocumentType.CreditNote
                    ? L["FileName_CreditNote"].Value : L["FileName_Invoice"].Value;
                var fileName = $"{prefix}_{invoice.DocumentNumber ?? invoice.Id.ToString()}.pdf";
                await JS.InvokeVoidAsync("downloadFile", fileName, base64, "application/pdf");
                Snackbar.Add(L["Invoice_PdfDownloaded"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Invoice_PdfFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error downloading PDF: {ex.Message}", Severity.Error); }
    }

    // --- Bulk operations ---

    /// <summary>
    /// Clears the multi-select checkbox selection and hides the bulk toolbar.
    /// </summary>
    private void ClearSelection()
    {
        _selectedInvoices = new HashSet<InvoiceDto>();
        StateHasChanged();
    }

    /// <summary>
    /// Bulk completes (issues) all selected Draft invoices.
    /// Filters eligible invoices first, shows confirmation, then processes.
    /// </summary>
    private async Task BulkIssue()
    {
        var eligible = _selectedInvoices.Where(i => i.Status == EInvoiceStatus.Draft).ToList();
        if (eligible.Count == 0)
        {
            Snackbar.Add(L["Bulk_NoneEligible"].Value, Severity.Warning);
            return;
        }

        // Confirm action with user
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            string.Format(L["Bulk_ConfirmIssue"].Value, eligible.Count));
        if (!confirmed) return;

        _bulkProcessing = true;
        StateHasChanged();
        try
        {
            var result = await InvoiceService.BulkCompleteAsync(eligible.Select(i => i.Id).ToList());
            ShowBulkResult(result);
            ClearSelection();
            await SearchInvoices();
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
        finally { _bulkProcessing = false; }
    }

    /// <summary>
    /// Bulk marks all selected Completed invoices as paid.
    /// </summary>
    private async Task BulkMarkPaid()
    {
        var eligible = _selectedInvoices.Where(i => i.Status == EInvoiceStatus.Completed).ToList();
        if (eligible.Count == 0)
        {
            Snackbar.Add(L["Bulk_NoneEligible"].Value, Severity.Warning);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            string.Format(L["Bulk_ConfirmPaid"].Value, eligible.Count));
        if (!confirmed) return;

        _bulkProcessing = true;
        StateHasChanged();
        try
        {
            var result = await InvoiceService.BulkMarkAsPaidAsync(eligible.Select(i => i.Id).ToList());
            ShowBulkResult(result);
            ClearSelection();
            await SearchInvoices();
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
        finally { _bulkProcessing = false; }
    }

    /// <summary>
    /// Bulk deletes selected invoices (soft delete).
    /// Draft invoices can always be deleted. Completed invoices are sent to the server
    /// which checks if they are the last in the numbering sequence — the server decides.
    /// Paid and Creditnoted invoices are filtered out on the client side.
    /// </summary>
    private async Task BulkDelete()
    {
        var eligible = _selectedInvoices
            .Where(i => i.Status == EInvoiceStatus.Draft || i.Status == EInvoiceStatus.Completed)
            .ToList();
        if (eligible.Count == 0)
        {
            Snackbar.Add(L["Bulk_NoneEligible"].Value, Severity.Warning);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            string.Format(L["Bulk_ConfirmDelete"].Value, eligible.Count));
        if (!confirmed) return;

        _bulkProcessing = true;
        StateHasChanged();
        try
        {
            var result = await InvoiceService.BulkDeleteAsync(eligible.Select(i => i.Id).ToList());
            ShowBulkResult(result);
            ClearSelection();
            await SearchInvoices();
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
        finally { _bulkProcessing = false; }
    }

    /// <summary>
    /// Bulk sends email for all selected invoices.
    /// Uses the default client email address for each invoice.
    /// </summary>
    private async Task BulkEmail()
    {
        if (_selectedInvoices.Count == 0) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            string.Format(L["Bulk_ConfirmEmail"].Value, _selectedInvoices.Count));
        if (!confirmed) return;

        _bulkProcessing = true;
        StateHasChanged();
        try
        {
            var result = await InvoiceService.BulkSendEmailAsync(_selectedInvoices.Select(i => i.Id).ToList());
            ShowBulkResult(result);
            ClearSelection();
            await SearchInvoices();
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
        finally { _bulkProcessing = false; }
    }

    /// <summary>
    /// Bulk downloads PDFs for all selected invoices as a ZIP archive.
    /// Uses JS interop to trigger the file download in the browser.
    /// </summary>
    private async Task BulkPdf()
    {
        if (_selectedInvoices.Count == 0) return;

        _bulkProcessing = true;
        StateHasChanged();
        try
        {
            // Deduplicate IDs — HashSet uses reference equality so duplicates can sneak in after table refresh
            var zipBytes = await InvoiceService.BulkExportPdfAsync(_selectedInvoices.Select(i => i.Id).Distinct().ToList());
            if (zipBytes != null && zipBytes.Length > 0)
            {
                var base64 = Convert.ToBase64String(zipBytes);
                // Use localized ZIP name based on current view (Invoices vs CreditNotes)
                var zipPrefix = _isCreditNoteView
                    ? L["FileName_CreditNotes"].Value : L["FileName_Invoices"].Value;
                var fileName = $"{zipPrefix}_{DateTime.Now:yyyyMMdd}.zip";
                await JS.InvokeVoidAsync("downloadFile", fileName, base64, "application/zip");
                Snackbar.Add(L["Bulk_Success"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Invoice_PdfFailed"].Value, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error); }
        finally { _bulkProcessing = false; }
    }

    /// <summary>
    /// Shows a snackbar message for bulk operation results.
    /// Distinguishes between full success, partial success, and complete failure.
    /// </summary>
    private void ShowBulkResult(BulkOperationResult? result)
    {
        if (result == null) return;

        if (result.FailedCount == 0)
        {
            Snackbar.Add(string.Format(L["Bulk_Success"].Value, result.SuccessCount), Severity.Success);
        }
        else if (result.SuccessCount > 0)
        {
            Snackbar.Add(string.Format(L["Bulk_PartialSuccess"].Value, result.SuccessCount, result.FailedCount), Severity.Warning);
        }
        else
        {
            Snackbar.Add(L["Bulk_NoneEligible"].Value, Severity.Error);
        }
    }

