    /// <summary>
    /// Returns a background-color CSS style for the row based on the client's display color.
    /// Uses low opacity (15%) so the text remains readable over the tinted background.
    /// </summary>
    /// <summary>
    /// Returns a background-color CSS style for the row based on the client's display color.
    /// Converts hex color to rgba with low opacity so text remains readable.
    /// Uses !important to override MudBlazor's striped row styling.
    /// </summary>
    /// <summary>
    /// Row style function for MudDataGrid — combines cursor pointer + client color highlighting.
    /// MudDataGrid RowStyleFunc signature: (InvoiceDto item, int index) → string.
    /// </summary>
    private string DataGridRowStyle(InvoiceDto item, int index)
    {
        var style = "cursor: pointer;";
        if (!string.IsNullOrEmpty(item.ClientColor))
            style += $" background-color: {HexToRgba(item.ClientColor, 0.12)} !important;";
        return style;
    }

    private string GetClientRowStyle(InvoiceDto invoice)
    {
        if (string.IsNullOrEmpty(invoice.ClientColor)) return "";
        return $"background-color: {HexToRgba(invoice.ClientColor, 0.12)} !important;";
    }

    /// <summary>
    /// Converts a CSS hex color (e.g., "#FF5722") to rgba with given opacity.
    /// </summary>
    private static string HexToRgba(string hex, double opacity)
    {
        hex = hex.TrimStart('#');
        if (hex.Length < 6) return $"rgba(0,0,0,{opacity})";
        var r = Convert.ToInt32(hex[..2], 16);
        var g = Convert.ToInt32(hex[2..4], 16);
        var b = Convert.ToInt32(hex[4..6], 16);
        return $"rgba({r},{g},{b},{opacity})";
    }
