@page "/companies"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SysAdmin")]
@using Fakvio.Contracts.Dto.Client
@using Fakvio.Contracts.Dto.CompanySettings
@inject CompanyApiService CompanyService
@inject CompanySettingsApiService SettingsService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@* Localization service for multi-language support *@
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Company_Title"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["Company_Title"]</MudText>
<MudText Class="mb-4">@L["Company_Subtitle"]</MudText>

<MudPaper Class="pa-4">
    @* Navigate to create page instead of opening a dialog *@
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Navigation.NavigateTo("/companies/create"))" Class="mb-4">
        @L["Company_New"]
    </MudButton>

    @* MudDataGrid with column filters, quick search, and inline actions *@
    <FakvioGrid T="ClientDto"
                GridKey="companies"
                @ref="_dataGrid"
                Items="@_companies"
                Loading="@_loading"
                QuickFilter="@FilterFunc"
                RowClick="@(args => Navigation.NavigateTo($"/companies/{args.Item.Id}"))">
        <ToolBarContent>
            <MudTextField @bind-Value="_searchString" Placeholder="@L["Btn_Search"].Value" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.CompanyName" Title="@L["Client_CompanyName"].Value" />
            <PropertyColumn Property="x => x.RegistrationNumber" Title="@L["Client_RegistrationNumber"].Value" />
            <PropertyColumn Property="x => x.TaxNumber" Title="@L["Client_TaxNumber"].Value">
                <CellTemplate>@(context.Item.TaxNumber ?? "—")</CellTemplate>
            </PropertyColumn>
            <TemplateColumn T="ClientDto" Title="@L["Client_City"].Value" Sortable="false">
                <CellTemplate>@(context.Item.Address.FirstOrDefault()?.City ?? "—")</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.IsVatPayer" Title="@L["Client_IsVatPayer"].Value" Filterable="false">
                <CellTemplate>
                    @if (context.Item.IsVatPayer)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.IsActive" Title="@L["Label_Status"].Value">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                        @(context.Item.IsActive ? L["Label_Active"].Value : L["Label_Inactive"].Value)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn T="ClientDto" Title="@L["TenantSettings_Provisioned"].Value" Sortable="false" Filterable="false">
                <CellTemplate>
                    @if (_settingsMap.TryGetValue(context.Item.Id, out var tenantSettings))
                    {
                        @if (tenantSettings.IsProvisioned && tenantSettings.IsActive)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["TenantSettings_Provisioned"]</MudChip>
                        }
                        else if (tenantSettings.IsProvisioned && !tenantSettings.IsActive)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["Label_Inactive"]</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["TenantSettings_NotProvisioned"]</MudChip>
                        }
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@L["TenantSettings_NoSettings"]</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            @* Actions column — edit and delete buttons, not sortable or filterable *@
            <TemplateColumn T="ClientDto" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   OnClick="@(() => Navigation.NavigateTo($"/companies/{context.Item.Id}"))" Title="@L["Btn_Edit"].Value" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(async () => await DeleteCompany(context.Item.Id))" Title="@L["Btn_Delete"].Value" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudAlert Severity="Severity.Info">@L["Company_NoRecords"]</MudAlert>
        </NoRecordsContent>
    </FakvioGrid>
</MudPaper>

@code {
    private FakvioGrid<ClientDto>? _dataGrid;
    private List<ClientDto> _companies = new();
    private Dictionary<long, CompanySystemSettingsDto> _settingsMap = new();
    private bool _loading = true;
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCompanies();
    }

    /// <summary>
    /// Loads companies and their tenant settings in parallel.
    /// Settings are stored in a dictionary for O(1) lookup by CompanyId in the grid.
    /// </summary>
    private async Task LoadCompanies()
    {
        try
        {
            _loading = true;
            var companiesTask = CompanyService.GetAllAsync();
            var settingsTask = SettingsService.GetAllSettingsAsync();
            await Task.WhenAll(companiesTask, settingsTask);

            _companies = companiesTask.Result;
            _settingsMap = settingsTask.Result.ToDictionary(s => s.CompanyId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Client-side filter function for the search bar — matches company name, registration number, trading name, or city.
    /// </summary>
    private bool FilterFunc(ClientDto company)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        var search = _searchString.ToLower();
        return company.CompanyName?.ToLower().Contains(search) == true
            || company.RegistrationNumber?.Contains(search) == true
            || company.TradingName?.ToLower().Contains(search) == true
            || company.Address.Any(a => a.City?.ToLower().Contains(search) == true);
    }

    /// <summary>
    /// Deletes a company by ID via CompanyApiService and reloads the grid.
    /// </summary>
    private async Task DeleteCompany(long id)
    {
        try
        {
            var success = await CompanyService.DeleteAsync(id);
            if (success)
            {
                Snackbar.Add(L["Msg_DeleteSuccess"].Value, Severity.Success);
                await LoadCompanies();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }
}
