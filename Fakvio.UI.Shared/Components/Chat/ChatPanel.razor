@using Fakvio.Contracts.Dto.Chat
@using Fakvio.UI.Shared.Services
@inject ChatApiService ChatApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L
@inject ILogger<ChatPanel> Logger
@inject IUiErrorHandler ErrorHandler

@*
    Main chat panel component — displayed inside the right MudDrawer in MainLayout.
    Contains:
    - Top toolbar with provider selector, conversation history toggle, and close button
    - Message area with auto-scroll
    - Input area at the bottom

    Supports both conversation list view and message view.
    Streaming responses are displayed progressively as chunks arrive.
*@

<div class="d-flex flex-column" style="height: 100%;">
    @* ─── Top toolbar ──────────────────────────────────────────────────── *@
    <MudToolBar Dense="true" Class="px-2">
        @* Toggle conversation list / messages *@
        <MudIconButton Icon="@(_showConversationList ? Icons.Material.Filled.Chat : Icons.Material.Filled.History)"
                       Size="Size.Small"
                       OnClick="@ToggleConversationList"
                       title="@(_showConversationList ? "Back to chat" : "History")" />

        <MudText Typo="Typo.subtitle2" Class="flex-grow-1 text-truncate mx-2">
            @(_currentConversation?.Title ?? L["Chat_Title"])
        </MudText>

        @* Provider selector (only if multiple providers available) *@
        @if (_providers.Count > 1)
        {
            <MudSelect T="string" Value="_selectedProvider" ValueChanged="OnProviderChanged"
                       Dense="true" Margin="Margin.Dense" Variant="Variant.Text"
                       Style="max-width: 120px;" Label="">
                @foreach (var p in _providers)
                {
                    <MudSelectItem Value="@p">@p</MudSelectItem>
                }
            </MudSelect>
        }

        @* New conversation *@
        <MudIconButton Icon="@Icons.Material.Filled.AddComment"
                       Size="Size.Small"
                       OnClick="@StartNewConversation"
                       title="@L["Chat_NewConversation"]" />

        @* Close drawer *@
        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       Size="Size.Small"
                       OnClick="@OnClose"
                       title="@L["Btn_Close"]" />
    </MudToolBar>

    <MudDivider />

    @* ─── Content area ─────────────────────────────────────────────────── *@
    @if (_showConversationList)
    {
        @* Conversation list sidebar view *@
        <ChatConversationList Conversations="@_conversations"
                              SelectedConversationId="@_currentConversation?.Id"
                              OnSelectConversation="LoadConversation"
                              OnDeleteConversation="DeleteConversation"
                              OnNewConversation="StartNewConversation" />
    }
    else
    {
        @* Messages view *@
        <div class="flex-grow-1 overflow-y-auto pa-2" @ref="_messagesContainer" id="chat-messages">
            @if (_providers.Count == 0 && !_isStreaming)
            {
                @* No AI providers configured — show setup instructions *@
                <div class="d-flex flex-column align-center justify-center pa-4" style="height: 100%;">
                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Large" Color="Color.Warning" />
                    <MudText Typo="Typo.h6" Class="mt-3" Align="Align.Center">@L["Chat_NoProviders_Title"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2" Align="Align.Center">
                        @L["Chat_NoProviders_Description"]
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-4"
                               StartIcon="@Icons.Material.Filled.Settings"
                               Href="/my-company">
                        @L["Chat_NoProviders_GoToSettings"]
                    </MudButton>
                </div>
            }
            else if (_messages.Count == 0 && !_isStreaming)
            {
                <div class="d-flex flex-column align-center justify-center" style="height: 100%; opacity: 0.5;">
                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Large" />
                    <MudText Typo="Typo.body2" Class="mt-2">@L["Chat_Placeholder"]</MudText>
                </div>
            }
            else
            {
                @foreach (var msg in _messages)
                {
                    <ChatMessageBubble Message="@msg" />
                }

                @* Streaming response in progress *@
                @if (_isStreaming)
                {
                    <div class="d-flex justify-start mb-2">
                        @* Geometry/colors come from app.css — same classes as ChatMessageBubble *@
                        <div class="chat-bubble chat-bubble-assistant">
                            <MudText Typo="Typo.caption" Class="mb-1" Style="opacity: 0.7;">
                                @L["EChatRole_Assistant"]
                            </MudText>
                            @if (string.IsNullOrEmpty(_streamingContent))
                            {
                                <MudText Typo="Typo.body2" Class="chat-bubble-text">
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    <span class="ml-2">@L["Chat_Thinking"]</span>
                                </MudText>
                            }
                            else
                            {
                                @* Rendered as markdown while streaming too, so the answer does not
                                   visually "snap" from raw asterisks to formatted text at the end. *@
                                <MarkdownView Content="@_streamingContent" />
                            }
                        </div>
                    </div>
                }
            }
        </div>

        @* ─── Input area ───────────────────────────────────────────────── *@
        <ChatInput IsDisabled="@(_isStreaming || _providers.Count == 0)"
                   IsExtracting="@_isExtractingPdf"
                   AttachedFileName="@_attachedFileName"
                   AttachedImagePreview="@_attachedImagePreview"
                   OnSend="HandleSendMessage"
                   OnFileAttached="HandleFileData"
                   OnFileRemoved="HandleFileRemoved" />
    }
</div>

@code {
    // ─── Parameters ──────────────────────────────────────────────────────

    /// <summary>
    /// Callback to close the chat drawer from MainLayout.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    // ─── State ───────────────────────────────────────────────────────────

    private List<ChatConversationListDto> _conversations = new();
    private List<ChatMessageDto> _messages = new();
    private ChatConversationDto? _currentConversation;
    private List<string> _providers = new();
    private string _selectedProvider = string.Empty;
    private bool _showConversationList;
    private bool _isStreaming;
    private string _streamingContent = string.Empty;
    private ElementReference _messagesContainer;

    // ─── Attachment state (PDF or image) ─────────────────────────────────
    private bool _isExtractingPdf;
    private string? _attachedFileName;
    private string? _attachedFileContent;

    // Image-specific state: base64 for the API and data URI for the UI preview.
    private string? _attachedImageBase64;
    private string? _attachedImagePreview;

    // ─── Lifecycle ───────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await LoadProviders();
        await LoadConversations();
    }

    // ─── Data Loading ────────────────────────────────────────────────────

    private async Task LoadProviders()
    {
        _providers = await ChatApi.GetProvidersAsync();
        if (_providers.Count > 0 && string.IsNullOrEmpty(_selectedProvider))
        {
            _selectedProvider = _providers[0];
        }
    }

    private async Task LoadConversations()
    {
        _conversations = await ChatApi.GetConversationsAsync();
    }

    private async Task LoadConversation(long conversationId)
    {
        var conversation = await ChatApi.GetConversationAsync(conversationId);
        if (conversation != null)
        {
            _currentConversation = conversation;
            _messages = conversation.Messages;
            _showConversationList = false;
            StateHasChanged();
        }
    }

    // ─── Actions ─────────────────────────────────────────────────────────

    /// <summary>
    /// Sends a user message and streams the AI response.
    /// Uses the streaming endpoint for progressive display.
    /// </summary>
    private async Task HandleSendMessage(string message)
    {
        // Add user message to the UI immediately.
        _messages.Add(new ChatMessageDto
        {
            Role = "User",
            Content = message,
            CreatedAt = DateTime.UtcNow
        });

        _isStreaming = true;
        _streamingContent = string.Empty;
        StateHasChanged();

        try
        {
            // Where the user is standing right now — the server folds it into the system prompt
            // so the assistant can resolve "tuhle fakturu" without asking which one.
            var route = ChatSituation.NormalizeRoute(Navigation.ToBaseRelativePath(Navigation.Uri));

            // Build the request — include attached PDF content or image base64 if present.
            var request = new SendMessageRequest
            {
                ConversationId = _currentConversation?.Id,
                Message = message,
                Provider = _selectedProvider,
                AttachedFileContent = _attachedFileContent,
                AttachedFileName = _attachedFileName,
                AttachedImageBase64 = _attachedImageBase64,
                CurrentRoute = route,
                OpenEntity = ChatSituation.DescribeOpenEntity(route)
            };

            // Clear all attachment state after sending — the content is now part of the request.
            _attachedFileName = null;
            _attachedFileContent = null;
            _attachedImageBase64 = null;
            _attachedImagePreview = null;

            // Stream the response — ChatStreamEvent can be text or UI action.
            ChatUiAction? pendingAction = null;

            await foreach (var evt in ChatApi.StreamMessageAsync(request))
            {
                if (evt.IsError)
                {
                    // Server-side error — display it as the assistant response so user sees it.
                    // This — not the catch below — is where SSE failures land: the API sends them
                    // as a regular {"error": …} event, ChatApiService turns it into an error event.
                    // The text is already sanitized server-side and carries the reference ID
                    // (issue #156), so rendering it verbatim is safe.
                    _streamingContent += $"\n\n**Error:** {evt.Error}";
                    StateHasChanged();
                }
                else if (evt.IsText)
                {
                    _streamingContent += evt.Text;
                    StateHasChanged();
                }
                else if (evt.IsAction)
                {
                    // Capture the UI action for execution after stream completes.
                    pendingAction = evt.Action;
                }
            }

            // If stream completed with no content at all, show a warning.
            // This happens when the AI provider fails silently or returns nothing.
            if (string.IsNullOrWhiteSpace(_streamingContent))
            {
                _streamingContent = "No response received from AI provider. Check server logs for details.";
            }

            // Streaming complete — add the final assistant message to the list.
            _messages.Add(new ChatMessageDto
            {
                Role = "Assistant",
                Content = _streamingContent,
                ProviderUsed = _selectedProvider,
                CreatedAt = DateTime.UtcNow
            });

            // Reload conversation metadata (to get the correct ConversationId for new conversations).
            await LoadConversations();

            // If this was a new conversation, find it in the list and set it as current.
            if (_currentConversation == null && _conversations.Count > 0)
            {
                var latest = _conversations[0]; // Most recent
                _currentConversation = new ChatConversationDto
                {
                    Id = latest.Id,
                    Title = latest.Title,
                    LastMessageAt = latest.LastMessageAt,
                    MessageCount = latest.MessageCount
                };
            }

            // Execute the pending UI action AFTER the stream is finalized and the UI is updated.
            // Small delay so the user can see the AI response before acting.
            if (pendingAction is { Url: not null })
            {
                StateHasChanged(); // Ensure the final message is rendered.
                await Task.Delay(800); // Let the user read the AI response.

                if (pendingAction.Type == "navigate")
                {
                    Navigation.NavigateTo(pendingAction.Url);
                }
                else if (pendingAction.Type == "download")
                {
                    // Download file via API — fetch bytes and trigger browser download via JS interop
                    await HandleDownloadActionAsync(pendingAction);
                }
            }
        }
        catch (Exception ex)
        {
            // This catch handles failures of the request itself — a non-2xx response before the
            // stream starts, a dropped connection, a JS interop error. (Errors reported *inside*
            // a running stream arrive as evt.IsError above, not here.)
            //
            // Never render ex.ToString() — it would print the whole .NET stack trace into the
            // chat bubble (issue #156). An ApiException already carries the text the API decided
            // is safe to show (it includes the reference ID for the server log); anything else is
            // a local failure the user can only react to by retrying.
            var errorText = ex is ApiException apiEx
                ? apiEx.Message
                : L["Chat_Error_Unexpected"].Value;

            // Central handler: mirrors the error to the console, forwards non-ApiException
            // errors to AppLog and shows the snackbar. See DEVGUIDE §10.4.
            ErrorHandler.Handle(ex, "ChatPanel.HandleSendMessage", errorText);

            _messages.Add(new ChatMessageDto
            {
                Role = "Assistant",
                Content = $"**{L["Msg_Error"]}:** {errorText}",
                CreatedAt = DateTime.UtcNow
            });
        }
        finally
        {
            _isStreaming = false;
            _streamingContent = string.Empty;
            StateHasChanged();
        }
    }

    // ─── File Attachment ─────────────────────────────────────────────────

    private static readonly HashSet<string> ImageExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".jpg", ".jpeg", ".png", ".gif", ".webp"
    };

    /// <summary>
    /// Receives pre-read file bytes from ChatInput.
    /// ChatInput reads bytes eagerly before any re-render to avoid stale IBrowserFile.
    /// Routes to PDF extraction or image base64 encoding based on extension.
    /// </summary>
    private async Task HandleFileData((string FileName, byte[] Bytes) fileData)
    {
        var extension = Path.GetExtension(fileData.FileName)?.ToLowerInvariant();

        if (extension == ".pdf")
        {
            await HandlePdfBytes(fileData.FileName, fileData.Bytes);
        }
        else if (extension != null && ImageExtensions.Contains(extension))
        {
            HandleImageBytes(fileData.FileName, fileData.Bytes, extension);
        }
        else
        {
            Logger.LogWarning("Unsupported file type: {FileName}", fileData.FileName);
        }
    }

    /// <summary>
    /// Handles a "download" UI action from a chat tool — fetches binary content from the API
    /// endpoint and triggers a browser file download via JS interop.
    /// </summary>
    private async Task HandleDownloadActionAsync(ChatUiAction action)
    {
        try
        {
            var fileName = action.Parameters?.GetValueOrDefault("fileName") ?? "download.pdf";
            var mimeType = action.Parameters?.GetValueOrDefault("mimeType") ?? "application/pdf";

            // Fetch the file bytes from the API endpoint (uses authenticated HttpClient)
            var fileBytes = await ChatApi.DownloadFileAsync(action.Url!);
            if (fileBytes != null && fileBytes.Length > 0)
            {
                var base64 = Convert.ToBase64String(fileBytes);
                await JS.InvokeVoidAsync("downloadFile", fileName, base64, mimeType);
            }
            else
            {
                Logger.LogWarning("Download action returned empty content: {Url}", action.Url);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling download action: {Url}", action.Url);
        }
    }

    /// <summary>
    /// Sends pre-read PDF bytes to the API for text extraction.
    /// </summary>
    private async Task HandlePdfBytes(string fileName, byte[] fileBytes)
    {
        _isExtractingPdf = true;
        StateHasChanged();

        try
        {
            var extractedText = await ChatApi.ExtractPdfTextAsync(fileBytes, fileName);

            if (!string.IsNullOrWhiteSpace(extractedText))
            {
                _attachedFileName = fileName;
                _attachedFileContent = extractedText;
                Logger.LogInformation("PDF text extracted: {FileName} ({Chars} chars)",
                    fileName, extractedText.Length);
            }
            else
            {
                Logger.LogWarning("PDF extraction returned empty text for {FileName}", fileName);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to extract text from PDF '{FileName}'", fileName);
            _attachedFileName = null;
            _attachedFileContent = null;
        }
        finally
        {
            _isExtractingPdf = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Converts pre-read image bytes to base64 for multimodal AI and builds UI preview.
    /// </summary>
    private void HandleImageBytes(string fileName, byte[] imageBytes, string extension)
    {
        _attachedImageBase64 = Convert.ToBase64String(imageBytes);

        var mimeType = extension switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            _ => "image/png"
        };

        _attachedImagePreview = $"data:{mimeType};base64,{_attachedImageBase64}";
        _attachedFileName = fileName;

        Logger.LogInformation("Image attached: {FileName} ({Size} bytes)", fileName, imageBytes.Length);
        StateHasChanged();
    }

    /// <summary>
    /// Removes the currently attached file (PDF or image).
    /// Clears all attachment-related state.
    /// Called when the user clicks the close button on the file chip.
    /// </summary>
    private void HandleFileRemoved()
    {
        _attachedFileName = null;
        _attachedFileContent = null;
        _attachedImageBase64 = null;
        _attachedImagePreview = null;
        StateHasChanged();
    }

    /// <summary>
    /// Starts a new conversation — clears messages and resets state.
    /// </summary>
    private void StartNewConversation()
    {
        _currentConversation = null;
        _messages.Clear();
        _showConversationList = false;
        StateHasChanged();
    }

    /// <summary>
    /// Deletes a conversation and refreshes the list.
    /// Asks for confirmation first — deleting a conversation is irreversible and the
    /// delete button sits right next to the row that selects the conversation.
    /// </summary>
    private async Task DeleteConversation(long conversationId)
    {
        var confirmed = await DialogService.ShowMessageBox(
            L["Msg_ConfirmDeleteTitle"].Value,
            L["Chat_DeleteConfirm"].Value,
            yesText: L["Btn_Delete"].Value,
            cancelText: L["Btn_Cancel"].Value);

        if (confirmed != true)
            return;

        await ChatApi.DeleteConversationAsync(conversationId);
        await LoadConversations();

        // If we deleted the current conversation, reset to new.
        if (_currentConversation?.Id == conversationId)
        {
            StartNewConversation();
        }
    }

    /// <summary>
    /// Toggles between conversation list and message view.
    /// </summary>
    private async Task ToggleConversationList()
    {
        _showConversationList = !_showConversationList;

        if (_showConversationList)
        {
            await LoadConversations();
        }
    }

    private void OnProviderChanged(string provider)
    {
        _selectedProvider = provider;
    }
}
