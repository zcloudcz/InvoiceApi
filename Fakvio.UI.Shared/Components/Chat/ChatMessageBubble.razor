@using Fakvio.Contracts.Dto.Chat
@inject IStringLocalizer<SharedResource> L

@*
    Displays a single chat message as a bubble.
    User messages are right-aligned (primary color).
    Assistant messages are left-aligned (surface color).
    Shows provider name and timestamp subtly below the message.

    Bubble geometry and colors live in app.css (.chat-bubble*) — the same classes are
    reused by the streaming placeholder in ChatPanel.
*@

<div class="d-flex @(IsUser ? "justify-end" : "justify-start") mb-2">
    <div class="chat-bubble @(IsUser ? "chat-bubble-user" : "chat-bubble-assistant")">

        @* Role label *@
        <MudText Typo="Typo.caption" Class="mb-1" Style="opacity: 0.7;">
            @(IsUser ? L["EChatRole_User"] : L["EChatRole_Assistant"])
        </MudText>

        @* Message content.
           Assistant answers are markdown (lists, bold, tables) and are rendered as such.
           User messages stay plain text — the user typed literal characters and markdown
           formatting would silently mangle them (e.g. an invoice number with underscores). *@
        @if (IsUser)
        {
            <MudText Typo="Typo.body2" Class="chat-bubble-text">
                @Message.Content
            </MudText>
        }
        else
        {
            <MarkdownView Content="@Message.Content" />
        }

        @* Metadata: timestamp and provider *@
        <div class="d-flex justify-end gap-2 mt-1">
            @if (!string.IsNullOrEmpty(Message.ProviderUsed))
            {
                <MudText Typo="Typo.caption" Style="opacity: 0.5;">@Message.ProviderUsed</MudText>
            }
            <MudText Typo="Typo.caption" Style="opacity: 0.5;">
                @Message.CreatedAt.ToLocalTime().ToString("HH:mm")
            </MudText>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// The chat message to display.
    /// </summary>
    [Parameter, EditorRequired]
    public ChatMessageDto Message { get; set; } = null!;

    /// <summary>
    /// Whether this is a user message (right-aligned) or assistant message (left-aligned).
    /// </summary>
    private bool IsUser => Message.Role == "User";
}
