@*
    ResponsiveButton — THE primary-action button for toolbars and filter bars.

    Renders a MudButton with a StartIcon that is always visible and a text label
    that hides below 600px (MudBlazor xs breakpoint) via the .btn-responsive CSS
    in wwwroot/css/app.css. On phones the button collapses to an icon-only "+"
    (or whatever StartIcon is passed); the Label doubles as the hover tooltip so
    the action stays discoverable.

    Usage:
    <ResponsiveButton Label="@L["Invoice_New"].Value"
                      StartIcon="@Icons.Material.Filled.Add"
                      OnClick="CreateNew" />

    Works inside MudButtonGroup too (it renders a plain MudButton).
*@

<MudButton Variant="Variant"
           Color="Color"
           Size="Size"
           Disabled="Disabled"
           StartIcon="@StartIcon"
           OnClick="OnClick"
           Href="@Href"
           Class="@($"btn-responsive {Class}".Trim())"
           title="@Label">
    <span class="btn-responsive-label">@Label</span>
</MudButton>

@code {
    /// <summary>
    /// Button text — shown from 600px up, hidden on phones. Also used as the
    /// hover tooltip so the icon-only state stays understandable.
    /// </summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>Icon shown at all sizes (the only visible content on phones).</summary>
    [Parameter, EditorRequired]
    public string StartIcon { get; set; } = "";

    [Parameter]
    public Variant Variant { get; set; } = Variant.Filled;

    [Parameter]
    public Color Color { get; set; } = Color.Primary;

    [Parameter]
    public Size Size { get; set; } = Size.Medium;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Navigation target — alternative to OnClick.</summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>Extra CSS classes appended after btn-responsive.</summary>
    [Parameter]
    public string? Class { get; set; }
}
