@*
    Dialog wrapper around RecurringScheduleEditor — used for both "add" and "edit" from the
    invoice template detail page's "Recurring schedule" panel. Owns the API call; the caller
    just re-loads its list on a truthy DialogResult.
*@
@using Fakvio.Contracts.Dto.Client
@using Fakvio.Contracts.Dto.RecurringInvoice
@using Fakvio.UI.Shared.Models
@using Fakvio.UI.Shared.Services
@inject RecurringInvoiceApiService Api
@inject IStringLocalizer<SharedResource> L
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <RecurringScheduleEditor Model="Model" Clients="Clients" ShowAutoSend="ShowAutoSend" />
        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@_saving">
            @L["Btn_Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public RecurringScheduleFormModel Model { get; set; } = null!;

    [Parameter, EditorRequired]
    public List<ClientDto> Clients { get; set; } = [];

    [Parameter]
    public bool ShowAutoSend { get; set; } = true;

    private bool _saving;
    private string? _error;

    private async Task Save()
    {
        _saving = true;
        _error = null;
        try
        {
            RecurringInvoiceScheduleDto? result;
            if (Model.Id is { } id)
            {
                result = await Api.UpdateAsync(id, BuildUpdateDto());
            }
            else
            {
                result = await Api.CreateAsync(BuildCreateDto());
            }

            if (result != null)
            {
                Snackbar.Add(L["Recurring_SaveSuccess"].Value, Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _error = L["Msg_Error"].Value;
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private CreateRecurringInvoiceScheduleDto BuildCreateDto() => new()
    {
        TemplateId = Model.TemplateId,
        ClientId = Model.ClientId,
        Frequency = Model.Frequency,
        IntervalCount = Model.IntervalCount,
        DayOfMonth = Model.DayOfMonthValue,
        DayOfWeek = Model.DayOfWeekValue,
        StartDate = Model.StartDate ?? DateTime.Today,
        EndDate = Model.EndDate,
        MaxOccurrences = Model.MaxOccurrences,
        AutoSend = Model.AutoSend,
    };

    private UpdateRecurringInvoiceScheduleDto BuildUpdateDto() => new()
    {
        ClientId = Model.ClientId,
        Frequency = Model.Frequency,
        IntervalCount = Model.IntervalCount,
        DayOfMonth = Model.DayOfMonthValue ?? -1, // -1 = explicitly clear (switching to Weekly)
        DayOfWeek = Model.DayOfWeekValue,
        ClearDayOfWeek = Model.DayOfWeekValue is null,
        EndDate = Model.EndDate,
        ClearEndDate = Model.EndMode != "date",
        MaxOccurrences = Model.MaxOccurrences,
        ClearMaxOccurrences = Model.EndMode != "count",
        AutoSend = Model.AutoSend,
    };

    private void Cancel() => MudDialog.Cancel();
}
