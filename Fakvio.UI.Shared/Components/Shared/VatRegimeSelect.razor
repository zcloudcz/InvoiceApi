@*
    Reusable dropdown for the VAT regime of an invoice item (Standard / ReverseCharge / Exempt / OutOfScope).
    Thin wrapper over the generic EnumSelect so every screen shows the same label and localized values.

    Usage:
      <VatRegimeSelect @bind-Value="item.VatRegime" />
*@
@using Fakvio.Domain.Enums
@inject IStringLocalizer<SharedResource> L

<EnumSelect TEnum="EVatRegime" Value="Value" ValueChanged="ValueChanged"
            Label="@(Label ?? L["InvoiceItem_VatRegime"].Value)"
            Variant="Variant" Margin="Margin" Dense="Dense" Disabled="Disabled" />

@code {
    [Parameter] public EVatRegime Value { get; set; }
    [Parameter] public EventCallback<EVatRegime> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Text;
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public bool Dense { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
}
