@*
    DateColumnFilter — unified single-row MudDataGrid column filter for date columns.

    Design: the operator selector is embedded INSIDE the date input as a start adornment,
    so the whole filter looks and behaves like a single compact input — just like
    the calendar icon on the right side.

    - Single mode (=, >, >=, <, <=): one date picker with operator button on the left
    - Range mode (↔): a second compact date picker appears next to the first one in the same row,
      separated by an arrow, so the entire filter still occupies one logical line.

    Usage:
    <PropertyColumn Property="x => x.IssueDate" Title="Issue Date" Format="d">
        <FilterTemplate>
            <DateColumnFilter T="InvoiceDto" Context="context" ValueFunc="x => x.IssueDate" />
        </FilterTemplate>
    </PropertyColumn>
*@
@typeparam T

@* Single-row container — flex layout keeps from/to pickers on one line in range mode *@
<div class="date-col-filter">

    @* Primary picker wrapper — relatively positioned so the operator button can overlay the input *@
    <div class="date-col-filter-input-wrap">

        @* Operator menu — overlaid as a start adornment inside the date input.
           The activator looks like a small pill with the current operator symbol; clicking it opens a menu. *@
        <MudMenu Dense="true"
                 AnchorOrigin="Origin.BottomLeft"
                 TransformOrigin="Origin.TopLeft"
                 PopoverClass="date-col-filter-popover">
            <ActivatorContent>
                <button type="button"
                        class="date-col-filter-op-btn"
                        title="@GetOperatorTitle()"
                        @onclick:stopPropagation="true">
                    @GetOperatorSymbol()
                </button>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="@(() => SetOperator(Op_Is))">
                    <span class="date-col-filter-menu-sym">=</span> @L["DateFilter_Is"]
                </MudMenuItem>
                <MudMenuItem OnClick="@(() => SetOperator(Op_After))">
                    <span class="date-col-filter-menu-sym">&gt;</span> @L["DateFilter_After"]
                </MudMenuItem>
                <MudMenuItem OnClick="@(() => SetOperator(Op_OnOrAfter))">
                    <span class="date-col-filter-menu-sym">&ge;</span> @L["DateFilter_OnOrAfter"]
                </MudMenuItem>
                <MudMenuItem OnClick="@(() => SetOperator(Op_Before))">
                    <span class="date-col-filter-menu-sym">&lt;</span> @L["DateFilter_Before"]
                </MudMenuItem>
                <MudMenuItem OnClick="@(() => SetOperator(Op_OnOrBefore))">
                    <span class="date-col-filter-menu-sym">&le;</span> @L["DateFilter_OnOrBefore"]
                </MudMenuItem>
                <MudMenuItem OnClick="@(() => SetOperator(Op_Range))">
                    <span class="date-col-filter-menu-sym">↔</span> @L["DateFilter_Range"]
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        @* Date picker — left padding is added via scoped CSS to make room for the operator pill *@
        <MudDatePicker Date="_dateFrom"
                       DateChanged="OnDateFromChanged"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Clearable="true"
                       Class="date-col-filter-input" />
    </div>

    @* Range mode — second picker on the same row, separated by an arrow.
       Visible only when the user picks the ↔ (between) operator. *@
    @if (_operator == Op_Range)
    {
        <span class="date-col-filter-arrow">→</span>
        <MudDatePicker Date="_dateTo"
                       DateChanged="OnDateToChanged"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Clearable="true"
                       Class="date-col-filter-input-to" />
    }
</div>

@code {
    /// <summary>
    /// MudDataGrid FilterContext — provides the filter definition and the apply action.
    /// </summary>
    [Parameter, EditorRequired]
    public FilterContext<T> Context { get; set; } = default!;

    /// <summary>
    /// Function to extract the DateTime value from the row item.
    /// Required for the range (↔) filter which uses a custom FilterFunction.
    /// Must match the Property expression on the PropertyColumn.
    /// Example: ValueFunc="x => x.IssueDate"
    /// </summary>
    [Parameter, EditorRequired]
    public Func<T, DateTime?> ValueFunc { get; set; } = default!;

    [Inject] private IStringLocalizer<SharedResource> L { get; set; } = default!;

    // Operator constants matching MudBlazor FilterOperator.DateTime string values
    private const string Op_Is = "is";
    private const string Op_After = "gt";
    private const string Op_OnOrAfter = "on or after";
    private const string Op_Before = "lt";
    private const string Op_OnOrBefore = "on or before";
    private const string Op_Range = "between";

    private string _operator = Op_Is;
    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    /// <summary>
    /// Returns the short symbol for the current operator (displayed in the pill button).
    /// Kept very short to fit inside the date input start adornment.
    /// </summary>
    private string GetOperatorSymbol() => _operator switch
    {
        Op_Is => "=",
        Op_After => ">",
        Op_OnOrAfter => "≥",
        Op_Before => "<",
        Op_OnOrBefore => "≤",
        Op_Range => "↔",
        _ => "="
    };

    /// <summary>
    /// Returns a localized title (tooltip) for the operator pill button.
    /// </summary>
    private string GetOperatorTitle() => _operator switch
    {
        Op_Is => L["DateFilter_Is"],
        Op_After => L["DateFilter_After"],
        Op_OnOrAfter => L["DateFilter_OnOrAfter"],
        Op_Before => L["DateFilter_Before"],
        Op_OnOrBefore => L["DateFilter_OnOrBefore"],
        Op_Range => L["DateFilter_Range"],
        _ => string.Empty
    };

    /// <summary>
    /// Called when the user picks an operator from the menu.
    /// Switching away from range mode clears the secondary date.
    /// </summary>
    private async Task SetOperator(string value)
    {
        _operator = value;
        if (value != Op_Range)
            _dateTo = null;
        await ApplyFilterAsync();
    }

    private async Task OnDateFromChanged(DateTime? value)
    {
        _dateFrom = value;
        await ApplyFilterAsync();
    }

    private async Task OnDateToChanged(DateTime? value)
    {
        _dateTo = value;
        await ApplyFilterAsync();
    }

    /// <summary>
    /// Applies the current operator + date(s) to the filter definition.
    /// Standard operators (=, >, etc.) use built-in MudBlazor operators.
    /// Range (↔) uses a custom FilterFunction with the provided ValueFunc.
    /// </summary>
    private async Task ApplyFilterAsync()
    {
        var filterDef = Context.FilterDefinition;

        // No primary date → clear filter (waiting for user input)
        if (!_dateFrom.HasValue)
        {
            ClearFilter(filterDef);
            if (Context.Actions != null)
                await Context.Actions.ApplyFilterAsync(filterDef);
            return;
        }

        if (_operator == Op_Range)
        {
            // Range: custom FilterFunction using ValueFunc to extract the date from each row
            if (filterDef is FilterDefinition<T> concreteDef)
            {
                var from = _dateFrom.Value.Date;
                var to = _dateTo?.Date;
                var extractDate = ValueFunc;

                concreteDef.Operator = null;
                concreteDef.Value = null;
                concreteDef.FilterFunction = item =>
                {
                    var cellDate = extractDate(item)?.Date;
                    if (cellDate == null) return false;
                    if (to == null) return cellDate >= from;
                    return cellDate >= from && cellDate <= to;
                };
            }
        }
        else
        {
            // Standard operators — clear any custom FilterFunction so the built-in operator runs
            if (filterDef is FilterDefinition<T> concreteDef)
                concreteDef.FilterFunction = null;

            filterDef.Operator = _operator switch
            {
                Op_Is => FilterOperator.DateTime.Is,
                Op_After => FilterOperator.DateTime.After,
                Op_OnOrAfter => FilterOperator.DateTime.OnOrAfter,
                Op_Before => FilterOperator.DateTime.Before,
                Op_OnOrBefore => FilterOperator.DateTime.OnOrBefore,
                _ => FilterOperator.DateTime.Is
            };
            filterDef.Value = _dateFrom.Value.Date;
        }

        if (Context.Actions != null)
            await Context.Actions.ApplyFilterAsync(filterDef);
    }

    /// <summary>
    /// Resets the filter definition to its default (no filter) state.
    /// </summary>
    private static void ClearFilter(IFilterDefinition<T> filterDef)
    {
        filterDef.Operator = null;
        filterDef.Value = null;
        if (filterDef is FilterDefinition<T> concreteDef)
            concreteDef.FilterFunction = null;
    }
}
