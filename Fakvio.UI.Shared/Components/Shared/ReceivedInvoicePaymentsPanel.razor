@using Fakvio.Contracts.Dto.PaymentMatching
@using Fakvio.Contracts.Dto.ReceivedInvoice
@using Fakvio.Domain.Enums
@inject ReceivedInvoiceApiService ReceivedInvoiceApi
@inject PaymentMatchingApiService PaymentApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

@*
    Payments panel for the ReceivedInvoiceDetail page.
    Shows matched outgoing bank transactions alongside the "Automaticky spárovat" button.
    Mirrors InvoicePaymentsPanel but targets ReceivedInvoice PaymentMatch rows.
*@

@if (Invoice != null)
{
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <div class="d-flex align-center mb-2">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Class="mr-1" />
                @L["InvoicePayments_Panel_Title"]
            </MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.AutoFixHigh"
                       OnClick="TriggerAutoMatchAsync"
                       Disabled="_autoMatchBusy">
                @if (_autoMatchBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                }
                @L["AutoMatch_Button"]
            </MudButton>
        </div>

        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else if (_matches == null || _matches.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["InvoicePayments_NoMatches"]</MudText>
        }
        else
        {
            <MudTable Items="_matches" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>@L["InvoicePayments_Col_Date"]</MudTh>
                    <MudTh>@L["InvoicePayments_Col_Amount"]</MudTh>
                    <MudTh>@L["InvoicePayments_Col_Source"]</MudTh>
                    <MudTh>@L["InvoicePayments_Col_Note"]</MudTh>
                    <MudTh Style="width:100px;text-align:right;">&nbsp;</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.MatchedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
                    <MudTd>@context.MatchedAmount.ToString("N2") @Invoice.CurrencyCode</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.MatchedBy == EMatchType.Auto ? Color.Info : Color.Default)">
                            @context.MatchedBy
                        </MudChip>
                    </MudTd>
                    <MudTd>@(context.Note ?? "—")</MudTd>
                    <MudTd Style="text-align:right;">
                        <MudTooltip Text="@L["InvoicePayments_Unmatch"]">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.LinkOff"
                                           OnClick="@(() => UnmatchAsync(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

@code {
    /// <summary>The received invoice being viewed.</summary>
    [Parameter, EditorRequired] public ReceivedInvoiceDto? Invoice { get; set; }

    /// <summary>Bumped by parent to force a reload.</summary>
    [Parameter] public int RefreshTrigger { get; set; }

    /// <summary>Raised after a match/unmatch so the parent can reload the invoice.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<PaymentMatchDto>? _matches;
    private bool _loading;
    private bool _autoMatchBusy;
    private int _lastTrigger = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (Invoice == null) return;
        if (RefreshTrigger != _lastTrigger)
        {
            _lastTrigger = RefreshTrigger;
            await LoadMatchesAsync();
        }
    }

    private async Task LoadMatchesAsync()
    {
        if (Invoice == null) return;
        _loading = true;
        try
        {
            var result = await ReceivedInvoiceApi.GetPaymentsAsync(Invoice.Id);
            _matches = result?.ToList() ?? new List<PaymentMatchDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Called when user clicks "Automaticky spárovat".
    /// Calls the API to find a matching transaction, then shows a confirmation dialog.
    /// </summary>
    private async Task TriggerAutoMatchAsync()
    {
        if (Invoice == null) return;
        _autoMatchBusy = true;
        try
        {
            // Call backend to find a matching transaction.
            var proposal = await ReceivedInvoiceApi.FindAutoMatchAsync(Invoice.Id);

            if (proposal == null)
            {
                // HTTP 204 — no match found.
                Snackbar.Add(L["AutoMatch_NotFound"], Severity.Info);
                return;
            }

            // Show the confirmation dialog with the proposal details.
            var parameters = new DialogParameters { ["Proposal"] = proposal };
            var dialog = await DialogService.ShowAsync<AutoMatchDialog>(
                L["AutoMatch_DialogTitle"], parameters);
            var result = await dialog.Result;

            if (result?.Canceled == true) return;

            // User confirmed — create the PaymentMatch.
            var confirmResult = await PaymentApi.ConfirmAutoMatchAsync(new ConfirmAutoMatchRequest
            {
                BankTransactionId = proposal.BankTransactionId,
                ReceivedInvoiceId = Invoice.Id,
            });

            if (confirmResult != null)
            {
                Snackbar.Add(L["AutoMatch_Success"], Severity.Success);
                await OnChanged.InvokeAsync();
            }
            else
            {
                Snackbar.Add(L["AutoMatch_Error"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["AutoMatch_Error"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _autoMatchBusy = false;
        }
    }

    private async Task UnmatchAsync(PaymentMatchDto row)
    {
        var confirm = await DialogService.ShowMessageBox(
            L["InvoicePayments_Unmatch"],
            L["InvoicePayments_UnmatchConfirm"],
            yesText: L["Common_Yes"], cancelText: L["Common_Cancel"]);
        if (confirm != true) return;

        try
        {
            await PaymentApi.UnmatchAsync(row.BankTransactionId, new UnmatchRequest
            {
                PaymentMatchId = row.Id,
                Reason = null,
            });
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
