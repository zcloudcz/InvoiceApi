@using Fakvio.Contracts.Dto.Invoice
@using Fakvio.Contracts.Dto.PaymentMatching
@using Fakvio.Domain.Enums
@using Fakvio.UI.Shared.Models
@inject FakvioService InvoiceApi
@inject PaymentMatchingApiService PaymentApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

@*
    Reusable payments panel embedded inside InvoiceDetail, for issued AND received documents. Shows:
      - Progress bar PaidAmount / TotalWithVat
      - List of PaymentMatch rows of THIS document (GET /api/invoice/{id}/payments: date, amount, source,
        note, Unmatch button that sends the real PaymentMatch id)
      - "Match payment manually..." button → MatchPaymentDialog (issued documents only, see
        DocumentTypeUiPolicy.SupportsManualPaymentMatch)
    Auto-match has been moved to the Payments overview page (issue #125).
    Parent controls when to refresh by toggling the RefreshTrigger parameter.
*@

@if (Invoice != null)
{
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <div class="d-flex align-center mb-2">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Class="mr-1" />
                @L["InvoicePayments_Panel_Title"]
            </MudText>
            <MudSpacer />
            @if (Policy.SupportsManualPaymentMatch)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Link"
                           OnClick="OpenMatchDialog">
                    @L["InvoicePayments_MatchManually"]
                </MudButton>
            }
        </div>

        @* Progress bar — green when fully paid, blue partial, grey unpaid. *@
        <MudText Typo="Typo.body2">
            <strong>@L["InvoicePayments_PaidLabel"]:</strong>
            @Invoice.PaidAmount.ToString("N2") @Invoice.CurrencyCode
            @L["InvoicePayments_OfTotal"]
            @Invoice.TotalWithVat.ToString("N2") @Invoice.CurrencyCode
        </MudText>
        <MudProgressLinear Color="@ProgressColor" Value="@ProgressPercent"
                           Class="mt-1 mb-3" Size="Size.Large" Rounded="true" />

        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else if (_matches == null || _matches.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["InvoicePayments_NoMatches"]</MudText>
        }
        else
        {
            <MudTable Items="_matches" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>@L["InvoicePayments_Col_Date"]</MudTh>
                    <MudTh>@L["InvoicePayments_Col_Amount"]</MudTh>
                    <MudTh>@L["InvoicePayments_Col_Source"]</MudTh>
                    <MudTh>@L["InvoicePayments_Col_Note"]</MudTh>
                    <MudTh Style="width:100px;text-align:right;">&nbsp;</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.MatchedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
                    <MudTd>@context.MatchedAmount.ToString("N2") @Invoice.CurrencyCode</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.MatchedBy == EMatchType.Auto ? Color.Info : Color.Default)">
                            @context.MatchedBy
                        </MudChip>
                    </MudTd>
                    <MudTd>@(context.Note ?? "—")</MudTd>
                    <MudTd Style="text-align:right;">
                        <MudTooltip Text="@L["InvoicePayments_Unmatch"]">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.LinkOff"
                                           OnClick="@(() => UnmatchAsync(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

@code {
    /// <summary>The invoice being viewed. Used for Currency, Total, and PaidAmount.</summary>
    [Parameter, EditorRequired] public InvoiceDto? Invoice { get; set; }

    /// <summary>Bumped by parent to force a reload (e.g., after editing the invoice).</summary>
    [Parameter] public int RefreshTrigger { get; set; }

    /// <summary>Raised after a manual match or unmatch — parent reloads the invoice.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<PaymentMatchDto>? _matches;
    private bool _loading;
    private int _lastTrigger = -1;
    private long _loadedForId = -1;

    private double ProgressPercent =>
        Invoice == null || Invoice.TotalWithVat <= 0
            ? 0
            : Math.Min(100, (double)(Invoice.PaidAmount / Invoice.TotalWithVat * 100m));

    private Color ProgressColor => Invoice switch
    {
        null => Color.Default,
        { PaidAmount: var p, TotalWithVat: var t } when p >= t => Color.Success,
        { PaidAmount: > 0 } => Color.Info,
        _ => Color.Default,
    };

    /// <summary>Policy of the viewed document (an unset/unknown type falls back to an ordinary invoice).</summary>
    private DocumentTypeUiPolicy Policy => DocumentTypeUiPolicy.For(
        Invoice != null && Enum.IsDefined(Invoice.DocumentType) ? Invoice.DocumentType : EDocumentType.Invoice);

    protected override async Task OnParametersSetAsync()
    {
        if (Invoice == null) return;
        // Reload on an explicit refresh AND when the panel is handed another document (same instance reused).
        if (RefreshTrigger != _lastTrigger || Invoice.Id != _loadedForId)
        {
            _lastTrigger = RefreshTrigger;
            _loadedForId = Invoice.Id;
            await LoadMatchesAsync();
        }
    }

    /// <summary>
    /// Loads the payments of THIS document by its id (GET /api/invoice/{id}/payments, works for issued and
    /// received documents). The rows carry the real PaymentMatch id, which the unmatch call needs; the old
    /// approach (first 100 bank transactions matched by document number) found nothing for older documents.
    /// </summary>
    private async Task LoadMatchesAsync()
    {
        if (Invoice == null) return;
        _loading = true;
        try
        {
            _matches = await InvoiceApi.GetPaymentsAsync(Invoice.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenMatchDialog()
    {
        if (Invoice == null) return;
        var parameters = new DialogParameters { ["Invoice"] = Invoice };
        var dialog = await DialogService.ShowAsync<MatchPaymentDialog>(L["MatchDialog_Title"], parameters);
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await OnChanged.InvokeAsync();
        }
    }

    private async Task UnmatchAsync(PaymentMatchDto row)
    {
        var confirm = await DialogService.ShowMessageBox(
            L["InvoicePayments_Unmatch"],
            L["InvoicePayments_UnmatchConfirm"],
            yesText: L["Common_Yes"], cancelText: L["Common_Cancel"]);
        if (confirm != true) return;

        try
        {
            await PaymentApi.UnmatchAsync(row.BankTransactionId, new UnmatchRequest
            {
                PaymentMatchId = row.Id,
                Reason = null,
            });
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            // The server refuses some unmatches on purpose (e.g. after a manual "mark as paid") and explains why in
            // the 400 body; ApiClientBase puts that text into the exception, so the user reads the real reason.
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
