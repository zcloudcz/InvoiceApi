@using Fakvio.Contracts.Dto.Feedback
@using Fakvio.Domain.Enums
@inject FeedbackApiService Api
@inject IStringLocalizer<SharedResource> L
@inject ISnackbar Snackbar
@implements IDisposable

<MudButton Href="@(Admin ? "/sysadmin/feedback" : "/feedback")" StartIcon="@Icons.Material.Filled.ArrowBack">@L[Admin ? "Feedback_Inbox" : "Feedback_Mine"]</MudButton>
@if (_error) { <MudAlert Severity="Severity.Error">@L["Feedback_Error"]</MudAlert> }
@if (_loading) { <MudProgressLinear Indeterminate="true" /> }
@if (_report is not null)
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h4">@_report.Subject</MudText>
        <MudText>@L[$"EFeedbackType_{_report.Type}"] · @L[$"EFeedbackStatus_{_report.Status}"]</MudText>
        <MudText Typo="Typo.caption">@L["Feedback_Created"]: @_report.CreatedAt.ToLocalTime()</MudText>
        @* Normal Razor text stays HTML-escaped; never render reports as MarkupString. *@
        <MudText Class="my-4" Style="white-space:pre-wrap;overflow-wrap:anywhere">@_report.Description</MudText>
        <MudText Typo="Typo.caption" Style="overflow-wrap:anywhere">@L["Feedback_Page"]: @_report.Page</MudText>
        <MudText Typo="Typo.caption">@L["Feedback_Version"]: @_report.AppVersion</MudText>
        @if (!string.IsNullOrWhiteSpace(_report.PublicResponse))
        {
            <MudText Typo="Typo.h6" Class="mt-4">@L["Feedback_Response"]</MudText>
            <MudText Style="white-space:pre-wrap;overflow-wrap:anywhere">@_report.PublicResponse</MudText>
        }
        @if (Admin)
        {
            <AuthorizeView Roles="SysAdmin">
                <EnumSelect TEnum="EFeedbackStatus" @bind-Value="_status" Label="@L["Feedback_Status"].Value" Disabled="_saving" />
                <MudTextField @bind-Value="_response" Label="@L["Feedback_Response"].Value" Lines="5" MaxLength="10000" Immediate="true" Disabled="_saving" />
                <MudButton OnClick="SaveAsync" Disabled="_saving" Color="Color.Primary" Variant="Variant.Filled">@L["Btn_Save"]</MudButton>
            </AuthorizeView>
        }
    </MudPaper>
}

@code {
    [Parameter] public long Id { get; set; }
    [Parameter] public bool Admin { get; set; }
    private FeedbackDto? _report;
    private EFeedbackStatus _status;
    private string? _response;
    private bool _error, _loading, _saving;
    private (long, bool)? _loadedKey;
    private CancellationTokenSource? _load;
    private readonly CancellationTokenSource _lifetime = new();

    protected override async Task OnParametersSetAsync()
    {
        var key = (Id, Admin);
        if (_loadedKey == key) return;
        _loadedKey = key;
        _load?.Cancel();
        _load?.Dispose();
        _load = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var token = _load.Token;
        _report = null;
        _loading = true;
        _error = false;
        try
        {
            var report = await Api.GetReportAsync(Id, Admin, token);
            if (token.IsCancellationRequested) return;
            _report = report;
            _status = report.Status;
            _response = report.PublicResponse;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception) { if (!token.IsCancellationRequested) _error = true; }
        finally { if (!token.IsCancellationRequested) _loading = false; }
    }

    private async Task SaveAsync()
    {
        if (_saving || _report is null) return;
        _saving = true;
        _error = false;
        var id = Id;
        try
        {
            var report = await Api.UpdateAsync(id, new UpdateFeedbackStatusDto { Status = _status, PublicResponse = _response }, _lifetime.Token);
            if (Id == id) { _report = report; Snackbar.Add(L["Feedback_Saved"], Severity.Success); }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { if (Id == id) _error = true; }
        finally { _saving = false; }
    }
    public void Dispose() { _lifetime.Cancel(); _load?.Cancel(); _load?.Dispose(); _lifetime.Dispose(); }
}
