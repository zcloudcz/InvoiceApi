@using Fakvio.Contracts.Dto.Invoice
@using Fakvio.Contracts.Dto.VatRate
@using Fakvio.Contracts.Dto.ReverseChargeCode
@using Fakvio.Domain.Enums
@using Fakvio.UI.Shared.Services
@* Use the typed VatRateApiService instead of raw HttpClient — it handles BaseAddress, auth, and logging *@
@inject VatRateApiService VatRateService
@* Issuer lookup — a non-VAT payer gets no VAT column, no VAT totals and 0 % on every row *@
@inject ClientApiService ClientService
@* Reverse charge code lookup (§92a-92e ZDPH) — only relevant for a VAT payer issuer *@
@inject ReverseChargeCodeApiService ReverseChargeCodeService
@inject ISnackbar Snackbar
@* Localization service for multi-language support *@
@inject IStringLocalizer<SharedResource> L

@* Inline editable grid for invoice items — each row is directly editable *@
<div class="d-flex justify-space-between align-center mb-2">
    <MudText Typo="Typo.h6">@L["InvoiceItem_Items"]</MudText>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   OnClick="AddNewRow" StartIcon="@Icons.Material.Filled.Add">
            @L["Btn_AddItem"]
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                   OnClick="AddTextRow" StartIcon="@Icons.Material.Filled.Notes">
            @L["Btn_AddTextRow"]
        </MudButton>
    </MudStack>
</div>

@* Reverse charge bulk toggle (§92a ZDPH) — only offered to a VAT payer issuer. UI-only helper:
   it just loops over the existing items and sets VatRegime/ReverseChargeCodeId on each one,
   no extra entity/column is added for it. *@
@if (_isVatPayer)
{
    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudSwitch T="bool" Value="@_reverseChargeToggleOn" ValueChanged="OnReverseChargeToggleChanged"
                       Color="Color.Primary" Label="@L["Invoice_ReverseChargeToggle"].Value" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Invoice_ReverseChargeToggle_Hint"]</MudText>
            @if (_reverseChargeToggleOn)
            {
                <ReverseChargeCodeSelect Codes="_reverseChargeCodes" Value="@_bulkReverseChargeCodeId"
                                         ValueChanged="OnBulkReverseChargeCodeChanged"
                                         Label="@L["Invoice_ReverseChargeToggle_SelectCode"].Value"
                                         Variant="Variant.Text" Style="min-width: 260px;" />
            }
        </MudStack>
    </MudPaper>
}

<MudTable T="CreateInvoiceItemDto" Items="@Items" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <MudTh Style="width: 60px;">@L["InvoiceItem_Order"]</MudTh>
        <MudTh Style="width: 100px;">@L["InvoiceItem_Code"]</MudTh>
        <MudTh>@L["InvoiceItem_Description"]</MudTh>
        <MudTh Style="width: 90px;">@L["InvoiceItem_Quantity"]</MudTh>
        <MudTh Style="width: 80px;">@L["InvoiceItem_Unit"]</MudTh>
        <MudTh Style="width: 110px;">@L["InvoiceItem_PricePerUnit"]</MudTh>
        @if (_isVatPayer)
        {
            <MudTh Style="width: 140px;">@L["InvoiceItem_VatRate"]</MudTh>
            <MudTh Style="width: 160px;">@L["InvoiceItem_VatRegime"]</MudTh>
            <MudTh Style="width: 200px;">@L["InvoiceItem_ReverseChargeCode"]</MudTh>
        }
        <MudTh Style="width: 100px;">@L["InvoiceItem_Total"]</MudTh>
        <MudTh Style="width: 50px;"></MudTh>
    </HeaderContent>
    <RowTemplate>
        @if (context.IsTextRow)
        {
            @* Text row — spans most columns, only description + order + delete *@
            <MudTd>
                <MudNumericField T="int" Value="@context.OrderIndex"
                                 ValueChanged="@(v => { context.OrderIndex = v; NotifyChanged(); })"
                                 Variant="Variant.Text" Margin="Margin.Dense" Min="1"
                                 HideSpinButtons="true" Style="width: 50px;" />
            </MudTd>
            <MudTd></MudTd>
            <MudTd colspan="@(_isVatPayer ? 7 : 4)">
                <MudTextField T="string" Value="@context.Description"
                              ValueChanged="@(v => { context.Description = v; NotifyChanged(); })"
                              Variant="Variant.Text" Margin="Margin.Dense"
                              Placeholder="@L["InvoiceItem_TextRowPlaceholder"].Value"
                              Style="font-style:italic;" />
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InvoiceItem_TextRow"]</MudText>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteItem(context))" Title="@L["Btn_Delete"].Value" />
            </MudTd>
        }
        else
        {
            @* Regular billable item row *@
            <MudTd>
                <MudNumericField T="int" Value="@context.OrderIndex"
                                 ValueChanged="@(v => { context.OrderIndex = v; NotifyChanged(); })"
                                 Variant="Variant.Text" Margin="Margin.Dense" Min="1"
                                 HideSpinButtons="true" Style="width: 50px;" />
            </MudTd>
            <MudTd>
                <MudTextField T="string" Value="@context.ProductCode"
                              ValueChanged="@(v => { context.ProductCode = v; NotifyChanged(); })"
                              Variant="Variant.Text" Margin="Margin.Dense" />
            </MudTd>
            <MudTd>
                <MudTextField T="string" Value="@context.Description"
                              ValueChanged="@(v => { context.Description = v; NotifyChanged(); })"
                              Variant="Variant.Text" Margin="Margin.Dense" Required="true" />
            </MudTd>
            <MudTd>
                <MudNumericField T="decimal" Value="@context.Quantity"
                                 ValueChanged="@(v => { context.Quantity = v; NotifyChanged(); })"
                                 Variant="Variant.Text" Margin="Margin.Dense" Min="0.01m"
                                 Format="N2" HideSpinButtons="true" />
            </MudTd>
            <MudTd>
                <MudTextField T="string" Value="@context.Unit"
                              ValueChanged="@(v => { context.Unit = v; NotifyChanged(); })"
                              Variant="Variant.Text" Margin="Margin.Dense" />
            </MudTd>
            <MudTd>
                <MudNumericField T="decimal" Value="@context.UnitPrice"
                                 ValueChanged="@(v => { context.UnitPrice = v; NotifyChanged(); })"
                                 Variant="Variant.Text" Margin="Margin.Dense" Min="0"
                                 Format="N2" HideSpinButtons="true" />
            </MudTd>
            @if (_isVatPayer)
            {
                <MudTd>
                    <MudSelect T="long?" Value="@context.VatRateId"
                               ValueChanged="@(v => OnVatRateChanged(context, v))"
                               Variant="Variant.Text" Margin="Margin.Dense" Dense="true">
                        @foreach (var vr in _vatRates)
                        {
                            <MudSelectItem T="long?" Value="@((long?)vr.Id)">@vr.Rate%</MudSelectItem>
                        }
                    </MudSelect>
                    @if (context.VatRegime == EVatRegime.ReverseCharge)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InvoiceItem_VatZeroCustomerPays"]</MudText>
                    }
                </MudTd>
                <MudTd>
                    <VatRegimeSelect Value="@context.VatRegime" ValueChanged="@(v => OnVatRegimeChanged(context, v))" />
                </MudTd>
                <MudTd>
                    @if (context.VatRegime == EVatRegime.ReverseCharge)
                    {
                        <ReverseChargeCodeSelect Codes="_reverseChargeCodes" Value="@context.ReverseChargeCodeId"
                                                 ValueChanged="@(v => { context.ReverseChargeCodeId = v; NotifyChanged(); })"
                                                 Required="true" />
                    }
                </MudTd>
            }
            <MudTd>
                <MudText Typo="Typo.body2" Align="Align.Right">
                    @((context.Quantity * context.UnitPrice).ToString("N2"))
                </MudText>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteItem(context))" Title="@L["Btn_Delete"].Value" />
            </MudTd>
        }
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">@L["InvoiceItem_NoItems"]</MudText>
    </NoRecordsContent>
</MudTable>

@* Totals summary *@
@if (Items.Any())
{
    <MudPaper Class="pa-4 mt-4">
        <MudGrid>
            @if (!_isVatPayer)
            {
                @* Non-VAT payer: a single total — the invoice must not mention VAT at all *@
                <MudItem xs="8">
                    <MudText Typo="Typo.h6" Align="Align.Right"><strong>@L["Label_Total"]:</strong></MudText>
                </MudItem>
                <MudItem xs="4">
                    <MudText Typo="Typo.h6" Align="Align.Right"><strong>@CalculateTotalBeforeVat().ToString("N2")</strong></MudText>
                </MudItem>
            }
            else
            {
            <MudItem xs="8">
                <MudText Typo="Typo.h6" Align="Align.Right">@L["Invoice_TotalBeforeVat"]:</MudText>
            </MudItem>
            <MudItem xs="4">
                <MudText Typo="Typo.h6" Align="Align.Right">@CalculateTotalBeforeVat().ToString("N2")</MudText>
            </MudItem>
            <MudItem xs="8">
                <MudText Typo="Typo.h6" Align="Align.Right">@L["Invoice_TotalVat"]:</MudText>
            </MudItem>
            <MudItem xs="4">
                <MudText Typo="Typo.h6" Align="Align.Right">@CalculateTotalVat().ToString("N2")</MudText>
            </MudItem>
            <MudItem xs="8">
                <MudText Typo="Typo.h6" Align="Align.Right"><strong>@L["Invoice_TotalWithVat"]:</strong></MudText>
            </MudItem>
            <MudItem xs="4">
                <MudText Typo="Typo.h6" Align="Align.Right"><strong>@CalculateTotalWithVatAll().ToString("N2")</strong></MudText>
            </MudItem>
            @if (HasReverseChargeItems())
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@L["Invoice_ReverseChargeNote"]</MudAlert>
                </MudItem>
            }
            }
        </MudGrid>
    </MudPaper>
}

@code {
    /// <summary>
    /// The list of invoice items to edit inline.
    /// Bound two-way via Items/ItemsChanged.
    /// </summary>
    [Parameter]
    public List<CreateInvoiceItemDto> Items { get; set; } = new();

    [Parameter]
    public EventCallback<List<CreateInvoiceItemDto>> ItemsChanged { get; set; }

    private List<VatRateDto> _vatRates = new();

    /// <summary>
    /// Reverse charge codes (kódy předmětu plnění PDP), loaded only for a VAT payer issuer —
    /// a non-payer can never use Reverse Charge (§92a ZDPH applies to VAT payers only).
    /// </summary>
    private List<ReverseChargeCodeDto> _reverseChargeCodes = new();

    /// <summary>
    /// State of the bulk "Přenesená daňová povinnost" toggle above the grid. UI-only helper —
    /// it just writes VatRegime/ReverseChargeCodeId on every item, no extra field is persisted.
    /// </summary>
    private bool _reverseChargeToggleOn;
    private long? _bulkReverseChargeCodeId;

    /// <summary>
    /// Whether the issuing company is a VAT payer. Defaults to true until the issuer is
    /// loaded — if the lookup fails the server still strips VAT for a non-payer, so the
    /// worst case is a VAT column shown for nothing, never VAT charged.
    /// </summary>
    private bool _isVatPayer = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadVatRates();
        await LoadIssuerVatStatus();
        if (_isVatPayer)
        {
            await LoadReverseChargeCodes();
            SyncReverseChargeToggleFromItems();
        }
    }

    /// <summary>
    /// When editing an existing invoice whose items were already all set to the same
    /// ReverseCharge code (e.g. via this very toggle, or a prior edit), reflect that in the
    /// toggle UI instead of showing it off and the per-item selects on independently.
    /// </summary>
    private void SyncReverseChargeToggleFromItems()
    {
        var billable = Items.Where(i => !i.IsTextRow).ToList();
        if (billable.Count == 0)
        {
            return;
        }

        var codeIds = billable.Select(i => i.VatRegime == EVatRegime.ReverseCharge ? i.ReverseChargeCodeId : null).ToList();
        if (billable.All(i => i.VatRegime == EVatRegime.ReverseCharge) && codeIds.Distinct().Count() == 1)
        {
            _reverseChargeToggleOn = true;
            _bulkReverseChargeCodeId = codeIds[0];
        }
    }

    /// <summary>
    /// Reads the issuer's VAT status. For a non-VAT payer, rows loaded from an existing
    /// invoice or template are reset to 0 % so the on-screen totals match what the server
    /// will store (it ignores VAT for non-payers). Reverse charge is a VAT-payer-only regime
    /// (same rule as NonVatPayerItems.StripVat on the server), so it is stripped back to
    /// Standard as well.
    /// </summary>
    private async Task LoadIssuerVatStatus()
    {
        try
        {
            var issuer = await ClientService.GetIssuerAsync();
            _isVatPayer = issuer?.IsVatPayer ?? true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
            return;
        }

        if (!_isVatPayer && Items.Any(i => i.VatRateId.HasValue || i.VatRatePercentage != 0 || i.VatRegime == EVatRegime.ReverseCharge))
        {
            foreach (var item in Items)
            {
                item.VatRateId = null;
                item.VatRatePercentage = 0;
                if (item.VatRegime == EVatRegime.ReverseCharge)
                {
                    item.VatRegime = EVatRegime.Standard;
                }
                item.ReverseChargeCodeId = null;
            }
            NotifyChanged();
        }
    }

    /// <summary>
    /// Loads active reverse charge codes for the per-item dropdown and the bulk toggle.
    /// Empty list on error — the select just shows no options, same graceful degradation
    /// pattern as LoadVatRates.
    /// </summary>
    private async Task LoadReverseChargeCodes()
    {
        try
        {
            _reverseChargeCodes = await ReverseChargeCodeService.GetAllActiveAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Loads active VAT rates via the typed VatRateApiService.
    /// The service handles auth headers, base URL, and error logging automatically.
    /// </summary>
    private async Task LoadVatRates()
    {
        try
        {
            _vatRates = await VatRateService.GetActiveForDateAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Adds a new empty row at the bottom of the grid with sensible defaults
    /// </summary>
    private void AddNewRow()
    {
        var nextOrder = Items.Any() ? Items.Max(i => i.OrderIndex) + 1 : 1;
        // A non-VAT payer never gets a VAT rate; a VAT payer starts with the default rate.
        var defaultVatRate = _isVatPayer ? _vatRates.FirstOrDefault(v => v.IsDefault) : null;

        Items.Add(new CreateInvoiceItemDto
        {
            OrderIndex = nextOrder,
            Unit = "ks",
            Quantity = 1,
            UnitPrice = 0,
            VatRateId = defaultVatRate?.Id,
            VatRatePercentage = _isVatPayer ? defaultVatRate?.Rate ?? 21 : 0
        });

        NotifyChanged();
    }

    /// <summary>
    /// Adds a text-only row (note/comment) — not a billable item.
    /// </summary>
    private void AddTextRow()
    {
        var nextOrder = Items.Any() ? Items.Max(i => i.OrderIndex) + 1 : 1;
        Items.Add(new CreateInvoiceItemDto
        {
            OrderIndex = nextOrder,
            IsTextRow = true,
            Description = "",
            Unit = "",
            Quantity = 0,
            UnitPrice = 0
        });
        NotifyChanged();
    }

    /// <summary>
    /// Removes an item from the list and notifies the parent
    /// </summary>
    private void DeleteItem(CreateInvoiceItemDto item)
    {
        Items.Remove(item);
        NotifyChanged();
    }

    /// <summary>
    /// Updates VAT rate percentage when the user selects a different rate from the dropdown
    /// </summary>
    private void OnVatRateChanged(CreateInvoiceItemDto item, long? vatRateId)
    {
        item.VatRateId = vatRateId;

        if (vatRateId.HasValue)
        {
            var vatRate = _vatRates.FirstOrDefault(v => v.Id == vatRateId.Value);
            if (vatRate != null)
            {
                item.VatRatePercentage = vatRate.Rate;
            }
        }

        NotifyChanged();
    }

    /// <summary>
    /// Updates VatRegime on a single row. Switching away from ReverseCharge clears the
    /// reverse charge code (mirrors the server-side rule in InvoiceService.ValidateReverseChargeCodes:
    /// a non-ReverseCharge item must not carry a code).
    /// </summary>
    private void OnVatRegimeChanged(CreateInvoiceItemDto item, EVatRegime regime)
    {
        item.VatRegime = regime;
        if (regime != EVatRegime.ReverseCharge)
        {
            item.ReverseChargeCodeId = null;
        }
        NotifyChanged();
    }

    /// <summary>
    /// Toggles "Přenesená daňová povinnost" for the whole invoice. Turning it on requires a
    /// code to be picked first (applied once selected, see OnBulkReverseChargeCodeChanged).
    /// Turning it off resets every item back to Standard VAT.
    /// </summary>
    private void OnReverseChargeToggleChanged(bool value)
    {
        _reverseChargeToggleOn = value;
        if (!value)
        {
            _bulkReverseChargeCodeId = null;
            foreach (var item in Items.Where(i => !i.IsTextRow))
            {
                item.VatRegime = EVatRegime.Standard;
                item.ReverseChargeCodeId = null;
            }
            NotifyChanged();
        }
    }

    /// <summary>
    /// Applies the chosen reverse charge code to every billable item as soon as it is picked.
    /// </summary>
    private void OnBulkReverseChargeCodeChanged(long? codeId)
    {
        _bulkReverseChargeCodeId = codeId;
        if (!codeId.HasValue)
        {
            return;
        }

        foreach (var item in Items.Where(i => !i.IsTextRow))
        {
            item.VatRegime = EVatRegime.ReverseCharge;
            item.ReverseChargeCodeId = codeId;
        }
        NotifyChanged();
    }

    /// <summary>
    /// Notifies the parent component that items have changed
    /// </summary>
    private void NotifyChanged()
    {
        ItemsChanged.InvokeAsync(Items);
    }

    // --- Totals calculations ---

    private decimal CalculateTotalBeforeVat()
    {
        return Items.Where(i => !i.IsTextRow).Sum(i => i.Quantity * i.UnitPrice);
    }

    /// <summary>
    /// Sums VAT for Standard items only — mirrors InvoiceService.CalculateItemVat:
    /// ReverseCharge/Exempt/OutOfScope items bill 0 VAT, so the preview must match what
    /// the server actually stores.
    /// </summary>
    private decimal CalculateTotalVat()
    {
        return Items.Where(i => !i.IsTextRow && i.VatRegime == EVatRegime.Standard)
            .Sum(i => i.Quantity * i.UnitPrice * i.VatRatePercentage / 100);
    }

    private decimal CalculateTotalWithVatAll()
    {
        return CalculateTotalBeforeVat() + CalculateTotalVat();
    }

    private bool HasReverseChargeItems()
    {
        return Items.Any(i => !i.IsTextRow && i.VatRegime == EVatRegime.ReverseCharge);
    }
}
