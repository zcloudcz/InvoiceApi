@using Fakvio.Contracts.Dto.Invoice
@using Fakvio.Contracts.Dto.VatRate
@using Fakvio.UI.Shared.Services
@* Use the typed VatRateApiService instead of raw HttpClient — it handles BaseAddress, auth, and logging *@
@inject VatRateApiService VatRateService
@* Issuer lookup — a non-VAT payer gets no VAT column, no VAT totals and 0 % on every row *@
@inject ClientApiService ClientService
@inject ISnackbar Snackbar
@* Localization service for multi-language support *@
@inject IStringLocalizer<SharedResource> L

@* Inline editable grid for invoice items — each row is directly editable *@
<div class="d-flex justify-space-between align-center mb-2">
    <MudText Typo="Typo.h6">@L["InvoiceItem_Items"]</MudText>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   OnClick="AddNewRow" StartIcon="@Icons.Material.Filled.Add">
            @L["Btn_AddItem"]
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                   OnClick="AddTextRow" StartIcon="@Icons.Material.Filled.Notes">
            @L["Btn_AddTextRow"]
        </MudButton>
    </MudStack>
</div>

<MudTable T="CreateInvoiceItemDto" Items="@Items" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <MudTh Style="width: 60px;">@L["InvoiceItem_Order"]</MudTh>
        <MudTh Style="width: 100px;">@L["InvoiceItem_Code"]</MudTh>
        <MudTh>@L["InvoiceItem_Description"]</MudTh>
        <MudTh Style="width: 90px;">@L["InvoiceItem_Quantity"]</MudTh>
        <MudTh Style="width: 80px;">@L["InvoiceItem_Unit"]</MudTh>
        <MudTh Style="width: 110px;">@L["InvoiceItem_PricePerUnit"]</MudTh>
        @if (_isVatPayer)
        {
            <MudTh Style="width: 140px;">@L["InvoiceItem_VatRate"]</MudTh>
        }
        <MudTh Style="width: 100px;">@L["InvoiceItem_Total"]</MudTh>
        <MudTh Style="width: 50px;"></MudTh>
    </HeaderContent>
    <RowTemplate>
        @if (context.IsTextRow)
        {
            @* Text row — spans most columns, only description + order + delete *@
            <MudTd>
                <MudNumericField T="int" Value="@context.OrderIndex"
                                 ValueChanged="@(v => { context.OrderIndex = v; NotifyChanged(); })"
                                 Variant="Variant.Text" Margin="Margin.Dense" Min="1"
                                 HideSpinButtons="true" Style="width: 50px;" />
            </MudTd>
            <MudTd></MudTd>
            <MudTd colspan="@(_isVatPayer ? 5 : 4)">
                <MudTextField T="string" Value="@context.Description"
                              ValueChanged="@(v => { context.Description = v; NotifyChanged(); })"
                              Variant="Variant.Text" Margin="Margin.Dense"
                              Placeholder="@L["InvoiceItem_TextRowPlaceholder"].Value"
                              Style="font-style:italic;" />
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InvoiceItem_TextRow"]</MudText>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteItem(context))" Title="@L["Btn_Delete"].Value" />
            </MudTd>
        }
        else
        {
            @* Regular billable item row *@
            <MudTd>
                <MudNumericField T="int" Value="@context.OrderIndex"
                                 ValueChanged="@(v => { context.OrderIndex = v; NotifyChanged(); })"
                                 Variant="Variant.Text" Margin="Margin.Dense" Min="1"
                                 HideSpinButtons="true" Style="width: 50px;" />
            </MudTd>
            <MudTd>
                <MudTextField T="string" Value="@context.ProductCode"
                              ValueChanged="@(v => { context.ProductCode = v; NotifyChanged(); })"
                              Variant="Variant.Text" Margin="Margin.Dense" />
            </MudTd>
            <MudTd>
                <MudTextField T="string" Value="@context.Description"
                              ValueChanged="@(v => { context.Description = v; NotifyChanged(); })"
                              Variant="Variant.Text" Margin="Margin.Dense" Required="true" />
            </MudTd>
            <MudTd>
                <MudNumericField T="decimal" Value="@context.Quantity"
                                 ValueChanged="@(v => { context.Quantity = v; NotifyChanged(); })"
                                 Variant="Variant.Text" Margin="Margin.Dense" Min="0.01m"
                                 Format="N2" HideSpinButtons="true" />
            </MudTd>
            <MudTd>
                <MudTextField T="string" Value="@context.Unit"
                              ValueChanged="@(v => { context.Unit = v; NotifyChanged(); })"
                              Variant="Variant.Text" Margin="Margin.Dense" />
            </MudTd>
            <MudTd>
                <MudNumericField T="decimal" Value="@context.UnitPrice"
                                 ValueChanged="@(v => { context.UnitPrice = v; NotifyChanged(); })"
                                 Variant="Variant.Text" Margin="Margin.Dense" Min="0"
                                 Format="N2" HideSpinButtons="true" />
            </MudTd>
            @if (_isVatPayer)
            {
                <MudTd>
                    @if (!string.IsNullOrEmpty(OssCountryCode))
                    {
                        @* EU OSS invoice: rates of the destination country (no tenant VatRate FK). *@
                        <MudSelect T="decimal" Value="@context.VatRatePercentage"
                                   ValueChanged="@(v => OnOssRateChanged(context, v))"
                                   Variant="Variant.Text" Margin="Margin.Dense" Dense="true">
                            @foreach (var r in _ossRates)
                            {
                                <MudSelectItem T="decimal" Value="@r.Rate">@r.Rate.ToString("0.##")% (@OssCountryCode)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudSelect T="long?" Value="@context.VatRateId"
                                   ValueChanged="@(v => OnVatRateChanged(context, v))"
                                   Variant="Variant.Text" Margin="Margin.Dense" Dense="true">
                            @foreach (var vr in _vatRates)
                            {
                                <MudSelectItem T="long?" Value="@((long?)vr.Id)">@vr.Rate%</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudTd>
            }
            <MudTd>
                <MudText Typo="Typo.body2" Align="Align.Right">
                    @((context.Quantity * context.UnitPrice).ToString("N2"))
                </MudText>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteItem(context))" Title="@L["Btn_Delete"].Value" />
            </MudTd>
        }
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">@L["InvoiceItem_NoItems"]</MudText>
    </NoRecordsContent>
</MudTable>

@* Totals summary *@
@if (Items.Any())
{
    <MudPaper Class="pa-4 mt-4">
        <MudGrid>
            @if (!_isVatPayer)
            {
                @* Non-VAT payer: a single total — the invoice must not mention VAT at all *@
                <MudItem xs="8">
                    <MudText Typo="Typo.h6" Align="Align.Right"><strong>@L["Label_Total"]:</strong></MudText>
                </MudItem>
                <MudItem xs="4">
                    <MudText Typo="Typo.h6" Align="Align.Right"><strong>@CalculateTotalBeforeVat().ToString("N2")</strong></MudText>
                </MudItem>
            }
            else
            {
            <MudItem xs="8">
                <MudText Typo="Typo.h6" Align="Align.Right">@L["Invoice_TotalBeforeVat"]:</MudText>
            </MudItem>
            <MudItem xs="4">
                <MudText Typo="Typo.h6" Align="Align.Right">@CalculateTotalBeforeVat().ToString("N2")</MudText>
            </MudItem>
            <MudItem xs="8">
                <MudText Typo="Typo.h6" Align="Align.Right">@L["Invoice_TotalVat"]:</MudText>
            </MudItem>
            <MudItem xs="4">
                <MudText Typo="Typo.h6" Align="Align.Right">@CalculateTotalVat().ToString("N2")</MudText>
            </MudItem>
            <MudItem xs="8">
                <MudText Typo="Typo.h6" Align="Align.Right"><strong>@L["Invoice_TotalWithVat"]:</strong></MudText>
            </MudItem>
            <MudItem xs="4">
                <MudText Typo="Typo.h6" Align="Align.Right"><strong>@CalculateTotalWithVatAll().ToString("N2")</strong></MudText>
            </MudItem>
            }
        </MudGrid>
    </MudPaper>
}

@code {
    /// <summary>
    /// The list of invoice items to edit inline.
    /// Bound two-way via Items/ItemsChanged.
    /// </summary>
    [Parameter]
    public List<CreateInvoiceItemDto> Items { get; set; } = new();

    [Parameter]
    public EventCallback<List<CreateInvoiceItemDto>> ItemsChanged { get; set; }

    /// <summary>
    /// ISO2 destination country when the invoice is an EU OSS invoice (see DEVGUIDE §4.15); the VAT column
    /// then offers that country's OSS rates. Null/empty = ordinary invoice with the tenant's CZ rates.
    /// </summary>
    [Parameter]
    public string? OssCountryCode { get; set; }

    private List<VatRateDto> _vatRates = new();
    private List<Fakvio.Contracts.Dto.OssVatRate.OssVatRateDto> _ossRates = new();
    private string? _loadedOssCountry;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedOssCountry == OssCountryCode) return;
        _loadedOssCountry = OssCountryCode;
        _ossRates = string.IsNullOrEmpty(OssCountryCode) ? new() : await VatRateService.GetOssRatesAsync(OssCountryCode);

        // Items carrying a rate that is not valid for the destination country (e.g. CZ 21 % on a German
        // invoice) switch to that country's standard rate so the user never submits an invalid rate.
        var standard = _ossRates.OrderBy(r => r.Category).FirstOrDefault();
        if (standard == null) return;
        var changed = false;
        foreach (var item in Items.Where(i => !i.IsTextRow && !_ossRates.Any(r => r.Rate == i.VatRatePercentage)))
        {
            item.VatRateId = null;
            item.VatRatePercentage = standard.Rate;
            changed = true;
        }
        if (changed) NotifyChanged();
    }

    /// <summary>OSS item: only the percentage matters (the tenant VatRateId must stay empty).</summary>
    private void OnOssRateChanged(CreateInvoiceItemDto item, decimal rate)
    {
        item.VatRateId = null;
        item.VatRatePercentage = rate;
        NotifyChanged();
    }

    /// <summary>
    /// Whether the issuing company is a VAT payer. Defaults to true until the issuer is
    /// loaded — if the lookup fails the server still strips VAT for a non-payer, so the
    /// worst case is a VAT column shown for nothing, never VAT charged.
    /// </summary>
    private bool _isVatPayer = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadVatRates();
        await LoadIssuerVatStatus();
    }

    /// <summary>
    /// Reads the issuer's VAT status. For a non-VAT payer, rows loaded from an existing
    /// invoice or template are reset to 0 % so the on-screen totals match what the server
    /// will store (it ignores VAT for non-payers).
    /// </summary>
    private async Task LoadIssuerVatStatus()
    {
        try
        {
            var issuer = await ClientService.GetIssuerAsync();
            _isVatPayer = issuer?.IsVatPayer ?? true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
            return;
        }

        if (!_isVatPayer && Items.Any(i => i.VatRateId.HasValue || i.VatRatePercentage != 0))
        {
            foreach (var item in Items)
            {
                item.VatRateId = null;
                item.VatRatePercentage = 0;
            }
            NotifyChanged();
        }
    }

    /// <summary>
    /// Loads active VAT rates via the typed VatRateApiService.
    /// The service handles auth headers, base URL, and error logging automatically.
    /// </summary>
    private async Task LoadVatRates()
    {
        try
        {
            _vatRates = await VatRateService.GetActiveForDateAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Msg_Error"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Adds a new empty row at the bottom of the grid with sensible defaults
    /// </summary>
    private void AddNewRow()
    {
        var nextOrder = Items.Any() ? Items.Max(i => i.OrderIndex) + 1 : 1;
        // A non-VAT payer never gets a VAT rate; a VAT payer starts with the default rate.
        var defaultVatRate = _isVatPayer ? _vatRates.FirstOrDefault(v => v.IsDefault) : null;
        var ossStandard = !string.IsNullOrEmpty(OssCountryCode) ? _ossRates.OrderBy(r => r.Category).FirstOrDefault() : null;

        Items.Add(new CreateInvoiceItemDto
        {
            OrderIndex = nextOrder,
            Unit = "ks",
            Quantity = 1,
            UnitPrice = 0,
            VatRateId = ossStandard != null ? null : defaultVatRate?.Id,
            VatRatePercentage = ossStandard?.Rate ?? (_isVatPayer ? defaultVatRate?.Rate ?? 21 : 0)
        });

        NotifyChanged();
    }

    /// <summary>
    /// Adds a text-only row (note/comment) — not a billable item.
    /// </summary>
    private void AddTextRow()
    {
        var nextOrder = Items.Any() ? Items.Max(i => i.OrderIndex) + 1 : 1;
        Items.Add(new CreateInvoiceItemDto
        {
            OrderIndex = nextOrder,
            IsTextRow = true,
            Description = "",
            Unit = "",
            Quantity = 0,
            UnitPrice = 0
        });
        NotifyChanged();
    }

    /// <summary>
    /// Removes an item from the list and notifies the parent
    /// </summary>
    private void DeleteItem(CreateInvoiceItemDto item)
    {
        Items.Remove(item);
        NotifyChanged();
    }

    /// <summary>
    /// Updates VAT rate percentage when the user selects a different rate from the dropdown
    /// </summary>
    private void OnVatRateChanged(CreateInvoiceItemDto item, long? vatRateId)
    {
        item.VatRateId = vatRateId;

        if (vatRateId.HasValue)
        {
            var vatRate = _vatRates.FirstOrDefault(v => v.Id == vatRateId.Value);
            if (vatRate != null)
            {
                item.VatRatePercentage = vatRate.Rate;
            }
        }

        NotifyChanged();
    }

    /// <summary>
    /// Notifies the parent component that items have changed
    /// </summary>
    private void NotifyChanged()
    {
        ItemsChanged.InvokeAsync(Items);
    }

    // --- Totals calculations ---

    private decimal CalculateTotalBeforeVat()
    {
        return Items.Where(i => !i.IsTextRow).Sum(i => i.Quantity * i.UnitPrice);
    }

    private decimal CalculateTotalVat()
    {
        return Items.Where(i => !i.IsTextRow).Sum(i => i.Quantity * i.UnitPrice * i.VatRatePercentage / 100);
    }

    private decimal CalculateTotalWithVatAll()
    {
        return CalculateTotalBeforeVat() + CalculateTotalVat();
    }
}
