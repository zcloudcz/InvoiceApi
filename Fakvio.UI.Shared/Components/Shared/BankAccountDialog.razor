@*
    Dialog for adding or editing a bank account.
    Used by BankAccountListEditor for both "Add" and "Edit" operations.
    Returns the edited BankAccountDto via MudDialog.Close() on save.
    Follows the same pattern as AddressDialog.razor.

    Mailbox section:
    - Edit mode (BankAccount.Id > 0): renders BankAccountMailboxCard so the user
      can activate/deactivate/regenerate the per-account payment-matching email.
      Mailbox actions persist immediately via PaymentMatchingApiService and are
      independent of the dialog Save/Cancel — closing the dialog does not roll them back.
    - Add mode (Id == 0): the account does not exist on the server yet, so the
      mailbox card cannot bind. Show an info hint instead.
*@
@inject IStringLocalizer<SharedResource> L
@using Fakvio.Contracts.Dto.Client
@using Fakvio.Domain.Validation

<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        @* Capture Enter key to save, allowing natural tab navigation between fields *@
        <MudGrid @onkeydown="OnKeyDown">
            @* Account number is required — the main identifier for this account *@
            <MudItem xs="12">
                <MudTextField @bind-Value="BankAccount.AccountNumber"
                              Label="@L["BankAccount_AccountNumber"].Value"
                              Required="true"
                              Immediate="true"
                              Validation="@(new Func<string?, string?>(ValidateAccountNumber))"
                              Placeholder="19-2000145399/0800"
                              HelperText="@L["BankAccount_AccountNumberHelper"].Value" />
            </MudItem>

            @* Label — optional, helps distinguish between multiple accounts *@
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="BankAccount.Label"
                              Label="@L["BankAccount_Label"].Value"
                              Placeholder="CZK Account" />
            </MudItem>

            @* Bank name — optional *@
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="BankAccount.BankName"
                              Label="@L["BankAccount_BankName"].Value"
                              Placeholder="Fio banka" />
            </MudItem>

            @* IBAN — optional, used for international payments and QR codes *@
            <MudItem xs="12">
                <MudTextField @bind-Value="BankAccount.IBAN"
                              Label="@L["BankAccount_IBAN"].Value"
                              Immediate="true"
                              Validation="@(new Func<string?, string?>(ValidateIban))"
                              Placeholder="CZ65 0800 0000 1920 0014 5399" />
            </MudItem>

            @* SWIFT and Currency side by side *@
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="BankAccount.SWIFT"
                              Label="@L["BankAccount_SWIFT"].Value"
                              Placeholder="GIBACZPX" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="BankAccount.CurrencyCode"
                              Label="@L["BankAccount_Currency"].Value"
                              Placeholder="CZK"
                              MaxLength="3" />
            </MudItem>

            @* Default toggle — only one account per client can be default *@
            <MudItem xs="12">
                <MudSwitch @bind-Value="BankAccount.IsDefault"
                           Label="@L["BankAccount_Default"].Value"
                           Color="Color.Warning" />
            </MudItem>

            @* ── Mailbox section (per-bank-account payment-matching email) ───────── *@
            @* Visually separated by a divider + section title. The card itself
               talks to /api/payment-matching/mailbox/* and persists immediately,
               so it does not participate in the dialog's Save/Cancel flow. *@
            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">
                    @L["BankMailbox_Section_Title"]
                </MudText>
                @if (BankAccount.Id > 0)
                {
                    <BankAccountMailboxCard BankAccountId="@BankAccount.Id" />
                }
                else
                {
                    @* Add mode — bank account not persisted yet, mailbox can only bind to a real Id. *@
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @L["BankMailbox_AvailableAfterSave"]
                    </MudAlert>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">@L["Btn_Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// MudDialog instance — required for closing the dialog with a result.
    /// </summary>
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// The bank account being created or edited.
    /// Pre-populated with defaults (add) or existing values (edit) by the caller.
    /// In edit mode the Id property is required so the mailbox card can bind.
    /// </summary>
    [Parameter]
    public BankAccountDto BankAccount { get; set; } = new();

    /// <summary>
    /// Dialog title text — set by the caller to distinguish "Add" vs "Edit" mode.
    /// </summary>
    [Parameter]
    public string DialogTitle { get; set; } = "";

    /// <summary>
    /// Inline validation of the account number.
    ///
    /// Issue #154: the only rule here used to be Required="true", so a mistyped account number
    /// was accepted, stored, and only became visible much later — as a QR code nobody could
    /// pay, on an invoice the customer had already received. The moment the user types the
    /// value is the only moment the correct number is still in front of them.
    ///
    /// The shared <see cref="BankAccountValidator"/> decides what is valid (Czech-shaped
    /// numbers must pass modulo 11, foreign ones are accepted as-is), so the form, the API,
    /// and the QR generator cannot drift apart. Its reasons are technical and English-only,
    /// so the message shown here is the localized one.
    /// </summary>
    private string? ValidateAccountNumber(string? value)
    {
        // Empty is handled by Required="true" — no point in showing two errors at once.
        if (string.IsNullOrWhiteSpace(value)) return null;

        return BankAccountValidator.TryValidateAccountNumber(value, out _)
            ? null
            : L["BankAccount_AccountNumberInvalid"].Value;
    }

    /// <summary>
    /// Inline validation of the IBAN. The field is optional, so only a filled-in value
    /// has to be correct — but an incorrect one would produce an unpayable QR code.
    /// </summary>
    private string? ValidateIban(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;

        return BankAccountValidator.TryValidateIban(value, out _)
            ? null
            : L["BankAccount_IbanInvalid"].Value;
    }

    /// <summary>
    /// Validates the fields and closes the dialog returning the edited bank account.
    /// The same checks run in ClientService on the server, so a client that skips the
    /// dialog still cannot store an unusable account — this is the convenience half.
    /// </summary>
    private void Save()
    {
        // AccountNumber is required — don't close if empty
        if (string.IsNullOrWhiteSpace(BankAccount.AccountNumber))
        {
            return; // MudTextField Required="true" will show validation error
        }

        // Don't close while a field is showing a validation error; the inline messages
        // already tell the user what is wrong.
        if (ValidateAccountNumber(BankAccount.AccountNumber) != null ||
            ValidateIban(BankAccount.IBAN) != null)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(BankAccount));
    }

    /// <summary>
    /// Closes the dialog without saving — returns a canceled result.
    /// </summary>
    private void Cancel() => MudDialog.Cancel();

    /// <summary>
    /// Handles keyboard shortcuts:
    /// - Enter → Save (submit the form)
    /// - ESC is handled by MudDialog's CloseOnEscapeKey option
    /// </summary>
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Save();
        }
    }
}
