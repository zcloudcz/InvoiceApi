<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.7.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <!-- TestServer: hosts the MCP HTTP transport in memory (no socket, no port) so the
         cross-tenant isolation tests run the real ASP.NET Core pipeline. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.2" />
    <!-- Localization — needed for SharedResource localization unit tests -->
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.2" />
    <!-- UBL / Peppol BIS schematron validation (ADR 0002, F1.2) — Saxon-HE 12 (XSLT 2.0) via
         IKVM, test-project only. The official EN16931/Peppol validation artefacts are
         precompiled XSLT 2.0, which System.Xml.Xsl (XSLT 1.0 only) cannot run.
         IKVM.Maven.Sdk enables <MavenReference> below; it does not pull the Saxon-HE Java
         artifact itself — that has to be requested explicitly. -->
    <PackageReference Include="SaxonHE12s9apiExtensions" Version="12.10.1" />
    <PackageReference Include="IKVM.Maven.Sdk" Version="1.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Downloaded from Maven Central at build time (and cached) by IKVM.Maven.Sdk, then
         compiled to a .NET assembly by IKVM — not a NuGet package, so it does not show up in
         `dotnet list package`. Version must stay in sync with the JAR SaxonHE12s9apiExtensions
         12.10.1 was built against (see its README). -->
    <MavenReference Include="net.sf.saxon:Saxon-HE" Version="12.10" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Copy appsettings.json to output directory so tests can load real SMTP config -->
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- UBL/Peppol sample invoices for UblImportParserTests (F1.10). Origin and license
       are documented in Ubl/ImportFixtures/README.md. -->
  <ItemGroup>
    <None Include="Ubl\ImportFixtures\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- UBL/Peppol validation artifacts (ADR 0002, F1.2) — vendored XSD/XSLT + example fixtures,
       see Ubl/Vendored/README.md for provenance. Copied to output so UblTestValidator can read
       them by relative path at test run time (same pattern as appsettings.json above). -->
  <ItemGroup>
    <None Update="Ubl\Vendored\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Ubl\Fixtures\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Vendor schemas for AccountingExporterTests (see Schemas/README.md). -->
  <ItemGroup>
    <None Update="Schemas\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fakvio.Domain\Fakvio.Domain.csproj" />
    <ProjectReference Include="..\Fakvio.Application\Fakvio.Application.csproj" />
    <ProjectReference Include="..\Fakvio.Infrastructure\Fakvio.Infrastructure.csproj" />
    <ProjectReference Include="..\Fakvio.API\Fakvio.API.csproj" />
    <ProjectReference Include="..\Fakvio.UI.Shared\Fakvio.UI.Shared.csproj" />
    <ProjectReference Include="..\Fakvio.McpServer\Fakvio.McpServer.csproj" />
  </ItemGroup>

</Project>