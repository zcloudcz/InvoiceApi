{
  "ConnectionStrings": {
    // Master database — Users, Companies, CompanySystemSettings, code table defaults (SQL Server)
    // Trusted_Connection=true uses Windows Authentication (no username/password needed)
    "MasterConnection": "Server=localhost;Database=invoiceapi_master_dev;Trusted_Connection=true;TrustServerCertificate=true",
    // Template tenant database — used only by EF CLI tools for migration generation
    "TenantTemplateConnection": "Server=localhost;Database=invoiceapi_tenant_template;Trusted_Connection=true;TrustServerCertificate=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Secret": "DevOnlyJwtSecretKeyThatIsAtLeast32CharactersLong!ForLocalDevelopment"
  },
  "CorsSettings": {
    // Development: allow localhost origins for Blazor WASM UI, API, and Swagger
    "AllowedOrigins": [
      "https://localhost:5001",
      "http://localhost:5000",
      "https://localhost:7001",
      "http://localhost:7000",
      "https://localhost:7212",
      "http://localhost:5145",
      "https://localhost:7047"
    ]
  }
}
