@page "/register"
@using InvoiceApi.UI.Shared.Models
@using InvoiceApi.UI.Shared.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthApiService AuthApiService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IConfiguration Configuration
@* Localization service for multi-language support *@
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Register_Title"] - Invoice API</PageTitle>

@*
    Anonymous page — no [Authorize] attribute.
    Self-registration for new companies.
    If query params are present (from OAuth redirect), pre-fill the form.
*@

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-8">
        <MudStack Spacing="4">
            @* Header *@
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h4" Align="Align.Center">Invoice API</MudText>
                <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Secondary">@L["Register_Title"]</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    @L["Register_Subtitle"]
                </MudText>
            </MudStack>

            @* OAuth provider indicator (when registering via OAuth redirect) *@
            @if (_isOAuthRegistration)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    @string.Format(L["Register_OAuthWith"].Value, _oauthProvider)
                </MudAlert>
            }

            @* Success message after registration *@
            @if (_isSuccess)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled">
                    @L["Register_Success"]
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="@(() => Navigation.NavigateTo("/login"))">
                    @L["Btn_Login"]
                </MudButton>
            }
            else
            {
                @* Error message *@
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
                }

                @* Registration form *@
                <MudStack Spacing="3">
                    @* Email *@
                    <MudTextField @bind-Value="_request.Email"
                                  Label="@L["Register_Email"].Value"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Required="true"
                                  Disabled="_isOAuthRegistration"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email" />

                    @* Password fields — hidden for OAuth registrations *@
                    @if (!_isOAuthRegistration)
                    {
                        <MudTextField @bind-Value="_password"
                                      Label="@L["Register_Password"].Value"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />

                        <MudTextField @bind-Value="_confirmPassword"
                                      Label="@L["Register_ConfirmPassword"].Value"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                    }

                    @* Name fields *@
                    <MudStack Row="true" Spacing="2">
                        <MudTextField @bind-Value="_request.FirstName"
                                      Label="@L["Register_FirstName"].Value"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />

                        <MudTextField @bind-Value="_request.LastName"
                                      Label="@L["Register_LastName"].Value"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />
                    </MudStack>

                    @* Company name *@
                    <MudTextField @bind-Value="_request.CompanyName"
                                  Label="@L["Register_CompanyName"].Value"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Business" />

                    @* IČO with ARES button *@
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                        <MudTextField @bind-Value="_request.RegistrationNumber"
                                      Label="@L["Register_RegistrationNumber"].Value"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Numbers"
                                      Style="flex: 1" />

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@(_isLoadingAres || string.IsNullOrWhiteSpace(_request.RegistrationNumber))"
                                   OnClick="LoadFromAresAsync"
                                   Style="white-space: nowrap">
                            @if (_isLoadingAres)
                            {
                                <MudProgressCircular Class="mr-1" Size="Size.Small" Indeterminate="true" />
                                @L["Register_AresLoading"]
                            }
                            else
                            {
                                @L["Register_LoadAres"]
                            }
                        </MudButton>
                    </MudStack>

                    @* ARES result feedback *@
                    @if (!string.IsNullOrEmpty(_aresMessage))
                    {
                        <MudAlert Severity="@_aresSeverity" Dense="true">@_aresMessage</MudAlert>
                    }

                    @* Submit button *@
                    <MudButton ButtonType="ButtonType.Button"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth="true"
                               Disabled="@_isSubmitting"
                               OnClick="HandleRegisterAsync">
                        @if (_isSubmitting)
                        {
                            <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            <span>@L["Register_Registering"]</span>
                        }
                        else
                        {
                            <span>@L["Register_Submit"]</span>
                        }
                    </MudButton>
                </MudStack>

                @* OAuth provider buttons *@
                @if (!_isOAuthRegistration)
                {
                    <MudDivider />
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        @L["Login_OrContinueWith"]
                    </MudText>
                    <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                        <MudIconButton Icon="@Icons.Custom.Brands.Google"
                                       Color="Color.Default"
                                       Variant="Variant.Outlined"
                                       OnClick="@(() => LoginWithProvider("Google"))"
                                       title="Google" />
                        <MudIconButton Icon="@Icons.Custom.Brands.Microsoft"
                                       Color="Color.Default"
                                       Variant="Variant.Outlined"
                                       OnClick="@(() => LoginWithProvider("Microsoft"))"
                                       title="Microsoft" />
                        <MudIconButton Icon="@Icons.Custom.Brands.Facebook"
                                       Color="Color.Default"
                                       Variant="Variant.Outlined"
                                       OnClick="@(() => LoginWithProvider("Facebook"))"
                                       title="Facebook" />
                        <MudIconButton Icon="@Icons.Custom.Brands.Apple"
                                       Color="Color.Default"
                                       Variant="Variant.Outlined"
                                       OnClick="@(() => LoginWithProvider("Apple"))"
                                       title="Apple" />
                    </MudStack>
                }

                @* Link to login page *@
                <MudText Typo="Typo.body2" Align="Align.Center">
                    <MudLink Href="/login" Color="Color.Primary">
                        @L["Register_AlreadyHaveAccount"]
                    </MudLink>
                </MudText>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    // Query parameters for OAuth pre-fill (from /api/auth/external-callback redirect)
    [SupplyParameterFromQuery] public string? Provider { get; set; }
    [SupplyParameterFromQuery] public string? ProviderId { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? FirstName { get; set; }
    [SupplyParameterFromQuery] public string? LastName { get; set; }

    private RegisterRequest _request = new();
    private string _password = "";
    private string _confirmPassword = "";
    private string? _errorMessage;
    private bool _isSubmitting;
    private bool _isSuccess;
    private bool _isLoadingAres;
    private string? _aresMessage;
    private Severity _aresSeverity;

    // OAuth registration state
    private bool _isOAuthRegistration;
    private string _oauthProvider = "";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Redirect if already authenticated
        if (AuthenticationState != null)
        {
            var authState = await AuthenticationState;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo("/");
            }
        }

        // Pre-fill from OAuth redirect query params
        if (!string.IsNullOrEmpty(Provider))
        {
            _isOAuthRegistration = true;
            _oauthProvider = Provider;
            _request.Email = Email ?? "";
            _request.FirstName = FirstName ?? "";
            _request.LastName = LastName ?? "";
        }
    }

    /// <summary>
    /// Handles registration form submission.
    /// Validates inputs, calls the API, and shows success/error messages.
    /// </summary>
    private async Task HandleRegisterAsync()
    {
        _errorMessage = null;

        // Client-side validation for non-OAuth registrations
        if (!_isOAuthRegistration)
        {
            if (_password != _confirmPassword)
            {
                _errorMessage = L["Register_PasswordMismatch"].Value;
                return;
            }

            if (_password.Length < 6)
            {
                _errorMessage = L["Register_MinPasswordLength"].Value;
                return;
            }

            _request.Password = _password;
        }
        else
        {
            // OAuth users get a random password (they'll never use it)
            _request.Password = Guid.NewGuid().ToString();
        }

        // Basic field validation
        if (string.IsNullOrWhiteSpace(_request.Email) ||
            string.IsNullOrWhiteSpace(_request.FirstName) ||
            string.IsNullOrWhiteSpace(_request.LastName) ||
            string.IsNullOrWhiteSpace(_request.CompanyName))
        {
            _errorMessage = L["Msg_FillRequired"].Value;
            return;
        }

        _isSubmitting = true;

        try
        {
            var response = await AuthApiService.RegisterAsync(_request);

            if (response != null)
            {
                _isSuccess = true;
                Snackbar.Add(L["Register_Success"].Value, Severity.Success);
            }
            else
            {
                _errorMessage = L["Register_Error"].Value;
            }
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = $"{L["Register_Error"].Value}: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    /// <summary>
    /// Calls the ARES API to auto-fill company details from IČO (registration number).
    /// Uses the existing /api/client/ares/{ico} endpoint.
    /// </summary>
    private async Task LoadFromAresAsync()
    {
        if (string.IsNullOrWhiteSpace(_request.RegistrationNumber)) return;

        _isLoadingAres = true;
        _aresMessage = null;

        try
        {
            // Use the existing ARES endpoint on the API
            var apiBaseUrl = Configuration["ApiSettings:BaseUrl"]!;
            using var httpClient = new HttpClient { BaseAddress = new Uri(apiBaseUrl) };
            var response = await httpClient.GetAsync($"/api/client/ares/{_request.RegistrationNumber}");

            if (response.IsSuccessStatusCode)
            {
                var aresData = await response.Content.ReadFromJsonAsync<AresResult>();
                if (aresData != null && !string.IsNullOrEmpty(aresData.CompanyName))
                {
                    _request.CompanyName = aresData.CompanyName;
                    _aresMessage = L["Register_AresSuccess"].Value;
                    _aresSeverity = Severity.Success;
                }
                else
                {
                    _aresMessage = L["Register_AresFailed"].Value;
                    _aresSeverity = Severity.Warning;
                }
            }
            else
            {
                _aresMessage = L["Register_AresFailed"].Value;
                _aresSeverity = Severity.Warning;
            }
        }
        catch
        {
            _aresMessage = L["Register_AresFailed"].Value;
            _aresSeverity = Severity.Error;
        }
        finally
        {
            _isLoadingAres = false;
        }
    }

    /// <summary>
    /// Navigates to the API's external login endpoint for the specified OAuth provider.
    /// The API will redirect the browser to the provider's login page.
    /// </summary>
    private void LoginWithProvider(string provider)
    {
        var apiBaseUrl = Configuration["ApiSettings:BaseUrl"]!;
        Navigation.NavigateTo(
            $"{apiBaseUrl}/api/auth/external-login?provider={provider}&returnUrl=/auth-callback",
            forceLoad: true);
    }

    /// <summary>
    /// Simple DTO for ARES response deserialization (only CompanyName is needed here)
    /// </summary>
    private class AresResult
    {
        public string? CompanyName { get; set; }
    }
}
