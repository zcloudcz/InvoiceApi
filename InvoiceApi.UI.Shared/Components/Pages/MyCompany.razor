        }
    }

    // ─── Cloud Storage Methods ───────────────────────────────────────────────

    /// <summary>
    /// Loads the cloud storage connection status for all providers.
    /// </summary>
    private async Task LoadCloudStorageStatus()
    {
        try
        {
            _cloudStorageLoading = true;
            _cloudStorageStatuses = await CloudStorageApi.GetStatusAsync();
        }
        catch (Exception ex)
        {
            _cloudStorageStatuses = new List<CloudStorageStatusDto>();
            Snackbar.Add($"Failed to load cloud storage status: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _cloudStorageLoading = false;
        }
    }

    /// <summary>
    /// Opens an OAuth popup window to connect a cloud storage provider.
    /// The popup navigates to the provider's OAuth page; on success, the callback page
    /// posts a message back to this window, which triggers a status reload.
    /// </summary>
    private async Task ConnectCloud(ECloudStorageProvider provider)
    {
        try
        {
            // Build the redirect URI for the OAuth callback page
            var callbackUri = Navigation.ToAbsoluteUri("/cloud-storage/callback").ToString();
            var authUrl = await CloudStorageApi.GetAuthorizationUrlAsync(provider, callbackUri);

            if (string.IsNullOrEmpty(authUrl))
            {
                Snackbar.Add("Failed to get authorization URL", Severity.Error);
                return;
            }

            // Open OAuth authorization URL in a popup window
            // The state parameter carries the provider name so the callback knows which provider
            var fullUrl = authUrl + $"&state={provider}";
            await JS.InvokeVoidAsync("eval",
                $"window.open('{fullUrl}', 'cloud_auth', 'width=600,height=700,left=200,top=100');");

            // Listen for the success message from the popup callback page
            // The callback page does: window.opener.postMessage('cloud-storage-connected','*')
            // We can't directly listen from Blazor Server, so we'll prompt user to refresh
            Snackbar.Add("Please complete authorization in the popup window, then refresh this page.",
                Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Disconnects a cloud storage provider after confirmation.
    /// </summary>
    private async Task DisconnectCloud(ECloudStorageProvider provider)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", L["CloudStorage_DisconnectConfirm"].Value);
        if (!confirmed) return;

        try
        {
            var success = await CloudStorageApi.DisconnectAsync(provider);
            if (success)
            {
                Snackbar.Add(L["CloudStorage_DisconnectSuccess"].Value, Severity.Success);
                await LoadCloudStorageStatus();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Tests the connection to a cloud storage provider.
    /// </summary>
    private async Task TestCloudConnection(ECloudStorageProvider provider)
    {
        try
        {
            var success = await CloudStorageApi.TestConnectionAsync(provider);
            Snackbar.Add(
                success ? L["CloudStorage_TestSuccess"].Value : L["CloudStorage_TestFailed"].Value,
                success ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["CloudStorage_TestFailed"].Value}: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Opens the folder picker dialog for a cloud storage provider.
    /// </summary>
    private async Task OpenFolderPicker(ECloudStorageProvider provider)
    {
        var status = _cloudStorageStatuses.FirstOrDefault(s => s.Provider == provider);

        var parameters = new DialogParameters<FolderPicker>
        {
            { x => x.Provider, provider },
            { x => x.CurrentFolderId, status?.FolderId }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<FolderPicker>(L["CloudStorage_SelectFolder"].Value, parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CloudStorageSetFolderRequest folderRequest)
        {
            try
            {
                var success = await CloudStorageApi.SetFolderAsync(provider, folderRequest);
                if (success)
                {
                    Snackbar.Add(L["CloudStorage_FolderSet"].Value, Severity.Success);
                    await LoadCloudStorageStatus();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }
