<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- SkippableFact: lets a test skip at runtime when PostgreSQL is not reachable. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Fakvio.MigrationTool is the only project under test here; Domain and Infrastructure come
    in transitively. Until this reference existed, NO test project referenced the migration
    tool at all, so nothing could pin the behaviour of its composition root (see the class
    comment in TenantSchemaCanonicalizationTests).

    Deliberately NO reference to Fakvio.API. "Npgsql.EnableLegacyTimestampBehavior" is a
    process-global AppContext switch that every host in this repository turns on at startup;
    Npgsql reads it once and then freezes it. A test assembly that also boots the API host
    would therefore have the switch flipped by whichever test ran first — the ordering
    dependency behind issue #194. Keeping this assembly host-free means the fixture sets it
    exactly once and the outcome does not depend on test order.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Fakvio.MigrationTool\Fakvio.MigrationTool.csproj" />
  </ItemGroup>

</Project>
